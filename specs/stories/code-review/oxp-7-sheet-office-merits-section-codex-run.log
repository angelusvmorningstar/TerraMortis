  it('no longer imports initFeedingEngine', () => {
    expect(src).not.toMatch(/import\s*\{\s*initFeedingEngine\s*\}/);
    expect(src).not.toMatch(/from\s*['"]\.\/admin\/feeding-engine\.js['"]/);
  });
  it('no longer imports initSessionTracker', () => {
