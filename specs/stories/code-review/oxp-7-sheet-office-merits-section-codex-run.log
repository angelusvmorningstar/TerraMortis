    expect(src).toMatch(/_genOwnedCompounds\s*=\s*_genCompounds\.filter\(cmp\s*=>\s*ownsCompound\(c,\s*cmp\)\)/);
    expect(src).toMatch(/_genPoolsFor\s*=\s*\(name\)\s*=>/);
