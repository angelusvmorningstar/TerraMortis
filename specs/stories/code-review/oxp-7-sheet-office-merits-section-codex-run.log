      const rr = rule.rating_range;
      const minR = rr ? rr[0] : 1;
      if (minR > 1) continue;
      if (rr && rr[0] === rr[1] && rr[0] !== 1) continue;
      if (_everyPrereqPathRequiresCarthian(rule.prereq)) continue;
      qualified.push({ key: rule.name.toLowerCase(), label: rule.name });
