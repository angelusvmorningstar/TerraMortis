+  if (!data) return; // Administrator — no merit suite exists yet (oxp.8)
+
+  let seats = null, dotsBySeat = null;
+  try {
+    [seats, dotsBySeat] = await Promise.all([
+      apiGet('/api/office_seats'),
+      apiGet('/api/office_merit_dots'),
