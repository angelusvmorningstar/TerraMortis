 * @param {string} currentName - currently selected merit name
 */
const MCI_DOT_RATING = [1, 1, 2, 3, 3];
export function buildMCIGrantOptions(c, dotLevel, currentName) {
  const maxR = MCI_DOT_RATING[dotLevel] || 1;
