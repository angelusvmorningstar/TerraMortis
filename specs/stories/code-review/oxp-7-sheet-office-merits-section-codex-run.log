  });

  it('zero when capacity is zero or used >= capacity', () => {
    expect(poolAvailableFor({ _grant_pools: [], merits: [] }, 'necro')).toBe(0);
    const over = {
      _grant_pools: [{ category: 'necro', amount: 2 }],
