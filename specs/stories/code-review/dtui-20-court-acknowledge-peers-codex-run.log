+      fakeMeritToggle.dataset.meritToggle = 'review-temp';
+      fakeMeritToggle.value = 'yes';
+      document.querySelector('#dt-sandbox').appendChild(fakeMeritToggle);
+      fakeMeritToggle.dispatchEvent(new Event('change', { bubbles: true }));
