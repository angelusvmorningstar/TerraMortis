+      body: JSON.stringify([{ _id: char._id, name: char.name }, ...OTHER_CHARS]),
+    })
+  );
+  await page.route('**/api/chapters', r =>
+    r.fulfill({ status: 200, contentType: 'application/json', body: JSON.stringify([ACTIVE_CYCLE]) })
