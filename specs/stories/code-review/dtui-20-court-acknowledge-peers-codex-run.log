.cc-alert.red{background:var(--badge-err-bg);color:var(--txt-on-dark);border:1px solid var(--badge-err-bdr);}
.cc-alert.yellow{background:var(--badge-warn-bg);color:var(--txt-on-dark);border:1px solid var(--badge-warn-bdr);font-size:var(--fs-floor-body);}
.cc-identity{flex:1;min-width:0;}
