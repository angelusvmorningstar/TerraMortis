   1: /**
   2:  * Bonus-success evaluator — processes rule_bonus_success docs at ROLL time.
   3:  *
   4:  * Every other evaluator in this directory runs during a character render and
   5:  * produces dots. This one runs once per dice roll, after the dice have been
   6:  * counted, and produces successes. It is deliberately NOT wired into
   7:  * applyDerivedMerits: a bonus success is a property of a roll, not of a sheet.
   8:  *
   9:  * The first rule to use it is Stronger Than You (Strength Performance rank 4):
  10:  * "Successful Strength rolls add an additional free success." Defined in
  11:  * public/data/man_db.json since project inception, never enforced until now.
  12:  *
  13:  * No external imports — pure functions, safe in Node.js test contexts, same
  14:  * contract as every sibling evaluator here.
  15:  *
  16:  * Contract notes:
  17:  *   - Bonus successes apply only when the roll ALREADY scored at least one
  18:  *     rolled success. A failed roll stays failed; nothing rescues it.
  19:  *   - A chance die showing 10 is a rolled success, so it qualifies.
  20:  *   - Rolled and bonus counts are kept apart in the result so a future rule
  21:  *     that must ignore bonus successes (Street Fighting "Kick 'Em While
  22:  *     They're Down", Merits Errata:693) can read `rolled` on its own.
  23:  *   - Multiple matching rules stack additively, including two rules that
  24:  *     share a `source`.
  25:  */
  26: 
  27: // ── Public API ───────────────────────────────────────────────────────────────
  28: 
  29: /**
  30:  * Which bonus-success rules fire for this character on this roll.
  31:  *
  32:  * @param {object}  c            character document (never mutated)
  33:  * @param {object}  rollContext  { attr, skill, disc, spec, rolledSuccesses }
  34:  * @param {Array}   rules        rule_bonus_success docs (the whole collection)
  35:  * @returns {Array<{source: string, count: number}>} empty when nothing fires
  36:  */
  37: export function resolveBonusSuccesses(c, rollContext = {}, rules = []) {
  38:   if (!c || !Array.isArray(rules) || rules.length === 0) return [];
  39: 
  40:   // Failed-roll gate. Also covers the "no count supplied" case, which must
  41:   // never silently grant successes.
  42:   const rolled = _int(rollContext?.rolledSuccesses);
  43:   if (rolled < 1) return [];
  44: 
  45:   const out = [];
  46:   for (const rule of rules) {
  47:     if (!rule || typeof rule !== 'object') continue;
  48:     if (!rule.source) continue;
  49:     if (!_matches(c, rollContext, rule.predicate)) continue;
  50: 
  51:     const extra = Array.isArray(rule.also_requires) ? rule.also_requires : [];
  52:     if (!extra.every(p => _matches(c, rollContext, p))) continue;
  53: 
  54:     const count = _count(c, rule);
  55:     if (count > 0) out.push({ source: String(rule.source), count });
  56:   }
  57:   return out;
  58: }
  59: 
  60: /**
  61:  * Fold a rolled-success count together with whatever bonus successes apply.
  62:  *
  63:  * Kept separate from resolveSuccesses(cols, ...) in shared/dice.js because the
  64:  * rote path has already reduced two dice pools to one winning ROLLED count by
  65:  * the time the bonus is added — the bonus is added once, to the winner, never
  66:  * to each candidate roll.
  67:  *
  68:  * @returns {{rolled: number, bonus: Array, total: number}}
  69:  */
  70: export function combineSuccesses(rolled, c, rollContext = {}, rules = []) {
  71:   const r = _int(rolled);
  72:   const bonus = resolveBonusSuccesses(c, { ...rollContext, rolledSuccesses: r }, rules || []);
  73:   const total = r + bonus.reduce((sum, b) => sum + b.count, 0);
  74:   return { rolled: r, bonus, total };
  75: }
  76: 
  77: /**
  78:  * The verdict-line breakdown, e.g.
  79:  *   "4 rolled + 1 (Stronger Than You) = 5 successes"
  80:  *
  81:  * Returns '' when no bonus applies, so every display surface can append it
  82:  * unconditionally and leave the existing line untouched on a normal roll.
  83:  */
  84: export function formatSuccessBreakdown(result) {
  85:   if (!result || !Array.isArray(result.bonus) || result.bonus.length === 0) return '';
  86:   const parts = result.bonus.map(b => `+ ${b.count} (${b.source})`).join(' ');
  87:   const total = _int(result.total);
  88:   return `${_int(result.rolled)} rolled ${parts} = ${total} success${total === 1 ? '' : 'es'}`;
  89: }
  90: 
  91: // ── Predicates ───────────────────────────────────────────────────────────────
  92: 
  93: function _matches(c, ctx, pred) {
  94:   if (!pred || typeof pred !== 'object' || !pred.kind || !pred.name) return false;
  95:   const name = String(pred.name);
  96: 
  97:   switch (pred.kind) {
  98:     case 'roll_attr':
  99:       return _sameName(ctx?.attr, name);
 100: 
 101:     case 'roll_skill':
 102:       return _sameName(ctx?.skill, name);
 103: 
 104:     case 'merit_present': {
 105:       const min = Number.isInteger(pred.min_rating) && pred.min_rating > 0 ? pred.min_rating : 1;
 106:       return (c.merits || []).some(m => _sameName(m?.name, name) && _meritRating(m) >= min);
 107:     }
 108: 
 109:     // Manoeuvre possession is flat fighting_picks[] membership by name, not a
 110:     // style-rating threshold — a character has picked the manoeuvre or has
 111:     // not. Mirrors the existing check in public/js/admin/rules-view.js:99-102.
 112:     // Style dots alone never grant it.
 113:     case 'manoeuvre_present':
 114:       return (c.fighting_picks || []).some(pk =>
 115:         _sameName(typeof pk === 'string' ? pk : pk?.manoeuvre, name)
 116:       );
 117: 
 118:     default:
 119:       return false;
 120:   }
 121: }
 122: 
 123: // ── Amounts ──────────────────────────────────────────────────────────────────
 124: 
 125: function _count(c, rule) {
 126:   switch (rule.count_basis) {
 127:     case 'flat':
 128:       return _int(rule.flat_amount ?? 1);
 129: 
 130:     // Only meaningful against a merit_present predicate; the route rejects any
 131:     // other pairing, and this returns 0 rather than throwing if one slips in.
 132:     case 'rating': {
 133:       if (rule.predicate?.kind !== 'merit_present') return 0;
 134:       const name = String(rule.predicate.name);
 135:       const m = (c.merits || []).find(x => _sameName(x?.name, name));
 136:       return m ? _meritRating(m) : 0;
 137:     }
 138: 
 139:     default:
 140:       return 0;
 141:   }
 142: }
 143: 
 144: /**
 145:  * ADR-001 trait-reference primitive: a rule referencing a merit's rating reads
 146:  * `m.rating`, which is already the effective sum (inherent dots plus every
 147:  * free_* channel) after the render's phase-5 rating sync. There is deliberately
 148:  * no inherent-only fallback here — reading purchased dots would reintroduce the
 149:  * exact bug class the effective-rating contract exists to prevent.
 150:  */
 151: function _meritRating(m) {
 152:   const n = Number(m?.rating);
 153:   return Number.isFinite(n) && n > 0 ? Math.floor(n) : 0;
 154: }
 155: 
 156: // ── Small helpers ────────────────────────────────────────────────────────────
 157: 
 158: function _sameName(a, b) {
 159:   if (typeof a !== 'string' || typeof b !== 'string') return false;
 160:   return a.trim().toLowerCase() === b.trim().toLowerCase();
 161: }
 162: 
 163: function _int(v) {
 164:   const n = Number(v);
 165:   return Number.isFinite(n) && n > 0 ? Math.floor(n) : 0;
 166: }
