 303: export function loadPool(total, name, pi) {
 304:   state.PS = Math.max(0, total);
 305:   state.MOD = 0;
 306:   state.specBonuses = {};
 307:   state.activeEquipBonus = null;
 308:   state.activeWeaponId = null;
 309:   state.POOL_INFO = pi || null;
 310:   // rcv.3a: painted once here, never from updPool() (see updRulesSummary()).
 311:   updRulesSummary(state.POOL_INFO);
 312:   // rlv.7 (#1039): restore this power's persisted mod chips, folding
 313:   // currently-on ones into MOD — same reset-then-rebuild pattern as
 314:   // specBonuses/activeEquipBonus above, just sourced from localStorage
 315:   // instead of starting empty.
 316:   state.POOL_NAME = name;
 317:   state.powerChips = state.rollChar ? loadChips(String(state.rollChar._id), name) : [];
 318:   state.MOD += state.powerChips.filter(c => c.on).reduce((sum, c) => sum + c.value, 0);
 319:   // Auto-set 9-Again when the pool source grants it
 320:   if (pi?.nineAgain) setAgain(9);
 321:   else setAgain(10);
 322:   // Reset Rote — player toggles manually (PT dot-5 costs 1 WP)
 323:   if (state.ROTE) togMod('rote');
 324:   showResistSec();
 325:   updPool();
 326:   const banner = document.getElementById('pool-banner');
 327:   const cn = state.rollChar ? state.rollChar.name.split(' ')[0] : '';
 328:   banner.textContent = cn ? cn + ' \u00B7 ' + name + ' \u00B7 ' + total + 'd' : name + ' \u00B7 ' + total + 'd';
 329:   banner.classList.add('on');
 330:   document.getElementById('sc-disc-lbl').textContent = '';
 331:   document.getElementById('sc-disc-val').textContent = name;
 332:   document.getElementById('sc-disc').classList.add('loaded');
 333:   closePanel();
 334: }
