 451:   h += `<div class="feeding-st-roll-body">`;
 452:   h += `<span class="feeding-st-roll-dice">${pool} dice`;
 453:   if (againLabel) h += ` \u00B7 ${againLabel}`;
 454:   if (rote) h += ' \u00B7 Rote';
 455:   h += '</span>';
 456:   h += `<span class="feeding-st-roll-result ${cls}">${suc} success${suc !== 1 ? 'es' : ''}`;
 457:   if (exc && suc > 0) h += ' (exceptional)';
 458:   h += '</span>';
