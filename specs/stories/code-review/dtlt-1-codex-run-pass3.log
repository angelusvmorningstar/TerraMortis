   1: /**
   2:  * Seed script — inserts the rule_bonus_success docs (dtlt.1).
   3:  * Idempotent: replaceOne/upsert on a stable composite key.
   4:  *
   5:  * One doc in v1 (scope confirmed by Angelus, 2026-08-31):
   6:  *   Stronger Than You — Strength Performance rank 4. A successful Strength
   7:  *   roll gains one free success. Gated on having actually PICKED the
   8:  *   manoeuvre (fighting_picks[]), not on Strength Performance style dots.
   9:  *
  10:  * Any further "+N successes when X" house rule is a Mongo doc edit through the
  11:  * admin Engine panel, not a code change — that is the whole point of the
  12:  * collection. Add new docs here only when they should ship as defaults.
  13:  *
  14:  * Usage:
  15:  *   node server/scripts/seed-rules-bonus-successes.js --dry-run   (default)
  16:  *   node server/scripts/seed-rules-bonus-successes.js --apply
  17:  *
  18:  * Target DB is the MONGODB_DB env var (default: tm_game).
  19:  * Use MONGODB_DB=tm_game_test for test-DB seeding.
  20:  */
  21: 
  22: import { pathToFileURL } from 'url';
  23: 
  24: // ── Rule docs ─────────────────────────────────────────────────────────────────
  25: 
  26: export const BONUS_SUCCESS_DOCS = [
  27:   {
  28:     doc: {
  29:       source: 'Stronger Than You',
  30:       predicate: { kind: 'manoeuvre_present', name: 'Stronger Than You' },
  31:       also_requires: [{ kind: 'roll_attr', name: 'Strength' }],
  32:       count_basis: 'flat',
  33:       flat_amount: 1,
  34:       notes:
  35:         'Strength Performance rank 4 (public/data/man_db.json): a successful Strength roll adds '
  36:         + 'one free success. Applies only when the roll already scored at least one rolled success. '
  37:         + 'Requires an explicit fighting_picks entry — Strength Performance style dots alone do not '
  38:         + 'grant it.',
  39:     },
  40:     filter: { source: 'Stronger Than You', 'predicate.name': 'Stronger Than You' },
  41:   },
  42: ];
  43: 
  44: // ── Main ─────────────────────────────────────────────────────────────────────
  45: 
  46: async function run() {
  47:   await import('dotenv/config');
  48:   const { MongoClient } = await import('mongodb');
  49: 
  50:   const DRY_RUN = !process.argv.includes('--apply');
  51:   const MONGODB_URI = process.env.MONGODB_URI;
  52:   const DB_NAME = process.env.MONGODB_DB || 'tm_game';
  53: 
  54:   if (!MONGODB_URI) {
  55:     console.error('MONGODB_URI not set — ensure server/.env is present.');
  56:     process.exit(1);
  57:   }
  58: 
  59:   const strip = (uri) => uri.replace(/[&?]ssl=[^&]*/g, '');
  60:   const client = new MongoClient(strip(MONGODB_URI), { serverSelectionTimeoutMS: 5000, tls: true });
  61:   await client.connect();
  62:   const db = client.db(DB_NAME);
  63:   const now = new Date().toISOString();
  64: 
  65:   console.log(`[seed-rules-bonus-successes] ${DRY_RUN ? 'DRY RUN' : 'APPLY'} → ${DB_NAME}`);
  66: 
  67:   for (const { doc, filter } of BONUS_SUCCESS_DOCS) {
  68:     const existing = await db.collection('rule_bonus_success').findOne(filter);
  69:     console.log(`  [rule_bonus_success] ${existing ? 'EXISTS (upsert will refresh)' : 'INSERT'} — ${doc.source}`);
  70:     console.log(`    doc:   `, JSON.stringify({ ...doc, created_at: now, updated_at: now }));
  71: 
  72:     if (!DRY_RUN) {
  73:       await db.collection('rule_bonus_success').replaceOne(
  74:         filter,
  75:         { ...doc, created_at: existing?.created_at || now, updated_at: now },
  76:         { upsert: true },
  77:       );
  78:       console.log(`    → written`);
  79:     }
  80:   }
  81: 
  82:   console.log(`\n[seed-rules-bonus-successes] ${DRY_RUN ? 'Dry run complete — pass --apply to write.' : 'Done.'}`);
  83:   await client.close();
  84: }
  85: 
  86: // Only connect when invoked directly. Importing this module (tests read
  87: // BONUS_SUCCESS_DOCS as the single source of truth for the seed) must never
  88: // open a Mongo connection or load dotenv over the test harness's env.
  89: const _invokedDirectly = process.argv[1]
  90:   && import.meta.url === pathToFileURL(process.argv[1]).href;
  91: 
  92: if (_invokedDirectly) {
  93:   run().catch(err => {
  94:     console.error('[seed-rules-bonus-successes] Error:', err.message);
  95:     process.exit(1);
  96:   });
  97: }

