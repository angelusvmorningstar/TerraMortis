 724: // ── WEAPON REFERENCE PANEL (EQ-3) ──
 725: 
 726: const COMBAT_SKILLS = ['Weaponry', 'Brawl', 'Firearms', 'Archery'];
 727: 
 728: export function updWeaponRef() {
 729:   const panel = document.getElementById('weapon-ref');
 730:   if (!panel) return;
 731: 
 732:   // Capture live selection before rebuilding innerHTML
 733:   const liveSel = document.getElementById('weapon-sel');
 734:   if (liveSel && liveSel.value) state.activeWeaponId = liveSel.value;
 735:   else if (liveSel && !liveSel.value) state.activeWeaponId = null;
 736: 
 737:   const pi = state.POOL_INFO;
 738:   if (!pi || !pi.skill || !COMBAT_SKILLS.includes(pi.skill) || !state.rollChar) {
 739:     panel.style.display = 'none';
 740:     return;
 741:   }
 742:   const weapons = (state.rollChar.equipment || []).filter(item => {
 743:     // #752: 'active' is the strongest in-use state — include it in weapon-ref
 744:     // eligibility (matches the chip predicate above).
 745:     const entry = getCatalogueEntry(item.catalogue_id);
 746:     // EQC-1 (#1152): 'weapon' bucket merged into 'combat_gear'; weapon-shaped
 747:     // is identified via the shared isCombatGearWeaponShaped predicate (review
 748:     // patch: a single-field check missed legacy weapons whose weapon_type was
 749:     // null but damage_mod/damage_type were populated).
 750:     // EQC-2 (#1153): state check consolidated onto isEquipmentOnMe.
 751:     return entry && entry.bucket === 'combat_gear' && isCombatGearWeaponShaped(entry) &&
 752:            isEquipmentOnMe(item);
 753:   });
 754:   if (!weapons.length) {
 755:     panel.style.display = 'none';
 756:     return;
 757:   }
 758: 
 759:   panel.style.display = '';
 760:   const prevId = state.activeWeaponId;
 761: 
 762:   const optionsHtml = weapons.map(item => {
 763:     const e = getCatalogueEntry(item.catalogue_id);
 764:     const sel = prevId === e.id ? ' selected' : '';
 765:     return `<option value="${e.id}"${sel}>${e.name}</option>`;
 766:   }).join('');
 767: 
 768:   let statsHtml = '';
 769:   if (prevId) {
 770:     const e = getCatalogueEntry(prevId);
 771:     if (e) {
 772:       const DMGTYPE = { lethal: 'Lethal', bashing: 'Bashing', aggravated: 'Aggravated' };
 773:       const WPNTYPE = { melee: 'Melee', ranged: 'Ranged', thrown: 'Thrown' };
 774:       const mod = e.damage_mod > 0 ? '+' + e.damage_mod : String(e.damage_mod);
 775:       statsHtml = `<div class="trait-qual">`
 776:                + `${mod} · ${DMGTYPE[e.damage_type] || e.damage_type} · ${WPNTYPE[e.weapon_type] || e.weapon_type}`
 777:                + `</div>`;
 778:     }
 779:   }
 780: 
 781:   panel.innerHTML = `<div class="slabel">Weapon</div>`
 782:     + `<select id="weapon-sel" class="resist-sel" onchange="updWeaponRef()">`
 783:     + `<option value="">-- select --</option>${optionsHtml}</select>${statsHtml}`;
 784: }
