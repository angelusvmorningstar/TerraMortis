 605: // ── SPECIALTY TOGGLE ──
 606: //
 607: // Click handler for the specialty badges under the effective-pool line.
 608: // Toggling a badge on adds its dice bonus to MOD; toggling off subtracts
 609: // the same amount. The per-spec bonus is stored in state.specBonuses so
 610: // we can reverse the exact amount even if the displayed bonus would be
 611: // different at toggle-off time (e.g. character data changed mid-roll).
 612: 
 613: export function togSpec(badge) {
 614:   if (!badge) return;
 615:   const name = badge.dataset.spec;
 616:   const bonus = parseInt(badge.dataset.bonus, 10) || 0;
 617:   if (!name || !bonus) return;
 618:   const existing = state.specBonuses[name];
 619:   if (existing !== undefined) {
 620:     state.MOD = state.MOD - existing;
 621:     delete state.specBonuses[name];
 622:   } else {
 623:     state.MOD = state.MOD + bonus;
 624:     state.specBonuses[name] = bonus;
 625:   }
 626:   updPool();
 627: }
 628: 
 629: // ── EQUIPMENT CHIP TOGGLE (EQ-3) ──
 630: 
 631: export function togEquipChip(badge) {
 632:   if (!badge) return;
 633:   const id = badge.dataset.equip;
 634:   const bonus = parseInt(badge.dataset.bonus, 10) || 0;
 635:   if (!id || !bonus) return;
 636: 
 637:   if (state.activeEquipBonus && state.activeEquipBonus.catalogueId === id) {
 638:     state.MOD -= state.activeEquipBonus.bonus;
 639:     state.activeEquipBonus = null;
 640:   } else {
 641:     if (state.activeEquipBonus) {
 642:       state.MOD -= state.activeEquipBonus.bonus;
 643:     }
 644:     state.MOD += bonus;
 645:     state.activeEquipBonus = { catalogueId: id, bonus };
 646:   }
 647:   updPool();
 648: }
 649: 
 650: // ── PERSISTENT PER-POWER MOD CHIPS (rlv.7, #1039 item 2) ──
 651: 
 652: /** Add a new chip to the currently-loaded pool, on by default (AC2). Value
 653:  *  is clamped to power-mod-chips.js's own -10..+10 cap (AC9) before it's
 654:  *  applied — a clamped-to-0 or empty-label submission silently no-ops,
 655:  *  matching togSpec's own silent-guard style above. Clears the add-mod
 656:  *  row's own inputs on success, matching this file's existing direct-DOM
 657:  *  style (e.g. togMod's rote-c/wp-c classList writes). */
 658: export function addPowerChip(label, value) {
 659:   if (!state.rollChar || !state.POOL_NAME) return;
 660:   const v = clampChipValue(value);
 661:   if (!v) return;
 662:   const before = state.powerChips.length;
 663:   const updated = addChip(String(state.rollChar._id), state.POOL_NAME, label, v);
 664:   // addChip() has its own, independent empty/whitespace-label rejection —
 665:   // if it silently no-opped (list unchanged), MOD must not be touched
 666:   // either, or a rejected chip would still inflate the pool with no
 667:   // visible chip and nothing persisted to explain it on reload.
 668:   if (updated.length === before) return;
 669:   state.powerChips = updated;
 670:   state.MOD += v;
 671:   const labelEl = document.getElementById('pmc-label');
 672:   const valueEl = document.getElementById('pmc-value');
 673:   if (labelEl) labelEl.value = '';
 674:   if (valueEl) valueEl.value = '';
 675:   updPool();
 676: }
 677: 
 678: /** Sum of the on-chips' values in a chip list — shared by togPowerChip/
 679:  *  removePowerChip so both recompute the SAME way. */
 680: function _onSum(chips) {
 681:   return chips.filter(c => c.on).reduce((sum, c) => sum + c.value, 0);
 682: }
 683: 
 684: /** Toggle a chip on/off.
 685:  *
 686:  *  Review fix (Pass 1/2, Medium): the original version read `chip.on`
 687:  *  from the LOCAL `state.powerChips` copy to decide the MOD sign, then
 688:  *  separately called `toggleChip()`, which independently re-reads from
 689:  *  `localStorage` and mutates based on THAT fresh read. If the two ever
 690:  *  disagreed (e.g. another same-origin tab changed this same character's
 691:  *  chips in between), the local-read sign and the storage-write outcome
 692:  *  could point opposite ways, leaving `state.MOD` wrong. Recomputing the
 693:  *  MOD delta as (fresh on-sum) minus (local on-sum) is correct regardless
 694:  *  of whether local and storage agree — it reflects the NET change
 695:  *  `state.powerChips` is about to undergo, not an assumption about which
 696:  *  single chip caused it. */
 697: export function togPowerChip(badge) {
 698:   if (!badge) return;
 699:   const id = badge.dataset.chip;
 700:   if (!id || !state.rollChar || !state.POOL_NAME) return;
 701:   if (!state.powerChips.some(c => c.id === id)) return;
 702:   const before = _onSum(state.powerChips);
 703:   const updated = toggleChip(String(state.rollChar._id), state.POOL_NAME, id);
 704:   state.MOD += _onSum(updated) - before;
 705:   state.powerChips = updated;
 706:   updPool();
 707: }
 708: 
 709: /** Permanently remove a chip (curation, distinct from toggling off).
 710:  *  Same before/after-sum recomputation as togPowerChip, for the same
 711:  *  reason (review fix, Pass 1/2, Medium). */
 712: export function removePowerChip(badge) {
 713:   if (!badge) return;
 714:   const id = badge.dataset.chip;
 715:   if (!id || !state.rollChar || !state.POOL_NAME) return;
 716:   if (!state.powerChips.some(c => c.id === id)) return;
 717:   const before = _onSum(state.powerChips);
 718:   const updated = removeChip(String(state.rollChar._id), state.POOL_NAME, id);
 719:   state.MOD += _onSum(updated) - before;
 720:   state.powerChips = updated;
 721:   updPool();
 722: }
