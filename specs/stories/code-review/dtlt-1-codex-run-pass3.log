 523:         const entry = getCatalogueEntry(item.catalogue_id);
 524:         // #752: 'active' is the strongest in-use state — treat it identically
 525:         // to carried/worn for chip eligibility (Khepri's option (a) — preserves
 526:         // 'active' as a semantically-stronger marker an ST may have already used).
 527:         // EQC-1 (#1152): old 'equipment' bucket -> 'skill_gear', unchanged meaning.
 528:         // EQC-2 (#1153): state check consolidated onto isEquipmentOnMe.
 529:         return entry && entry.bucket === 'skill_gear' &&
 530:                entry.bonus_dice > 0 &&
 531:                entry.skill_domain === pi.skill &&
 532:                isEquipmentOnMe(item);
 533:       });
