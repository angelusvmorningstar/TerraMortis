 479: function bestTraitsFor(c, method) {
 480:   const out = { attr: '', attrV: 0, skill: '', skillV: 0, specs: [] };
 481:   if (!c || !method) return out;
 482:   for (const a of method.attrs || []) {
 483:     const v = getAttrVal(c, a);
 484:     if (v > out.attrV) { out.attrV = v; out.attr = a; }
 485:   }
 486:   for (const s of method.skills || []) {
 487:     const v = skTotal(c, s);
 488:     if (v > out.skillV) { out.skillV = v; out.skill = s; out.specs = c.skills?.[s]?.specs || []; }
 489:   }
 490:   return out;
 491: }
 492: 
 493: function buildPool(method, discName, specName) {
 494:   const c = currentChar;
 495:   if (!c || !method) { poolTotal = 0; poolBreakdown = ''; return; }
 496: 
 497:   const best = bestTraitsFor(c, method);
 498:   const bestA = best.attr, bestAV = best.attrV;
 499:   const bestS = best.skill, bestSV = best.skillV, bestSpecs = best.specs;
 500: 
 501:   const specBonus = specName && bestSpecs.includes(specName) ? (hasAoE(c, specName) ? 2 : 1) : 0;
 502:   const discVal = (discName && c.disciplines?.[discName]?.dots) || 0;
 503:   const unskilled = bestSV === 0
 504:     ? (method.skills.some(s => !SKILLS_MENTAL.includes(s)) ? -1 : -3)
 505:     : 0;
 506:   const fgVal = domMeritContrib(c, 'Feeding Grounds');
 507: 
 508:   poolTotal = Math.max(0, bestAV + bestSV + discVal + specBonus + unskilled + fgVal);
 509: 
 510:   const parts = [`${bestAV} ${bestA}`, `${bestSV} ${bestS}`];
 511:   if (discVal) parts.push(`${discVal} ${discName}`);
 512:   if (specBonus) parts.push(`${specBonus} ${specName}`);
 513:   if (unskilled) parts.push(`\u2212${Math.abs(unskilled)} (unskilled)`);
 514:   if (fgVal) parts.push(`${fgVal} Feeding Grounds`);
 515:   poolBreakdown = parts.join(' + ') + ` = ${poolTotal}`;
 516: }
 517: 
 518: // ── Compute vitae tally from character + submission data ──────────────────────
 519: // Used when feeding_vitae_tally hasn't been saved by the ST yet (ready state).
 520: // Returns the same shape as feeding_vitae_tally.
 521: // liveTerrDocs: array from /api/territories — overrides hardcoded TERRITORY_DATA ambienceMod
 522: function computeVitateTally(char, sub, liveTerrDocs = []) {
 523:   if (!char) return null;
 524: 
 525:   // Herd: effective dots (cp + free + free_mci + xp + SSJ/Flock bonuses)
 526:   const herd = domMeritContrib(char, 'Herd');
 527: 
 528:   // Oath of Fealty: covenant status dots (only if character has the pact)
 529:   const hasOoF = (char.powers || []).some(p => p.category === 'pact' && p.name === 'Oath of Fealty');
 530:   const oath_of_fealty = hasOoF ? effectiveInvictusStatus(char) : 0;
 531: 
 532:   // Ghoul retainers: count Retainer merits with 'ghoul' qualifier
 533:   const ghouls = (char.merits || []).filter(m =>
 534:     m.name === 'Retainer' && (m.area || m.qualifier || '').toLowerCase().includes('ghoul')
 535:   ).length;
 536: 
 537:   // Merge live territory docs over hardcoded defaults — live values take precedence.
 538:   // Carry _id forward from liveTerrDocs so the grid-key lookup below can match
 539:   // by ObjectId (post-migration shape) as well as slug (pre-migration fallback).
 540:   const effectiveTerrs = TERRITORY_DATA.map(t => {
 541:     const live = liveTerrDocs.find(d => d.slug === t.slug);
 542:     return live
 543:       ? { ...t, _id: String(live._id), ambience: live.ambience ?? t.ambience, ambienceMod: live.ambienceMod ?? t.ambienceMod }
 544:       : t;
 545:   });
 546: 
 547:   // Ambience: best territory among player-declared feeding territories.
 548:   // 2026-06-20 hotfix: grid keys are ObjectId strings post-territory-FK migration
 549:   // (server/scripts/archive/migrate-territory-fk.js). Match against effectiveTerrs._id
 550:   // first, fall back to slug for any pre-migration or sentinel keys.
 551:   let ambience = -4; // Barrens default
 552:   let ambience_territory = 'Barrens';
 553:   if (sub?.responses?.feeding_territories) {
 554:     try {
 555:       const grid = JSON.parse(sub.responses.feeding_territories);
 556:       const ACTIVE_FEED_STATUSES = new Set(['feeding_rights', 'poaching', 'resident', 'poacher', 'poach']);
 557:       for (const [tid, status] of Object.entries(grid)) {
 558:         if (!ACTIVE_FEED_STATUSES.has(status)) continue;
 559:         const td = effectiveTerrs.find(t =>
 560:           (t._id && t._id === tid) || String(t.slug) === tid
 561:         );
 562:         if (td?.ambienceMod != null && td.ambienceMod > ambience) {
 563:           ambience = td.ambienceMod;
 564:           ambience_territory = td.name;
 565:         }
 566:       }
 567:     } catch { /* ignore */ }
 568:   }
 569: 
 570:   // Rite cost and manual adjustment from ST-saved feeding_review
 571:   const rev = sub?.feeding_review || {};
 572:   const rite_cost = rev.vitae_rite_cost  ?? 0;
 573:   const manual    = rev.vitae_mod_manual ?? 0;
 574: 
 575:   const autoSum   = herd + oath_of_fealty + ambience - ghouls;
 576:   const total_bonus = Math.max(0, autoSum + manual - rite_cost);
 577: 
 578:   return { herd, ambience, ambience_territory, oath_of_fealty, ghouls, rite_cost, manual, total_bonus };
 579: }
 580: 
 581: // ── Render vitae breakdown card ───────────────────────────────────────────────
 582: function renderVitaeTallyCard(tally, vessels = null) {
 583:   if (!tally) return '';
 584:   let h = '<div class="fvt-card">';
 585:   h += '<div class="fvt-title">Vitae Sources</div>';
 586:   if (vessels !== null) h += `<div class="fvt-row"><span class="fvt-label">Vessels (from roll)</span><span class="fvt-val">${vessels}</span></div>`;
 587:   if (tally.herd)         h += `<div class="fvt-row fvt-pos"><span class="fvt-label">Herd</span><span class="fvt-val">+${tally.herd}</span></div>`;
 588:   if (tally.oath_of_fealty) h += `<div class="fvt-row fvt-pos"><span class="fvt-label">Oath of Fealty</span><span class="fvt-val">+${tally.oath_of_fealty}</span></div>`;
 589:   if (tally.ambience != null && tally.ambience !== 0) {
 590:     const lbl = tally.ambience_territory ? `Ambience (${tally.ambience_territory})` : 'Ambience';
 591:     const cls = tally.ambience > 0 ? ' fvt-pos' : ' fvt-neg';
 592:     const sign = tally.ambience > 0 ? '+' : '';
 593:     h += `<div class="fvt-row${cls}"><span class="fvt-label">${esc(lbl)}</span><span class="fvt-val">${sign}${tally.ambience}</span></div>`;
 594:   }
 595:   if (tally.ghouls)    h += `<div class="fvt-row fvt-neg"><span class="fvt-label">Ghoul retainers</span><span class="fvt-val">\u2212${tally.ghouls}</span></div>`;
 596:   if (tally.rite_cost) h += `<div class="fvt-row fvt-neg"><span class="fvt-label">Rite costs</span><span class="fvt-val">\u2212${tally.rite_cost}</span></div>`;
 597:   if (tally.manual)    h += `<div class="fvt-row${tally.manual > 0 ? ' fvt-pos' : ' fvt-neg'}"><span class="fvt-label">Adjustment</span><span class="fvt-val">${tally.manual > 0 ? '+' : ''}${tally.manual}</span></div>`;
 598:   h += '<div class="fvt-divider"></div>';
 599:   h += `<div class="fvt-row fvt-total"><span class="fvt-label">Bonus vitae</span><span class="fvt-val">+${tally.total_bonus}</span></div>`;
 600:   h += '</div>';
 601:   return h;
 602: }
 603: 
 604: function fvcConseqText(v) {
 605:   if (v <= 2) return 'Safe';
 606:   if (v === 3) return 'Drained';
 607:   if (v <= 5) return 'Serious injury';
 608:   if (v === 6) return 'Critical';
 609:   return 'Fatal';
 610: }
 611: 
 612: function fvcConseqClass(v) {
 613:   if (v <= 2) return 'fvc-safe';
 614:   if (v === 3) return 'fvc-drained';
 615:   if (v <= 5) return 'fvc-serious';
 616:   return 'fvc-critical';
 617: }
 618: 
 619: function render() {
 620:   if (!container) return;
 621:   const isST = isSTRole();
 622:   let h = '<div class="feeding-wrap">';
 623:   h += '<h3 class="feeding-title">Feeding: The Hunt</h3>';
 624: 
 625:   // ── LOADING ──
 626:   if (feedingState === 'loading') {
 627:     h += '<p class="placeholder-msg">Loading feeding data...</p>';
 628:   }
 629: 
 630:   // ── READY (from downtime declaration) ──
 631:   if (feedingState === 'ready' && declaredMethod) {
 632:     h += '<div class="feeding-ready">';
 633:     h += `<p class="feeding-method-label">Method: <strong>${esc(declaredMethod.name)}</strong>`;
 634:     if (stRote)    h += ' <span class="feeding-rote-badge">Rote</span>';
 635:     if (stAgain === 9) h += ' <span class="feeding-again-badge">9-Again</span>';
 636:     if (stAgain === 8) h += ' <span class="feeding-again-badge">8-Again</span>';
 637:     h += '</p>';
 638:     h += `<p class="feeding-method-desc">${esc(declaredMethod.desc)}</p>`;
 639:     h += `<div class="feeding-pool-display">`;
 640:     h += `<span class="feeding-pool-breakdown">${esc(poolBreakdown)}</span>`;
 641:     h += `<span class="feeding-pool-total">${poolTotal} dice</span>`;
 642:     h += '</div>';
 643:     h += renderFeedingSummary();
 644:     h += renderVitaeTallyCard(vitateTally);
 645:     h += renderStRollResult();
 646:     if (!stRollResult) {
 647:       h += '<p class="feeding-warning">You only get one roll. Once you roll, you are committed to the result.</p>';
 648:       h += `<button id="feeding-roll-btn" class="feeding-roll-btn">Roll Feeding (${poolTotal} dice)</button>`;
 649:     }
 650:     h += '</div>';
 651:   }
 652: 
 653:   // ── NO SUBMISSION (generic picker) ──
 654:   if (feedingState === 'no_submission') {
 655:     h += '<div class="feeding-no-sub">';
 656:     h += '<p class="feeding-state-detail">No downtime feeding declaration found. Select a generic method below.</p>';
 657:     h += '<div class="dt-feed-methods">';
 658:     for (const m of FEED_METHODS) {
 659:       if (m.id === 'other') continue; // no custom without downtime
 660:       const sel = selectedMethodId === m.id ? ' dt-feed-sel' : '';
 661:       h += `<button type="button" class="dt-feed-card${sel}" data-feed-method="${m.id}">`;
 662:       h += `<div class="dt-feed-card-name">${esc(m.name)}</div>`;
 663:       h += `<div class="dt-feed-card-desc">${esc(m.desc)}</div>`;
 664:       h += '</button>';
 665:     }
 666:     h += '</div>';
 667: 
 668:     if (selectedMethodId) {
 669:       const m = FEED_METHODS.find(fm => fm.id === selectedMethodId);
 670:       if (m) {
 671:         buildPool(m, selectedDisc, selectedSpec);
 672: 
 673:         // Discipline selector — show all template disciplines; template is a preset, not a gate
 674:         if (m.discs.length) {
 675:           h += '<div class="feeding-disc-row">';
 676:           h += '<label>Discipline:</label>';
 677:           h += '<select class="qf-select" id="feed-gen-disc">';
 678:           h += '<option value="">None</option>';
 679:           for (const d of m.discs) {
 680:             const dv = currentChar.disciplines?.[d]?.dots ?? 0;
 681:             const sel = selectedDisc === d ? ' selected' : '';
 682:             h += `<option value="${esc(d)}"${sel}>${esc(d)} (${dv})</option>`;
 683:           }
 684:           h += '</select></div>';
 685:         }
 686: 
 687:         h += `<div class="feeding-pool-display">`;
 688:         h += `<span class="feeding-pool-breakdown">${esc(poolBreakdown)}</span>`;
 689:         h += `<span class="feeding-pool-total">${poolTotal} dice</span>`;
 690:         h += '</div>';
 691:         h += '<p class="feeding-warning">You only get one roll. Once you roll, you are committed to the result.</p>';
 692:         h += `<button id="feeding-roll-btn" class="feeding-roll-btn">Roll Feeding (${poolTotal} dice)</button>`;
 693:       }
 694:     }
 695: 
 696:     // "See Storytellers" defer path — always available until roll or defer chosen
 697:     h += '<div class="feeding-defer-row">';
 698:     h += '<span class="feeding-defer-or">or</span>';
 699:     h += '<button id="feeding-defer-btn" class="feeding-defer-btn">See Storytellers at Start of Game</button>';
 700:     h += '</div>';
 701: 
 702:     h += '</div>';
 703:   }
 704: 
 705:   // ── DEFERRED ──
 706:   if (feedingState === 'deferred') {
 707:     h += '<div class="feeding-deferred-msg">See your Storytellers at the start of game.</div>';
 708:   }
 709: 
 710:   // ── ROLLED ──
 711:   if (feedingState === 'rolled' && rollResult) {
 712:     const { cols, successes, vessels, safeVitae, methodName, dramaticFailure, successBreakdown } = rollResult;
 713: 
 714:     // Show ST-confirmed result if published
 715:     if (publishedFeedingText) {
 716:       h += `<div class="feeding-confirmed">`;
 717:       h += `<div class="feeding-confirmed-head">&#x2713; Confirmed Result</div>`;
 718:       h += `<p class="feeding-confirmed-body">${esc(publishedFeedingText)}</p>`;
 719:       h += `</div>`;
 720:     }
 721: 
 722:     // Player Feedback (player_facing_note from feeding_review — read directly,
 723:     // as it is not embedded in the ## Feeding section of published_outcome)
 724:     const feedingNote = currentSub?.feeding_review?.player_facing_note?.trim();
 725:     if (feedingNote) {
 726:       h += `<div class="proj-card-feedback"><span class="proj-card-feedback-label">ST Note</span>${esc(feedingNote)}</div>`;
 727:     }
 728: 
 729:     h += '<div class="feeding-result">';
 730:     if (methodName) h += `<p class="feeding-method-label">Method: <strong>${esc(methodName)}</strong></p>`;
 731:     h += renderFeedingSummary();
 732:     h += `<div class="feeding-suc">${successes}</div>`;
 733:     h += `<div class="feeding-suc-label">success${successes !== 1 ? 'es' : ''}</div>`;
 734:     // dtlt.1: only rendered when a bonus-success rule actually fired. Rolls
 735:     // persisted before this story have no successBreakdown and are unchanged.
 736:     if (successBreakdown) {
 737:       h += `<span class="feeding-pool-breakdown">${esc(successBreakdown)}</span>`;
 738:     }
 739: 
 740:     h += '<div class="feeding-dice-row">';
 741:     for (const col of cols) {
 742:       for (const d of [col.r, ...col.ch]) {
 743:         let cls = 'feed-die';
 744:         if (d.s) cls += ' fd-s';
 745:         if (d.v === 1) cls += ' fd-1';
 746:         h += `<span class="${cls}">${d.v}</span>`;
 747:       }
 748:     }
 749:     h += '</div>';
 750: 
 751:     // ── Vitae breakdown card ──
 752:     h += renderVitaeTallyCard(vitateTally, vessels);
 753: 
 754:     if (dramaticFailure) {
 755:       h += '<div class="feeding-dramatic">Dramatic failure \u2014 see your Storyteller at game before feeding.</div>';
 756:     } else if (vessels === 0) {
 757:       h += '<p class="feeding-no-vessels">No vessels secured this hunt.</p>';
 758:     } else {
 759:       const bonusVitae = vitateTally?.total_bonus ?? 0;
 760:       const allocated = vitaeAllocation && vitaeAllocation.length === vessels;
 761:       h += `<div class="feeding-vessels-grid" id="feeding-vessels-grid">`;
 762:       for (let i = 0; i < vessels; i++) {
 763:         h += `<div class="feeding-vessel-card" data-vessel-idx="${i}">`;
 764:         h += `<span class="fvc-label">Vessel ${i + 1}</span>`;
 765:         if (allocated) {
 766:           const sv = vitaeAllocation[i];
 767:           h += `<span class="fvc-val">${sv} vitae</span>`;
 768:           h += `<span class="fvc-consequence ${fvcConseqClass(sv)}">${fvcConseqText(sv)}</span>`;
 769:         } else {
 770:           h += `<select class="fvc-select" id="fvc-sel-${i}" data-vessel-idx="${i}">`;
 771:           h += '<option value="">\u2014</option>';
 772:           h += '<option value="1">1 vitae \u2014 Safe</option>';
 773:           h += '<option value="2">2 vitae \u2014 Safe</option>';
 774:           h += '<option value="3">3 vitae \u2014 Drained (medical care needed)</option>';
 775:           h += '<option value="4">4 vitae \u2014 Serious injury</option>';
 776:           h += '<option value="5">5 vitae \u2014 Serious injury</option>';
 777:           h += '<option value="6">6 vitae \u2014 Critical (near death)</option>';
 778:           h += '<option value="7">7 vitae \u2014 Fatal</option>';
 779:           h += '</select>';
 780:           h += `<span class="fvc-consequence" id="fvc-con-${i}"></span>`;
 781:         }
 782:         h += '</div>';
 783:       }
 784:       h += '</div>';
 785:       if (allocated) {
 786:         const vesselTotal = vitaeAllocation.reduce((a, b) => a + b, 0);
 787:         const grandTotal  = vesselTotal + (vitateTally?.total_bonus ?? 0);
 788:         if (vitateTally?.total_bonus) {
 789:           h += `<div class="fvc-total">Vessel vitae: <strong>${vesselTotal}</strong> + Bonus: <strong>+${vitateTally.total_bonus}</strong> = <strong>${grandTotal}</strong> total</div>`;
 790:         } else {
 791:           h += `<div class="fvc-total">Total Vitae: <strong>${vesselTotal}</strong></div>`;
 792:         }
 793:         h += '<div class="fvc-alloc-badge">\u2713 Allocation recorded</div>';
 794:       } else {
 795:         if (bonusVitae) {
 796:           h += `<div class="fvc-total">Vessel vitae: <span id="fvc-total-val">0</span> + Bonus: <strong>+${bonusVitae}</strong> = <span id="fvc-grand-val">${bonusVitae}</span> total</div>`;
 797:         } else {
 798:           h += `<div class="fvc-total">Total Vitae: <span id="fvc-total-val">0</span></div>`;
 799:         }
 800:         h += `<p class="feeding-overfeed-warn">Draining beyond safe vitae (${safeVitae}) risks a Humanity check.</p>`;
 801:         h += '<button id="fvc-confirm" class="qf-btn qf-btn-submit" disabled>Confirm Allocation</button>';
 802:       }
 803:     }
 804: 
 805:     h += '</div>';
 806: 
 807:     // ── ST CONFIRM PANEL ──
 808:     if (isST) {
 809:       const stVesselTotal = vitaeAllocation
 810:         ? vitaeAllocation.reduce((a, b) => a + b, 0)
 811:         : safeVitae;
 812:       const stBonus = vitateTally?.total_bonus ?? 0;
 813:       const stDefault = stVesselTotal + stBonus;
 814:       const charId = String(currentChar._id);
 815:       const confirmed = _stConfirmed[charId];
 816:       const vitaeMax = calcVitaeMax(currentChar);
 817:       const infMax   = calcTotalInfluence(currentChar);
 818:       h += `<div class="feed-st-confirm">`;
 819:       if (confirmed) {
 820:         const vitaeStr = confirmed.vitaeMax != null
 821:           ? `Vitae ${confirmed.vitae}/${confirmed.vitaeMax}`
 822:           : `Vitae \u2192 ${confirmed.vitae}`;
 823:         const infStr = confirmed.infAfter != null && confirmed.infMax != null
 824:           ? `Inf ${confirmed.infAfter}/${confirmed.infMax}`
 825:           : confirmed.infSpent > 0 ? `Inf \u2212${confirmed.infSpent}` : null;
 826:         let rec = vitaeStr;
 827:         if (infStr) rec += ` \u2002|\u2002 ${infStr}`;
 828:         h += `<div class="feed-confirmed-record">\u2713 Feed confirmed \u2014 ${rec}</div>`;
 829:         h += `<button class="feed-reconfirm-btn" id="feed-reconfirm-btn">Edit</button>`;
 830:       } else {
 831:         // Vitae row
 832:         h += `<div class="feed-st-row">`;
 833:         h += `<div class="feed-st-row-lbl">Vitae Gained</div>`;
 834:         h += `<div class="feed-st-row-ctrl">`;
 835:         h += `<button class="feed-adj" id="feed-confirm-adj-down">\u2212</button>`;
 836:         h += `<span class="feed-confirm-val" id="feed-confirm-n" data-vit-max="${vitaeMax}">${stDefault}</span>`;
 837:         h += `<button class="feed-adj" id="feed-confirm-adj-up">+</button>`;
 838:         h += `</div>`;
 839:         h += `<div class="feed-st-row-max">/ ${vitaeMax}</div>`;
 840:         h += `</div>`;
 841:         // Influence row
 842:         h += `<div class="feed-st-row">`;
 843:         h += `<div class="feed-st-row-lbl">Influence Remaining</div>`;
 844:         h += `<div class="feed-st-row-ctrl">`;
 845:         h += `<button class="feed-adj" id="feed-inf-adj-down">\u2212</button>`;
 846:         const _curInf = trackerRead(String(currentChar._id))?.inf ?? infMax;
 847:         h += `<span class="feed-inf-val" id="feed-inf-spent" data-inf-max="${infMax}">${_curInf}</span>`;
 848:         h += `<button class="feed-adj" id="feed-inf-adj-up">+</button>`;
 849:         h += `</div>`;
 850:         h += `<div class="feed-st-row-max">/ ${infMax}</div>`;
 851:         h += `</div>`;
 852:         h += `<button class="feed-confirm-btn" id="feed-confirm-btn">Confirm Feed</button>`;
 853:       }
 854:       h += `</div>`;
 855:     }
 856:   }
 857: 
 858:   // ── ST OVERRIDE PANEL ──
 859:   if (isST && feedingState !== 'loading') {
 860:     if (feedingState === 'deferred') {
 861:       h += '<div class="feeding-st-override">';
 862:       h += '<span class="feeding-st-label">ST Override</span>';
 863:       h += '<button id="feeding-release-btn" class="feeding-roll-btn">Release Roll (ST)</button>';
 864:       h += '</div>';
 865:     } else if (feedingState === 'rolled') {
 866:       h += '<div class="feeding-st-override">';
 867:       h += '<span class="feeding-st-label">ST Override</span>';
 868:       h += '<button id="feeding-reroll-btn" class="feeding-roll-btn">Reset Roll (ST)</button>';
 869:       h += '</div>';
 870:     }
 871:   }
 872: 
 873:   h += '</div>';
 874:   container.innerHTML = h;
 875:   wireEvents();
 876: }
 877: 
 878: function wireEvents() {
 879:   if (!container) return;
 880: 
 881:   // Generic method selection
 882:   container.querySelectorAll('[data-feed-method]').forEach(btn => {
 883:     btn.addEventListener('click', () => {
 884:       selectedMethodId = btn.dataset.feedMethod;
 885:       selectedDisc = '';
 886:       selectedSpec = '';
 887:       render();
 888:     });
 889:   });
 890: 
 891:   // Generic disc selector
 892:   container.querySelector('#feed-gen-disc')?.addEventListener('change', e => {
 893:     selectedDisc = e.target.value;
 894:     render();
 895:   });
 896: 
 897:   // Vessel allocation selectors
 898:   container.querySelectorAll('.fvc-select').forEach(sel => {
 899:     sel.addEventListener('change', updateVesselUI);
 900:   });
 901: 
 902:   // Confirm allocation
