 549:   // Persistent per-power mod chips (rlv.7, #1039 item 2). Rendered
 550:   // unconditionally (not nested in the `pi.attr` branch above) — a chip's
 551:   // value is already folded into `state.MOD` by `loadPool()` regardless of
 552:   // whether this pool has an attr/skill breakdown (e.g. combat.js's
 553:   // quickRoll()), so it must stay visible/toggleable here too.
 554:   //
 555:   // Review fix (Pass 1, Medium): the id used to be interpolated directly
 556:   // into the onclick attribute's own single-quoted JS argument
 557:   // (`togPowerChip('${safeId}')`), escaped for `"` only — a chip id
 558:   // containing an apostrophe (a malformed/imported payload; `loadChips()`
 559:   // now also rejects those, see power-mod-chips.js) could break out of
 560:   // that string and inject arbitrary script. Switched to this file's own
 561:   // existing `togSpec(this)`/`togEquipChip(this)` pattern instead: the id
 562:   // is read via `.dataset.chip` from the clicked element, never embedded
 563:   // as executable JS text at all, so no escaping scheme can be bypassed.
 564:   //
 565:   // rcv.4: surfaced out of #effline's own collapsed-disclosure innerHTML into
 566:   // its own always-visible container - same template, same togPowerChip()/
 567:   // removePowerChip() wiring, only the write target changed.
 568:   const powerChipsEl = document.getElementById('rv2-power-chips');
 569:   if (powerChipsEl) {
 570:     powerChipsEl.innerHTML = (state.powerChips && state.powerChips.length)
 571:       ? '<div class="effpool-specs">' + state.powerChips.map(chip => {
 572:           const cls = 'effpool-spec' + (chip.on ? ' on' : '');
 573:           const safeId = String(chip.id).replace(/"/g, '&quot;');
 574:           const safeLabel = String(chip.label).replace(/</g, '&lt;').replace(/>/g, '&gt;');
 575:           const sign = chip.value > 0 ? '+' : '';
 576:           return `<span class="${cls}" data-chip="${safeId}" `
 577:                + `onclick="togPowerChip(this)" title="Click to toggle">`
 578:                + `${safeLabel} <span class="effpool-spec-bonus">${sign}${chip.value}</span>`
 579:                + `<span class="effpool-spec-del" onclick="event.stopPropagation();removePowerChip(this.closest('[data-chip]'))" title="Remove">×</span>`
 580:                + `</span>`;
 581:         }).join('') + '</div>'
 582:       : '';
 583:   }
