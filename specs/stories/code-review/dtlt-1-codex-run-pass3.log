 504:       if (specs.length) {
 505:         html += '<div class="effpool-specs">' + specs.map(s => {
 506:           const aoe = hasAoE(rc, s);
 507:           const bonusN = na || aoe ? 2 : 1;
 508:           const bonusLbl = na ? '2 (9-again)' : aoe ? '2 (AoE)' : '1';
 509:           const isOn = state.specBonuses[s] !== undefined;
 510:           const cls = 'effpool-spec' + (isOn ? ' on' : '');
 511:           const safe = String(s).replace(/"/g, '&quot;');
 512:           return `<span class="${cls}" data-spec="${safe}" data-bonus="${bonusN}" `
 513:                + `onclick="togSpec(this)" title="Click to add this specialty's bonus to your modifier">`
 514:                + `${s} <span class="effpool-spec-bonus">+${bonusLbl}</span></span>`;
