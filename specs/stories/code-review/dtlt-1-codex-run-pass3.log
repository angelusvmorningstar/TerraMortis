 830: // ── DIE DOM ELEMENTS ──
 831: 
 832: export function mkDieEl(d, delay, isX) {
 833:   const el = document.createElement('div');
 834:   // Exploding re-roll dice use the same success/fail colour as initial dice,
 835:   // plus an 'ed' marker class for the chain connector styling.
 836:   let cls = d.s ? 'die sd' : 'die fd';
 837:   if (isX) cls += ' ed';
 838:   if (d.x) cls += ' xd';
 839:   el.className = cls;
 840:   el.textContent = d.v;
 841:   el.style.animationDelay = (delay * 40) + 'ms';
 842:   return el;
 843: }
 844: 
 845: export function mkColsEl(cols, base) {
 846:   const w = document.createElement('div');
 847:   w.style.cssText = 'display:flex;flex-wrap:wrap;gap:5px;';
 848:   let delay = base;
 849:   cols.forEach(col => {
 850:     const ce = document.createElement('div');
 851:     ce.className = 'dcol';
 852:     ce.appendChild(mkDieEl(col.r, delay++, false));
 853:     col.ch.forEach(child => {
 854:       const conn = document.createElement('div');
 855:       conn.className = 'xconn';
 856:       ce.appendChild(conn);
 857:       ce.appendChild(mkDieEl(child, delay++, true));
 858:     });
 859:     w.appendChild(ce);
 860:   });
 861:   return w;
 862: }
