 368: // Paint the segmented Again pill so its `on` class tracks state.AGAIN + NA
 369: // (slice D). Safe to call when the container isn't in the DOM (v1 tab).
 370: function _paintAgainSeg() {
 371:   const seg = document.getElementById('rv2-again-seg');
 372:   if (!seg) return;
 373:   const buttons = seg.querySelectorAll('button[data-again]');
 374:   buttons.forEach(b => {
 375:     const val = b.dataset.again;
 376:     const on = val === 'none'
 377:       ? state.NA
 378:       : (!state.NA && String(state.AGAIN) === val);
 379:     b.classList.toggle('on', on);
 380:   });
 381: }
