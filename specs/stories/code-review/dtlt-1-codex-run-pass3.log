 338: export function effPool() {
 339:   // gdx-11 (#981, AC6): pi.noWP pools (Humanity Check's would-be sibling
 340:   // Blood Bond Resistance) cost 1 WP to ATTEMPT, per the rulebook — never a
 341:   // dice bonus. The WP(+3) chip must not add dice regardless of chip state.
 342:   const wpBonus = (state.WP && !state.POOL_INFO?.noWP) ? 3 : 0;
 343:   return state.RESIST_MODE === '-'
 344:     ? Math.max(0, state.PS + state.MOD + wpBonus - state.RESIST_VAL)
 345:     : state.PS + state.MOD + wpBonus;
 346: }
