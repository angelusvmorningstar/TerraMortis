 114: /**
 115:  * The `#roll-btn` label. Falls back to the plain dice-count label — not a
 116:  * separate "insufficient funds" message — whenever there is nothing to
 117:  * spend, the flag is off, or the balance can't cover the real cost in
 118:  * full: that plain label already IS "roll without spending" (AC5), the
 119:  * same button, same one tap, just no deduction attempted.
 120:  *
 121:  * Review fix (Acceptance Auditor, AC3/AC6): `wantsSpend` gates on the
 122:  * power's OWN cost (`cost.hasPowerCost`) only — the WP-chip alone must
 123:  * never flip a genuinely free power's button into spend-mode. The VITAE/WP
 124:  * bits shown name only the power's own amounts (`cost.powerWillpowerCost`,
 125:  * not the chip-inflated `cost.willpowerCost`) — the chip's own +1 WP stays
 126:  * disclosed separately in the sub-line (updPool()), so the two sources are
 127:  * never merged into one ambiguous figure.
 128:  */
 129: export function rollButtonLabel(eff, cost, gameInProgress, canAfford) {
 130:   const isChance = eff <= 0;
 131:   const diceLabel = isChance ? 'ROLL CHANCE DIE' : `ROLL ${eff} DICE`;
 132:   const wantsSpend = gameInProgress && cost.hasPowerCost;
 133:   if (!wantsSpend || !canAfford) return '✦ ' + diceLabel;
 134:   const bits = [];
 135:   if (cost.vitaeCost > 0) bits.push(cost.vitaeCost + ' VITAE');
 136:   if (cost.powerWillpowerCost > 0) bits.push(cost.powerWillpowerCost + ' WP');
 137:   return '✦ ROLL & SPEND ' + bits.join(', ');
 138: }
