 350: export function chgPool(d) {
 351:   state.PS = Math.max(-5, Math.min(40, state.PS + d));
 352:   updPool();
 353: }
 354: 
 355: export function chgMod(d) {
 356:   state.MOD = Math.max(-10, Math.min(10, state.MOD + d));
 357:   updPool();
 358: }
