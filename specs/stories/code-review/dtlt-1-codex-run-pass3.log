 383: export function updPool() {
 384:   const eff = effPool();
 385: 
 386:   // v2 stepper values (small).
 387:   const pv = document.getElementById('pval');
 388:   if (pv) {
 389:     pv.textContent = state.PS <= 0 ? 'Chance' : state.PS;
 390:     pv.className = 'rv2-stepper-val' + (state.PS <= 0 ? ' chance' : '');
 391:   }
 392:   const mv = document.getElementById('mval');
 393:   if (mv) {
 394:     const mod = state.MOD;
 395:     mv.textContent = mod === 0 ? '0' : mod > 0 ? '+' + mod : mod;
 396:     mv.className = 'rv2-stepper-val' + (mod > 0 ? ' pos' : mod < 0 ? ' neg' : '');
 397:   }
 398: 
 399:   // v2 anchor: huge effective count + sub-line (slice A).
 400:   const effEl = document.getElementById('rv2-eff');
 401:   const unitEl = document.getElementById('rv2-eff-unit');
 402:   const subEl = document.getElementById('rv2-sub');
 403:   const rollBtn = document.getElementById('roll-btn');
 404:   const isChance = eff <= 0;
 405:   if (effEl) {
 406:     effEl.textContent = isChance ? 'CHANCE' : String(eff);
 407:     effEl.classList.toggle('chance', isChance);
 408:   }
 409:   if (unitEl) {
 410:     unitEl.textContent = isChance ? 'die' : (eff === 1 ? 'die' : 'dice');
 411:   }
 412:   // gdx.7 (#988): computed once, used by both the sub-line's WP-chip
 413:   // wording and the roll button's own label below.
 414:   const spend = _currentSpendDecision();
 415:   if (subEl) {
 416:     const parts = [
 417:       'base ' + (state.PS <= 0 ? 'chance' : state.PS),
 418:     ];
 419:     if (state.MOD !== 0) parts.push((state.MOD > 0 ? '+' : '') + state.MOD + ' mod');
 420:     parts.push(_againPhrase());
 421:     // AC6: the chip's own +3 pool boost is a separate fact from whether it
 422:     // will ALSO really spend 1 Willpower this roll (game_in_progress) —
 423:     // labelled distinctly from a power's own vitae_cost/willpower_cost,
 424:     // which shows up in the roll button's own label instead, not here.
 425:     // Review fix (Blind Hunter): also gate on spend.canAfford — without it,
 426:     // this line claimed "(spends 1 WP)" even when the combined cost (power
 427:     // + chip) couldn't be afforded and doRoll() would spend nothing at all,
 428:     // disagreeing with the button's own (correctly gated) fallback label.
 429:     // gdx-11 (#981, AC6): noWP pools never add dice from the chip, so the
 430:     // sub-line must not claim "WP +3" when it's inert.
 431:     if (state.WP && !state.POOL_INFO?.noWP) parts.push((spend.gameInProgress && spend.canAfford) ? 'WP +3 (spends 1 WP)' : 'WP +3');
 432:     if (state.ROTE) parts.push('rote');
 433:     if (state.RESIST_MODE === '-' && state.RESIST_VAL > 0) parts.push('−' + state.RESIST_VAL + ' resist');
 434:     // U+00B7 middle-dot separator (matches sub-line separators elsewhere).
 435:     subEl.textContent = parts.join(' · ');
 436:   }
 437:   if (rollBtn) {
