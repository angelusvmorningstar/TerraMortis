  26: // Dice math (configurable again threshold: 10 = standard, 9 = 9-again, 8 = 8-again)
  27: function d10() { return Math.floor(Math.random() * 10) + 1; }
  28: function mkDie(v, again = 10)  { return { v, s: v >= 8, x: v >= again }; }
  29: function mkChain(rv, again = 10) {
  30:   const r = mkDie(rv, again); const ch = [];
  31:   let l = r; while (l.x) { const c = mkDie(d10(), again); ch.push(c); l = c; }
  32:   return { r, ch };
  33: }
  34: function rollDice(n, again = 10) { const c = []; for (let i = 0; i < n; i++) c.push(mkChain(d10(), again)); return c; }
  35: function cntSuc(cols) { let s = 0; cols.forEach(col => { if (col.r.s) s++; col.ch.forEach(d => { if (d.s) s++; }); }); return s; }
