  78: /**
  79:  * How much this roll would really spend: the loaded power's own
  80:  * vitae_cost/willpower_cost (gdx.6, via pools.js — `null`/absent both mean
  81:  * "nothing", same as `0` at this layer) plus the WP(+3) boost chip's own
  82:  * separate 1-Willpower cost when it's toggled on. Additive, never either/or
  83:  * — a devotion that itself costs 1 WP, rolled with the boost chip also on,
  84:  * spends 2 WP total from two different sources. `hasPowerCost`/
  85:  * `powerWillpowerCost` are exposed separately (review finding, Acceptance
  86:  * Auditor: AC3/AC6) so the button label can trigger and display ONLY the
  87:  * power's own cost — never flip into spend-mode, or claim a power cost,
  88:  * purely because the chip is on — while the chip's own spend stays
  89:  * distinctly labelled in the sub-line instead (updPool()). The combined
  90:  * `vitaeCost`/`willpowerCost` total is still what's actually checked for
  91:  * affordability and actually spent — both must be paid together or not at
  92:  * all (AC5's "never partial").
  93:  */
  94: export function spendableCost(poolInfo, wpChipOn) {
  95:   const powerVitae = poolInfo?.vitae_cost || 0;
  96:   const powerWillpower = poolInfo?.willpower_cost || 0;
  97:   const chipWillpower = wpChipOn ? 1 : 0;
  98:   return {
  99:     vitaeCost: powerVitae,
 100:     willpowerCost: powerWillpower + chipWillpower,
 101:     hasPowerCost: powerVitae > 0 || powerWillpower > 0,
 102:     powerWillpowerCost: powerWillpower,
 103:   };
 104: }
