 441:   const suc = stRollResult.successes ?? 0;
 442:   const exc = stRollResult.exceptional || suc >= 5;
 443:   const again = stRollResult.params?.again ?? 10;
 444:   const againLabel = again === 8 ? '8-Again' : again === 9 ? '9-Again' : '';
 445:   const rote = stRollResult.params?.rote;
 446:   const pool = stRollResult.params?.size ?? 0;
 447:   const cls = suc === 0 ? 'feeding-st-roll-fail' : exc ? 'feeding-st-roll-exc' : 'feeding-st-roll-suc';
