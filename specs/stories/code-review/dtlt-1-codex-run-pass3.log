 465:   // rlv.7 review fix (Pass 2/3b): this used to `return` here, which skipped
 466:   // the power-chip rendering block AND the add-mod row painting below for
 467:   // any pool with no `.attr` — a real case, not hypothetical: combat.js's
 468:   // `quickRoll()` calls `loadPool(pool, label, { total: pool })`, a `pi`
 469:   // with no `.attr` at all. `loadPool()` still folds a persisted chip's
 470:   // value into `state.MOD` in that case, so the roll WAS already using it —
 471:   // it just never rendered, leaving the ST unable to see, toggle, or remove
 472:   // a modifier that's silently affecting a combat roll. Restructured so the
 473:   // attr/skill/disc breakdown is skipped for a no-`.attr` pool, but chips
 474:   // and the add-mod row still render below — the two are independent.
 475:   const segs = [];
 476:   let html;
 477: 
 478:   if (!pi || !pi.attr) {
 479:     html = eff <= 0
 480:       ? 'Effective pool: <span class="effpool-seg effpool-seg--neg">Chance die</span>'
 481:       : 'Effective pool: <span>' + eff + (eff === 1 ? ' die' : ' dice') + '</span>';
 482:   } else {
 483:     if (pi.attr) segs.push('<span class="effpool-seg">' + pi.attr + ' <b>' + pi.attrV + '</b></span>');
 484:     if (pi.skill) segs.push('<span class="effpool-seg">' + pi.skill + ' <b>' + pi.skillV + '</b></span>');
 485:     if (pi.unskilled) segs.push('<span class="effpool-seg effpool-seg--neg">unskilled <b>' + pi.unskilled + '</b></span>');
 486:     if (pi.discName && pi.discV) segs.push('<span class="effpool-seg">' + pi.discName + ' <b>' + pi.discV + '</b></span>');
 487:     if (pi.meritBonus && pi.meritLabel) segs.push('<span class="effpool-seg effpool-seg--merit">' + pi.meritLabel + ' <b>+' + pi.meritBonus + '</b></span>');
 488:     if (pi.roteEligible && !state.ROTE) segs.push('<span class="effpool-seg effpool-seg--rote" onclick="togMod(\'rote\')" title="PT dot 5: spend 1 WP for Rote quality">Rote ✓</span>');
 489:     // gdx-11 (#981, AC6): noWP pools (Blood Bond Resistance) never show the
 490:     // WP +3 bonus segment — the WP spend there is the cost of attempting,
 491:     // never a dice bonus. wpBonus/spend-line copy above already respect
