 864: // ── STAKING (gdx-11, #981, AC7) ──
 865: //
 866: // After any weapon-attack roll where the active weapon is stake-tagged and
 867: // the roll's own successes are 5+, flag it for a Torpor confirmation —
 868: // armour/soak reduction is not computed at this layer, honestly disclosed in
 869: // the note text itself rather than silently assumed. Apply Torpor targets
 870: // `state.RESIST_CHAR` (the resist-target dropdown's own selection) per this
 871: // story's AC — DISCLOSED LIMITATION: that dropdown only populates when the
 872: // loaded pool carries a `resistance` string (showResistSec()), so a plain
 873: // weapon-skill pool with no resistance formula (most Common Actions weapon
 874: // rolls) will not have a resist-target selected. The note still shows; the
 875: // button is omitted rather than wired to a target that was never chosen —
 876: // not a bug to chase, matching this story's own accepted-limitation
 877: // precedent (see Lash Out's resistance-string simplification).
 878: function _stakeNote(successes) {
 879:   if (successes < 5 || !state.activeWeaponId) return null;
 880:   const entry = getCatalogueEntry(state.activeWeaponId);
 881:   if (!isStakeWeapon(entry)) return null;
 882: 
 883:   const div = document.createElement('div');
 884:   div.className = 'rv2-stake-note';
 885:   const msg = document.createElement('div');
 886:   msg.className = 'rv2-stake-msg';
 887:   msg.textContent = '5+ successes with a stake — confirm 5+ net damage for Torpor';
 888:   div.appendChild(msg);
 889: 
 890:   // Code review finding (Acceptance Auditor, tracing the actual code path):
 891:   // this originally gated the Apply Torpor button on state.RESIST_CHAR,
 892:   // which only gets set by showResistSec() when the loaded pool carries a
 893:   // `resistance` string - true for Clash of Wills/Lash Out, but NOT true
 894:   // for an ordinary weapon-skill attack roll (Brawl/Weaponry via Common
 895:   // Actions or Custom Pool), which is the realistic way a stake attack
 896:   // actually happens. AC7 promises "a one-tap Apply Torpor action" - it was
 897:   // realistically unreachable. Fixed with its own target picker, same
 898:   // window._charNames/_charDisplayMap source showResistSec() itself uses,
 899:   // independent of the resistance mechanism. Defaults to the current
 900:   // resist-target as a convenience when one happens to be set.
 901:   const sel = document.createElement('select');
 902:   sel.className = 'resist-sel rv2-stake-target-sel';
 903:   const optDefault = document.createElement('option');
 904:   optDefault.value = '';
 905:   optDefault.textContent = '— select target —';
 906:   sel.appendChild(optDefault);
 907:   (window._charNames || []).slice().sort().forEach(n => {
 908:     const opt = document.createElement('option');
 909:     opt.value = n;
 910:     opt.textContent = (window._charDisplayMap || {})[n] || n;
 911:     sel.appendChild(opt);
 912:   });
 913:   if (state.RESIST_CHAR) sel.value = state.RESIST_CHAR.name;
 914:   div.appendChild(sel);
 915: 
 916:   const btn = document.createElement('button');
 917:   btn.className = 'rv2-stake-btn';
 918:   btn.textContent = 'Apply Torpor';
 919:   btn.disabled = !sel.value;
 920:   sel.addEventListener('change', () => { btn.disabled = !sel.value; });
 921:   btn.addEventListener('click', async () => {
 922:     const target = (state.chars || []).find(c => c.name === sel.value);
 923:     if (!target) return;
 924:     // Disabled immediately, before the await, so a double-tap during the
 925:     // (usually instant, first-time-only) load can't fire this twice.
 926:     btn.disabled = true;
 927:     sel.disabled = true;
 928:     btn.textContent = 'Applying…';
 929:     const targetId = String(target._id);
 930:     const targetName = target.name.split(' ')[0];
 931:     // Found via live re-verification (this exact button is what AC7's own
 932:     // "Verified end-to-end" line requires proving): trackerWriteField()
 933:     // silently no-ops for any character whose tracker was never
 934:     // ensureLoaded()'d this session (tracker.js's _confirmed gate exists to
 935:     // stop stale-cache writes clobbering real data, but a stake target
 936:     // picked from this dropdown - unlike state.rollChar - has no guarantee
 937:     // anything has loaded their tracker yet). Same await-before-write
 938:     // pattern doRoll() already uses for state.rollChar, applied here for
 939:     // the target instead.
 940:     await ensureTrackerLoaded(target);
 941:     trackerWriteField(targetId, 'in_torpor', true);
 942:     toast('Torpor applied to ' + targetName);
 943:     btn.textContent = 'Torpor Applied';
 944:   });
 945:   div.appendChild(btn);
 946:   return div;
 947: }
 948: 
 949: // ── MAIN ROLL ──
 950: 
 951: // Review fix (Blind Hunter + Edge Case Hunter, independently): nothing
 952: // guarded against doRoll() firing twice before the first spend's cache
 953: // update lands (no debounce anywhere in #roll-btn's wiring — plain
 954: // `onclick="doRoll()"` in both index.html layouts). A double-tap could
 955: // double-charge a power's real cost. Module-level, not per-character —
 956: // this dice roller only ever has one character loaded at a time.
 957: let _spendInFlight = false;
 958: 
 959: export async function doRoll() {
 960:   const eff = effPool();
 961:   const area = document.getElementById('dice-area');
 962:   const hdr = document.getElementById('res-hdr');
 963:   area.innerHTML = '';
 964:   hdr.classList.remove('on');
 965: 
 966:   // gdx.7 (#988): the cost of ACTIVATING the power is paid up front, once,
 967:   // regardless of which of the three result branches below actually fires
 968:   // — a chance die, a contested roll, and a standard roll all still cost
 969:   // the same Vitae/Willpower to attempt (VtR 2e: you pay to activate, then
 970:   // roll; a failed roll doesn't refund the cost). Recomputed fresh here
 971:   // (not read from whatever `updPool()` last painted) so a stale label
 972:   // can never cause a stale spend.
 973:   //
 974:   // Review fix (Edge Case Hunter): `state.rollChar` can be set by `app.js`'s
 975:   // `pickChar()` (the roll tab's own picker) without ever loading the
 976:   // tracker first — `trackerRead` would then read seeded MAX defaults, not
 977:   // real balance. `ensureTrackerLoaded` is a no-op if already confirmed, so
 978:   // this costs nothing on the common path and only actually awaits a
 979:   // network round-trip the first time a given character is ever read.
 980:   // Review fix (Edge Case Hunter, gdx.8): captured BEFORE the awaits below,
 981:   // not re-read from `state.rollChar` at each branch's own _logRoll() call.
 982:   // `state.rollChar` is plain module state with no lock during doRoll()'s
 983:   // awaited network round-trips (ensureTrackerLoaded, up to two trackerAdj
 984:   // calls) — the character picker stays fully interactive throughout, so a
 985:   // character switch mid-roll would otherwise attribute the persisted
 986:   // roll_log entry (and its real vitae/willpower spend) to whichever
 987:   // character happens to be loaded when the roll finishes, not the one that
 988:   // was actually rolled. This is the exact character the roll below is FOR.
 989:   const _rollChar = state.rollChar;
 990:   // dtlt.1: the pool's own trait names, captured at the same moment and for
 991:   // the same reason as _rollChar above — a character or power switch during
 992:   // the awaits below must not change which bonus-success rules are tested.
 993:   const _bonusCtx = {
 994:     attr:  state.POOL_INFO?.attr || '',
 995:     skill: state.POOL_INFO?.skill || '',
 996:     disc:  state.POOL_INFO?.discName || '',
 997:     spec:  state.POOL_INFO?.spec || '',
 998:   };
 999:   if (state.rollChar) await ensureTrackerLoaded(state.rollChar);
1000:   const spend = _currentSpendDecision();
1001:   // gdx.8 (#989): what was ACTUALLY spent this roll, for roll_log — not
1002:   // spend.cost.*, which is what the label OFFERED to spend and stays
1003:   // populated even when the guard below never fires (game off, can't
1004:   // afford, already in flight). Zero unless a real trackerAdj happens.
1005:   let _loggedVitaeSpent = 0, _loggedWillpowerSpent = 0;
1006:   if (!_spendInFlight && spend.gameInProgress && spend.canAfford && spend.charId &&
1007:       (spend.cost.vitaeCost > 0 || spend.cost.willpowerCost > 0)) {
1008:     _spendInFlight = true;
1009:     try {
1010:       // Sequenced, not fired concurrently (review fix, Edge Case Hunter):
1011:       // two concurrent trackerAdj() calls on a not-yet-confirmed character
1012:       // would each independently race `ensureLoaded()`, risking one write
1013:       // clobbering the other. Awaited in turn instead — negligible cost,
1014:       // since trackerAdj never actually suspends once confirmed (which the
1015:       // await above guarantees it now is).
1016:       if (spend.cost.vitaeCost > 0) {
1017:         await trackerAdj(spend.charId, 'vitae', -spend.cost.vitaeCost);
1018:         _loggedVitaeSpent = spend.cost.vitaeCost;
1019:       }
1020:       if (spend.cost.willpowerCost > 0) {
1021:         await trackerAdj(spend.charId, 'willpower', -spend.cost.willpowerCost);
1022:         _loggedWillpowerSpent = spend.cost.willpowerCost;
1023:       }
1024:     } finally {
1025:       _spendInFlight = false;
1026:     }
1027:   }
1028: 
1029:   if (eff <= 0) {
1030:     const v = d10();
1031:     const suc = v === 10;
1032:     const dram = v === 1;
1033:     // dtlt.1: a chance die showing 10 is a rolled success, so bonus-success
1034:     // rules apply to it exactly as they do to a full pool.
1035:     const chance = addBonusSuccesses(suc ? 1 : 0, _rollChar, _bonusCtx);
1036:     const chanceBreakdown = dram ? '' : formatSuccessBreakdown(chance);
1037:     const cls = dram ? 'd' : suc ? 'e' : 'f';
1038:     const lbl = dram ? 'Dramatic Failure' : suc ? 'Success (Chance)' : 'Failure (Chance)';
1039:     const cnt = dram ? '\u2014' : String(chance.total);
1040:     const chanceVerd = chanceBreakdown ? `Chance die \u00b7 ${chanceBreakdown}` : 'Chance die';
1041:     hdr.innerHTML = `<div><span class="rcnt ${cls}">${cnt}</span><span class="rlbl ${cls}">${lbl}</span></div><div class="rverd">${chanceVerd}</div>`;
1042:     hdr.classList.add('on');
1043:     const del = document.createElement('div');
1044:     del.className = 'die cd';
1045:     del.textContent = v;
1046:     area.appendChild(del);
1047:     addHist('Chance', cls, lbl, cnt, chanceVerd);
1048:     if (_rollChar && getGlobalSettings()?.game_in_progress) {
1049:       _logRoll(_rollChar._id, buildRollLogPayload({
1050:         pool: 'Chance', label: lbl, successes: dram ? 0 : chance.total, results: [v],
1051:         againRule: state.AGAIN, rote: state.ROTE, wpBonus: state.WP,
1052:         vitaeSpent: _loggedVitaeSpent, willpowerSpent: _loggedWillpowerSpent,
1053:       }));
1054:     }
1055:     return;
1056:   }
1057: 
1058:   const cA = rollPool(eff);
1059:   const cB = state.ROTE ? rollPool(eff) : null;
1060:   const sA = cntSuc(cA);
1061:   const sB = state.ROTE ? cntSuc(cB) : 0;
1062:   let wC, wS, lC, lS;
1063: 
1064:   if (state.ROTE && sB > sA) {
1065:     wC = cB; wS = sB; lC = cA; lS = sA;
1066:   } else {
1067:     wC = cA; wS = sA;
1068:     if (state.ROTE) { lC = cB; lS = sB; }
1069:   }
1070: 
1071:   // dtlt.1: the rote comparison above is rolled-only on purpose — it asks
1072:   // which pool's DICE came up better. Bonus successes are added once, to the
1073:   // winner, only after that choice is made. wS stays the rolled count (it
1074:   // labels the dice actually shown); wTotal is what the roll is worth.
1075:   const bonusRes = addBonusSuccesses(wS, _rollChar, _bonusCtx);
1076:   const wTotal = bonusRes.total;
1077:   const bonusLine = formatSuccessBreakdown(bonusRes);
1078: 
1079:   const mods = [];
1080:   if (state.WP) mods.push('WP +3');
1081:   if (state.ROTE) mods.push('rote');
1082:   if (state.NA) mods.push('no again');
1083: 
1084:   const pi = state.POOL_INFO;
1085:   const verdParts = [];
1086:   if (pi && pi.attr) {
1087:     if (pi.attr) verdParts.push(pi.attr + ' ' + pi.attrV);
1088:     if (pi.skill) verdParts.push(pi.skill + ' ' + pi.skillV);
1089:     if (pi.unskilled) verdParts.push('unskilled ' + pi.unskilled);
1090:     if (pi.discName && pi.discV) verdParts.push(pi.discName + ' ' + pi.discV);
1091:   }
1092:   const poolStr = verdParts.length ? verdParts.join(' + ') : eff + 'd10';
1093:   const ag = state.AGAIN;
1094:   const verd = `${poolStr} \u00B7 ${ag}-again${mods.length ? ' \u00B7 ' + mods.join(', ') : ''}${bonusLine ? ' \u00B7 ' + bonusLine : ''}`;
1095: 
1096:   // Contested roll
1097:   if (state.RESIST_MODE === 'v' && state.RESIST_CHAR && state.RESIST_VAL > 0) {
1098:     const cR = rollPool(state.RESIST_VAL);
1099:     const sR = cntSuc(cR);
1100:     const net = wTotal - sR;
1101:     const won = net > 0;
1102:     const draw = net === 0;
1103:     const cls = won ? (net >= 5 ? 'e' : 's') : 'f';
1104:     const outcome = won ? (net >= 5 ? 'Exceptional Success' : 'Success') : draw ? 'Draw (Failure)' : 'Failure';
1105:     const rcName = state.rollChar ? state.rollChar.name.split(' ')[0] : 'Roll';
1106:     const resistName = state.RESIST_CHAR.name.split(' ')[0];
1107:     const resistLabel = pi ? pi.resistance : '';
1108: 
1109:     // dtlt.1: the contested comparison uses the attacker's TOTAL (rolled plus
1110:     // any bonus successes) against the resistance roll. The resistance roll
1111:     // itself stays rolled-only \u2014 resolving bonus rules for the resisting
1112:     // character would need that character's own pool context, which this
1113:     // surface does not have. Noted in the story's Dev Agent Record.
1114:     const contestVerd = `${poolStr} vs ${resistName} ${resistLabel} \u00B7 ${wTotal} vs ${sR}`
1115:       + (bonusLine ? ` \u00B7 ${bonusLine}` : '');
1116:     hdr.innerHTML = `<div><span class="rcnt ${cls}">${won ? net : wTotal}</span><span class="rlbl ${cls}">${outcome}</span></div><div class="rverd">${contestVerd}</div>`;
1117:     hdr.classList.add('on');
1118: 
1119:     const wb = document.createElement('div');
1120:     wb.className = 'rote-blk win';
1121:     wb.innerHTML = `<div class="rote-lbl">${rcName} \u2014 ${wS} success${wS !== 1 ? 'es' : ''}</div>`;
1122:     wb.appendChild(mkColsEl(wC, 0));
1123:     area.appendChild(wb);
1124: 
1125:     const rb = document.createElement('div');
1126:     rb.className = 'rote-blk' + (won ? '' : ' win');
1127:     rb.innerHTML = `<div class="rote-lbl">${resistName} (resistance) \u2014 ${sR} success${sR !== 1 ? 'es' : ''}</div>`;
1128:     rb.appendChild(mkColsEl(cR, wC.length + 2));
1129:     area.appendChild(rb);
1130: 
1131:     // Code review finding (Blind Hunter + Edge Case Hunter, independently):
1132:     // this used to check raw wS regardless of contest outcome, so a stake
1133:     // attack that scored 5+ successes but was then BEATEN by the target's
1134:     // resistance roll (a loss or draw) still offered "Apply Torpor" - wrong,
1135:     // and contradicts the note's own text ("confirm 5+ NET damage"). Gated
1136:     // on `won` now; `net` (not `wS`) is what actually reached the target.
1137:     const stakeNoteC = _stakeNote(won ? net : 0);
1138:     if (stakeNoteC) area.appendChild(stakeNoteC);
1139: 
1140:     addHist(eff + 'd10', cls, outcome, won ? net : wTotal, verd);
1141:     if (_rollChar && getGlobalSettings()?.game_in_progress) {
1142:       // Review fix (Codex, external): addHist() above (pre-existing,
1143:       // untouched, out of this story's scope) uses `won ? net : wS` — on a
1144:       // loss/draw that still stores the attacker's raw success count, not
1145:       // the true (zero) net that reached the target. That's a display-only
1146:       // quirk for the client-local Roll-tab history list, but roll-feed.js
1147:       // is a NEW consumer this story adds, and its hit/miss styling keys
1148:       // directly on `entry.successes > 0` — inheriting the same value would
1149:       // paint a genuinely lost contested roll (label: "Failure") as a hit
1150:       // in the ST feed. `successes` here is 0 on any non-win, not `wS`.
1151:       _logRoll(_rollChar._id, buildRollLogPayload({
1152:         pool: eff + 'd10', label: outcome, successes: won ? net : 0, results: flattenDiceChainResults(wC),
1153:         againRule: state.AGAIN, rote: state.ROTE, wpBonus: state.WP,
1154:         vitaeSpent: _loggedVitaeSpent, willpowerSpent: _loggedWillpowerSpent,
1155:       }));
1156:     }
1157:     return;
1158:   }
1159: 
1160:   // Standard roll result. dtlt.1: the headline count, the exceptional-success
1161:   // threshold and the stake note all read the TOTAL. wTotal === wS whenever no
1162:   // bonus-success rule fires, so a normal roll displays exactly as before.
1163:   const exc = wTotal >= 5;
1164:   const cls = wTotal === 0 ? 'f' : exc ? 'e' : 's';
1165:   const lbl = wTotal === 0 ? 'Failure' : exc ? 'Exceptional Success' : 'Success';
1166:   hdr.innerHTML = `<div><span class="rcnt ${cls}">${wTotal}</span><span class="rlbl ${cls}">${lbl}</span></div><div class="rverd">${verd}</div>`;
1167:   hdr.classList.add('on');
1168: 
1169:   if (state.ROTE) {
1170:     const wb = document.createElement('div');
1171:     wb.className = 'rote-blk win';
1172:     wb.innerHTML = `<div class="rote-lbl">Roll 1 \u2014 ${wS} success${wS !== 1 ? 'es' : ''} (selected)</div>`;
1173:     wb.appendChild(mkColsEl(wC, 0));
1174:     area.appendChild(wb);
1175: 
1176:     const lb = document.createElement('div');
1177:     lb.className = 'rote-blk';
1178:     lb.innerHTML = `<div class="rote-lbl">Roll 2 \u2014 ${lS} success${lS !== 1 ? 'es' : ''}</div>`;
1179:     lb.appendChild(mkColsEl(lC, wC.length + 2));
1180:     area.appendChild(lb);
1181:   } else {
1182:     area.appendChild(mkColsEl(wC, 0));
1183:   }
1184: 
1185:   const stakeNote = _stakeNote(wTotal);
1186:   if (stakeNote) area.appendChild(stakeNote);
1187: 
1188:   addHist(eff + 'd10', cls, lbl, wTotal, verd);
1189:   if (_rollChar && getGlobalSettings()?.game_in_progress) {
1190:     _logRoll(_rollChar._id, buildRollLogPayload({
1191:       pool: eff + 'd10', label: lbl, successes: wTotal, results: flattenDiceChainResults(wC),
1192:       againRule: state.AGAIN, rote: state.ROTE, wpBonus: state.WP,
1193:       vitaeSpent: _loggedVitaeSpent, willpowerSpent: _loggedWillpowerSpent,
1194:     }));
1195:   }
1196: 
1197:   // Auto-reset WP after rolling (one-time spend)
1198:   if (state.WP) {
1199:     state.WP = false;
1200:     document.getElementById('wp-c')?.classList.remove('on');
1201:     updPool();
1202:   }
1203: }
1204: 
1205: // ── ROLL HISTORY ──
1206: 
1207: // Review fix (Codex, external — the real find this internal review's own
1208: // three layers missed): `rollPool(eff)` (used by the standard/contested
1209: // branches, via `cA`/`cB`/`wC`/`lC`) returns an array of dice-CHAIN objects
1210: // (`{ r: { v, s, x }, ch: [...] }`, from shared/dice.js's own mkChain/
1211: // rollPool), not plain face-value integers. Passed straight through as
1212: // `results`, every one of those two branches' real POSTs was schema-invalid
1213: // (`results` items must be `type: 'integer'`) and got silently 400'd —
1214: // `_logRoll`'s own fire-and-forget catch swallowed it with zero signal.
1215: // This is the ONLY one of the three doRoll() branches that needs it — the
1216: // chance-die branch rolls a raw `d10()` and already passes a plain integer.
1217: // Flattens to every face actually rolled, including exploded re-rolls, in
1218: // roll order — the true "what came up" record an ST audit trail wants.
1219: export function flattenDiceChainResults(chains) {
1220:   const out = [];
1221:   for (const col of chains || []) {
1222:     out.push(col.r.v);
1223:     for (const d of col.ch) out.push(d.v);
1224:   }
1225:   return out;
1226: }
1227: 
1228: // gdx.8 (#989): persisted roll history, alongside (not instead of) the
1229: // client-local addHist() below. Pure function — no DOM, no globals — so it
1230: // is directly testable; builds the exact server-side schema shape (see
1231: // server/schemas/roll_log.schema.js) from whatever a doRoll() branch already
1232: // has in scope. character_id is NOT included here — the caller (doRoll())
1233: // passes it separately to _logRoll(), since it comes from state.rollChar,
1234: // not from any of the per-branch roll data this function receives.
1235: export function buildRollLogPayload({ pool, label, successes, results, againRule, rote, wpBonus, vitaeSpent, willpowerSpent }) {
1236:   return {
1237:     label,
1238:     pool,
1239:     results,
1240:     successes,
1241:     // Review fix (Codex, external): `state.AGAIN` (every real call site's
1242:     // own `againRule` value) is a NUMBER (public/js/suite/data.js's own
1243:     // `AGAIN: 10` default, reassigned via `Number(v)`), but the schema
1244:     // requires string/null and this server's validate() middleware runs
1245:     // with `coerceTypes: false` — a raw number here 400'd every real roll.
1246:     again_rule: (againRule === null || againRule === undefined) ? null : String(againRule),
1247:     rote: !!rote,
1248:     wp_bonus: !!wpBonus,
1249:     vitae_spent: vitaeSpent || 0,
1250:     wp_spent: willpowerSpent || 0,
1251:   };
1252: }
1253: 
1254: // Fire-and-forget — mirrors trackerAdj's own established silent-fail shape
1255: // (game/tracker.js's saveToApi). The roll UI must never block on this
1256: // write's own round-trip, and a dropped roll_log entry is not worth
1257: // surfacing an error to the player over.
1258: function _logRoll(characterId, payload) {
1259:   // Review fix (Blind Hunter): fire-and-forget by design, mirroring
1260:   // trackerAdj's own established silent-fail shape (the player's roll must
1261:   // never block or error on the persisted-history write) — but a bare
1262:   // catch(() => {}) gave zero operator-visible signal even on a total,
1263:   // permanent failure. console.warn costs nothing and doesn't change that
1264:   // contract; it just stops a broken pipeline from being invisible.
1265:   apiPost('/api/roll_log', { character_id: String(characterId), ...payload })
1266:     .catch(err => console.warn('[roll_log] failed to persist roll history:', err?.message || err));
1267: }
1268: 
1269: export function addHist(pool, cls, lbl, cnt, verd) {
1270:   const h = state.hist;
1271:   h.unshift({ pool, lbl, cnt, cls, verd });
1272:   if (h.length > 20) h.pop();
1273:   state.hist = h;
1274:   renderHist();
1275: }
1276: 
1277: export function renderHist() {
1278:   const l = document.getElementById('hlist');
1279:   const h = state.hist;
1280:   if (!h.length) {
1281:     l.innerHTML = '<div class="hempty">No rolls yet</div>';
1282:     return;
1283:   }
1284:   l.innerHTML = h.map(r =>
1285:     `<div class="hitem"><span class="hmeta">${r.verd}</span><span class="hres ${r.cls}">${r.cnt} ${r.lbl}</span></div>`
1286:   ).join('');
1287: }
1288: 
1289: export function clrHist() {
1290:   state.hist = [];
1291:   renderHist();
1292: }
