 382:   const feedTerrs = Object.entries(territories)
 383:     .filter(([, v]) => v === 'resident' || v === 'poach')
 384:     .map(([k, v]) => {
 385:       const t = _resolveTerrKey(k);
 386:       const name = t ? t.name : k.replace(/_/g, ' ');
 387:       return `${name} (${v})`;
 388:     });
 389:   if (feedTerrs.length) {
 390:     h += `<div class="feeding-sum-row"><span class="feeding-sum-label">Territory:</span> ${feedTerrs.map(t => esc(t)).join(', ')}</div>`;
 391:   }
 392: 
 393:   // Description
 394:   if (r['feeding_description']) {
 395:     h += `<div class="feeding-sum-row"><span class="feeding-sum-label">Description:</span> ${esc(r['feeding_description'])}</div>`;
 396:   }
 397: 
 398:   // Rote + secondary hunt
 399:   // Issue #234 — `_feed_rote` was dropped by dt-form.22; rote is now a per-slot
 400:   // project action. Detect via project-slot scan, mirroring the admin pattern
 401:   // at downtime-views.js:2775-2780. Match both 'rote' and 'feed': the rote-lock
 402:   // at downtime-form.js:620 auto-writes 'feed' for the locked slot; users
 403:   // selecting Rote Hunt manually from the dropdown write 'rote'.
 404:   const feedRote = [1, 2, 3, 4].some(n => {
 405:     const a = r[`project_${n}_action`];
 406:     return a === 'rote' || a === 'feed';
 407:   });
 408:   if (feedRote) {
 409:     h += '<div class="feeding-sum-rote">';
 410:     h += '<span class="feeding-sum-label">Rote:</span> Project action dedicated to feeding';
 411:     // Find the rote/feed project slot
 412:     for (let n = 1; n <= 4; n++) {
 413:       const a = r[`project_${n}_action`];
 414:       if (a === 'rote' || a === 'feed') {
 415:         const method2 = r[`project_${n}_feed_method2`];
 416:         if (method2) {
 417:           const m2 = FEED_METHODS.find(fm => fm.id === method2);
 418:           h += ` \u2014 Secondary method: <strong>${esc(m2?.name || method2)}</strong>`;
 419:         }
 420:         const projTerr = r[`project_${n}_territory`];
 421:         if (projTerr) {
 422:           const t = TERRITORY_DATA.find(td => td.slug === projTerr);
 423:           h += ` in <strong>${esc(t?.name || projTerr)}</strong>`;
 424:         }
 425:         const projDesc = r[`project_${n}_description`];
 426:         if (projDesc) {
 427:           h += `<div class="feeding-sum-sub">${esc(projDesc)}</div>`;
 428:         }
 429:         break;
