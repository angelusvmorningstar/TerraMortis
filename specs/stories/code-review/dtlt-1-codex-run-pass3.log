 106: /** Can `balance` ({vitae, willpower}) cover `cost` in full? Never partial —
 107:  *  a roll either affords its whole real cost or it doesn't spend at all. */
 108: export function canAffordCost(cost, balance) {
 109:   const vitae = balance?.vitae ?? 0;
 110:   const willpower = balance?.willpower ?? 0;
 111:   return cost.vitaeCost <= vitae && cost.willpowerCost <= willpower;
 112: }
