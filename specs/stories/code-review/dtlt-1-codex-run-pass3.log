 786: // ── AGAIN / MODIFIER TOGGLES ──
 787: 
 788: // Segmented Again pill entry point (slice D). `v` is one of
 789: // '10' | '9' | '8' | 'none' (or the numeric variants). 'none' disables
 790: // die explosion via state.NA; the other values set state.AGAIN and clear
 791: // NA. Repaints the pill and the sub-line via updPool().
 792: export function setAgainSeg(v) {
 793:   if (v === 'none' || v === 'None') {
 794:     state.NA = true;
 795:   } else {
 796:     state.NA = false;
 797:     state.AGAIN = Number(v);
 798:   }
 799:   // updPool paints the seg AND the anchor sub-line so both stay in sync.
 800:   updPool();
 801: }
 802: 
 803: // Kept as an export because loadPool() calls it. Delegates to the new
 804: // segmented entry point so the pill + sub-line stay in sync when a pool
 805: // with a `nineAgain` flag is loaded.
 806: export function setAgain(v) {
 807:   setAgainSeg(v);
 808: }
 809: 
 810: export function togMod(m) {
 811:   if (m === 'rote') {
 812:     state.ROTE = !state.ROTE;
 813:     const el = document.getElementById('rote-c');
 814:     if (el) el.classList.toggle('on', state.ROTE);
 815:     updPool();
 816:   } else if (m === 'wp') {
 817:     state.WP = !state.WP;
 818:     const el = document.getElementById('wp-c');
 819:     if (el) el.classList.toggle('on', state.WP);
 820:     updPool();
 821:   } else {
 822:     // 'na' — no dedicated button in v2 markup; routed through the
 823:     // segmented pill instead. Kept for any external caller still on the
 824:     // old chip contract.
 825:     state.NA = !state.NA;
 826:     updPool();
 827:   }
 828: }
