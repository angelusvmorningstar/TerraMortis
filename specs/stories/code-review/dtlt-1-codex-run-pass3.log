  65: function _resolveTerrKey(tid) {
  66:   if (!tid) return null;
  67:   // 1) Look up live doc by _id, then map back to TERRITORY_DATA via slug.
  68:   const live = _liveTerrDocs.find(d => String(d._id) === tid);
