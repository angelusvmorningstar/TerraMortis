 536:           const entry = getCatalogueEntry(item.catalogue_id);
 537:           const isOn = state.activeEquipBonus &&
 538:                        state.activeEquipBonus.catalogueId === entry.id;
 539:           const cls = 'effpool-spec' + (isOn ? ' on' : '');
 540:           const safe = String(entry.id).replace(/"/g, '&quot;');
 541:           return `<span class="${cls}" data-equip="${safe}" data-bonus="${entry.bonus_dice}" `
 542:                + `onclick="togEquipChip(this)" title="${entry.name}">`
 543:                + `${entry.name} <span class="effpool-spec-bonus">+${entry.bonus_dice}</span></span>`;
 544:         }).join('') + '</div>';
 545:       }
 546:     }
 547:   }
