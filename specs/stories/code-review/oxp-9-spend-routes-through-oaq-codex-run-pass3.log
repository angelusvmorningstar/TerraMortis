65:// GET /api/contested_roll_requests/mine — pending challenges targeting me
66:router.get('/mine', async (req, res) => {
67:  const charIds = (req.user.character_ids || []).map(id => String(id));
68:  if (!charIds.length) return res.json([]);
69:
70:  // crd.1 route audit: this query had NO request_type clause at all. It was
71:  // safe only by accident — office-actions.js writes `target_id`, not
72:  // `target_character_id`, so a Status Action simply never matched the field
73:  // name. Any future writer adding a target_character_id to a status_action
74:  // (or a fourth request_type sharing this collection) would have leaked
75:  // straight into a player's own queue. Scoped positively rather than as
76:  // `$ne: 'status_action'`: `$in: [null, 'contested_roll']` matches legacy
77:  // documents (request_type absent — everything written before crd.1) and new
78:  // explicit ones, and nothing else.
79:  const docs = await col()
80:    .find({
81:      target_character_id: { $in: charIds },
82:      status: 'pending',
83:      request_type: { $in: [null, 'contested_roll'] },
84:    })
85:    .sort({ created_at: -1 })
86:    .toArray();
87:
88:  res.json(docs);
89:});
