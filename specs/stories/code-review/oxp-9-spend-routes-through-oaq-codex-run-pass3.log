249:// PUT /api/office_actions/:id/accept
250:// oaq.2: ST-only. Applies the effect for real — re-reads the target live,
251:// re-validates the action's precondition against its CURRENT status (not
252:// whatever it was at submission time), claims a budget slot (paid types
253:// only — budget spends on approval, never on submission, per this story's
254:// explicit decision), writes the target via the same compare-and-swap
255:// pattern issue-1143 established, logs the applied effect to
256:// office_actions (the same collection the client's per-session action log
257:// already reads via GET /), and marks the pending record resolved — all
258:// inside one MongoDB transaction so a failure at any step leaves nothing
259:// half-applied.
260://
261:// Deliberately NOT re-checked here: the live game-phase gate. otc.2's rule
262:// governs SUBMISSION — an ST reviewing a queue is expected to work through
263:// it after the game session has ended, not necessarily while a game is
264:// still live. Re-requiring a live game at accept time would mean nothing
265:// could ever be approved once a session ends, defeating the point of a
266:// queue. Product decision, 2026-08-12, after internal review raised it as
267:// a question — confirmed no re-check wanted. By contrast, whether the
268:// actor still holds office at all IS re-checked (below): losing office
269:// entirely between submission and approval is a narrower, different case
270:// than "the game moved on".
271:router.put('/:id/accept', requireRole('st'), async (req, res) => {
272:  const pending = await _findPending(req, res);
273:  if (!pending) return;
274:
275:  const client = getClient();
276:  const dbSession = client.startSession();
277:  let statusCode, body;
278:  try {
279:    await dbSession.withTransaction(async () => {
280:      const actorObjectId  = new ObjectId(pending.actor_id);
281:      const targetObjectId = new ObjectId(pending.target_id);
282:
283:      const actor = await getCollection('characters').findOne({ _id: actorObjectId }, { session: dbSession });
284:      if (!actor) throw new RouteResponse(404, { error: 'NOT_FOUND', message: 'Actor not found' });
285:      // Internal review finding: the actor's authorization to hold office can
286:      // change between submission and approval (a handover, a removal) just
287:      // as legitimately as the target's status.city can — re-checked fresh
288:      // here for the same reason AC5 re-checks the target's precondition,
289:      // not trusted from whatever was true at submission time.
290:      if (!actor.court_category) throw new RouteResponse(403, { error: 'FORBIDDEN', message: 'Actor no longer holds a court office' });
291:
292:      const target = await getCollection('characters').findOne({ _id: targetObjectId }, { session: dbSession });
293:      if (!target) throw new RouteResponse(404, { error: 'NOT_FOUND', message: 'Target not found' });
294:
295:      const old_status = target.status?.city || 0;
296:      const new_status = computeNewStatus(pending.action_type, old_status);
297:
298:      // review finding (external, verified live): a TRUE concurrent accept
299:      // race on the SAME pending record — both requests pass _findPending's
300:      // read before either commits — used to reach the office_actions
301:      // insertOne below on BOTH sides, and the second one crashed with an
302:      // uncaught E11000 on the old issue-1143 unique index (a raw
303:      // MongoServerError, not a RouteResponse, so it propagated as a bare
304:      // 500). Claiming the pending record HERE, before any other write,
305:      // means the losing side is rejected cleanly (its own updateOne
306:      // legitimately matches 0 documents once the winner has committed) and
307:      // never reaches the log insert or the budget/CAS writes at all.
308:      const timestamp = new Date().toISOString();
309:      const resolved_by = req.user.username;
310:      const resolveResult = await pendingCol().updateOne(
311:        { _id: pending._id, status: 'pending' },
312:        { $set: { status: 'resolved', outcome: { old_status, new_status }, resolved_by, updated_at: timestamp } },
313:        { session: dbSession },
314:      );
315:      if (resolveResult.matchedCount === 0)
316:        throw new RouteResponse(409, { error: 'CONFLICT', message: 'Request is no longer pending', _needsEnrichment: true });
317:
318:      if (PAID_TYPES.has(pending.action_type)) {
319:        const territories = await getCollection('territories').find({}, { session: dbSession }).toArray();
320:        const regentAmbience = findRegentTerritory(territories, actor)?.ambience;
321:        const budget = calcEffectiveCityStatus(actor, regentAmbience);
322:
323:        const budgetKey = `${pending.game_session_id}:${pending.actor_id}`;
324:        const budgetCol = getCollection('office_action_budgets');
325:        await budgetCol.updateOne(
326:          { _id: budgetKey },
327:          { $setOnInsert: { used: 0 } },
328:          { session: dbSession, upsert: true },
329:        );
330:        const claim = await budgetCol.findOneAndUpdate(
331:          { _id: budgetKey, used: { $lt: budget } },
332:          { $inc: { used: 1 } },
333:          { session: dbSession, returnDocument: 'after' },
334:        );
335:        if (!claim)
336:          throw new RouteResponse(403, { error: 'FORBIDDEN', message: 'Budget exhausted for this session' });
337:      }
338:
339:      const statusMatch = old_status === 0
340:        ? { $or: [{ 'status.city': { $exists: false } }, { 'status.city': 0 }] }
341:        : { 'status.city': old_status };
342:      const casResult = await getCollection('characters').updateOne(
343:        { _id: targetObjectId, ...statusMatch },
344:        { $set: { 'status.city': new_status, updated_at: timestamp } },
345:        { session: dbSession },
346:      );
347:      if (casResult.matchedCount === 0)
348:        throw new RouteResponse(409, { error: 'CONFLICT', message: 'Target was changed by another action — please retry' });
349:
350:      const logDoc = {
351:        game_session_id: pending.game_session_id,
352:        actor_id:    pending.actor_id,
353:        actor_name:  pending.actor_name,
354:        target_id:   pending.target_id,
355:        target_name: pending.target_name,
356:        action_type: pending.action_type,
357:        old_status,
358:        new_status,
359:        timestamp,
360:      };
361:      const insertedLog = await actionsCol().insertOne(logDoc, { session: dbSession });
362:
363:      statusCode = 200;
364:      body = {
365:        request: { ...pending, status: 'resolved', outcome: { old_status, new_status }, resolved_by },
366:        action:  { ...logDoc, _id: insertedLog.insertedId },
367:        new_status,
368:      };
369:    });
370:  } catch (err) {
371:    if (err instanceof RouteResponse) {
372:      statusCode = err.statusCode;
373:      body = err.body;
374:      // review finding: this branch fires on a true concurrent-accept race
375:      // (both requests pass _findPending's read before either commits), so
376:      // _findPending's own enrichment never ran for the loser. The winner's
377:      // write is guaranteed committed by the time matchedCount is 0 (that's
378:      // the only way this filtered update can fail to match), so a plain
379:      // re-read here reliably sees it.
380:      if (body._needsEnrichment) {
381:        delete body._needsEnrichment;
382:        const fresh = await pendingCol().findOne({ _id: pending._id });
383:        Object.assign(body, _conflictBody(fresh));
384:      }
385:    }
386:    else throw err;
387:  } finally {
388:    await dbSession.endSession();
389:  }
390:
391:  res.status(statusCode).json(body);
392:});
