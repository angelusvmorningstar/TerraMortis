145:// POST /api/office_actions
146:// oaq.2: submits a Status Action for ST review — no longer applies it.
147:// Validates everything that can be validated up front (auth, live session,
148:// game phase, actor/target existence and court office, and the action's
149:// precondition against the target's CURRENT status.city) so an obviously-
150:// invalid request is rejected immediately rather than silently queued to
151:// fail later — but the precondition is re-checked, authoritatively, again
152:// at accept time (see PUT /:id/accept), since the target can change between
153:// submission and approval.
154:router.post('/', validate(officeActionSchema), async (req, res) => {
155:  const { actor_id, target_id, action_type } = req.body;
156:
157:  const callerCharIds = (req.user?.character_ids || []).map(String);
158:  if (!isStRole(req.user) && !callerCharIds.includes(String(actor_id)))
159:    return res.status(403).json({ error: 'FORBIDDEN', message: 'You may not act as this character' });
160:
161:  const session = await findLatestSession();
162:  if (!session)
163:    return res.status(403).json({ error: 'FORBIDDEN', message: 'No active game session found' });
164:  const game_session_id = String(session._id);
165:
166:  if (GATED_TYPES.has(action_type)) {
167:    const cycles = await getCollection('chapters').find().toArray();
168:    const liveCycle = currentCycleInGamePhase(cycles);
169:    if (!liveCycle)
170:      return res.status(403).json({ error: 'FORBIDDEN', message: 'No game session is currently in progress' });
171:  }
172:
173:  let actorObjectId, targetObjectId;
174:  try { actorObjectId = new ObjectId(actor_id); }
175:  catch { return res.status(400).json({ error: 'VALIDATION_ERROR', message: 'Invalid actor_id' }); }
176:  try { targetObjectId = new ObjectId(target_id); }
177:  catch { return res.status(400).json({ error: 'VALIDATION_ERROR', message: 'Invalid target_id' }); }
178:  if (actorObjectId.equals(targetObjectId))
179:    return res.status(400).json({ error: 'VALIDATION_ERROR', message: 'Cannot target yourself' });
180:
181:  const actor = await getCollection('characters').findOne({ _id: actorObjectId });
182:  if (!actor)
183:    return res.status(404).json({ error: 'NOT_FOUND', message: 'Actor not found' });
184:  if (!actor.court_category)
185:    return res.status(403).json({ error: 'FORBIDDEN', message: 'Actor holds no court office' });
186:
187:  const target = await getCollection('characters').findOne({ _id: targetObjectId });
188:  if (!target)
189:    return res.status(404).json({ error: 'NOT_FOUND', message: 'Target not found' });
190:
191:  const old_status = target.status?.city || 0;
192:  try {
193:    computeNewStatus(action_type, old_status);
194:  } catch (err) {
195:    if (err instanceof RouteResponse) return res.status(err.statusCode).json(err.body);
196:    throw err;
197:  }
198:
199:  // Product decision (2026-08-12): once a paid raise/lower on a
200:  // (actor, target) pair has been ACCEPTED this session, that same actor
201:  // cannot spend another budget slot on the same target again — a decline
202:  // is the only way to free up a retry, since a decline means nothing
203:  // actually happened. Checked here as a plain read: the pending-scoped
204:  // unique index below already makes the CONCURRENT-race case atomic (two
205:  // simultaneous submissions for the same actor+target can't both land as
206:  // pending), so by the time this check runs there is never a second
207:  // in-flight pending request to race against — only a real, already-
208:  // resolved history to consult. This also structurally closes an earlier
209:  // review finding: a second raise/lower could previously reach `accept`
210:  // and crash on a stale `office_actions` unique index built for the old
211:  // apply-immediately design; now it can never be submitted in the first
212:  // place.
213:  if (PAID_TYPES.has(action_type)) {
214:    const alreadyResolved = await pendingCol().findOne({
215:      request_type: 'status_action', game_session_id, actor_id, target_id,
216:      action_type: { $in: ['raise', 'lower'] }, status: 'resolved',
217:    });
218:    if (alreadyResolved)
219:      return res.status(409).json({ error: 'CONFLICT', message: 'You have already acted on this target this session' });
220:  }
221:
222:  const timestamp = new Date().toISOString();
223:  const doc = {
224:    request_type: 'status_action',
225:    status:       'pending',
226:    outcome:      null,
227:    game_session_id,
228:    actor_id,
229:    actor_name:  actor.moniker  || actor.name  || actor_id,
230:    target_id,
231:    target_name: target.moniker || target.name || target_id,
232:    action_type,
233:    created_at: timestamp,
234:    updated_at: timestamp,
235:  };
236:
237:  let inserted;
238:  try {
239:    inserted = await pendingCol().insertOne(doc);
240:  } catch (err) {
241:    if (err?.code === 11000)
242:      return res.status(409).json({ error: 'CONFLICT', message: 'A pending request already exists for this target' });
243:    throw err;
244:  }
245:
246:  res.status(201).json({ request: { ...doc, _id: inserted.insertedId } });
247:});
