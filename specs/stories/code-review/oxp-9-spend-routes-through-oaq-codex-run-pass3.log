34:import { Router } from 'express';
35:import { ObjectId } from 'mongodb';
36:import { getCollection, getClient } from '../db.js';
37:import { validate } from '../middleware/validate.js';
38:import { isStRole, requireRole } from '../middleware/auth.js';
39:import { officePurchaseRequestSchema } from '../schemas/office_purchase_request.schema.js';
40:import { resolveOfficeSeat } from '../lib/office-seat-resolve.js';
41:import { OFFICE_DATA, MERIT_DOT_CAPS } from '../../public/js/tabs/office-data.js';
42:import { officeSeatXp } from '../../public/js/data/office-xp.js';
43:
44:const router = Router();
45:const pendingCol   = () => getCollection('contested_roll_requests');
46:const seatsCol     = () => getCollection('office_seats');
47:const meritDotsCol = () => getCollection('office_merit_dots');
48:const manoeuvreCol = () => getCollection('office_manoeuvre_ranks');
49:
50:const REQUEST_TYPE = 'office_purchase';
51:
52:/**
53: * A deliberate business rejection thrown from inside a withTransaction()
54: * callback. Same class, same reasoning, as office-actions.js's own:
55: * withTransaction only retries errors MongoDB itself labels transient, so a
56: * plain thrown Error aborts the transaction and propagates straight out with
57: * no spurious retry.
58: */
59:class RouteResponse extends Error {
60:  constructor(statusCode, body) { super(body.message); this.statusCode = statusCode; this.body = body; }
61:}
62:
63:/**
64: * This route family's own lookup + pending guard, literal to
65: * `request_type: 'office_purchase'`.
66: *
67: * Deliberately NOT office-actions.js's `_findPending`: that one hardcodes
68: * `request_type: 'status_action'`, and gdx.12's own Dev Notes already ruled
69: * out generalising it — every discriminator in this shared collection owns its
70: * own copy, the same way contested-rolls.js's `_findChallenge` does.
71: */
72:async function _findPendingPurchase(req, res) {
73:  let oid;
74:  try { oid = new ObjectId(req.params.id); } catch {
75:    res.status(400).json({ error: 'VALIDATION_ERROR', message: 'Invalid ID format' });
76:    return null;
77:  }
78:  const doc = await pendingCol().findOne({ _id: oid, request_type: REQUEST_TYPE });
79:  if (!doc) { res.status(404).json({ error: 'NOT_FOUND' }); return null; }
80:  if (doc.status !== 'pending') {
81:    res.status(409).json(_conflictBody(doc));
82:    return null;
83:  }
84:  return doc;
85:}
86:
87:/** This route family's own enriched 409 body, mirroring office-actions.js's
88: *  `_conflictBody` in shape without importing it (same reasoning as
89: *  `_findPendingPurchase` above). */
90:function _conflictBody(doc) {
91:  const by = doc?.status === 'resolved' ? doc.resolved_by : doc?.status === 'declined' ? doc.declined_by : null;
92:  const message = by ? `Request is no longer pending, already ${doc.status} by ${by}` : 'Request is no longer pending';
93:  return { error: 'CONFLICT', message, resolved_by: doc?.resolved_by, declined_by: doc?.declined_by };
94:}
95:
96:/**
97: * Shared purchase-validity check, run at BOTH submission (a courtesy
98: * rejection) and accept (the real one, against freshly-read documents). The
99: * same submit-then-recheck shape office-actions.js uses for `computeNewStatus`
100: * — the ST's own steppers can move either value in between, so what was valid
101: * at submission is not necessarily valid at approval.
102: *
103: * Returns `{ from, to, cap }` on success. Throws RouteResponse(status, body)
104: * otherwise; the caller decides which status a stale-state rejection deserves
105: * (400 at submission, 409 at accept).
106: *
107: * @param {number} conflictStatus 400 at submission, 409 at accept
108: */
109:function checkPurchaseValidity(officeEntry, purchase_kind, merit, meritDotsDoc, manoeuvreRankDoc, conflictStatus) {
110:  if (purchase_kind === 'merit') {
111:    if (!Array.isArray(officeEntry.merits) || !officeEntry.merits.includes(merit))
112:      throw new RouteResponse(400, { error: 'VALIDATION_ERROR', message: 'That merit does not belong to this office' });
113:
114:    const cap = MERIT_DOT_CAPS[merit] || 5;
115:    const from = (meritDotsDoc && meritDotsDoc.dots && meritDotsDoc.dots[merit]) || 0;
116:    if (from >= cap)
117:      throw new RouteResponse(conflictStatus, {
118:        error: conflictStatus === 409 ? 'CONFLICT' : 'VALIDATION_ERROR',
119:        message: `${merit} is already at its cap of ${cap} dots`,
120:      });
121:    return { from, to: from + 1, cap };
122:  }
123:
124:  if (!Array.isArray(officeEntry.manoeuvres) || officeEntry.manoeuvres.length === 0)
125:    throw new RouteResponse(400, { error: 'VALIDATION_ERROR', message: 'This seat\'s office has no manoeuvres' });
126:
127:  const max = officeEntry.manoeuvres.length;
128:  const from = (manoeuvreRankDoc && manoeuvreRankDoc.rank) || 0;
129:  if (from >= max)
130:    throw new RouteResponse(conflictStatus, {
131:      error: conflictStatus === 409 ? 'CONFLICT' : 'VALIDATION_ERROR',
132:      message: `All ${max} manoeuvres are already purchased for this seat`,
133:    });
134:  return { from, to: from + 1, cap: max };
135:}
136:
137:/** ST, or a character the caller owns who currently holds this seat. A vacant
138: *  seat (`holder_id: null`) therefore has no holder who can submit, so it is
139: *  ST-only by construction — no special case needed.
140: *
141: *  `office_seats.holder_id` is the identity field here, NOT
142: *  `characters.court_category`: it is per-SEAT (two Primogen seats are
143: *  distinguishable, two court_category values are not) and it is what oxp.5's
144: *  handover route keeps current. */
145:function holderCharacterId(seat, user) {
146:  const holderId = seat.holder_id == null ? null : String(seat.holder_id);
147:  if (!holderId) return null;
148:  const callerCharIds = (user?.character_ids || []).map(String);
149:  return callerCharIds.includes(holderId) ? holderId : null;
150:}
