154:// POST /api/office_purchase_requests
155:// The holder (or an ST on their behalf) submits ONE purchase for ST review.
156:// Nothing is spent and nothing is written to either purchase collection here.
157:router.post('/', validate(officePurchaseRequestSchema), async (req, res) => {
158:  const { seat_id, purchase_kind } = req.body;
159:  const merit = req.body.merit;
160:
161:  // Resolved first, so its existing 400/404/400 bodies pass straight through —
162:  // which is what preserves the Administrator refusal (no OFFICE_DATA entry
163:  // until oxp.8) with the message that route family already returns.
164:  const resolved = await resolveOfficeSeat(seat_id);
165:  if (resolved.error) return res.status(resolved.error.status).json(resolved.error.body);
166:  const { seatId, seat, category, officeEntry } = resolved;
167:
168:  const requesterId = holderCharacterId(seat, req.user);
169:  if (!isStRole(req.user) && !requesterId)
170:    return res.status(403).json({ error: 'FORBIDDEN', message: 'You do not hold this office seat' });
171:
172:  // A merit name is required for a merit purchase and refused for a manoeuvre
173:  // one. `null` counts as absent (the schema allows it) so a client that
174:  // always sends the key is not punished for it.
175:  if (purchase_kind === 'merit') {
176:    if (typeof merit !== 'string' || merit.trim() === '')
177:      return res.status(400).json({ error: 'VALIDATION_ERROR', message: 'A merit name is required for a merit purchase' });
178:  } else if (merit != null) {
179:    return res.status(400).json({ error: 'VALIDATION_ERROR', message: 'A merit must not be supplied for a manoeuvre purchase' });
180:  }
181:
182:  const meritDotsDoc     = await meritDotsCol().findOne({ _id: seatId });
183:  const manoeuvreRankDoc = await manoeuvreCol().findOne({ _id: seatId });
184:
185:  try {
186:    checkPurchaseValidity(officeEntry, purchase_kind, merit, meritDotsDoc, manoeuvreRankDoc, 400);
187:  } catch (err) {
188:    if (err instanceof RouteResponse) return res.status(err.statusCode).json(err.body);
189:    throw err;
190:  }
191:
192:  // Courtesy affordability pre-check. NOT the authoritative one (that is the
193:  // accept route's, against documents re-read inside its transaction) — this
194:  // only keeps an obviously unaffordable request out of the ST's queue.
195:  const allSeats = await seatsCol().find({}).toArray();
196:  const balance = officeSeatXp(seat, allSeats, meritDotsDoc, manoeuvreRankDoc, new Date());
197:  if (balance.left < 1)
198:    return res.status(403).json({
199:      error: 'FORBIDDEN',
200:      message: `Not enough office XP (${1 - balance.left} short)`,
201:    });
202:
203:  // One in-flight request per SEAT, regardless of kind or merit. That is what
204:  // keeps the accept-time budget check from being defeated by queueing five
205:  // requests against one point of XP. A plain findOne pre-check is enough:
206:  // this is one holder tapping their own button, not a multi-actor budget
207:  // race, and the accept route's own re-check is the real guard either way
208:  // (the same reasoning gdx.12's AC2 recorded — no unique index here).
209:  const existing = await pendingCol().findOne({ request_type: REQUEST_TYPE, seat_id: seatId, status: 'pending' });
210:  if (existing)
211:    return res.status(409).json({ error: 'CONFLICT', message: 'A purchase request is already pending for this seat' });
212:
213:  let requesterName = null;
214:  if (requesterId) {
215:    let requesterOid = null;
216:    try { requesterOid = new ObjectId(requesterId); } catch { requesterOid = null; }
217:    const character = requesterOid ? await getCollection('characters').findOne({ _id: requesterOid }) : null;
218:    requesterName = character ? (character.moniker || character.name || requesterId) : requesterId;
219:  }
220:
221:  const timestamp = new Date().toISOString();
222:  const doc = {
223:    request_type: REQUEST_TYPE,
224:    status:       'pending',
225:    outcome:      null,
226:    // The NORMALISED (lower-case) seat id resolveOfficeSeat returned. That is
227:    // the document key on both purchase collections; storing the raw request
228:    // form instead would let a later accept mint a second purchase document
229:    // for the same seat.
230:    seat_id:    seatId,
231:    // Denormalised for display only, never authoritative — the same posture
232:    // `office_category` already has on both purchase collections.
233:    office_category: category,
234:    seat_label: seat.seat_label ?? null,
235:    purchase_kind,
236:    merit: purchase_kind === 'merit' ? merit : null,
237:    // Null when an ST submits on a seat none of their own characters hold.
238:    // The accept route's requester-still-holds-seat re-check is skipped in
239:    // that case, deliberately: there is no requester to have lost the seat.
240:    requested_by_character_id:   requesterId,
241:    requested_by_character_name: requesterName,
242:    created_at: timestamp,
243:    updated_at: timestamp,
244:  };
245:
246:  const result  = await pendingCol().insertOne(doc);
247:  const created = await pendingCol().findOne({ _id: result.insertedId });
248:  res.status(201).json(created);
249:});
