45:// oaq.2: shared action-type precondition check, used at BOTH submission
46:// time (a courtesy rejection of an obviously-invalid request) and accept
47:// time (the real, authoritative check — against whatever status.city is
48:// AT APPROVAL, not whatever it was when the request was submitted; the
49:// target can legitimately change in between via another accepted action).
50:// Throws RouteResponse(400, ...) on an invalid transition; otherwise
51:// returns the new_status value.
52:function computeNewStatus(action_type, old_status) {
53:  if (action_type === 'grant_first') {
54:    if (old_status !== 0)
55:      throw new RouteResponse(400, { error: 'VALIDATION_ERROR', message: 'Target already has City Status' });
56:    return 1;
57:  }
58:  if (action_type === 'raise') {
59:    if (old_status >= 10)
60:      throw new RouteResponse(400, { error: 'VALIDATION_ERROR', message: 'Target is at max City Status' });
61:    return old_status + 1;
62:  }
63:  if (action_type === 'lower') {
64:    if (old_status <= 1)
65:      throw new RouteResponse(400, { error: 'VALIDATION_ERROR', message: 'Use strip_last to remove the final dot' });
66:    return old_status - 1;
67:  }
68:  if (action_type === 'strip_last') {
69:    if (old_status !== 1)
70:      throw new RouteResponse(400, { error: 'VALIDATION_ERROR', message: 'Target must be at exactly 1 City Status' });
71:    return 0;
72:  }
73:  throw new RouteResponse(400, { error: 'VALIDATION_ERROR', message: 'Unknown action_type' });
74:}
