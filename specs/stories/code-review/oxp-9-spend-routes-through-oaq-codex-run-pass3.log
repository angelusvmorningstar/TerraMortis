31:async function findLatestSession() {
32:  const today = new Date().toISOString().slice(0, 10);
33:  return getCollection('game_sessions').findOne(
34:    { session_date: { $lte: today } },
35:    // oaq.2 review finding: a secondary sort on _id (insertion order) makes
36:    // ties on session_date deterministic — two game_sessions docs sharing a
37:    // date previously resolved to whichever the query happened to return
38:    // first (implementation-defined, not guaranteed stable), which surfaced
39:    // as genuine cross-file test flakiness once multiple test files started
40:    // seeding same-date sessions in the same shared tm_suite_test run.
41:    { sort: { session_date: -1, _id: -1 }, projection: { _id: 1, title: 1, session_date: 1, game_number: 1 } },
42:  );
