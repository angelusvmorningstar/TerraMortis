1:/**
2: * JSON Schema for the POST body of /api/office_purchase_requests (oxp.9).
3: *
4: * Mirrors humanity_check_request.schema.js's shape: a REQUEST-BODY schema for
5: * one route, not a document schema for the whole `contested_roll_requests`
6: * collection (which carries four discriminated shapes side by side and has no
7: * MongoDB collection-level $jsonSchema validator — re-verified by grep at
8: * oxp.9 dev time, as gdx.12 verified it before that).
9: *
10: * THE `title` IS LOAD-BEARING, NOT DECORATION. server/middleware/validate.js
11: * caches compiled Ajv validators keyed by `schema.title`, so a title-less
12: * schema compiles under cache key `undefined` and silently collides with
13: * `office_action.schema.js` (still title-less). gdx.12 lost real debugging
14: * time to exactly that — every POST to its new route was validated against
15: * officeActionSchema instead, surfacing as an unexplained 400 on a
16: * schema-valid payload. Do not remove it, and do not add a title-less schema
17: * to this directory.
18: */
19:export const officePurchaseRequestSchema = {
20:  title: 'TM Office Purchase Request',
21:  type: 'object',
22:  required: ['seat_id', 'purchase_kind'],
23:  additionalProperties: false,
24:  properties: {
25:    // The office SEAT the purchase is against (`office_seats._id` as 24-hex).
26:    // Case-insensitive here; resolveOfficeSeat normalises it to lower case,
27:    // and the NORMALISED form is what gets stored on the pending record, so a
28:    // later accept cannot mint a second purchase document for the same seat.
29:    seat_id: { type: 'string', pattern: '^[0-9a-fA-F]{24}$' },
30:
31:    // One request buys exactly one dot: one merit dot, or the next manoeuvre
32:    // rank. Batch purchases are deliberately out of scope — one dot per
33:    // request is what makes the accept-time budget check a single,
34:    // unambiguous `left >= 1` question.
35:    purchase_kind: { type: 'string', enum: ['merit', 'manoeuvre'] },
36:
37:    // Optional at the schema layer, conditionally required at the route:
38:    // required when purchase_kind === 'merit', rejected (400) when supplied
39:    // for a manoeuvre request. Ajv's `if`/`then` could express that, but the
40:    // route already owns every other purchase-validity rule (the merit must
41:    // belong to THIS office, and be below ITS cap) and splitting one rule
42:    // across two layers is how the two drift.
43:    merit: { type: ['string', 'null'] },
44:  },
45:};
===== server/routes/office-purchase.js =====
1:/**
2: * oxp.9 — office XP spend, routed through Epic OAQ's ST Approval Queue.
3: *
4: * The holder of a Court Position seat requests ONE purchase from their
5: * office's own XP pool (one merit dot, or the next manoeuvre rank). The
6: * request lands in `contested_roll_requests` as a fourth discriminated shape,
7: * `request_type: 'office_purchase'`, alongside `contested_roll` (crd.1),
8: * `status_action` (oaq.2) and `humanity_check` (gdx.12). gdx.12 is the
9: * precedent this file follows line for line: its own schema, its own route
10: * file, its own accept/decline, and ONE widened `$in` in office-actions.js's
11: * shared `GET /pending` rather than a second GET endpoint.
12: *
13: * TWO THINGS THIS FILE IS THE ONLY PLACE FOR, AND ONE IT IS NOT:
14: *
15: *   - The purchase WRITE happens only on ST accept. Nothing is written to
16: *     `office_merit_dots` / `office_manoeuvre_ranks` at submission time, and a
17: *     decline writes nothing at all — the same "budget spends on approval,
18: *     never on submission" decision oaq.2 recorded for Status Actions.
19: *   - The BUDGET CHECK (`officeSeatXp().left >= 1`) is authoritative only in
20: *     the accept route, against documents re-read inside the same transaction.
21: *     POST carries a courtesy copy of the same rule so an obviously
22: *     unaffordable request never reaches the ST's queue, exactly as
23: *     office-actions.js re-checks `computeNewStatus` at both ends.
24: *   - It is NOT a gate on the existing ST-only PUT routes
25: *     (`office-merit-dots.js`, `office-manoeuvre-rank.js`). Those stay direct
26: *     ST-set state with no budget check, and `officeSeatXp().left` is still
27: *     allowed to go negative, BY DESIGN: the down-steppers are a correction
28: *     path with no approval to give, STs still need to seed historical
29: *     purchase state that predates this economy, and office-tab.js's
30: *     "N over budget" line only works because a negative `left` is
31: *     representable. An ST setting state directly IS an ST-approved action.
32: */
