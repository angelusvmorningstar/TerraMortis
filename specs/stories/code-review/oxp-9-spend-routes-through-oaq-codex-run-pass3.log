90:// oaq.2: shared lookup + pending-guard for the accept/decline routes,
91:// mirroring contested-rolls.js's own _findChallenge shape (AC8's race
92:// guard: reject 409 if the record is no longer pending by the time a
93:// mutating route reaches it).
94:async function _findPending(req, res) {
95:  let oid;
96:  try { oid = new ObjectId(req.params.id); }
97:  catch { res.status(400).json({ error: 'VALIDATION_ERROR', message: 'Invalid ID format' }); return null; }
98:  const doc = await pendingCol().findOne({ _id: oid, request_type: 'status_action' });
99:  if (!doc) { res.status(404).json({ error: 'NOT_FOUND' }); return null; }
100:  if (doc.status !== 'pending') {
101:    res.status(409).json(_conflictBody(doc));
102:    return null;
103:  }
104:  return doc;
105:}
