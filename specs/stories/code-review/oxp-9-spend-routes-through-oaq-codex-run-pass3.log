76:// oaq.3: builds the enriched 409 body (names who already resolved/declined a
77:// no-longer-pending record) from a freshly-read document. Shared by
78:// _findPending's own check AND by the inner concurrent-race branches inside
79:// accept/decline's transactions — a true simultaneous accept-vs-accept (or
80:// accept-vs-decline) race passes _findPending's initial read before either
81:// side has committed, so that check alone doesn't cover it; the loser's own
82:// matchedCount===0 branch re-reads the document to enrich its 409 the same
83:// way, closing the gap for the actual concurrent case (review finding).
84:function _conflictBody(doc) {
85:  const by = doc?.status === 'resolved' ? doc.resolved_by : doc?.status === 'declined' ? doc.declined_by : null;
86:  const message = by ? `Request is no longer pending — already ${doc.status} by ${by}` : 'Request is no longer pending';
87:  return { error: 'CONFLICT', message, resolved_by: doc?.resolved_by, declined_by: doc?.declined_by };
88:}
