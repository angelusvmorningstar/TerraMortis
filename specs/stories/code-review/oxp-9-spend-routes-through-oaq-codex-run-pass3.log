394:// PUT /api/office_actions/:id/decline
395:// oaq.2: ST-only. Marks the record declined. No character mutation, no
396:// budget claim (nothing was ever spent by a submission), no office_actions
397:// log entry (nothing happened).
398:router.put('/:id/decline', requireRole('st'), async (req, res) => {
399:  const pending = await _findPending(req, res);
400:  if (!pending) return;
401:
402:  const timestamp = new Date().toISOString();
403:  const declined_by = req.user.username;
404:  const result = await pendingCol().updateOne(
405:    { _id: pending._id, status: 'pending' },
406:    { $set: { status: 'declined', declined_by, updated_at: timestamp } },
407:  );
408:  if (!result.matchedCount) {
409:    // review finding: true concurrent race with another accept/decline —
410:    // _findPending's own enrichment already ran before this update was
411:    // attempted, so re-read fresh to name whoever actually won.
412:    const fresh = await pendingCol().findOne({ _id: pending._id });
413:    return res.status(409).json(_conflictBody(fresh));
414:  }
415:
416:  res.json({ declined: true, declined_by });
417:});
