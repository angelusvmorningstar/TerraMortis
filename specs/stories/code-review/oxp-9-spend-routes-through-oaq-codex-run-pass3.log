251:// GET /api/office_purchase_requests?seat_id=<24-hex>
252:// The pending request(s) for ONE seat, so the Office tab can show "awaiting ST
253:// approval" after a reload instead of offering a button that would 409.
254:router.get('/', async (req, res) => {
255:  const seat_id = req.query.seat_id;
256:  // `typeof === 'string'` is the guard that matters, not truthiness: a
257:  // repeated query key (?seat_id=a&seat_id=b) arrives as an ARRAY under
258:  // Express 5's default 'simple' query parser, and that is the genuinely
259:  // reachable non-string vector here. Bracket-notation injection is not — see
260:  // the project-express5-query-parser memory and gdx.12's own review finding,
261:  // which named the wrong vector before it was checked empirically.
262:  if (typeof seat_id !== 'string')
263:    return res.status(400).json({ error: 'VALIDATION_ERROR', message: 'seat_id is required' });
264:
265:  const resolved = await resolveOfficeSeat(seat_id);
266:  if (resolved.error) return res.status(resolved.error.status).json(resolved.error.body);
267:  const { seatId, seat } = resolved;
268:
269:  if (!isStRole(req.user) && !holderCharacterId(seat, req.user))
270:    return res.status(403).json({ error: 'FORBIDDEN', message: 'You do not hold this office seat' });
271:
272:  const docs = await pendingCol()
273:    .find({ request_type: REQUEST_TYPE, seat_id: seatId, status: 'pending' })
274:    .sort({ created_at: 1 })
275:    .toArray();
276:  res.json(docs);
277:});
