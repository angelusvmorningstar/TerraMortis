114:/**
115: * Total XP a seat has EARNED since it was created (AC2).
116: *
117: * Reads `created_at` and nothing else. It deliberately does not look at
118: * `holder_id`: a vacant seat accrues exactly as a filled one does, because the
119: * pool belongs to the office. "A long-dormant office is a prize" in the
120: * ruling's own words — whoever is appointed to it inherits every point banked
121: * since creation.
122: *
123: * @param {{ created_at: string }} seat - one `office_seats` document
124: * @param {string|Date} now - caller-supplied evaluation date
125: * @returns {number}
126: */
127:export function officeXpEarned(seat, now) {
128:  return officeMonthsAccrued(seat.created_at, now) * OFFICE_XP_PER_MONTH;
129:}
