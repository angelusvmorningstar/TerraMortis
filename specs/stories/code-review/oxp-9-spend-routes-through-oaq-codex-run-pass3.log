===== server/routes/contested-rolls.js =====
1:import { Router } from 'express';
2:import { ObjectId } from 'mongodb';
3:import { getCollection } from '../db.js';
4:import { validate } from '../middleware/validate.js';
5:import { requireRole } from '../middleware/auth.js';
6:import { contestedRollRequestSchema } from '../schemas/contested_roll_request.schema.js';
7:import { calcEffectiveCityStatus } from '../../public/js/data/city-status-calc.js';
8:import { findRegentTerritory } from '../../public/js/data/helpers.js';
9:import { currentCycleInGamePhase } from '../../public/js/downtime/cycle-phase.js';
10:
11:const router = Router();
12:const col     = () => getCollection('contested_roll_requests');
13:const logCol  = () => getCollection('session_logs');
14:
15:// POST /api/contested_roll_requests — player creates a challenge
16:router.post('/', validate(contestedRollRequestSchema), async (req, res) => {
17:  const { challenger_character_id } = req.body;
18:
19:  // Challenger must own the character they're challenging as
20:  const charIds = (req.user.character_ids || []).map(id => String(id));
21:  if (!charIds.includes(challenger_character_id)) {
22:    return res.status(403).json({ error: 'FORBIDDEN', message: 'Character does not belong to you' });
23:  }
24:
25:  // crd.1: request_type is set explicitly, AFTER the req.body spread, so the
26:  // route is always the authority on it. Before this story a plain contested
27:  // roll carried NO request_type at all, and every guard against Status
28:  // Actions sharing this collection worked only because absence happens to
29:  // satisfy `$ne: 'status_action'` — the same implicit-discriminator
30:  // fragility that produced the oaq.3 void-orphaning bug (see PUT /:id/void).
31:  const doc = {
32:    ...req.body,
33:    request_type: 'contested_roll',
34:    status:     'pending',
35:    outcome:    null,
36:    created_at: new Date().toISOString(),
37:    updated_at: new Date().toISOString(),
38:  };
39:
40:  // crd.1 (external code review). `defender_aspect`, `defender_wp_spent` and
41:  // `defender_merit_ids` are the DEFENDER's own submitted resolution choices —
42:  // AC3's literal rule is that they "only ever get populated later, by crd.3a,
43:  // not by this story or by POST /". The `...req.body` spread above let the
44:  // ATTACKER assert all three at creation, which is the same injury as the
45:  // attacker-writable `defender_pool` this whole epic exists to remove: an
46:  // attacker-authored value would sit in stored pending data looking like the
47:  // defender's own choice. Stripped AFTER the spread, the same way
48:  // `request_type` is force-set after it, so the route is always the authority.
49:  // The schema still LISTS them (additionalProperties: false, and crd.3a's
50:  // resolve endpoint writes them) — they are simply never honoured here.
51:  // crd.4a review (external Codex, Pass 2): defender_status_term is the same
52:  // shape of defender-owned field and was missed from this list when the
53:  // schema grew it — an attacker could otherwise pre-populate a bogus
54:  // "defender's choice" into a pending document before the defender ever
55:  // acts. /resolve still overwrites it before any pool is finalised, so this
56:  // could not change a final roll's outcome, but it violated the same
57:  // provenance boundary the other three fields exist to protect.
58:  for (const f of ['defender_aspect', 'defender_wp_spent', 'defender_merit_ids', 'defender_status_term']) delete doc[f];
59:
60:  const result  = await col().insertOne(doc);
61:  const created = await col().findOne({ _id: result.insertedId });
62:  res.status(201).json(created);
63:});
