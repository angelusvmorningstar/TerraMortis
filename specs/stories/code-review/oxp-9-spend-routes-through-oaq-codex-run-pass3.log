423:// PUT /api/office_purchase_requests/:id/decline
424:// ST-only. A pure state change: nothing was written to either purchase
425:// collection on submission, so there is nothing to unwind and no XP to refund.
426:router.put('/:id/decline', requireRole('st'), async (req, res) => {
427:  const pending = await _findPendingPurchase(req, res);
428:  if (!pending) return;
429:
430:  const timestamp = new Date().toISOString();
431:  const declined_by = req.user.username;
432:  const result = await pendingCol().updateOne(
433:    { _id: pending._id, request_type: REQUEST_TYPE, status: 'pending' },
434:    { $set: { status: 'declined', declined_by, updated_at: timestamp } },
435:  );
436:  if (!result.matchedCount) {
437:    const fresh = await pendingCol().findOne({ _id: pending._id });
438:    return res.status(409).json(_conflictBody(fresh));
439:  }
440:
441:  res.json({ declined: true, declined_by });
442:});
