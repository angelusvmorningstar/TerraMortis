471:async function _findChallenge(req, res) {
472:  let oid;
473:  try { oid = new ObjectId(req.params.id); } catch {
474:    res.status(400).json({ error: 'VALIDATION_ERROR', message: 'Invalid ID format' });
475:    return null;
476:  }
477:  // oaq.2 review finding: exclude status_action requests — they have their
478:  // own lifecycle (office-actions.js's accept/decline), and a status_action
479:  // doc has no challenger/target_character_id fields for the caller-
480:  // ownership check below to compare against anyway. gdx.12: same exclusion
481:  // for humanity_check requests (humanity-check.js's own lifecycle; a
482:  // humanity_check doc has no challenger/target_character_id fields either).
483:  // oxp.9: same exclusion for office_purchase requests (office-purchase.js's
484:  // own lifecycle; an office_purchase doc has none of those fields either).
485:  const doc = await col().findOne({ _id: oid, request_type: { $nin: ['status_action', 'humanity_check', 'office_purchase'] } });
486:  if (!doc) { res.status(404).json({ error: 'NOT_FOUND' }); return null; }
487:  if (doc.status !== 'pending') {
488:    res.status(409).json({ error: 'CONFLICT', message: 'Challenge is no longer pending' });
489:    return null;
490:  }
491:  return doc;
492:}
493:
494:function d10() { return Math.floor(Math.random() * 10) + 1; }
495:
496:function _roll(n) {
497:  const cols = [];
498:  for (let i = 0; i < Math.max(0, n); i++) {
499:    const v = d10();
500:    const r = { v, s: v >= 8, x: v === 10 };
501:    const ch = [];
502:    let last = r;
503:    while (last.x) { const cv = d10(); last = { v: cv, s: cv >= 8, x: cv === 10 }; ch.push(last); }
504:    cols.push({ r, ch });
505:  }
506:  return cols;
507:}
508:
509:function _countSuc(cols) {
510:  let s = 0;
511:  for (const col of cols) {
512:    if (col.r.s) s++;
513:    for (const d of col.ch) if (d.s) s++;
514:  }
515:  return s;
516:}
517:
518:export default router;

