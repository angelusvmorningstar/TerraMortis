279:// PUT /api/office_purchase_requests/:id/accept
280:// ST-only, and the ONLY place in oxp.9 where a purchase is written.
281://
282:// Runs inside a single MongoDB transaction because this route makes TWO writes
283:// (claim the pending record, apply the purchase) and a failure between them
284:// would otherwise leave an approved-but-unapplied purchase with no way to
285:// detect it. Reads come first (they are not writes, and office-actions.js's
286:// own accept reads actor/target before claiming); the CLAIM is still the first
287:// write, which is the ordering office-actions.js adopted after a real
288:// concurrent-accept race reached its later writes on both sides. The loser
289:// must never reach the purchase write.
290:router.put('/:id/accept', requireRole('st'), async (req, res) => {
291:  const pending = await _findPendingPurchase(req, res);
292:  if (!pending) return;
293:
294:  const client = getClient();
295:  const dbSession = client.startSession();
296:  let statusCode, body;
297:  try {
298:    await dbSession.withTransaction(async () => {
299:      const seatId = pending.seat_id;
300:      let seatOid;
301:      try { seatOid = new ObjectId(seatId); }
302:      catch { throw new RouteResponse(400, { error: 'VALIDATION_ERROR', message: 'Invalid seat_id on request' }); }
303:
304:      // Re-read LIVE, inside the transaction. Everything below is judged
305:      // against current state, never against whatever was true at submission.
306:      const seat = await seatsCol().findOne({ _id: seatOid }, { session: dbSession });
307:      if (!seat) throw new RouteResponse(404, { error: 'NOT_FOUND', message: 'Office seat no longer exists' });
308:
309:      const officeEntry = OFFICE_DATA[seat.office_category];
310:      if (!officeEntry)
311:        throw new RouteResponse(400, {
312:          error: 'VALIDATION_ERROR',
313:          message: `This seat's office ('${seat.office_category}') has no rules entry yet`,
314:        });
315:
316:      // officeSeatXp needs EVERY seat to establish spendKnown for this seat's
317:      // category. This story never reads spendKnown, only earned/spent/left,
318:      // but the function still has to be called correctly.
319:      const allSeats         = await seatsCol().find({}, { session: dbSession }).toArray();
320:      const meritDotsDoc     = await meritDotsCol().findOne({ _id: seatId }, { session: dbSession });
321:      const manoeuvreRankDoc = await manoeuvreCol().findOne({ _id: seatId }, { session: dbSession });
322:
323:      // A 409, not a 400: the ST's own stepper moving the same value since
324:      // submission is a conflict with current state, not a malformed request.
325:      const { from, to } = checkPurchaseValidity(
326:        officeEntry, pending.purchase_kind, pending.merit, meritDotsDoc, manoeuvreRankDoc, 409,
327:      );
328:
329:      // Losing the seat between submission and approval is a real, narrow case
330:      // that must not silently apply — the same reasoning office-actions.js
331:      // re-checks the actor's own court_category at accept. Skipped when the
332:      // request was submitted by an ST (no requester to have lost anything).
333:      if (pending.requested_by_character_id) {
334:        const holderId = seat.holder_id == null ? null : String(seat.holder_id);
335:        if (holderId !== String(pending.requested_by_character_id))
336:          throw new RouteResponse(403, {
337:            error: 'FORBIDDEN',
338:            message: 'The requester no longer holds this seat',
339:          });
340:      }
341:
342:      // THE authoritative budget check. The only enforcement point in oxp.9.
343:      const balance = officeSeatXp(seat, allSeats, meritDotsDoc, manoeuvreRankDoc, new Date());
344:      if (balance.left < 1)
345:        throw new RouteResponse(403, {
346:          error: 'FORBIDDEN',
347:          message: `Not enough office XP (${1 - balance.left} short)`,
348:        });
349:
350:      const timestamp = new Date().toISOString();
351:      const resolved_by = req.user.username;
352:      const outcome = {
353:        purchase_kind: pending.purchase_kind,
354:        merit:         pending.merit ?? null,
355:        from,
356:        to,
357:        xp_cost:       1,
358:        earned:        balance.earned,
359:        spent_before:  balance.spent,
360:        left_after:    balance.left - 1,
361:      };
362:
363:      // CLAIM FIRST — before the purchase write below. A true concurrent
364:      // accept race passes _findPendingPurchase's read on both sides; the
365:      // loser's own filtered update legitimately matches 0 documents once the
366:      // winner has committed, and is rejected here rather than applying a
367:      // second dot.
368:      const claim = await pendingCol().updateOne(
369:        { _id: pending._id, status: 'pending' },
370:        { $set: { status: 'resolved', outcome, resolved_by, updated_at: timestamp } },
371:        { session: dbSession },
372:      );
373:      if (claim.matchedCount === 0)
374:        throw new RouteResponse(409, { error: 'CONFLICT', message: 'Request is no longer pending', _needsEnrichment: true });
375:
376:      if (pending.purchase_kind === 'merit') {
377:        // The same document shape, cap validation and self-healing
378:        // denormalised office_category write office-merit-dots.js already
379:        // performs on its own PUT.
380:        await meritDotsCol().updateOne(
381:          { _id: seatId },
382:          { $set: { [`dots.${pending.merit}`]: to, office_category: seat.office_category, updated_at: timestamp } },
383:          { session: dbSession, upsert: true },
384:        );
385:      } else {
386:        // The SAME clamped aggregation-pipeline update office-manoeuvre-rank
387:        // .js's /step route uses, not a read-then-write of `rank + 1`. The
388:        // pipeline form exists precisely because the read-then-write form
389:        // silently lost overlapping steps (Codex review, oxp.3). $ifNull makes
390:        // the upsert path behave identically to an existing document, and
391:        // $literal states that the category is a value, not a field path.
392:        const max = officeEntry.manoeuvres.length;
393:        await manoeuvreCol().updateOne(
394:          { _id: seatId },
395:          [
396:            { $set: { rank: { $min: [max, { $max: [0, { $add: [{ $ifNull: ['$rank', 0] }, 1] }] }] } } },
397:            { $set: { office_category: { $literal: seat.office_category }, updated_at: timestamp } },
398:          ],
399:          { session: dbSession, upsert: true },
400:        );
401:      }
402:
403:      statusCode = 200;
404:      body = { ...pending, status: 'resolved', outcome, resolved_by, updated_at: timestamp };
405:    });
406:  } catch (err) {
407:    if (err instanceof RouteResponse) {
408:      statusCode = err.statusCode;
409:      body = err.body;
410:      if (body._needsEnrichment) {
411:        delete body._needsEnrichment;
412:        const fresh = await pendingCol().findOne({ _id: pending._id });
413:        Object.assign(body, _conflictBody(fresh));
414:      }
415:    } else throw err;
416:  } finally {
417:    await dbSession.endSession();
418:  }
419:
420:  res.status(statusCode).json(body);
421:});
