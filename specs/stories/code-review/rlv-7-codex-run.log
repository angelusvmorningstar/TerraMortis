+const { chromium } = require('playwright');
+
+(async () => {
+  const browser = await chromium.launch({ headless: true });
+  const context = await browser.newContext({ serviceWorkers: 'block' });
+  const page = await context.newPage();
+  await page.addInitScript(() => {
+    const user = { id: 'audit', role: 'st', player_id: 'audit-player', character_ids: [] };
+    localStorage.setItem('tm_auth_token', 'local-test-token');
+    localStorage.setItem('tm_auth_expires', String(Date.now() + 3600000));
+    localStorage.setItem('tm_auth_user', JSON.stringify(user));
+  });
+  await page.route('**/api/**', route => route.fulfill({ status: 200, contentType: 'application/json', body: '[]' }));
+  await page.goto('http://127.0.0.1:8080/');
+  await page.waitForSelector('#app', { state: 'visible', timeout: 15000 });
+  const attrs = {
+    Intelligence: { dots: 3, bonus: 0 }, Wits: { dots: 2, bonus: 0 }, Resolve: { dots: 2, bonus: 0 },
+    Strength: { dots: 3, bonus: 0 }, Dexterity: { dots: 3, bonus: 0 }, Stamina: { dots: 2, bonus: 0 },
+    Presence: { dots: 2, bonus: 0 }, Manipulation: { dots: 2, bonus: 0 }, Composure: { dots: 2, bonus: 0 },
+  };
+  const makeChar = (id, name) => ({
+    _id: id, name, attributes: attrs,
+    skills: { Occult: { dots: 3, bonus: 0, specs: [] }, Brawl: { dots: 2, bonus: 0, specs: [] } },
+    disciplines: {}, merits: [], powers: [], equipment: [], status: { city: 0, clan: 0, covenant: {} },
+  });
+  const a = makeChar('aaaaaaaaaaaaaaaaaaaaaaaa', 'Alpha Audit');
+  const b = makeChar('bbbbbbbbbbbbbbbbbbbbbbbb', 'Beta Audit');
+
+  await page.evaluate(({ a }) => {
+    window.goTab('roll');
+    window.pickChar(a);
+    window.loadPool(6, 'Occult', { total: 6, attr: 'Intelligence', attrV: 3, skill: 'Occult', skillV: 3 });
+    window.addPowerChip('Audit Bonus', 2);
+  }, { a });
+  const beforeSwitch = await page.evaluate(() => ({
+    effective: document.getElementById('rv2-eff').textContent,
+    chipCount: document.querySelectorAll('#effline [data-chip]').length,
+    buttonDisabled: document.querySelector('.rv2-addmod-btn').disabled,
+    deleteMargin: getComputedStyle(document.querySelector('.effpool-spec-del')).marginLeft,
+  }));
+  await page.evaluate(({ b }) => window.pickChar(b), { b });
+  const afterSwitch = await page.evaluate(() => ({
+    effective: document.getElementById('rv2-eff').textContent,
+    chipCount: document.querySelectorAll('#effline [data-chip]').length,
+    buttonDisabled: document.querySelector('.rv2-addmod-btn').disabled,
+    bannerVisible: document.getElementById('pool-banner').classList.contains('on'),
+  }));
+  await page.locator('#effline [data-chip]').click({ position: { x: 8, y: 8 } });
+  const afterStaleClick = await page.evaluate(() => ({
+    effective: document.getElementById('rv2-eff').textContent,
+    chipCount: document.querySelectorAll('#effline [data-chip]').length,
+  }));
+
+  await page.evaluate(({ b }) => {
+    window.pickChar(b);
+    window.loadPool(5, 'Brawl', { total: 5, attr: 'Strength', attrV: 3, skill: 'Brawl', skillV: 2 });
+    window.addPowerChip('Combat Bonus', 2);
+    window.loadPool(5, 'Brawl', { total: 5 });
+  }, { b });
+  const attrlessReload = await page.evaluate(() => ({
+    effective: document.getElementById('rv2-eff').textContent,
+    chipCount: document.querySelectorAll('#effline [data-chip]').length,
+    efflineText: document.getElementById('effline').textContent,
+    buttonDisabled: document.querySelector('.rv2-addmod-btn').disabled,
+  }));
+
+  console.log(JSON.stringify({ beforeSwitch, afterSwitch, afterStaleClick, attrlessReload }, null, 2));
+  await browser.close();
+})().catch(err => { console.error(err); process.exitCode = 1; });
