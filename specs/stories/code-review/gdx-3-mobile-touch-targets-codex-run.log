 .pref-dot {
   display: inline-flex;
   align-items: center;
   justify-content: center;
-  width: 38px;
-  height: 38px;
+  margin: calc((38px - var(--tap-min)) / 2);
+  width: var(--tap-min);
+  height: var(--tap-min);
   font-size:1.875rem;
   line-height: 1;
   cursor: pointer;
