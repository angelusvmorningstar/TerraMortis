public/css/suite.css-340-.panel-hdr{display:flex;align-items:center;justify-content:space-between;padding:16px 16px 10px;border-bottom:1px solid var(--bdr);}
public/css/suite.css-341-.panel-title{font-family:var(--fl);font-size:var(--fs-floor-micro);letter-spacing:.12em;text-transform:uppercase;color:var(--gold);}
public/css/suite.css-342-.panel-close{background:none;border:none;color:var(--txt3);font-family:var(--fl);font-size:var(--fs-floor-body);letter-spacing:.08em;cursor:pointer;padding:8px 12px;-webkit-tap-highlight-color:transparent;}
public/css/suite.css-343-.panel-body{overflow-y:auto;flex:1;padding:8px 0 24px;}
public/css/suite.css:344:.panel-section{font-family:var(--fl);font-size:var(--fs-floor-micro);letter-spacing:.18em;text-transform:uppercase;color:var(--gdim);padding:12px 16px 4px;}
public/css/suite.css-345-.panel-item{display:flex;align-items:center;justify-content:space-between;padding:12px 16px;min-height:52px;border-bottom:0.5px solid var(--bdr);cursor:pointer;-webkit-tap-highlight-color:transparent;}
public/css/suite.css-346-.panel-item:active{background:var(--surf2);}
public/css/suite.css-347-.pi-main{font-family:var(--fl);font-size:0.75rem;color:var(--txt);letter-spacing:.02em;}
public/css/suite.css-348-.pi-sub{font-family:var(--fl);font-size:var(--fs-floor-body);color:var(--txt3);letter-spacing:.04em;margin-top:2px;}
--
public/css/suite.css-352-/* gdx-11 (#981) — scoped mini-panels (Lash Out, Clash of Wills, Blood Bond
public/css/suite.css-353-   Resistance, Custom Pool): wrapping chip rows, live total, confirm button */
public/css/suite.css-354-.vm-chip-wrap{display:flex;flex-wrap:wrap;gap:6px;padding:0 16px 8px;}
public/css/suite.css-355-.vm-chip-wrap .mchip{flex:0 0 auto;height:36px;padding:0 12px;}
public/css/suite.css:356:.panel-section .cp-showall-btn{float:right;background:none;border:none;color:var(--gdim);font-family:var(--fl);font-size:var(--fs-floor-micro);letter-spacing:.1em;text-transform:uppercase;cursor:pointer;padding:0;-webkit-tap-highlight-color:transparent;}
public/css/suite.css-357-.panel-total{margin:8px 16px;padding:10px 12px;border:1px solid var(--gold2-a25);border-radius:6px;background:var(--gold2-a12);font-family:var(--fl);font-size:var(--fs-floor-body);color:var(--txt2);letter-spacing:.02em;}
public/css/suite.css-358-.panel-total b{color:var(--gold2);}
public/css/suite.css-359-.pnl-confirm-btn{display:block;width:calc(100% - 32px);margin:8px 16px 16px;padding:14px;border:none;border-radius:8px;background:var(--crim);color:var(--txt-on-dark);font-family:var(--fl);font-size:0.75rem;letter-spacing:.14em;text-transform:uppercase;cursor:pointer;-webkit-tap-highlight-color:transparent;}
public/css/suite.css-360-.pnl-confirm-btn:active{filter:brightness(1.15);}
--
public/css/suite.css-633-.trk-hd-dmg{font-family:var(--fl);font-size:var(--fs-floor-body);color:var(--err);background:var(--crim-a12);padding:1px 6px;border-radius:8px;}
public/css/suite.css-634-.trk-hd-cond{font-family:var(--fl);font-size:var(--fs-floor-body);color:var(--info2-a9);background:var(--info4-a15);padding:1px 6px;border-radius:8px;}
public/css/suite.css-635-.trk-chev{font-size:var(--fs-floor-body);color:var(--txt3);flex-shrink:0;margin-left:auto;}
