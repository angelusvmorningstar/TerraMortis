+const { test } = require('@playwright/test');
+
+test('codex production-context probes', async ({ page }) => {
+  await page.setViewportSize({ width: 1280, height: 900 });
+  await page.goto('/');
+
+  const result = await page.evaluate(() => {
+    document.getElementById('login-screen').style.display = 'none';
+    document.getElementById('app').style.display = 'flex';
+    document.querySelectorAll('.tab.active').forEach((el) => el.classList.remove('active'));
+    const editor = document.getElementById('t-editor');
+    editor.classList.add('active');
+
+    const svt = document.querySelector('.svt-btn');
+    const sr = svt.getBoundingClientRect();
+    const sx = sr.left + sr.width / 2;
+    const sy = sr.top + sr.height / 2;
+    const svtHits = [-21, 0, 21].map((dy) => {
+      const hit = document.elementFromPoint(sx, sy + dy);
+      return { dy, hit: hit ? `${hit.tagName.toLowerCase()}.${hit.className}` : null };
+    });
+
+    const host = document.createElement('div');
+    host.style.cssText = 'position:fixed;left:400px;top:300px;padding:80px;background:white;z-index:9999';
+    host.innerHTML = '<div class="cs-edit-stepper office-merit-stepper"><button id="up" class="cs-step-btn">▲</button><button id="down" class="cs-step-btn">▼</button></div>';
+    document.body.appendChild(host);
+    const up = document.getElementById('up').getBoundingClientRect();
+    const down = document.getElementById('down').getBoundingClientRect();
+    const overlapLeft = Math.max(up.left + up.width / 2 - 22, down.left + down.width / 2 - 22);
+    const overlapRight = Math.min(up.left + up.width / 2 + 22, down.left + down.width / 2 + 22);
+    const ox = (overlapLeft + overlapRight) / 2;
+    const oy = up.top + up.height / 2;
+    const overlapHit = document.elementFromPoint(ox, oy);
+    const office = {
+      up: { left: up.left, right: up.right, width: up.width },
+      down: { left: down.left, right: down.right, width: down.width },
+      centrePitch: down.left + down.width / 2 - (up.left + up.width / 2),
+      claimedOverlap: overlapRight - overlapLeft,
+      overlapHit: overlapHit ? overlapHit.id : null,
+    };
+    host.remove();
+    return { svtBox: { width: sr.width, height: sr.height }, svtHits, office };
+  });
+  console.log('CODEX_GDX3_PROBE=' + JSON.stringify(result));
+});

