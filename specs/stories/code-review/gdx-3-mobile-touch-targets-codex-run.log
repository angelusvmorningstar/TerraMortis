 931:       const tab = document.createElement('div');
 932:       tab.id = 't-more';
 933:       tab.className = 'tab active';
 934:       tab.style.display = 'block';
 935:       tab.innerHTML = html;
 936:       document.body.appendChild(tab);
 937:       let worstOverflow = { label: '', px: 0 };
 938:       for (const card of tab.querySelectorAll('.more-app-icon')) {
 939:         const label = card.querySelector('.more-app-label');
 940:         const cardRect = card.getBoundingClientRect();
 941:         const labelRect = label.getBoundingClientRect();
 942:         const px = Math.max(labelRect.right - cardRect.right, cardRect.left - labelRect.left);
 943:         if (px > worstOverflow.px) worstOverflow = { label: label.textContent, px };
 944:       }
 945:       document.body.removeChild(tab);
 946:       return worstOverflow;
 947:     }, gdx2MoreGridHtml());
 948:     expect(worst.px, 'label "' + worst.label + '" spills past its card').toBeLessThanOrEqual(0);
 949:   });
