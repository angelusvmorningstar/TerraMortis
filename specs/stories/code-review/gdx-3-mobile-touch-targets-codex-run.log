 923: // behind) spilled past its own .more-app-icon card by 1.2 to 6.2px at 320 to
 924: // 360px. The grid-level test above does not catch this: the card is inside the
 925: // grid track, so the spill is a child overflowing its parent rather than the tab.
 926: for (const gdx2LabelWidth of [320, 360, 375]) {
 927:   test('css-audit — .more-app-label wraps inside its card at ' + gdx2LabelWidth + 'px (gdx-2 AC4)', async ({ page }) => {
 928:     await page.setViewportSize({ width: gdx2LabelWidth, height: 900 });
 929:     await page.goto('/');
