1154: // Mount each fixture in the REAL tab container, measure, restore. Returns the
1155: // element's own box, its effective hit area, and the result of hit-testing the
1156: // four edge midpoints of that hit area.
1157: //
1158: // The effective hit area is the larger of the element's own border box and the
1159: // used box of a generated, TAPPABLE pseudo-element. pointer-events:none on the
1160: // overlay disqualifies it: an untappable overlay would otherwise pass the size
1161: // assertion while fixing nothing.
1162: //
1163: // The hit test is what actually proves AC1 and AC2 together. elementFromPoint
1164: // respects ancestor clipping (so a T2 overlay swallowed by an overflow:hidden
1165: // parent fails here even though its computed size says 44px) and respects paint
1166: // order (so an overlay covered by a neighbouring control fails too). The samples
1167: // are EDGE MIDPOINTS rather than corners on purpose: a corner sample on a
1168: // rounded box resolves to the parent and would report a false failure.
1169: async function gdx3Measure(page, probes) {
1170:   return page.evaluate((list) => {
1171:     // app.js boots on load, finds no auth token and paints the login overlay
1172:     // over everything, which would make every hit test resolve to .login-box.
1173:     // Reveal the real app shell instead. This is display plumbing only: no tab
1174:     // markup, padding or width cap is touched, so the ancestor chain the
1175:     // fixtures mount into is the one index.html actually ships.
1176:     const login = document.getElementById('login-screen');
1177:     if (login) login.style.display = 'none';
1178:     const app = document.getElementById('app');
1179:     if (app) app.style.display = 'flex';
1180: 
1181:     // app.js:1670 removes whichever of #t-dice / #t-roll the
1182:     // tm-use-new-dice-roller preference is not using, so one of the two is
1183:     // always absent from a booted page. Recreate it exactly as index.html
1184:     // declares it, inside the real .tab-wrap, so the ancestor chain still holds.
1185:     const ensureTab = (id) => {
1186:       const found = document.getElementById(id);
1187:       if (found) return found;
1188:       const wrap = document.querySelector('.tab-wrap');
1189:       if (!wrap) return null;
1190:       const made = document.createElement('div');
1191:       made.id = id;
1192:       made.className = 'tab';
1193:       wrap.appendChild(made);
1194:       return made;
1195:     };
1196: 
1197:     // Every .tab is position:absolute;inset:0, so two active tabs perfectly
1198:     // overlap and the later one in the DOM wins the hit test. index.html ships
1199:     // #t-stats with class="tab active" already on it, and it sits near the end
1200:     // of .tab-wrap, so without this it silently swallowed the hit test for
1201:     // every probe mounted in an earlier tab. Park them all, restore at the end.
1202:     const parked = [...document.querySelectorAll('.tab.active')];
1203:     for (const t of parked) t.classList.remove('active');
1204: 
1205:     const results = [];
1206:     for (const p of list) {
1207:       const tab = ensureTab(p.tab);
1208:       if (!tab) { results.push({ sel: p.sel, tech: p.tech, error: 'no #' + p.tab + ' and no .tab-wrap in index.html' }); continue; }
1209:       const saved = { cls: tab.className, html: tab.innerHTML };
1210:       tab.className = 'tab active';
1211:       // The fixture is inset inside the tab rather than flush against its
1212:       // scroll edges. Without this every probe sits at the tab's own top-left
1213:       // corner, where .tab{overflow-x:hidden} plus the top of the scroll box
1214:       // clip the expanded area - a property of the fixture, not of the CSS, and
1215:       // it would report a false failure on every selector at once. Real
1216:       // surfaces sit inside a padded panel; 60px vertical is simply more than
1217:       // half of --tap-min so the expansion always has room above and below.
1218:       // position:relative so any absolutely-positioned menu in a fixture
1219:       // anchors to the host the way it anchors to #hdr-user in the real DOM.
1220:       tab.innerHTML = '<div id="gdx3-host" style="padding:60px 16px;position:relative">' + p.html + '</div>';
1221: 
1222:       const el = tab.querySelector(p.sel);
1223:       if (!el) {
1224:         tab.className = saved.cls; tab.innerHTML = saved.html;
1225:         results.push({ sel: p.sel, tech: p.tech, error: 'fixture did not produce ' + p.sel });
1226:         continue;
1227:       }
1228:       el.scrollIntoView({ block: 'center', inline: 'center' });
1229:       const r = el.getBoundingClientRect();
1230: 
1231:       let w = r.width, h = r.height, pseudo = null;
1232:       for (const which of ['::after', '::before']) {
1233:         const cs = getComputedStyle(el, which);
1234:         if (!cs.content || cs.content === 'none' || cs.content === 'normal') continue;
1235:         if (cs.pointerEvents === 'none') continue;
1236:         const pw = parseFloat(cs.width), ph = parseFloat(cs.height);
1237:         if (Number.isFinite(pw) && pw > w) { w = pw; pseudo = which; }
1238:         if (Number.isFinite(ph) && ph > h) { h = ph; pseudo = which; }
1239:       }
1240: 
1241:       // The overlay is top:50%/left:50% + translate(-50%,-50%), which centres it
1242:       // on the PADDING box, not the border box. .edit-tab.on carries a 2px
1243:       // border-bottom, so sampling from the border-box centre put the bottom
1244:       // probe exactly 1px outside the overlay and reported a false failure.
1245:       const cs = getComputedStyle(el);
1246:       const bt = parseFloat(cs.borderTopWidth) || 0, bb = parseFloat(cs.borderBottomWidth) || 0;
1247:       const bl = parseFloat(cs.borderLeftWidth) || 0, br = parseFloat(cs.borderRightWidth) || 0;
1248:       const cx = r.left + bl + (r.width - bl - br) / 2;
1249:       const cy = r.top + bt + (r.height - bt - bb) / 2;
1250:       const pts = [
1251:         ['centre', cx, cy],
1252:         ['top', cx, cy - h / 2 + 1],
1253:         ['bottom', cx, cy + h / 2 - 1],
1254:         ['left', cx - w / 2 + 1, cy],
1255:         ['right', cx + w / 2 - 1, cy],
1256:       ];
1257:       const missed = [];
1258:       for (const [name, x, y] of pts) {
1259:         const hit = document.elementFromPoint(x, y);
1260:         if (!hit || !(hit === el || el.contains(hit))) {
1261:           missed.push(name + ' -> ' + (hit ? (hit.tagName.toLowerCase() + '.' + (hit.className || '').toString().split(' ')[0]) : 'null'));
1262:         }
1263:       }
1264: 
1265:       tab.className = saved.cls; tab.innerHTML = saved.html;
1266:       results.push({
1267:         sel: p.sel, tech: p.tech, pseudo,
1268:         boxW: Math.round(r.width * 100) / 100, boxH: Math.round(r.height * 100) / 100,
1269:         hitW: Math.round(w * 100) / 100, hitH: Math.round(h * 100) / 100,
1270:         missed,
1271:       });
1272:     }
1273:     for (const t of parked) t.classList.add('active');
1274:     return results;
1275:   }, probes);
1276: }
