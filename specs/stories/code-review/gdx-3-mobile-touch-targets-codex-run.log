public/css/suite.css-638-.trk-lbl{font-family:var(--fl);font-size:var(--fs-floor-micro);letter-spacing:.12em;text-transform:uppercase;color:var(--txt2);}
public/css/suite.css:639:.trk-ctr{display:flex;align-items:center;gap:8px;}
public/css/suite.css-640-.trk-adj{width:28px;height:28px;background:var(--surf2);border:1px solid var(--bdr);border-radius:4px;color:var(--txt2);font-size:1rem;cursor:pointer;display:flex;align-items:center;justify-content:center;-webkit-tap-highlight-color:transparent;line-height:1;}
public/css/suite.css-641-.trk-adj.sm{width:24px;height:24px;font-size:0.875rem;}
public/css/suite.css-642-.trk-adj:active{background:var(--surf3);}
public/css/suite.css-643-.trk-cur{font-family:var(--fl);font-size:1.375rem;color:var(--txt);line-height:1;min-width:28px;text-align:center;}
public/css/suite.css-644-.trk-sep{font-family:var(--fl);font-size:var(--fs-floor-body);color:var(--txt3);}
public/css/suite.css-645-.trk-max{font-family:var(--fl);font-size:var(--fs-floor-body);color:var(--txt3);min-width:20px;}
public/css/suite.css-646-/* Colour tints */
public/css/suite.css:647:.trk-row-v .trk-cur{color:var(--err3-a9);}
public/css/suite.css:648:.trk-row-w .trk-cur{color:var(--gold2);}
public/css/suite.css-649-/* Health row */
public/css/suite.css:650:.trk-row-hp{flex-wrap:wrap;gap:6px;align-items:flex-start;}
public/css/suite.css-651-.trk-hp-total{font-family:var(--fl);font-size:var(--fs-floor-body);color:var(--txt3);margin-left:4px;}
public/css/suite.css-652-.trk-dmg-cols{display:flex;gap:4px;flex:1;justify-content:flex-end;}
public/css/suite.css-653-.trk-dmg-col{display:flex;flex-direction:column;align-items:center;gap:3px;min-width:44px;}
public/css/suite.css-654-.trk-dmg-n{font-family:var(--fl);font-size:1.125rem;color:var(--txt);line-height:1;}
