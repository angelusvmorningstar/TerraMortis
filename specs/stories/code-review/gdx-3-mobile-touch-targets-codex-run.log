+/* gdx-3 (#984) — Technique T2 hit-area overlay. Unlike every other gdx-3 T2
+   rule (which lives in one block at the end of suite.css), this one has to be
+   here: .edit-tab renders on admin.html as well as inside index.html's ST
+   editor, and admin.html does not load suite.css. The visible tab is untouched
+   at every width, so the admin editor header is pixel-identical; the 8px of
+   vertical expansion on each side of the 28px box lands inside .edit-header's
+   own padding:12px 24px and .edit-tabs' 2px gap is horizontal only, so no two
+   expanded areas overlap. See the technique block in suite.css for the full
+   rationale and the four traps. */
+.edit-tab{position:relative;}
+.edit-tab::after{
+  content:'';
+  position:absolute;
+  top:50%;
+  left:50%;
+  transform:translate(-50%,-50%);
+  width:100%;
+  height:100%;
+  min-width:var(--tap-min);
+  min-height:var(--tap-min);
+}
 .edit-tab:hover{color:var(--txt2);}
 .edit-tab.on{color:var(--accent);background:var(--accent-a8);border-bottom:2px solid var(--accent);}
