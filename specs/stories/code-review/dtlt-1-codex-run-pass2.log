+const CTX = { attr: 'Resolve', skill: 'Composure' };
+
+function makeMeritChar(merit) {
+  return { name: 'Contract Test', merits: [merit], fighting_picks: [], skills: {} };
+}
+
+const MIN_RATING_RULE = {
