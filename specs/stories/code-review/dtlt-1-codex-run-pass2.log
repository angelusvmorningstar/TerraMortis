    1: /**
    2:  * Downtime dice roller — ES module version.
    3:  * VtR 2e dice pool roller with modal UI and rote support.
    4:  *
    5:  * Converted from downtime_helper/js/roller.js (Peter's original).
    6:  */
    7: 
    8: import { esc } from '../data/helpers.js';
    9: 
   10: // ── Core roller ─────────────────────────────────────────────────────────────
   11: 
   12: export function rollPool(size, again = 10, success = 8, exc = 5, rote = false) {
   13:   const d10  = () => Math.floor(Math.random() * 10); // 0 = face-10
   14:   const face = v  => (v === 0 ? 10 : v);
   15: 
   16:   function rollChain() {
   17:     const chain = [];
   18:     let v = d10();
   19:     chain.push(v);
   20:     while (face(v) >= again) { v = d10(); chain.push(v); }
   21:     return chain;
   22:   }
   23: 
   24:   function rollOnce() {
   25:     const chains = Array.from({ length: size }, rollChain);
   26:     let successes = 0;
   27:     for (const chain of chains)
   28:       for (const v of chain)
   29:         if (face(v) >= success) successes++;
   30:     const dice_string = '[' + chains.map(c => c.join('>')).join(',') + ']';
   31:     return { dice_string, successes };
   32:   }
   33: 
   34:   if (rote) {
   35:     const r1 = rollOnce(), r2 = rollOnce();
   36:     const [winner, loser] = r1.successes >= r2.successes ? [r1, r2] : [r2, r1];
   37:     return {
   38:       dice_string: winner.dice_string, successes: winner.successes,
   39:       exceptional: winner.successes >= exc, rolled_at: new Date().toISOString(),
   40:       params: { size, again, success, exc, rote: true },
   41:       rote_other: { dice_string: loser.dice_string, successes: loser.successes },
   42:     };
   43:   }
   44: 
   45:   const { dice_string, successes } = rollOnce();
   46:   return {
   47:     dice_string, successes, exceptional: successes >= exc,
   48:     rolled_at: new Date().toISOString(),
   49:     params: { size, again, success, exc, rote: false },
   50:   };
   51: }
   52: 
   53: // ── Dice string parser ──────────────────────────────────────────────────────
   54: 
   55: export function parseDiceString(diceString) {
   56:   const inner = diceString.replace(/^\[|\]$/g, '');
   57:   if (!inner) return [];
   58:   return inner.split(',').map(part => part.split('>').map(Number));
   59: }
   60: 
   61: // ── Dice block builder ──────────────────────────────────────────────────────
   62: 
   63: export function buildDiceBlock(diceString, params, label, dimmed) {
   64:   const wrap = document.createElement('div');
   65:   wrap.className = 'roll-dice-block' + (dimmed ? ' dimmed' : '');
   66: 
   67:   if (label) {
   68:     const lbl = document.createElement('div');
   69:     lbl.className = 'roll-dice-label' + (dimmed ? '' : ' winner');
   70:     lbl.textContent = label;

