   69:     is_dual_role: player.role === 'st' && (player.character_ids || []).length > 0,
   70:   };
   71: 
   72:   tokenCache.set(token, { user: userInfo, expiresAt: Date.now() + CACHE_TTL });
   73:   req.user = userInfo;
   74:   next();
   75: }
   76: 
   77: /**
   78:  * "dev" is a privacy-redacted ST role — full read/write access, but the
   79:  * client UI redacts character and player names. For access-control
   80:  * purposes it's equivalent to 'st' everywhere.
   81:  */
   82: export function isStRole(user) {
   83:   const r = user?.role;
   84:   return r === 'st' || r === 'dev';
   85: }
   86: 
   87: /**
   88:  * Coordinator tier — non-ST staff with access to check-in, finance,
   89:  * and emergency tabs. ST and dev also qualify.
   90:  */
   91: export function isCoordinatorRole(user) {
   92:   const r = user?.role;
   93:   return r === 'coordinator' || r === 'st' || r === 'dev';
   94: }
   95: 
   96: /**
   97:  * Regent check — returns true if the user is ST (override) OR the user's
   98:  * character_ids includes the territory's regent_id.
   99:  * Used by feeding-rights write gate.
  100:  */
  101: export function isRegentOfTerritory(user, territory) {
  102:   if (isStRole(user)) return true;
  103:   if (!territory?.regent_id) return false;
  104:   const charIds = (user?.character_ids || []).map(id => String(id));
  105:   return charIds.includes(String(territory.regent_id));
  106: }
  107: 
  108: // Role gate middleware — use after requireAuth
  109: export function requireRole(...roles) {
  110:   return (req, res, next) => {
  111:     const role = req.user?.role;
  112:     if (!role) {
  113:       return res.status(403).json({ error: 'FORBIDDEN', message: 'Insufficient role' });
  114:     }
  115:     // dev is treated as st for all access checks; st is also treated as coordinator
  116:     let effective = [...roles];
  117:     if (roles.includes('st') && !roles.includes('dev')) effective.push('dev');
  118:     if (roles.includes('coordinator')) {
  119:       if (!effective.includes('st')) effective.push('st');
  120:       if (!effective.includes('dev')) effective.push('dev');
  121:     }
  122:     if (!effective.includes(role)) {
  123:       return res.status(403).json({ error: 'FORBIDDEN', message: 'Insufficient role' });
  124:     }
  125:     next();
  126:   };
  127: }
