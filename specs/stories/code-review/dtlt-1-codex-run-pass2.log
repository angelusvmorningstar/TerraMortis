   56: // CORS v3 manual middleware — NO cors package
   57: const allowedOrigins = config.CORS_ORIGIN.split(',').map(o => o.trim());
   58: app.use((req, res, next) => {
   59:   const origin = req.headers.origin;
   60:   if (origin && (allowedOrigins.includes(origin) || config.NODE_ENV !== 'production')) {
   61:     res.setHeader('Access-Control-Allow-Origin', origin);
   62:   }
   63:   res.setHeader('Access-Control-Allow-Methods', 'GET,HEAD,PUT,PATCH,POST,DELETE,OPTIONS');
   64:   res.setHeader('Access-Control-Allow-Headers', 'Content-Type,Authorization');
   65:   res.setHeader('Access-Control-Allow-Credentials', 'true');
   66:   if (req.method === 'OPTIONS') {
   67:     res.status(204).end();
   68:     return;
   69:   }
   70:   next();
   71: });
