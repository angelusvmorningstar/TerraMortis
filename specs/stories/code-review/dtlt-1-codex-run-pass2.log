  273: // Start server first, then attempt DB connection
  274: // Server must be reachable even if MongoDB is unavailable
  275: async function start() {
  276:   const server = app.listen(config.PORT, () => {
  277:     console.log(`TM Suite API running on port ${config.PORT} (${config.NODE_ENV})`);
  278:   });
  279: 
  280:   // Attach WebSocket server for live tracker sync
  281:   attachWS(server);
  282: 
  283:   try {
  284:     await connectDb();
  285:     // Ensure unique index on cyoa_passages (issue #971).
  286:     // createIndex is idempotent — safe to call on every boot.
  287:     getDb().collection('cyoa_passages').createIndex(
  288:       { player_id: 1, story_id: 1 },
  289:       { unique: true, background: true },
  290:     );
  291:     // Ensure partial unique index on office_actions (issue #1143) — makes
  292:     // the per-target dedupe check for paid Status Actions (raise/lower)
  293:     // atomic at the database level instead of a racing findOne.
  294:     getDb().collection('office_actions').createIndex(
  295:       { game_session_id: 1, actor_id: 1, target_id: 1 },
  296:       {
  297:         unique: true,
  298:         background: true,
  299:         partialFilterExpression: { action_type: { $in: ['raise', 'lower'] } },
  300:       },
  301:     );
  302:     // Ensure partial unique index on contested_roll_requests (oaq.2) —
  303:     // prevents a second concurrent PENDING status_action request for the
  304:     // same (session, actor, target); scoped to status:'pending' so a
  305:     // resolved/declined record never blocks a later resubmission.
  306:     getDb().collection('contested_roll_requests').createIndex(
  307:       { game_session_id: 1, actor_id: 1, target_id: 1 },
  308:       {
  309:         unique: true,
  310:         background: true,
  311:         partialFilterExpression: { request_type: 'status_action', status: 'pending' },
  312:       },
  313:     );
  314:     // Ensure partial unique index on contested_roll_requests (oxp.9) —
  315:     // the one-pending-per-seat rule for office XP purchase requests. The
  316:     // sibling of the oaq.2 index above, for the same reason and by the same
  317:     // mechanism: office-purchase.js's POST kept a findOne pre-check as a
  318:     // fast-path, but a findOne-then-insertOne pair is not atomic, and an
  319:     // external Codex review round (2026-08-27, passes 1 and 2) REPRODUCED the
  320:     // double spend — a 12-request burst created ten pending rows for one seat
  321:     // and two of them were then accepted onto the same merit. This index is
  322:     // the authoritative guard; the route translates its duplicate-key error
  323:     // (11000) into the same 409 the pre-check already returns. Scoped to
  324:     // status:'pending' so a resolved/declined record never blocks a later
  325:     // resubmission, exactly as the oaq.2 index is.
  326:     getDb().collection('contested_roll_requests').createIndex(
  327:       { seat_id: 1 },
  328:       {
  329:         unique: true,
  330:         background: true,
  331:         partialFilterExpression: { request_type: 'office_purchase', status: 'pending' },
  332:       },
  333:     );
  334:     // Ensure the defender-queue compound index on contested_roll_requests
  335:     // (crd.1) — contested-rolls.js's GET /mine filters on target_character_id
  336:     // + status and sorts by created_at descending. Until crd.1 the ONLY index
  337:     // on this collection was the status_action partial unique one above, so a
  338:     // player's queue poll (every 10s, 30+ players at real table scale) was an
  339:     // unindexed scan across every historical challenge ever recorded.
  340:     // Not awaited, and deliberately not unique: it constrains nothing, so
  341:     // unlike the game_sessions.chapter_id index below it cannot reject at
  342:     // build time on live data.
  343:     getDb().collection('contested_roll_requests').createIndex(
  344:       { target_character_id: 1, status: 1, created_at: -1 },
  345:       { name: 'crd1_defender_queue', background: true },
  346:     );
  347:     // Ensure the terminal-status TTL index on contested_roll_requests (crd.1).
  348:     // Nothing has ever expired records in this collection; resolved/declined/
  349:     // voided documents accumulate for the life of the campaign. session_logs
  350:     // (written by contested-rolls.js's own accept path) carries the durable
  351:     // audit record, so no terminal request needs indefinite retention here.
  352:     // Retention: 30 days — long enough to cover a game's own post-session
  353:     // review window at this project's session cadence, short enough that the
  354:     // collection stays bounded across a whole campaign.
  355:     //
  356:     // The partial filter is on status alone, so it also covers terminal
  357:     // status_action records sharing this collection. That is safe and
  358:     // intended: office_actions holds the durable applied-action log, oaq.3's
  359:     // approval queue reads status:'pending' only, and oaq.2's "already acted
  360:     // on this target this session" dedupe read is scoped to the CURRENT
  361:     // game_session_id, whose records are days old, never 30+.
  362:     //
  363:     // KNOWN LIMITATION, deliberately not fixed here: MongoDB's TTL monitor
  364:     // only expires documents whose indexed field holds a BSON Date. Every
  365:     // writer on this collection (contested-rolls.js AND office-actions.js)
  366:     // stores `new Date().toISOString()` — a string — so this index is correct
  367:     // and idempotent but reaps nothing until updated_at becomes a real Date.
  368:     // Converting it is a cross-route data-shape change plus a backfill of
  369:     // every existing document, which crd.1 explicitly excludes. Flagged for a
  370:     // follow-up story; see crd-1-contested-roll-request-shape.test.js's own
  371:     // "DOCUMENTED LIMITATION" test, which fails the day updated_at changes.
  372:     getDb().collection('contested_roll_requests').createIndex(
  373:       { updated_at: 1 },
  374:       {
  375:         name: 'crd1_terminal_status_ttl',
  376:         background: true,
  377:         expireAfterSeconds: 2592000,
  378:         partialFilterExpression: { status: { $in: ['resolved', 'declined', 'voided'] } },
  379:       },
  380:     );
  381:     // Ensure the TTL index on roll_log (gdx.8, #989). 30-day retention, same
  382:     // window as its neighbour above. UNLIKE that neighbour, this one actually
  383:     // reaps documents: roll-log.js's own POST handler stamps rolled_at with
  384:     // `new Date()` (a genuine BSON Date), not `.toISOString()`, specifically
  385:     // so MongoDB's TTL monitor — which only expires documents whose indexed
  386:     // field holds a real Date — can act on it. Do not "fix" rolled_at to a
  387:     // string to match this codebase's usual date-as-ISO-string convention;
  388:     // that would silently repeat crd1_terminal_status_ttl's own documented,
  389:     // still-live bug.
  390:     getDb().collection('roll_log').createIndex(
  391:       { rolled_at: 1 },
  392:       { name: 'gdx8_roll_log_ttl', background: true, expireAfterSeconds: 2592000 },
  393:     );
  394:     // Ensure partial unique index on game_sessions.chapter_id (CM-6, folded into cm-4 per
  395:     // cycle-model.md §11a step 6) — makes the confirmed-always-1:1 session/Chapter invariant
  396:     // (Angelus, 2026-08-16) a database constraint rather than a convention.
  397:     //
  398:     // `$type` rather than `$exists: true`: a partial filter of `$exists: true` would INCLUDE
  399:     // documents holding an explicit null, and two of those would then collide on the unique key.
  400:     // `$ne: null` is not accepted in a partial filter at all. `$type` is, and it is exactly
  401:     // "unique where not null". Both storage types are listed because issue #497's mixed
  402:     // ObjectId/string FK split is still live in this database; writes go through
  403:     // `coerceChapterId` in server/routes/game-sessions.js, which only ever stores ObjectId.
  404:     //
  405:     // AWAITED, unlike the three above (cm-4 review, 2026-08-17, triple-confirmed). A unique index
  406:     // build over data that ALREADY contains a duplicate rejects. Un-awaited, that rejection escapes
  407:     // this try/catch entirely and surfaces as an unhandled promise rejection, which on Render can
  408:     // boot-loop the API — the one index of the four whose uniqueness constraint spans data an ST
  409:     // can hand-edit, so the one most able to find a duplicate at boot. Awaiting it means a
  410:     // duplicate is caught below and logged as a startup problem instead of killing the process.
  411:     try {
  412:       await getDb().collection('game_sessions').createIndex(
  413:         { chapter_id: 1 },
  414:         {
  415:           name: 'chapter_id_unique_notnull',
  416:           unique: true,
  417:           background: true,
  418:           partialFilterExpression: { chapter_id: { $type: ['objectId', 'string'] } },
  419:         },
  420:       );
  421:     } catch (indexErr) {
  422:       // Nested deliberately: a live duplicate must be loud, but it must not take the rules-engine
  423:       // gate down with it, and it must not read as "failed to connect to MongoDB" (which is what
  424:       // the outer catch says).
  425:       console.error(
  426:         "Could not create the game_sessions.chapter_id unique index — the session/Chapter 1:1 " +
  427:         'invariant is NOT enforced on this boot. Two sessions are probably paired with the same ' +
  428:         `chapter. Resolve by hand: ${indexErr.message}`
  429:       );
  430:     }
  431:     // prax.1: partial unique index on praxis_sessions.chapter_id - exactly ONE Praxis board per
  432:     // Chapter, made a database constraint rather than a convention. Defence in depth alongside the
  433:     // route-level 409 in POST /api/praxis_sessions, which cannot by itself close the read-then-write
  434:     // gap between two STs opening the board in the same moment.
  435:     //
  436:     // Mirrors the game_sessions block immediately above in every respect that matters, and for the
  437:     // same reasons: `$type` rather than `$exists: true` (an `$exists` filter would INCLUDE documents
  438:     // holding an explicit null, and two of those would then collide on the unique key, while
  439:     // `$ne: null` is not accepted in a partial filter at all), and AWAITED inside its own try/catch
  440:     // so that a build which rejects over pre-existing duplicate data is caught and logged here
  441:     // rather than escaping as an unhandled promise rejection that can boot-loop the API on Render.
  442:     //
  443:     // Unlike game_sessions, only 'objectId' is listed: this collection is new as of prax.1 and its
  444:     // sole writer (server/routes/praxis-sessions.js) always stores a real ObjectId, so there is no
  445:     // issue #497 mixed-type legacy to accommodate. If a string-typed chapter_id ever appears here it
  446:     // is a bug in a new writer, and it should NOT be quietly admitted to the uniqueness constraint.
  447:     try {
  448:       await getDb().collection('praxis_sessions').createIndex(
  449:         { chapter_id: 1 },
  450:         {
  451:           name: 'chapter_id_unique_notnull',
  452:           unique: true,
  453:           background: true,
  454:           partialFilterExpression: { chapter_id: { $type: ['objectId'] } },
  455:         },
  456:       );
  457:     } catch (indexErr) {
  458:       console.error(
  459:         'Could not create the praxis_sessions.chapter_id unique index - the one-board-per-Chapter ' +
  460:         'invariant is NOT enforced on this boot. Two praxis boards are probably paired with the ' +
  461:         `same chapter. Resolve by hand: ${indexErr.message}`
  462:       );
  463:     }
  464:     await runRulesEngineGate();
  465:   } catch (err) {
  466:     console.error('Failed to connect to MongoDB:', err.message);
  467:     console.error('Health check will report disconnected status');
  468:   }
  469: }
  470: 
  471: // Verify the rules-engine seed state matches expected_sources.json. In
  472: // production a missing tuple silently breaks XP/derived-stat calculations
  473: // (RDE-3 PT XP refund regression) — fail boot so the deploy goes red instead
  474: // of shipping silently broken behaviour. In dev/test we warn and continue so
  475: // a fresh laptop without seed data can still boot.
  476: async function runRulesEngineGate() {
  477:   const dbName = process.env.MONGODB_DB || 'tm_game';
  478:   const result = await verifyRulesEngine(getDb());
  479:   if (result.ok) {
  480:     console.log(formatPassReport(result.counts, dbName));
  481:     return;
  482:   }
  483:   if (config.NODE_ENV === 'production') {
  484:     console.error('CRITICAL: rules-engine verification failed — refusing to boot.');
  485:     console.error(formatMissingReport(result.missing, dbName));
  486:     process.exit(1);
  487:   }
  488:   console.warn('WARNING: rules-engine verification failed (non-production — continuing).');
  489:   console.warn(formatMissingReport(result.missing, dbName));
  490: }
  491: 
  492: // Graceful shutdown
  493: function shutdown(signal) {
  494:   console.log(`\n${signal} received — shutting down`);
  495:   closeDb().then(() => process.exit(0));
  496: }
  497: 
  498: process.on('SIGINT', () => shutdown('SIGINT'));
  499: process.on('SIGTERM', () => shutdown('SIGTERM'));
  500: 
  501: start();
--- public/js/editor/rule_engine/load-rules.js ---
    1: /**
    2:  * Rules cache — fetches all rule docs from /api/rules/<family> once and
    3:  * caches them in-memory. applyDerivedMerits (post-flip) calls getRulesBySource()
    4:  * synchronously; callers must await preloadRules() before first render.
    5:  */
    6: 
    7: import { apiGet } from '../../data/api.js';
    8: 
    9: let _cache = null; // { rule_grant, rule_nine_again, rule_skill_bonus, rule_speciality_grant, rule_tier_budget, ... }
   10: 
   11: /**
   12:  * Fetch all rule docs from the server and populate the module cache.
   13:  * Idempotent — subsequent calls return the cached promise.
   14:  *
   15:  * Issue #256 (perf, 2026-05-11): single aggregated round-trip instead
   16:  * of 7 parallel ones. Server route at /api/rules/aggregate accepts
   17:  * a `categories` query param and returns `{ rule_<category>: [...] }`.
   18:  * Cuts the wire overhead from 7 TLS+auth handshakes to 1.
   19:  */
   20: const RULE_CATEGORIES = [
   21:   'grant',
   22:   'nine_again',
   23:   'skill_bonus',
   24:   'speciality_grant',
   25:   'tier_budget',
   26:   'disc_attr',
   27:   'derived_stat_modifier',
   28:   // dtlt.1: roll-time bonus successes. Unlike the families above this one is
   29:   // read by the dice engine (shared/dice.js), not by applyDerivedMerits — it
   30:   // rides the same aggregate round-trip because the cache is already here.
   31:   'bonus_success',
   32: ];
   33: 
   34: export async function preloadRules() {
   35:   if (_cache) return _cache;
   36:   const data = await apiGet(`/api/rules/aggregate?categories=${RULE_CATEGORIES.join(',')}`);
   37:   // Guard each field — keeps the cache shape contract stable even if the
   38:   // server response is missing or malformed for any category. Consumers
   39:   // downstream (getRulesBySource) expect arrays only.
   40:   _cache = {
   41:     rule_grant:                 Array.isArray(data?.rule_grant)                 ? data.rule_grant                 : [],
   42:     rule_nine_again:            Array.isArray(data?.rule_nine_again)            ? data.rule_nine_again            : [],
   43:     rule_skill_bonus:           Array.isArray(data?.rule_skill_bonus)           ? data.rule_skill_bonus           : [],
   44:     rule_speciality_grant:      Array.isArray(data?.rule_speciality_grant)      ? data.rule_speciality_grant      : [],
   45:     rule_tier_budget:           Array.isArray(data?.rule_tier_budget)           ? data.rule_tier_budget           : [],
   46:     rule_disc_attr:             Array.isArray(data?.rule_disc_attr)             ? data.rule_disc_attr             : [],
   47:     rule_derived_stat_modifier: Array.isArray(data?.rule_derived_stat_modifier) ? data.rule_derived_stat_modifier : [],
   48:     rule_bonus_success:         Array.isArray(data?.rule_bonus_success)         ? data.rule_bonus_success         : [],
   49:   };
   50:   return _cache;
   51: }
   52: 
   53: /**
   54:  * Synchronously return rule docs for a given source merit name, split by
   55:  * collection. Returns empty arrays/null if the cache has not been preloaded yet.
   56:  */
   57: export function getRulesBySource(source) {
   58:   if (!_cache) return { grants: [], nineAgain: [], skillBonus: [], specialityGrants: [], tierBudget: null };
   59:   return {
   60:     grants:          (_cache.rule_grant            || []).filter(r => r.source === source),
   61:     nineAgain:       (_cache.rule_nine_again       || []).filter(r => r.source === source),
   62:     skillBonus:      (_cache.rule_skill_bonus      || []).filter(r => r.source === source),
   63:     specialityGrants:(_cache.rule_speciality_grant || []).filter(r => r.source === source),
   64:     tierBudget:      (_cache.rule_tier_budget      || []).find(r => r.source === source) || null,
   65:   };
   66: }
   67: 
   68: /** Expose the raw cache — used by evaluator wiring that needs other families. */
   69: export function getRulesCache() {
   70:   return _cache;
   71: }
   72: 
   73: /** Flush cache — call in tests or when rules are updated via admin UI. */
   74: export function invalidateRulesCache() {
   75:   _cache = null;
   76: }
--- public/js/shared/dice.js ---
    1: /* Shared dice rolling engine — pure functions for WoD d10 mechanics */
    2: 
    3: import state from '../suite/data.js';
    4: // dtlt.1: roll-time bonus successes. The evaluator is pure and import-free;
    5: // the cache lookup lives here so every dice surface gets it for free.
    6: import { getRulesCache } from '../editor/rule_engine/load-rules.js';
    7: import { combineSuccesses, formatSuccessBreakdown } from '../editor/rule_engine/bonus-success-evaluator.js';
    8: 
    9: export { formatSuccessBreakdown };
   10: 
   11: /** Roll a single d10 (1-10). */
   12: export function d10() { return Math.floor(Math.random() * 10) + 1; }
   13: 
   14: /** Create a die result object from a rolled value. */
   15: export function mkDie(v) {
   16:   return { v, s: v >= 8, x: !state.NA && v >= state.AGAIN };
   17: }
   18: 
   19: /** Roll a die chain: initial die plus any exploding re-rolls. */
   20: export function mkChain(rv) {
   21:   const r = mkDie(rv);
   22:   const ch = [];
   23:   if (!state.NA) {
   24:     let l = r;
   25:     while (l.x) { const c = mkDie(d10()); ch.push(c); l = c; }
   26:   }
   27:   return { r, ch };
   28: }
   29: 
   30: /** Roll a pool of n dice, returning an array of chains. */
   31: export function rollPool(n) {
   32:   const c = [];
   33:   for (let i = 0; i < n; i++) c.push(mkChain(d10()));
   34:   return c;
   35: }
   36: 
   37: /** Count total successes across all chains. */
   38: export function cntSuc(cols) {
   39:   let s = 0;
   40:   cols.forEach(col => {
   41:     if (col.r.s) s++;
   42:     col.ch.forEach(d => { if (d.s) s++; });
   43:   });
   44:   return s;
   45: }
   46: 
   47: // ── Bonus successes (dtlt.1) ─────────────────────────────────────────────────
   48: //
   49: // cntSuc stays exactly as it was: the rolled-only primitive. Callers that
   50: // genuinely want rolled-only counts (picking the better of two rote pools, for
   51: // instance) keep using it. Everything that reports a final result should use
   52: // resolveSuccesses / addBonusSuccesses instead, so that a rule like Stronger
   53: // Than You is actually enforced and the breakdown can be shown.
   54: 
   55: /** The rule_bonus_success docs currently cached, or [] if the cache is cold. */
   56: function _bonusRules() {
   57:   return getRulesCache()?.rule_bonus_success || [];
   58: }
   59: 
   60: /**
   61:  * Count a pool AND apply any bonus-success rules that fire for this character
   62:  * on this roll.
   63:  *
   64:  * @param {Array}  cols        dice chains, as returned by rollPool
   65:  * @param {object} character   the rolling character (may be null)
   66:  * @param {object} rollContext { attr, skill, disc, spec } describing the pool
   67:  * @returns {{rolled: number, bonus: Array<{source,count}>, total: number}}
   68:  */
   69: export function resolveSuccesses(cols, character, rollContext = {}) {
   70:   return addBonusSuccesses(cntSuc(cols), character, rollContext);
   71: }
   72: 
   73: /**
   74:  * Same as resolveSuccesses, but starting from an already-counted number of
   75:  * ROLLED successes. Used by the rote path, where the better of two pools is
   76:  * chosen on rolled successes alone and the bonus is then added once, to the
   77:  * winner — never to each candidate.
   78:  */
   79: export function addBonusSuccesses(rolled, character, rollContext = {}) {
   80:   return combineSuccesses(rolled, character, rollContext, _bonusRules());
   81: }

