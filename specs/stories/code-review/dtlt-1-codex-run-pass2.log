   59: 
   60: /**
   61:  * Fold a rolled-success count together with whatever bonus successes apply.
   62:  *
   63:  * Kept separate from resolveSuccesses(cols, ...) in shared/dice.js because the
   64:  * rote path has already reduced two dice pools to one winning ROLLED count by
   65:  * the time the bonus is added — the bonus is added once, to the winner, never
   66:  * to each candidate roll.
   67:  *
   68:  * @returns {{rolled: number, bonus: Array, total: number}}
   69:  */
   70: export function combineSuccesses(rolled, c, rollContext = {}, rules = []) {
   71:   const r = _int(rolled);
   72:   const bonus = resolveBonusSuccesses(c, { ...rollContext, rolledSuccesses: r }, rules || []);
   73:   const total = r + bonus.reduce((sum, b) => sum + b.count, 0);
   74:   return { rolled: r, bonus, total };
   75: }
   76: 
   77: /**
   78:  * The verdict-line breakdown, e.g.
   79:  *   "4 rolled + 1 (Stronger Than You) = 5 successes"
   80:  *
   81:  * Returns '' when no bonus applies, so every display surface can append it
   82:  * unconditionally and leave the existing line untouched on a normal roll.
   83:  */
   84: export function formatSuccessBreakdown(result) {
   85:   if (!result || !Array.isArray(result.bonus) || result.bonus.length === 0) return '';
   86:   const parts = result.bonus.map(b => `+ ${b.count} (${b.source})`).join(' ');
   87:   const total = _int(result.total);
   88:   return `${_int(result.rolled)} rolled ${parts} = ${total} success${total === 1 ? '' : 'es'}`;
   89: }
   90: 
   91: // ── Predicates ───────────────────────────────────────────────────────────────
   92: 
   93: function _matches(c, ctx, pred) {
   94:   if (!pred || typeof pred !== 'object' || !pred.kind || !pred.name) return false;
   95:   const name = String(pred.name);
   96: 
   97:   switch (pred.kind) {
   98:     case 'roll_attr':
   99:       return _sameName(ctx?.attr, name);
  100: 
  101:     case 'roll_skill':
  102:       return _sameName(ctx?.skill, name);
  103: 
  104:     case 'merit_present': {
  105:       const min = Number.isInteger(pred.min_rating) && pred.min_rating > 0 ? pred.min_rating : 1;
  106:       return (c.merits || []).some(m => _sameName(m?.name, name) && _meritRating(m) >= min);
  107:     }
  108: 
  109:     // Manoeuvre possession is flat fighting_picks[] membership by name, not a
  110:     // style-rating threshold — a character has picked the manoeuvre or has
  111:     // not. Mirrors the existing check in public/js/admin/rules-view.js:99-102.
  112:     // Style dots alone never grant it.
  113:     case 'manoeuvre_present':
  114:       return (c.fighting_picks || []).some(pk =>
  115:         _sameName(typeof pk === 'string' ? pk : pk?.manoeuvre, name)
  116:       );
  117: 
  118:     default:
  119:       return false;
  120:   }
  121: }
  122: 
  123: // ── Amounts ──────────────────────────────────────────────────────────────────
  124: 
  125: function _count(c, rule) {
  126:   switch (rule.count_basis) {
  127:     case 'flat':
  128:       return _int(rule.flat_amount ?? 1);
  129: 
  130:     // Only meaningful against a merit_present predicate; the route rejects any
  131:     // other pairing, and this returns 0 rather than throwing if one slips in.
  132:     case 'rating': {
  133:       if (rule.predicate?.kind !== 'merit_present') return 0;
  134:       const name = String(rule.predicate.name);
  135:       const m = (c.merits || []).find(x => _sameName(x?.name, name));
  136:       return m ? _meritRating(m) : 0;
  137:     }
  138: 
  139:     default:
  140:       return 0;
  141:   }
  142: }
  143: 
  144: /**
  145:  * ADR-001 trait-reference primitive: a rule referencing a merit's rating reads
  146:  * `m.rating`, which is already the effective sum (inherent dots plus every
  147:  * free_* channel) after the render's phase-5 rating sync. There is deliberately
  148:  * no inherent-only fallback here — reading purchased dots would reintroduce the
  149:  * exact bug class the effective-rating contract exists to prevent.
  150:  */
  151: function _meritRating(m) {
  152:   const n = Number(m?.rating);
  153:   return Number.isFinite(n) && n > 0 ? Math.floor(n) : 0;
  154: }
  155: 
  156: // ── Small helpers ────────────────────────────────────────────────────────────
  157: 
  158: function _sameName(a, b) {
  159:   if (typeof a !== 'string' || typeof b !== 'string') return false;
  160:   return a.trim().toLowerCase() === b.trim().toLowerCase();
  161: }
  162: 
  163: function _int(v) {
  164:   const n = Number(v);
  165:   return Number.isFinite(n) && n > 0 ? Math.floor(n) : 0;
  166: }
--- server/schemas/rules/rule-bonus-success.schema.js ---
    1: /**
    2:  * rule_bonus_success — roll-time "+N automatic successes when X" rules.
    3:  *
    4:  * The ninth typed-per-family rules-engine collection (ADR-001 Option B).
    5:  * Unlike every other family in the catalogue this one is NOT evaluated during
    6:  * a character render: it runs once per dice roll, after the dice are counted,
    7:  * and produces successes rather than dots. See
    8:  * public/js/editor/rule_engine/bonus-success-evaluator.js.
    9:  *
   10:  * Predicate vocabulary (dtlt.1, deliberately small — add kinds as real rules
   11:  * need them, never speculatively):
   12:  *   roll_attr          the named attribute is the attribute leg of the pool
   13:  *   roll_skill         the named skill is the skill leg of the pool
   14:  *   merit_present      the character holds the named merit, optionally at
   15:  *                      min_rating or better (effective rating, ADR-001)
   16:  *   manoeuvre_present  the character has picked the named fighting-style
   17:  *                      manoeuvre (flat fighting_picks[] membership). Boolean
   18:  *                      presence only: a manoeuvre has no rating, so min_rating
   19:  *                      is rejected on this kind by the route's postCheck.
   20:  *
   21:  * `also_requires` is an AND list: every predicate in it must match as well as
   22:  * `predicate` itself. Stronger Than You uses it to pin the manoeuvre to
   23:  * Strength-based pools.
   24:  *
   25:  * `excludes_from_threshold` is captured-but-not-enforced errata metadata (see
   26:  * docs/merits/Merits Errata.md:693, Street Fighting "Kick 'Em While They're
   27:  * Down"). dtlt.1 only guarantees the roll result carries rolled and bonus
   28:  * counts separately so a downstream rule can read rolled-only.
   29:  */
   30: 
   31: const predicate = {
   32:   type: 'object',
   33:   required: ['kind', 'name'],
   34:   additionalProperties: false,
   35:   properties: {
   36:     kind: {
   37:       type: 'string',
   38:       enum: ['roll_attr', 'roll_skill', 'merit_present', 'manoeuvre_present'],
   39:     },
   40:     name: { type: 'string', minLength: 1 },
   41:     // merit_present only. Enforced in server/routes/rules-engine.js's postCheck
   42:     // rather than with an if/then/else so the failure message names the reason.
   43:     min_rating: { type: 'integer', minimum: 1 },
   44:   },
   45: };
   46: 
   47: export const ruleBonusSuccessSchema = {
   48:   $schema: 'http://json-schema.org/draft-07/schema#',
   49:   title: 'TM Rule Bonus Success',
   50:   type: 'object',
   51:   required: ['source', 'predicate', 'count_basis'],
   52:   additionalProperties: false,
   53: 
   54:   properties: {
   55:     source:        { type: 'string', minLength: 1 },
   56:     predicate,
   57:     also_requires: { type: 'array', items: predicate },
   58:     count_basis:   { type: 'string', enum: ['flat', 'rating'] },
   59:     flat_amount:   { type: 'integer', minimum: 1 },
   60:     excludes_from_threshold: { type: 'array', items: { type: 'string', minLength: 1 } },
   61:     notes:         { type: 'string' },
   62:     created_at:    { type: 'string' },
   63:     updated_at:    { type: 'string' },
   64:   },
   65: };
   66: 
   67: /**
   68:  * Structural checks the JSON Schema cannot express readably. Returns an error
   69:  * string, or null when the doc is fine.
   70:  *
   71:  * NOTE on the story's "cyclic-reference check": ADR-001 explicitly permits a
   72:  * rule whose predicate references its own source ("PT references its own
   73:  * rating"); what it forbids is a grant whose *target* is its own source. This
   74:  * collection has no target — the output is successes, not a trait — so no
   75:  * cycle is constructible, and the v1 seed itself is source ===
   76:  * predicate.name ('Stronger Than You' gated on holding Stronger Than You).
   77:  * The genuinely useful structural guards are the two below.
   78:  */
   79: export function checkBonusSuccessDoc(body) {
   80:   if (!body || typeof body !== 'object') return 'body must be an object';
   81: 
   82:   const preds = [body.predicate, ...(Array.isArray(body.also_requires) ? body.also_requires : [])];
   83:   for (const p of preds) {
   84:     if (p && p.kind !== 'merit_present' && p.min_rating !== undefined) {
   85:       return `min_rating is only valid on a merit_present predicate (got kind '${p.kind}')`;
   86:     }
   87:   }
   88: 
   89:   if (body.count_basis === 'rating' && body.predicate?.kind !== 'merit_present') {
   90:     return "count_basis 'rating' requires a merit_present predicate — there is no rating to read otherwise";
   91:   }
   92: 
   93:   if (body.count_basis === 'flat' && body.flat_amount === undefined) {
   94:     return "count_basis 'flat' requires flat_amount";
   95:   }
   96: 
   97:   return null;
   98: }
--- server/scripts/seed-rules-bonus-successes.js ---
    1: /**
    2:  * Seed script — inserts the rule_bonus_success docs (dtlt.1).
    3:  * Idempotent: replaceOne/upsert on a stable composite key.
    4:  *
    5:  * One doc in v1 (scope confirmed by Angelus, 2026-08-31):
    6:  *   Stronger Than You — Strength Performance rank 4. A successful Strength
    7:  *   roll gains one free success. Gated on having actually PICKED the
    8:  *   manoeuvre (fighting_picks[]), not on Strength Performance style dots.
    9:  *
   10:  * Any further "+N successes when X" house rule is a Mongo doc edit through the
   11:  * admin Engine panel, not a code change — that is the whole point of the
   12:  * collection. Add new docs here only when they should ship as defaults.
   13:  *
   14:  * Usage:
   15:  *   node server/scripts/seed-rules-bonus-successes.js --dry-run   (default)
   16:  *   node server/scripts/seed-rules-bonus-successes.js --apply
   17:  *
   18:  * Target DB is the MONGODB_DB env var (default: tm_game).
   19:  * Use MONGODB_DB=tm_game_test for test-DB seeding.
   20:  */
   21: 
   22: import { pathToFileURL } from 'url';
   23: 
   24: // ── Rule docs ─────────────────────────────────────────────────────────────────
   25: 
   26: export const BONUS_SUCCESS_DOCS = [
   27:   {
   28:     doc: {
   29:       source: 'Stronger Than You',
   30:       predicate: { kind: 'manoeuvre_present', name: 'Stronger Than You' },
   31:       also_requires: [{ kind: 'roll_attr', name: 'Strength' }],
   32:       count_basis: 'flat',
   33:       flat_amount: 1,
   34:       notes:
   35:         'Strength Performance rank 4 (public/data/man_db.json): a successful Strength roll adds '
   36:         + 'one free success. Applies only when the roll already scored at least one rolled success. '
   37:         + 'Requires an explicit fighting_picks entry — Strength Performance style dots alone do not '
   38:         + 'grant it.',
   39:     },
   40:     filter: { source: 'Stronger Than You', 'predicate.name': 'Stronger Than You' },
   41:   },
   42: ];
   43: 
   44: // ── Main ─────────────────────────────────────────────────────────────────────
   45: 
   46: async function run() {
   47:   await import('dotenv/config');
   48:   const { MongoClient } = await import('mongodb');
   49: 
   50:   const DRY_RUN = !process.argv.includes('--apply');
   51:   const MONGODB_URI = process.env.MONGODB_URI;
   52:   const DB_NAME = process.env.MONGODB_DB || 'tm_game';
   53: 
   54:   if (!MONGODB_URI) {
   55:     console.error('MONGODB_URI not set — ensure server/.env is present.');
   56:     process.exit(1);
   57:   }
   58: 
   59:   const strip = (uri) => uri.replace(/[&?]ssl=[^&]*/g, '');
   60:   const client = new MongoClient(strip(MONGODB_URI), { serverSelectionTimeoutMS: 5000, tls: true });
   61:   await client.connect();
   62:   const db = client.db(DB_NAME);
   63:   const now = new Date().toISOString();
   64: 
   65:   console.log(`[seed-rules-bonus-successes] ${DRY_RUN ? 'DRY RUN' : 'APPLY'} → ${DB_NAME}`);
   66: 
   67:   for (const { doc, filter } of BONUS_SUCCESS_DOCS) {
   68:     const existing = await db.collection('rule_bonus_success').findOne(filter);
   69:     console.log(`  [rule_bonus_success] ${existing ? 'EXISTS (upsert will refresh)' : 'INSERT'} — ${doc.source}`);
   70:     console.log(`    doc:   `, JSON.stringify({ ...doc, created_at: now, updated_at: now }));
   71: 
   72:     if (!DRY_RUN) {
   73:       await db.collection('rule_bonus_success').replaceOne(
   74:         filter,
   75:         { ...doc, created_at: existing?.created_at || now, updated_at: now },
   76:         { upsert: true },
   77:       );
   78:       console.log(`    → written`);
   79:     }
   80:   }
   81: 
   82:   console.log(`\n[seed-rules-bonus-successes] ${DRY_RUN ? 'Dry run complete — pass --apply to write.' : 'Done.'}`);
   83:   await client.close();
   84: }
   85: 
   86: // Only connect when invoked directly. Importing this module (tests read
   87: // BONUS_SUCCESS_DOCS as the single source of truth for the seed) must never
   88: // open a Mongo connection or load dotenv over the test harness's env.
   89: const _invokedDirectly = process.argv[1]
   90:   && import.meta.url === pathToFileURL(process.argv[1]).href;
   91: 
   92: if (_invokedDirectly) {
   93:   run().catch(err => {
   94:     console.error('[seed-rules-bonus-successes] Error:', err.message);
   95:     process.exit(1);
   96:   });
   97: }
--- server/routes/rules-engine.js ---
    1: import { Router } from 'express';
    2: import { ObjectId } from 'mongodb';
    3: import { getCollection } from '../db.js';
    4: import { validate } from '../middleware/validate.js';
    5: import { ruleGrantSchema } from '../schemas/rules/rule-grant.schema.js';
    6: import { ruleSpecialityGrantSchema } from '../schemas/rules/rule-speciality-grant.schema.js';
    7: import { ruleSkillBonusSchema } from '../schemas/rules/rule-skill-bonus.schema.js';
    8: import { ruleNineAgainSchema } from '../schemas/rules/rule-nine-again.schema.js';
    9: import { ruleDiscAttrSchema } from '../schemas/rules/rule-disc-attr.schema.js';
   10: import { ruleDerivedStatModifierSchema } from '../schemas/rules/rule-derived-stat-modifier.schema.js';
   11: import { ruleTierBudgetSchema } from '../schemas/rules/rule-tier-budget.schema.js';
   12: import { ruleStatusFloorSchema } from '../schemas/rules/rule-status-floor.schema.js';
   13: import { ruleBonusSuccessSchema, checkBonusSuccessDoc } from '../schemas/rules/rule-bonus-success.schema.js';
   14: 
   15: function makeRulesRouter(collectionName, schema, { postCheck } = {}) {
   16:   const router = Router();
   17:   const col = () => getCollection(collectionName);
   18: 
   19:   router.get('/', async (req, res) => {
   20:     const docs = await col().find({}).sort({ _id: 1 }).toArray();
   21:     res.json(docs);
   22:   });
   23: 
   24:   router.get('/:id', async (req, res) => {
   25:     let oid;
   26:     try { oid = new ObjectId(req.params.id); } catch { return res.status(404).json({ error: 'NOT_FOUND' }); }
   27:     const doc = await col().findOne({ _id: oid });
   28:     if (!doc) return res.status(404).json({ error: 'NOT_FOUND' });
   29:     res.json(doc);
   30:   });
   31: 
   32:   router.post('/', validate(schema), async (req, res) => {
   33:     if (postCheck) {
   34:       const checkErr = postCheck(req.body);
   35:       if (checkErr) return res.status(400).json({ error: 'VALIDATION_ERROR', message: checkErr });
   36:     }
   37:     const doc = { ...req.body, created_at: new Date().toISOString(), updated_at: new Date().toISOString() };
   38:     const result = await col().insertOne(doc);
   39:     const created = await col().findOne({ _id: result.insertedId });
   40:     res.status(201).json(created);
   41:   });
   42: 
   43:   router.put('/:id', validate(schema), async (req, res) => {
   44:     let oid;
   45:     try { oid = new ObjectId(req.params.id); } catch { return res.status(404).json({ error: 'NOT_FOUND' }); }
   46:     if (postCheck) {
   47:       const checkErr = postCheck(req.body);
   48:       if (checkErr) return res.status(400).json({ error: 'VALIDATION_ERROR', message: checkErr });
   49:     }
   50:     const { _id, ...body } = req.body;
   51:     body.updated_at = new Date().toISOString();
   52:     const result = await col().findOneAndUpdate(
   53:       { _id: oid },
   54:       { $set: body },
   55:       { returnDocument: 'after' },
   56:     );
   57:     if (!result) return res.status(404).json({ error: 'NOT_FOUND' });
   58:     res.json(result);
   59:   });
   60: 
   61:   router.delete('/:id', async (req, res) => {
   62:     let oid;
   63:     try { oid = new ObjectId(req.params.id); } catch { return res.status(404).json({ error: 'NOT_FOUND' }); }
   64:     const result = await col().deleteOne({ _id: oid });
   65:     if (result.deletedCount === 0) return res.status(404).json({ error: 'NOT_FOUND' });
   66:     res.status(204).end();
   67:   });
   68: 
   69:   return router;
   70: }
   71: 
   72: export const grantRouter = makeRulesRouter('rule_grant', ruleGrantSchema, {
   73:   postCheck(body) {
   74:     if (body.source && body.target && body.source === body.target) {
   75:       return 'source and target must not be the same merit (cyclic self-grant)';
   76:     }
   77:     return null;
   78:   },
   79: });
   80: 
   81: export const specialityGrantRouter = makeRulesRouter('rule_speciality_grant', ruleSpecialityGrantSchema);
   82: export const skillBonusRouter      = makeRulesRouter('rule_skill_bonus',       ruleSkillBonusSchema);
   83: export const nineAgainRouter       = makeRulesRouter('rule_nine_again',        ruleNineAgainSchema);
   84: export const discAttrRouter        = makeRulesRouter('rule_disc_attr',         ruleDiscAttrSchema);
   85: export const derivedStatModRouter  = makeRulesRouter('rule_derived_stat_modifier', ruleDerivedStatModifierSchema);
   86: export const tierBudgetRouter      = makeRulesRouter('rule_tier_budget',       ruleTierBudgetSchema);
   87: export const statusFloorRouter     = makeRulesRouter('rule_status_floor',      ruleStatusFloorSchema);
   88: 
   89: // dtlt.1: the ninth family — roll-time "+N successes when X" rules. The
   90: // postCheck carries the structural guards the JSON Schema cannot state
   91: // readably (min_rating is merit_present-only; a 'rating' count needs a merit
   92: // to read the rating from). See the schema file for why there is no
   93: // source-vs-predicate cyclic check: this collection has no target trait, so no
   94: // cycle is constructible, and the v1 seed is legitimately self-referencing.
   95: export const bonusSuccessRouter    = makeRulesRouter('rule_bonus_success',     ruleBonusSuccessSchema, {
   96:   postCheck: checkBonusSuccessDoc,
   97: });
   98: 
   99: /**
  100:  * Issue #256 (perf): coalesce 7 rule-engine endpoints into a single
  101:  * round-trip used by `preloadRules` on the client. Cuts boot latency
  102:  * from 7 parallel TLS+auth round-trips to 1.
  103:  *
  104:  * GET /api/rules/aggregate?categories=grant,nine_again,...
  105:  *   → { rule_grant: [...], rule_nine_again: [...], ... }
  106:  *
  107:  * Auth: ST/dev only (mounted with the same `requireRole('st')` gate as
  108:  * the individual rule-engine endpoints in index.js — composes cleanly
  109:  * because every category has identical auth semantics).
  110:  *
  111:  * The 7 existing per-category endpoints stay in place for admin
  112:  * tooling that writes / inspects them individually.
  113:  */
  114: const ALLOWED_RULE_CATEGORIES = new Set([
  115:   'grant',
  116:   'nine_again',
  117:   'skill_bonus',
  118:   'speciality_grant',
  119:   'tier_budget',
  120:   'disc_attr',
  121:   'derived_stat_modifier',
  122:   'status_floor',
  123:   // dtlt.1 — roll-time bonus successes. Included here so the client's single
  124:   // aggregate round-trip picks it up alongside the render-time families.
  125:   'bonus_success',
  126: ]);
  127: 
  128: export const rulesAggregateRouter = Router();
  129: 
  130: rulesAggregateRouter.get('/', async (req, res) => {
  131:   const raw = req.query.categories;
  132:   if (!raw) {
  133:     return res.status(400).json({ error: 'VALIDATION_ERROR', message: 'categories query param required' });
  134:   }
  135:   const categories = String(raw)
  136:     .split(',')
  137:     .map(c => c.trim())
  138:     .filter(Boolean);
  139:   if (!categories.length) {
  140:     return res.status(400).json({ error: 'VALIDATION_ERROR', message: 'categories cannot be empty' });
  141:   }
  142:   const invalid = categories.filter(c => !ALLOWED_RULE_CATEGORIES.has(c));
  143:   if (invalid.length) {
  144:     return res.status(400).json({
  145:       error: 'VALIDATION_ERROR',
  146:       message: `Unknown rule categories: ${invalid.join(', ')}`,
  147:       allowed: [...ALLOWED_RULE_CATEGORIES],
  148:     });
  149:   }
  150:   // Deduplicate so a malformed `categories=grant,grant` doesn't double-query.
  151:   const uniq = [...new Set(categories)];
  152:   // Fire all category queries in parallel. Each backed by the same
  153:   // `rule_<category>` collection the individual routers use, so the
  154:   // wire format and semantics are identical.
  155:   const arrays = await Promise.all(
  156:     uniq.map(cat => getCollection(`rule_${cat}`).find({}).toArray())
  157:   );
  158:   const result = {};
  159:   for (let i = 0; i < uniq.length; i++) {
  160:     result[`rule_${uniq[i]}`] = arrays[i];
  161:   }
  162:   res.json(result);
  163: });
