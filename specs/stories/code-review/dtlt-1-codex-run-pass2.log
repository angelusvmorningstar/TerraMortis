+  it('resolveBonusSuccesses returns [] when rolledSuccesses is absent from the context', () => {
+    expect(resolveBonusSuccesses(charWithSTY(), STRENGTH_CRAFTS, [STY_RULE])).toEqual([]);
+  });
+});
+
+// ── Display breakdown ────────────────────────────────────────────────────────
+
+describe('formatSuccessBreakdown', () => {
