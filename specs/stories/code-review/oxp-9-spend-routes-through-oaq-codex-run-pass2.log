 287: // write, which is the ordering office-actions.js adopted after a real
 288: // concurrent-accept race reached its later writes on both sides. The loser
 289: // must never reach the purchase write.
 290: router.put('/:id/accept', requireRole('st'), async (req, res) => {
 291:   const pending = await _findPendingPurchase(req, res);
 292:   if (!pending) return;
 293: 
 294:   const client = getClient();
 295:   const dbSession = client.startSession();
 296:   let statusCode, body;
 297:   try {
 298:     await dbSession.withTransaction(async () => {
 299:       const seatId = pending.seat_id;
 300:       let seatOid;
 301:       try { seatOid = new ObjectId(seatId); }
 302:       catch { throw new RouteResponse(400, { error: 'VALIDATION_ERROR', message: 'Invalid seat_id on request' }); }
 303: 
 304:       // Re-read LIVE, inside the transaction. Everything below is judged
 305:       // against current state, never against whatever was true at submission.
 306:       const seat = await seatsCol().findOne({ _id: seatOid }, { session: dbSession });
