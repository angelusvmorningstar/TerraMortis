 309:       const officeEntry = OFFICE_DATA[seat.office_category];
 310:       if (!officeEntry)
 311:         throw new RouteResponse(400, {
 312:           error: 'VALIDATION_ERROR',
 313:           message: `This seat's office ('${seat.office_category}') has no rules entry yet`,
 314:         });
