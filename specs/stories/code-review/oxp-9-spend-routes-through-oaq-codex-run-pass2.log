 316:       // officeSeatXp needs EVERY seat to establish spendKnown for this seat's
 317:       // category. This story never reads spendKnown, only earned/spent/left,
 318:       // but the function still has to be called correctly.
 319:       const allSeats         = await seatsCol().find({}, { session: dbSession }).toArray();
 320:       const meritDotsDoc     = await meritDotsCol().findOne({ _id: seatId }, { session: dbSession });
 321:       const manoeuvreRankDoc = await manoeuvreCol().findOne({ _id: seatId }, { session: dbSession });
