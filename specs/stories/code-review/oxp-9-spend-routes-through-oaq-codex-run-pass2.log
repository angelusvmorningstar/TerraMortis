 249: /**
 250:  * The combined per-seat XP position (AC5).
 251:  *
 252:  * @param {object} seat - one `office_seats` document
 253:  * @param {Array<object>} allSeats - every seat document, so the seat count for
 254:  *   this seat's category can be established (see `officeSpendKnownByCategory`).
 255:  *   `seat` should be one of `allSeats`; if it genuinely is not, `spendKnown`
 256:  *   is forced `false` rather than trusting a possibly-incomplete count.
 257:  * @param {object|undefined|null} meritDotsDoc - this SEAT's merit dots. Before
 258:  *   oxp.11 the only thing that existed was the category's shared document;
 259:  *   after it, purchase documents are keyed by `office_seats._id` and this seat's
 260:  *   own document is what a caller should pass.
 261:  * @param {number|object|undefined|null} manoeuvreRankDoc - this SEAT's rank
 262:  * @param {string|Date} now - caller-supplied evaluation date
 263:  * @returns {{ earned: number, spent: number, left: number, spendKnown: boolean }}
 264:  *
 265:  * `earned` is always this seat's own, exact figure: it derives from this
 266:  * seat's `created_at` and nothing else, so two seats in the same office
 267:  * created in different months correctly differ.
 268:  *
 269:  * `spent` and `left` are always real numbers so no caller crashes on
 270:  * undefined. `spendKnown` is retained from oxp.2 and still reports `false` for
 271:  * a multi-seat office, even though oxp.11's seat-keying means spend genuinely
 272:  * IS attributable now. It fails safe in that direction, it has no consumer, and
 273:  * its retirement belongs with the first one (oxp.6 or oxp.7). Never simplify it
 274:  * away by defaulting it to true.
 275:  *
 276:  * `left` is allowed to go negative, and still is after oxp.9. That story added
 277:  * a budget check on the APPROVAL PATH ONLY: a holder-initiated purchase goes
 278:  * through `/api/office_purchase_requests`, and its ST-accept route refuses to
 279:  * apply the purchase unless `officeSeatXp(...).left >= 1`, computed against
 280:  * documents re-read inside the same transaction. The ST's own direct-set
 281:  * routes (`PUT /api/office_merit_dots/:seatId`,
 282:  * `PUT /api/office_manoeuvre_rank/:seatId(/step)`) deliberately still have NO
 283:  * budget check, so an office can genuinely show more purchased than earned;
 284:  * clamping to 0 here would hide that. Three concrete reasons that stays true:
 285:  * the down-steppers are a correction path, not spend; STs still need to seed
 286:  * and correct historical purchase state that predates this economy; and
 287:  * office-tab.js's "N over budget" line only works because a negative `left` is
 288:  * representable. Do not "fix" this by clamping.
 289:  *
 290:  * `spendKnown` is forced `false` — never inferred from `allSeats` alone — if
 291:  * `seat` itself cannot be found in `allSeats` (Codex review, oxp.2: a caller
 292:  * passing a stale or filtered `allSeats` that omits the very seat being
 293:  * evaluated made a genuinely multi-seat category undercount to 1 and report
 294:  * `spendKnown: true`, exactly the false-confidence outcome this flag exists
 295:  * to prevent). The failure direction is deliberately one-sided: an
 296:  * inconsistent call can only make this MORE cautious, never falsely
 297:  * confident, so a well-formed call (`seat` really is one of `allSeats`) is
 298:  * completely unaffected.
 299:  */
 300: export function officeSeatXp(seat, allSeats, meritDotsDoc, manoeuvreRankDoc, now) {
 301:   const earned = officeXpEarned(seat, now);
 302:   const spent = officeXpSpentForCategory(meritDotsDoc, manoeuvreRankDoc);
 303:   const seatIsIncluded = Array.isArray(allSeats) && allSeats.some(s =>
 304:     s === seat || (seat && s && seat._id != null && s._id != null && String(seat._id) === String(s._id))
 305:   );
 306:   const spendKnown = seatIsIncluded && officeSpendKnownByCategory(allSeats)[seat.office_category] === true;
 307: 
 308:   return { earned, spent, left: earned - spent, spendKnown };
 309: }

