  54:  * @returns {Promise<{seatId?:string, seat?:object, category?:string, officeEntry?:object, error?:{status:number, body:object}}>}
  55:  */
  56: export async function resolveOfficeSeat(seatId) {
  57:   if (typeof seatId !== 'string' || !SEAT_ID_PATTERN.test(seatId)) {
  58:     return {
  59:       error: {
  60:         status: 400,
  61:         body: {
  62:           error: 'VALIDATION_ERROR',
  63:           message: 'Seat id must be a 24-character hexadecimal office_seats id',
  64:         },
  65:       },
  66:     };
  67:   }
  68: 
  69:   const normalised = seatId.toLowerCase();
  70:   const seat = await getCollection('office_seats').findOne({ _id: new ObjectId(normalised) });
  71:   if (!seat) {
  72:     return {
  73:       error: {
  74:         status: 404,
  75:         body: { error: 'NOT_FOUND', message: 'No office seat with that id' },
  76:       },
  77:     };
  78:   }
  79: 
  80:   const category = seat.office_category;
  81:   const officeEntry = OFFICE_DATA[category];
  82:   if (!officeEntry) {
  83:     return {
  84:       error: {
  85:         status: 400,
  86:         body: {
  87:           error: 'VALIDATION_ERROR',
  88:           message: `This seat's office ('${category}') has no rules entry yet`,
  89:         },
  90:       },
  91:     };
  92:   }
  93: 
  94:   return { seatId: normalised, seat, category, officeEntry };
  95: }
