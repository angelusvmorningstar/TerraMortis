 334:         const holderId = seat.holder_id == null ? null : String(seat.holder_id);
 335:         if (holderId !== String(pending.requested_by_character_id))
 336:           throw new RouteResponse(403, {
 337:             error: 'FORBIDDEN',
 338:             message: 'The requester no longer holds this seat',
 339:           });
 340:       }
 341: 
 342:       // THE authoritative budget check. The only enforcement point in oxp.9.
 343:       const balance = officeSeatXp(seat, allSeats, meritDotsDoc, manoeuvreRankDoc, new Date());
 344:       if (balance.left < 1)
 345:         throw new RouteResponse(403, {
 346:           error: 'FORBIDDEN',
 347:           message: `Not enough office XP (${1 - balance.left} short)`,
 348:         });
 349: 
 350:       const timestamp = new Date().toISOString();
 351:       const resolved_by = req.user.username;
 352:       const outcome = {
 353:         purchase_kind: pending.purchase_kind,
 354:         merit:         pending.merit ?? null,
 355:         from,
 356:         to,
 357:         xp_cost:       1,
 358:         earned:        balance.earned,
 359:         spent_before:  balance.spent,
