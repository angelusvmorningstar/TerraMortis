+   const bpXP = (c.bp_creation || {}).xp !== undefined
+     ? ((c.bp_creation || {}).xp || 0)
+     : Math.max(0, (c.blood_potency || 1) - 1 - Math.floor(((c.bp_creation || {}).cp || 0) / 5)) * 5;
