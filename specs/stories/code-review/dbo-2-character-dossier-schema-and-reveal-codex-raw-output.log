200: // Summary-tier fact visibility (AC #5), enforced server-side:
201: //   - a fact with st_hidden !== true is always visible;
202: //   - a fact with st_hidden === true is visible ONLY if one of the viewer's own
203: //     character ids appears in the fact's revealed_to array;
204: //   - a missing/null revealed_to means "revealed to no one".
205: // String-normalised on both sides so an ObjectId-vs-string mismatch can't
206: // accidentally reveal (or accidentally hide) a fact.
207: export function filterFactsForViewer(facts, viewer) {
208:   if (!Array.isArray(facts)) return [];
209:   const viewerIds = Array.isArray(viewer?.character_ids) ? viewer.character_ids.map(String) : [];
210:   return facts.filter((fact) => {
211:     if (fact.st_hidden !== true) return true;
212:     const revealed = Array.isArray(fact.revealed_to) ? fact.revealed_to.map(String) : [];
213:     return viewerIds.some((vid) => revealed.includes(vid));
214:   });
215: }
