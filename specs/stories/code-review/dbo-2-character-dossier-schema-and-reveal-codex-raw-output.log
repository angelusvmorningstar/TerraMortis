import 'dotenv/config';
import { MongoClient } from 'mongodb';
import { DOSSIER_TAGS } from '../schemas/character_dossier.schema.js';
const c = new MongoClient(process.env.MONGODB_URI); await c.connect();
const db = c.db('tm_suite');
const docs = await db.collection('character_dossier').find({}).toArray();
const allFacts = docs.flatMap(d => (d.facts || []).map(f => ({ ...f, _char: d.character_id })));
console.log(`dossiers: ${docs.length} | facts: ${allFacts.length} | avg ${(allFacts.length/docs.length).toFixed(1)}/char\n`);

// 1. tag inventory + drift
const tagCount = {};
for (const f of allFacts) tagCount[f.tag] = (tagCount[f.tag]||0)+1;
const known = new Set(DOSSIER_TAGS);
console.log('TAGS used:', Object.entries(tagCount).sort((a,b)=>b[1]-a[1]).map(([t,n])=>`${t}:${n}${known.has(t)?'':' <DRIFT>'}`).join(', '));

// 2. source inventory
const srcCount = {};
for (const f of allFacts) srcCount[f.source||'(none)'] = (srcCount[f.source||'(none)']||0)+1;
console.log('SOURCES:', Object.entries(srcCount).map(([s,n])=>`${s}:${n}`).join(', '));

// 3. stateful completeness
const secrets = allFacts.filter(f=>f.tag==='secret');
const oblig = allFacts.filter(f=>f.tag==='boon'||f.tag==='debt');
console.log(`\nSECRETS: ${secrets.length} | missing severity: ${secrets.filter(f=>!f.severity).length} | compromised unset: ${secrets.filter(f=>f.compromised==null).length} | st_hidden unset: ${secrets.filter(f=>f.st_hidden!==true).length}`);
console.log(`OBLIGATIONS: ${oblig.length} | missing status: ${oblig.filter(f=>!f.status).length} | missing counterparty: ${oblig.filter(f=>!f.counterparty).length}`);
console.log('  counterparty values (free-text vs id):');
for (const f of oblig) console.log(`    ${f.tag} -> "${f.counterparty}" ${/^[0-9a-f]{24}$/.test(String(f.counterparty))?'(id)':'(NAME - not a ref)'}`);

// 4. people-referencing facts: linkage rate
const peopleTags = ['sire','brood_sibling','family_member','notable_ally','notable_enemy'];
const peopleFacts = allFacts.filter(f=>peopleTags.includes(f.tag));
const linked = peopleFacts.filter(f=>f.npc_id);
console.log(`\nPEOPLE-REF facts: ${peopleFacts.length} | with npc_id: ${linked.length} | UNLINKED (names only in prose): ${peopleFacts.length-linked.length}`);

// 5. duplicates (same char+tag+normalised value)
const seen = new Map(); let dups=0;
for (const f of allFacts){ const k = String(f._char)+'|'+f.tag+'|'+String(f.value).toLowerCase().replace(/\s+/g,' ').slice(0,40); if (seen.has(k)) dups++; else seen.set(k,1); }
console.log(`\nDUPLICATE-ish facts (char+tag+value prefix): ${dups}`);

// 6. value length distribution (prose-heaviness)
const lens = allFacts.map(f=>String(f.value).length).sort((a,b)=>a-b);
console.log(`VALUE length: min ${lens[0]} / median ${lens[Math.floor(lens.length/2)]} / p90 ${lens[Math.floor(lens.length*0.9)]} / max ${lens[lens.length-1]}`);

// 7. structured-data candidates trapped in prose
const yearish = allFacts.filter(f=>/\b(18|19|20)\d\d\b/.test(String(f.value))).length;
console.log(`facts containing a YEAR in prose (structured-date candidates): ${yearish}`);

// 8. is the schema enforced? check collection validator
const info = await db.listCollections({ name:'character_dossier' }).toArray();
console.log(`\nDB-level validator on character_dossier: ${info[0]?.options?.validator ? 'YES' : 'NONE (schema is documentation-only)'}`);
await c.close();

