     let stampedHere = 0;
 
     for (const i of row.indices) {
-      const fact = facts[i];
-      // Index no longer exists, or already carries a key as of the fresh read.
-      if (!fact || typeof fact !== 'object') continue;
-      if (Object.prototype.hasOwnProperty.call(fact, 'fact_key')) continue;
-
-      const result = await collection.updateOne(
-        { _id: row._id, [`facts.${i}.fact_key`]: { $exists: false } },
+      const fact = facts[i];
+      // Index no longer exists, or already carries a key as of the fresh read.
+      if (!fact || typeof fact !== 'object') continue;
+      if (Object.prototype.hasOwnProperty.call(fact, 'fact_key')) continue;
+
+      const result = await collection.updateOne(
+        { _id: row._id, [`facts.${i}.fact_key`]: { $exists: false } },
         { $set: { [`facts.${i}.fact_key`]: mint() } }
       );
       if (result.modifiedCount === 1) stampedHere += 1;
