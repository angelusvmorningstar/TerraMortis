import { MongoClient, ObjectId } from 'mongodb';
import { readFileSync, writeFileSync } from 'node:fs';
const c = new MongoClient(process.env.MONGODB_URI); await c.connect();
const db = c.db('tm_suite');
const now = '2026-06-21T14:00:00Z';
const by = { type:'st', id:'geography-build' };

// --- 1. locations collection from KMZ ---
const feats = JSON.parse(readFileSync('server/scripts/_locations.json','utf-8'));
const typeOf = layer => layer==='Vampires' ? 'territory' : (layer==='Old Cov HQs' ? 'hq' : 'zone');
await db.collection('locations').deleteMany({ source: 'kmz' });
for (const f of feats) {
  await db.collection('locations').insertOne({ type: typeOf(f.layer), layer: f.layer, name: f.name,
    real_place: f.description||null, centroid: f.centroid, polygon: f.polygon, source:'kmz', created_at: now });
}
console.log(`locations: wrote ${feats.length} map features (territories/HQs/zones).`);

// --- 2. DT4 havens ---
const subs = await db.collection('downtime_submissions').find({ cycle_id:new ObjectId('6a11a3814fce658310cdee80') }).toArray();
const chars = await db.collection('characters').find({}).project({name:1,moniker:1}).toArray();
const norm = s=>String(s||'').toLowerCase().replace(/[^a-z0-9]/g,'');
const findCh = nm => chars.find(c=>{ const a=norm(c.name),b=norm(c.moniker),n=norm(nm); return (a&&(a.includes(n)||n.includes(a)))||(b&&b===n); });
const TERR = { pyrmont:'The Harbour', ultimo:'The Harbour', darlinghurst:'The Harbour', chinatown:'The Harbour', sydney:'The Harbour', dixon:'The Harbour', goulburn:'The Harbour', necropolis:'The Harbour', drummoyne:'The Harbour',
  parramatta:'The Second City', newtown:'The Academy', 'st peters':'The Academy', redfern:'The Academy', canterbury:'The Academy', mosman:'The Shore',
  'la perouse':'The Port', botany:'The Port', londonderry:'Barrens/outside', 'duffy':'Barrens/outside', cowan:'Barrens/outside', yagoona:'Barrens/outside' };
const guessTerr = addr => { const a=addr.toLowerCase(); for (const [k,v] of Object.entries(TERR)) if (a.includes(k)) return v; return '(unknown)'; };
const skip = v => !v || /^(none|same as|sorry|it's in|what carver|i moved|moving from)/i.test(v.trim()) ? false : true; // keep most; flag refs

await db.collection('locations').deleteMany({ type:'haven' });
const csv = [['Character','Haven','Suburb/Place','Likely Territory','Note']];
let havenFacts=0, havenLocs=0;
for (const s of subs) {
  const raw = (s.responses?.safe_place_location_0 || '').trim();
  if (!raw) continue;
  const ch = findCh(s.character_name);
  const terr = guessTerr(raw);
  const isRef = /^(same as|sorry|it's in|what carver|i forget)/i.test(raw);
  // location doc
  await db.collection('locations').insertOne({ type:'haven', layer:'Havens', name:`${s.character_name} haven`, character:s.character_name,
    character_id: ch?String(ch._id):null, address: raw, territory: terr, source:'dt4', created_at: now });
  havenLocs++;
  // dossier haven fact
  if (ch && !isRef) {
    await db.collection('character_dossier').updateOne({ character_id: ch._id }, { $pull:{ facts:{ tag:'haven' } } });
    await db.collection('character_dossier').updateOne({ character_id: ch._id }, { $setOnInsert:{ character_id: ch._id }, $push:{ facts:{ tag:'haven', value: raw, source:'downtime', since:'DT4' } }, $set:{ updated_at: now } }, { upsert:true });
    havenFacts++;
  }
  csv.push([s.character_name, raw.replace(/\s+/g,' '), raw.split(',').slice(-2).join(',').trim().slice(0,40), terr, isRef?'(references prior cycle)':'']);
}
writeFileSync('data/exports/tm_havens_for_map.csv', csv.map(r=>r.map(x=>`"${String(x).replace(/"/g,'""')}"`).join(',')).join('\n'));
console.log(`havens: ${havenLocs} location docs, ${havenFacts} dossier facts, CSV -> data/exports/tm_havens_for_map.csv`);

// --- 3. coterie edges from shared havens ---
const id = async rx => { const ch = chars.find(c=>new RegExp(rx,'i').test(c.name)); return ch?String(ch._id):null; };
const COTERIE = [
  ['René Meyer','Einar Solveig','shared haven: Birkenhead Marina, Drummoyne'],
  ['Carver','Hazel','shared haven: Endeavour Ave, La Perouse'],
  ['Brandy LaRoux','Cyrus Reynolds','coterie (Brandy stated)'],
  ['Brandy LaRoux','Alice Vunder','coterie (Brandy stated)'],
  ['Cyrus Reynolds','Alice Vunder','coterie (Brandy stated)'],
];
let edges=0;
for (const [a,b,note] of COTERIE) {
  const ai=await id(a), bi=await id(b); if(!ai||!bi) { console.log(`(missing ${a} or ${b})`); continue; }
  const ex = await db.collection('relationships').findOne({ kind:'coterie', $or:[{'a.id':ai,'b.id':bi},{'a.id':bi,'b.id':ai}] });
  if (ex) continue;
  await db.collection('relationships').insertOne({ a:{type:'pc',id:ai}, b:{type:'pc',id:bi}, kind:'coterie', direction:'mutual', disposition:'positive', state:note, st_hidden:false, status:'active', created_by:by, history:[{at:now,by,change:'created (shared haven)'}], created_at:now, updated_at:now });
  edges++;
}
console.log(`coterie edges created: ${edges}`);
console.log(`\nlocations total: ${await db.collection('locations').countDocuments()}`);
await c.close();


