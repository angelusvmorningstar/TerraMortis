 */
export function shCommitOath(realIdx) {
  if (state.editIdx < 0) return;
  const c = state.chars[state.editIdx];
  const m = c && c.merits[realIdx];
  if (!m) return;
  const draft = Array.isArray(m._pledge_draft)
    ? m._pledge_draft
    : ((m.sworn_by && m.sworn_by.attachments) || []);
