  177: /** Calls crd.3a's own PUT .../resolve and displays exactly its returned
  178:  *  defender_pool. Guarded against TWO distinct staleness sources (crd.3b code
  179:  *  review, external Codex, Pass 1): _resolveGen orders overlapping resolve
  180:  *  calls WITHIN one mount (matching this codebase's own established shape,
  181:  *  e.g. office-tab.js's _officeManoeuvreGen); _mountGen additionally catches
  182:  *  a call issued by an EARLIER mount landing after a newer mount (even one
  183:  *  for a different challenge) has already taken over this same module state.
  184:  *  Also guarded against apiRaw itself REJECTING (a thrown fetch, not just a
  185:  *  non-OK response — e.g. a dropped connection) via try/catch/finally, so a
  186:  *  network failure can never leave `resolving` latched true forever with no
  187:  *  way for the player to recover. */
  188: async function _resolve(rootEl) {
  189:   if (!state.aspect) { state.pool = null; _render(rootEl); return; }
  190: 
  191:   const myMount = _mountGen;
  192:   const gen = ++_resolveGen;
  193:   state.resolving = true;
  194:   _render(rootEl);
  195: 
  196:   let res;
  197:   try {
  198:     res = await apiRaw('PUT', `/api/contested_roll_requests/${state.challengeId}/resolve`, {
  199:       defender_aspect:      state.aspect,
  200:       defender_wp_spent:    state.wpOn,
  201:       defender_merit_ids:   Array.from(state.meritIds),
  202:       defender_status_term: state.statusTerm,
  203:     });
  204:   } catch {
  205:     res = { ok: false, body: { message: 'Could not reach the server, try again.' } };
  206:   }
  207: 
  208:   if (myMount !== _mountGen || gen !== _resolveGen) return; // superseded
  209:   state.resolving = false;
