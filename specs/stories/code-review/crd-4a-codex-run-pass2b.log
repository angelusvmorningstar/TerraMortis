  363:   // Log to session_logs directly (session_logs HTTP endpoint is ST-only)
  364:   try {
  365:     await logCol().insertOne({
  366:       session_date:  new Date().toISOString().slice(0, 10),
  367:       type:          'player_contested_roll',
  368:       roll_type:     challenge.roll_type,
  369:       power_name:    challenge.power_name || null,
  370:       challenge_id:  String(challenge._id),
  371:       attacker:      outcomeData.attacker,
  372:       defender:      outcomeData.defender,
  373:       outcome,
  374:       margin,
  375:       timestamp:     new Date().toISOString(),
