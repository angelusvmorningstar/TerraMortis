   60: // ── Element stub — mirrors crd-2's own makeRoot() shape ────────────────────
   61: 
   62: function makeRoot() {
   63:   const fakeEl = { appendChild: vi.fn() };
   64:   const listeners = [];
   65:   return {
   66:     _html: '',
   67:     get innerHTML() { return this._html; },
   68:     set innerHTML(v) { this._html = v; },
   69:     // Not real DOM traversal — a stable stand-in, same trick crd-2's own
   70:     // stub uses for [data-cq-body]. Good enough to prove mkColsEl is CALLED
   71:     // with the right data; real pixel rendering is a browser-verification
   72:     // concern, not this stub's job.
   73:     querySelector: sel => (
   74:       sel === '[data-cr-defender-rolls]' || sel === '[data-cr-attacker-rolls]' ? fakeEl : null
   75:     ),
   76:     addEventListener: (type, fn) => listeners.push([type, fn]),
   77:     click(target) { for (const [t, fn] of listeners) if (t === 'click') fn({ target }); },
   78:   };
   79: }
   80: 
   81: function targetOf(selector, { disabled = false } = {}) {
   82:   return {
   83:     closest: sel => (sel === selector
   84:       ? { dataset: {}, disabled, classList: { contains: c => c === 'disabled' && disabled } }
   85:       : null),
   86:   };
   87: }
   88: function aspectTarget(aspect) {
   89:   return { closest: sel => (sel === '[data-cr-aspect]' ? { dataset: { crAspect: aspect } } : null) };
   90: }
   91: function meritTarget(key) {
   92:   return { closest: sel => (sel === '[data-cr-merit]' ? { dataset: { crMerit: key } } : null) };
   93: }
   94: function statusTermTarget(term) {
   95:   return { closest: sel => (sel === '[data-cr-status-term]' ? { dataset: { crStatusTerm: term } } : null) };
   96: }
