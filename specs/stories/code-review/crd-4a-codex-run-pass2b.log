   16: const REDACT_BLOCK = '\u2588';
   17: 
   18: export function isRedactMode() {
   19:   if (getRole() !== 'dev') return false;
   20:   // Don't redact on the player portal — dev users see their own characters there
   21:   if (location.pathname.startsWith('/player')) return false;
   22:   // Don't redact when dev has Player Mode active
   23:   if (sessionStorage.getItem('tm_view_mode') === 'player') return false;
   24:   return true;
   25: }
   26: 
   27: /** Replace a name-like string with a block-character placeholder.
   28:  *  Length is clamped so layout stays stable without revealing exact length. */
   29: function _blockOut(s, min = 8, max = 14) {
   30:   if (s == null || s === '') return s;
   31:   const len = Math.max(min, Math.min(max, String(s).length));
   32:   return REDACT_BLOCK.repeat(len);
   33: }
   34: 
   35: /** Wrap a raw player-name string for display. Returns the original string
   36:  *  for non-dev roles; otherwise returns a block-character redaction. */
   37: export function redactPlayer(s) {
   38:   return isRedactMode() ? _blockOut(s, 6, 12) : s;
   39: }
   40: 
   41: /** Wrap a raw character-name string for display (use when you need to show
   42:  *  a name that didn't come through displayName(c) — e.g. legacy lookups). */
   43: export function redactCharName(s) {
   44:   return isRedactMode() ? _blockOut(s, 8, 14) : s;
   45: }
