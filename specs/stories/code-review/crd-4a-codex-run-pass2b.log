  346:   let outcome, margin;
  347:   if (atkSuc > defSuc)      { outcome = 'attacker'; margin = atkSuc - defSuc; }
  348:   else if (defSuc > atkSuc) { outcome = 'defender'; margin = defSuc - atkSuc; }
  349:   else                       { outcome = 'draw';     margin = 0; }
