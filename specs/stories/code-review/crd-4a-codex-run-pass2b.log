    1: /**
    2:  * JSON Schema (Draft-07) for TM Character v3.
    3:  *
    4:  * This schema enforces structural correctness — types, required fields,
    5:  * enum values, and array/object shapes. It does NOT enforce business rules
    6:  * such as XP arithmetic, CP budgets, or merit prerequisites.
    7:  * Those require a separate audit layer.
    8:  *
    9:  * v3 changes (PP.9): creation tracking is now inline on each object.
   10:  *   - attr_creation, skill_creation, disc_creation, merit_creation removed
   11:  *   - Attributes, skills, disciplines, merits each embed cp/xp/free + rule_key
   12:  *   - Powers and fighting styles gain rule_key
   13:  *   - Disciplines changed from integer to object { dots, cp, xp, free, rule_key }
   14:  *
   15:  * Known legacy fields still present in real data (not rejected, just tolerated):
   16:  *   - fighting_styles[].up (old alias for free, from Excel import)
   17:  *   - merits[].benefit_grants (old MCI format, pre-migration)
   18:  */
   19: 
   20: /**
   21:  * Derive a partial-update schema: same type/shape validation but no required fields.
   22:  * Used for PUT (partial $set updates) where only some fields are sent.
   23:  */
   24: function derivePartialSchema(schema) {
   25:   const clone = JSON.parse(JSON.stringify(schema));
   26:   clone.title += ' (partial)';
   27:   delete clone.$schema;
   28:   (function stripRequired(obj) {
   29:     if (!obj || typeof obj !== 'object') return;
   30:     delete obj.required;
   31:     for (const v of Object.values(obj)) stripRequired(v);
   32:   })(clone);
   33:   return clone;
   34: }
