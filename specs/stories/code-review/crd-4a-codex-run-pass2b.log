   57: const state = {
   58:   challengeId: null,
   59:   challenge:   null,
   60:   character:   null,
   61:   charsCount:  0,
   62:   wpAvailable: 0,
   63:   aspect:      null,
   64:   wpOn:        false,
   65:   meritIds:    new Set(),
