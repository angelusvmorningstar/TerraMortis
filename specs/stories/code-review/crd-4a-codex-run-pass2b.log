  351:   const outcomeData = {
  352:     attacker: { name: challenge.challenger_character_name, pool: challenge.challenger_pool, successes: atkSuc, rolls: atkCols },
  353:     defender: { name: challenge.target_character_name,    pool: challenge.defender_pool,   successes: defSuc, rolls: defCols },
  354:     outcome,
  355:     margin,
  356:   };
