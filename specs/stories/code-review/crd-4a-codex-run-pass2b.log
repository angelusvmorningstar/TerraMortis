  425: // ── Helpers ──────────────────────────────────────────────────────────────────
  426: 
  427: async function _findChallenge(req, res) {
  428:   let oid;
  429:   try { oid = new ObjectId(req.params.id); } catch {
  430:     res.status(400).json({ error: 'VALIDATION_ERROR', message: 'Invalid ID format' });
  431:     return null;
  432:   }
  433:   // oaq.2 review finding: exclude status_action requests — they have their
  434:   // own lifecycle (office-actions.js's accept/decline), and a status_action
  435:   // doc has no challenger/target_character_id fields for the caller-
  436:   // ownership check below to compare against anyway. gdx.12: same exclusion
  437:   // for humanity_check requests (humanity-check.js's own lifecycle; a
  438:   // humanity_check doc has no challenger/target_character_id fields either).
  439:   const doc = await col().findOne({ _id: oid, request_type: { $nin: ['status_action', 'humanity_check'] } });
  440:   if (!doc) { res.status(404).json({ error: 'NOT_FOUND' }); return null; }
  441:   if (doc.status !== 'pending') {
  442:     res.status(409).json({ error: 'CONFLICT', message: 'Challenge is no longer pending' });
  443:     return null;
  444:   }
  445:   return doc;
  446: }
  447: 
  448: function d10() { return Math.floor(Math.random() * 10) + 1; }
  449: 
  450: function _roll(n) {
  451:   const cols = [];
  452:   for (let i = 0; i < Math.max(0, n); i++) {
  453:     const v = d10();
  454:     const r = { v, s: v >= 8, x: v === 10 };
  455:     const ch = [];
  456:     let last = r;
  457:     while (last.x) { const cv = d10(); last = { v: cv, s: cv >= 8, x: cv === 10 }; ch.push(last); }
  458:     cols.push({ r, ch });
  459:   }
  460:   return cols;
  461: }
  462: 
  463: function _countSuc(cols) {
  464:   let s = 0;
  465:   for (const col of cols) {
  466:     if (col.r.s) s++;
  467:     for (const d of col.ch) if (d.s) s++;
  468:   }
  469:   return s;
  470: }
