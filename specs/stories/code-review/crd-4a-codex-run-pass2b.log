   45: let _rootEl = null;
   46: let _resolveGen = 0;
   47: // crd.3b code review (external Codex, Pass 1): bumped on every mount, checked
   48: // after every awaited network call in _resolve/_accept/the WP-load callback.
   49: // _resolveGen alone only orders resolves WITHIN one mount — a mount's own
   50: // first resolve call after _resetState still has the SAME _resolveGen value
