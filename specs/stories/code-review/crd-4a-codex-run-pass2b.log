diff --git a/server/tests/crd-4a-pass2-probe.test.js b/server/tests/crd-4a-pass2-probe.test.js
new file mode 100644
index 0000000000000000000000000000000000000000..f41f064d31d010a61c224a8fe45e1dfc82586d0e
--- /dev/null
+++ b/server/tests/crd-4a-pass2-probe.test.js
@@ -0,0 +1,129 @@
+import { describe, it, expect, vi, beforeEach } from 'vitest';
+import express from 'express';
+import request from 'supertest';
+import { ObjectId } from 'mongodb';
+
+const probe = vi.hoisted(() => ({
+  challenge: null,
+  phase: 'game',
+  blockNextChapter: false,
+  chapterEntered: null,
+  releaseChapter: null,
+}));
+
+const DEFENDER = '0000000000000000000000d1';
+const CHALLENGER = '0000000000000000000000c1';
+
+const defender = {
+  _id: new ObjectId(DEFENDER), name: 'Defender', blood_potency: 2,
+  status: { city: 5 }, court_category: null, merits: [],
+  attributes: { Resolve: { dots: 2, bonus: 0 } },
+};
+const challenger = {
+  _id: new ObjectId(CHALLENGER), name: 'Challenger', blood_potency: 1,
+  status: { city: 1 }, court_category: null, merits: [], attributes: {},
+};
+
+function clone(value) { return structuredClone(value); }
+
+vi.mock('../db.js', () => ({
+  getCollection(name) {
+    if (name === 'contested_roll_requests') return {
+      findOne: async () => clone(probe.challenge),
+      updateOne: async (_q, update) => {
+        Object.assign(probe.challenge, clone(update.$set));
+        return { matchedCount: 1, modifiedCount: 1 };
+      },
+    };
+    if (name === 'characters') return {
+      findOne: async q => String(q._id) === DEFENDER ? clone(defender) : clone(challenger),
+    };
+    if (name === 'chapters') return {
+      find: () => ({ toArray: async () => {
+        if (probe.blockNextChapter) {
+          probe.blockNextChapter = false;
+          probe.chapterEntered();
+          await new Promise(resolve => { probe.releaseChapter = resolve; });
+        }
+        return [{ phase: probe.phase, game_number: 1 }];
+      } }),
+    };
+    if (name === 'game_sessions') return {
+      find: () => ({
+        sort() { return this; }, limit() { return this; },
+        toArray: async () => [{ session_date: '2026-08-26', attendance: [
+          { character_id: DEFENDER, attended: true },
+          { character_id: CHALLENGER, attended: true },
+        ] }],
+      }),
+    };
+    if (name === 'territories') return { find: () => ({ toArray: async () => [] }) };
+    if (name === 'session_logs') return { insertOne: async () => ({ insertedId: new ObjectId() }) };
+    throw new Error(`unexpected collection ${name}`);
+  },
+}));
+
+const { default: router } = await import('../routes/contested-rolls.js');
+
+function app() {
+  const a = express();
+  a.use(express.json());
+  a.use((req, _res, next) => {
+    req.user = { role: 'player', character_ids: [DEFENDER], username: 'probe' };
+    next();
+  });
+  a.use('/api/contested_roll_requests', router);
+  return a;
+}
+
+beforeEach(() => {
+  probe.phase = 'game';
+  probe.blockNextChapter = false;
+  probe.releaseChapter = null;
+  probe.challenge = {
+    _id: new ObjectId('0000000000000000000000a1'),
+    challenger_character_id: CHALLENGER,
+    challenger_character_name: 'Challenger',
+    target_character_id: DEFENDER,
+    target_character_name: 'Defender',
+    challenger_pool: 5,
+    power_name: 'Majesty',
+    request_type: 'contested_roll',
+    status: 'pending',
+  };
+});
+
+describe('Pass 2 probes', () => {
+  it('an older resolve can persist after a newer status choice', async () => {
+    let entered;
+    const enteredPromise = new Promise(resolve => { entered = resolve; });
+    probe.chapterEntered = entered;
+    probe.blockNextChapter = true;
+
+    const a = request(app()).put('/api/contested_roll_requests/0000000000000000000000a1/resolve')
+      .send({ defender_aspect: 'mental', defender_status_term: null });
+    await enteredPromise;
+    const b = await request(app()).put('/api/contested_roll_requests/0000000000000000000000a1/resolve')
+      .send({ defender_aspect: 'mental', defender_status_term: 'city' });
+    expect(b.status).toBe(200);
+    expect(b.body.defender_pool).toBe(6);
+
+    probe.releaseChapter();
+    const stale = await a;
+    expect(stale.status).toBe(200);
+    expect(probe.challenge.defender_pool).toBeNull();
+    expect(probe.challenge.defender_status_term).toBeNull();
+  });
+
+  it('/accept consumes an already-persisted gated pool after the gate closes', async () => {
+    const a = app();
+    const resolved = await request(a).put('/api/contested_roll_requests/0000000000000000000000a1/resolve')
+      .send({ defender_aspect: 'mental', defender_status_term: 'city' });
+    expect(resolved.body.defender_pool).toBe(6);
+    probe.phase = 'prep';
+
+    const accepted = await request(a).put('/api/contested_roll_requests/0000000000000000000000a1/accept').send({});
+    expect(accepted.status).toBe(200);
+    expect(accepted.body.outcome.defender.pool).toBe(6);
+  });
+});

