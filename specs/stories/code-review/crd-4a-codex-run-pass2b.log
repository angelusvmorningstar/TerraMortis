   36: const ASPECT_ATTR = { mental: 'Resolve', social: 'Composure', physical: 'Stamina' };
   37: const ASPECT_ORDER = ['mental', 'social', 'physical'];
   38: const ASPECT_LABEL = { mental: 'Mental', social: 'Social', physical: 'Physical' };
