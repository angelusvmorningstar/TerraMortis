   30: import { apiRaw } from '../data/api.js';
   31: import { esc, redactCharName } from '../data/helpers.js';
   32: import { ROLL_LABELS, getPendingChallenge, markChallengeResolved } from './pending-queue.js';
   33: import { ensureLoaded, trackerRead } from './tracker.js';
   34: import { mkColsEl } from '../suite/roll-v2.js';
