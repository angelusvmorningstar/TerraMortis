  282: /**
  283:  * Resolve a shared_with entry (string) to a character object.
  284:  * Accepts either a 24-hex ObjectId (new format) or a legacy character name.
  285:  * Returns the matching character object, or null if not found.
  286:  *
  287:  * @param {Array} chars - state.chars array
  288:  * @param {string} entry - _id hex string or character name
  289:  * @returns {object|null}
  290:  */
  291: export function resolveSharedWithMember(chars, entry) {
  292:   if (typeof entry === 'string' && /^[a-f0-9]{24}$/i.test(entry)) {
  293:     return chars.find(ch => String(ch._id) === entry) || null;
  294:   }
  295:   return chars.find(ch => ch.name === entry) || null;
  296: }
  297: 
  298: /**
  299:  * Parse a published downtime outcome string (## Section headings format)
  300:  * into an array of { heading, body } objects for rendering.
  301:  * If no ## headings found, returns a single entry with heading=null.
  302:  */
  303: export function parseOutcomeSections(text) {
  304:   if (!text) return [];
  305:   const sections = [];
  306:   let current = null;
  307:   for (const line of text.split('\n')) {
  308:     if (line.startsWith('## ')) {
  309:       if (current) sections.push(current);
  310:       current = { heading: line.slice(3).trim(), lines: [] };
  311:     } else if (current) {
  312:       current.lines.push(line);
  313:     }
  314:   }
  315:   if (current) sections.push(current);
  316:   if (!sections.length) return [{ heading: null, lines: text.split('\n') }];
  317:   return sections;
  318: }
    1: /**
    2:  * Effective City Status — the one shared calculation, importable by both the
    3:  * client (public/js/data/accessors.js) and the server
    4:  * (server/routes/office-actions.js), so there is exactly one implementation
    5:  * of the budget formula, not two independently-maintained copies. Mirrors
    6:  * the public/js/downtime/cycle-phase.js precedent for the same reason.
    7:  *
    8:  * Deliberately imports only public/js/data/constants.js, a verified
    9:  * zero-import leaf module — accessors.js itself is NOT safe to import
   10:  * server-side (its getRulesCache import chain transitively reads
   11:  * location.hostname at module scope via public/js/data/api.js and crashes
   12:  * under Node/vitest, the same landmine issue-1141 routed around once
   13:  * already via a different chain).
   14:  */
   15: 
   16: import { TITLE_STATUS_BONUS } from './constants.js';
   17: 
   18: // Bonus from regenting an ambience territory. Regent-only by design;
   19: // lieutenants receive no bonus (issue #13 Q-A, 2026-05-05).
   20: export const REGENT_AMBIENCE_BONUS = Object.freeze({ 'Curated': 1, 'Verdant': 1, 'The Rack': 2 });
   21: 
   22: export function titleStatusBonusFor(courtCategory) {
   23:   return TITLE_STATUS_BONUS[courtCategory] || 0;
   24: }
   25: 
   26: export function regentAmbienceBonusFor(ambience) {
   27:   return REGENT_AMBIENCE_BONUS[ambience] || 0;
   28: }
   29: 
   30: /**
   31:  * @param {object} c - character-like object with status.city and court_category
   32:  * @param {string|null|undefined} regentAmbience - ambience of the territory c regents, if any
   33:  */
   34: export function calcEffectiveCityStatus(c, regentAmbience) {
   35:   const raw = (c?.status?.city || 0) + titleStatusBonusFor(c?.court_category) + regentAmbienceBonusFor(regentAmbience);
   36:   return Math.min(raw, 10);
   37: }
    1: /**
    2:  * cycle-phase.js — CM-1 (issue #1028): the cycle phase model as data.
    3:  *
    4:  * PURE MODULE: no imports, no I/O, no browser globals. Deliberately importable
    5:  * by the client (db.js), the server (routes/downtime.js), and the test suite
    6:  * directly, so there is exactly one implementation of the phase contract and
    7:  * no mirror copies to drift (the mirror-in-test convention exists only because
    8:  * db.js imports api.js, which touches `location` at module load; this module
    9:  * sidesteps that). Twin on the reader side: TM Wiki's
   10:  * server/downtime-cycle-phase.js (the 11-1 stub contract).
   11:  *
   12:  * Ruling document: D:/Terra Mortis/cycle-model.md Rev 2, sections 7 and 11.
   13:  *
   14:  * THE THREE MEANINGS OF "prep" (do not conflate):
   15:  *   - status: 'prep'        legacy enum value, "ST is setting the cycle up,
   16:  *                           downtime not yet open" (the START of the cycle).
   17:  *   - phase_signoff.prep    the first DTUX-1 sign-off checkbox.
   18:  *   - phase: 'prep'         THIS module's value: the game-prep window between
   19:  *                           processing and game (near the END of the cycle).
   20:  *                           Feeding is open during it.
   21:  * statusToPhase maps legacy status 'prep' to null, never to 'prep'.
   22:  */
   23: 
   24: // The canonical phase order. A cycle's own phase_sequence wins when present.
   25: export const CYCLE_PHASE_SEQUENCE = Object.freeze(['downtime', 'processing', 'prep', 'game']);
   26: 
   27: const PHASE_VALUES = new Set(CYCLE_PHASE_SEQUENCE);
   28: 
   29: // Rev 2 section 7 mirror table: what the legacy fields say for each new phase,
   30: // so every pre-CM-1 reader (including a stale browser tab reading the API)
   31: // sees a coherent old-model state. prep mirrors to the PROCESSING pair, never
   32: // the game pair: nothing keyed to game-start may fire early (the vetoed
   33: // contamination), and the server's closed-cycle write gate stays closed to
   34: // everything except feeding fields (see openCycleVerdict).
   35: export const PHASE_MIRROR = Object.freeze({
   36:   downtime:   Object.freeze({ game_phase: 'downtime',   status: 'active' }),
   37:   processing: Object.freeze({ game_phase: 'processing', status: 'closed' }),
   38:   prep:       Object.freeze({ game_phase: 'processing', status: 'closed' }),
   39:   game:       Object.freeze({ game_phase: 'game',       status: 'game' }),
   40: });
   41: 
   42: /**
   43:  * Map a legacy effective status to the new phase vocabulary.
   44:  * 'open' folds to 'downtime' (both mean the downtime window is open, matching
   45:  * the Wiki stub's treatment). Legacy 'prep' and anything unrecognised map to
   46:  * null: no phase, form closed, the safe default.
   47:  */
   48: export function statusToPhase(status) {
   49:   switch (status) {
   50:     case 'active':
   51:     case 'open':   return 'downtime';
   52:     case 'game':   return 'game';
   53:     case 'closed': return 'processing';
   54:     default:       return null;
   55:   }
   56: }
   57: 
   58: /**
   59:  * The canonical phase read. `cycle.phase` wins when it is a known phase value;
   60:  * otherwise fall back to the legacy fields via `deriveStatus`.
   61:  *
   62:  * `deriveStatus` defaults to reading the raw `status` field. Client callers
   63:  * should pass db.js's deriveCycleStatus for full legacy fidelity (the #708
   64:  * game_phase override, the #231 manual_open latch, the sign-off ladder).
   65:  * Server callers only enter phase-aware branches when `phase` is a known
   66:  * value, so the fallback fidelity does not matter there.
   67:  */
   68: export function cyclePhase(cycle, deriveStatus) {
   69:   if (cycle && PHASE_VALUES.has(cycle.phase)) return cycle.phase;
   70:   const status = typeof deriveStatus === 'function' ? deriveStatus(cycle) : cycle?.status;
   71:   return statusToPhase(status);
   72: }
   73: 
   74: /**
   75:  * CM-4a: the ONE reader of the phase a transition moves FROM, shared verbatim
   76:  * by the admin Cycle tab (cycle-views.js's uiPhase) and by the server route
   77:  * that enforces the wipe rule (routes/downtime.js's cycles PUT).
   78:  *
   79:  * It exists because the two tiers used to disagree. The client read
   80:  * `phase || game_phase`; the server's `cyclePhase` falls back to
   81:  * `statusToPhase(status)` instead. On the real legacy shape
   82:  * `{game_phase:'game', status:'closed'}` the client said 'game' (so entering
   83:  * prep showed no dialog) and the server said 'processing' (so entering prep
   84:  * WOULD wipe) - a tracker wipe on a transition the ST was never warned about.
   85:  * The `from` side of a transition is exactly where a legacy document gets
   86:  * read, so the two answers have to be one answer.
   87:  *
   88:  * Resolution order: a known `phase`, else a known legacy `game_phase`, else
   89:  * `statusToPhase(status)`, else null. Unknown values never leak - a
   90:  * hand-edited `phase: 'feeding'` falls through to the legacy fields rather
   91:  * than being handed to the transition matrix.
   92:  *
   93:  * Distinct from `cyclePhase` above, deliberately: that one takes an injected
   94:  * `deriveStatus` and is the general "what phase is this cycle in" read.
   95:  */
   96: export function transitionFromPhase(cycle) {
   97:   if (!cycle) return null;
   98:   if (PHASE_VALUES.has(cycle.phase)) return cycle.phase;
   99:   if (PHASE_VALUES.has(cycle.game_phase)) return cycle.game_phase;
  100:   return statusToPhase(cycle.status);
  101: }
  102: 
  103: /**
  104:  * The single current cycle: highest game_number wins, never API/_id/array
  105:  * order (creation order is proven wrong for game order in this data - see
  106:  * db.js's getFeedingCycle doc comment for the same rule applied elsewhere).
  107:  * Returns null for an empty/missing list.
  108:  */
  109: export function currentCycle(cycles) {
  110:   if (!Array.isArray(cycles) || !cycles.length) return null;
  111:   return cycles.reduce((best, c) => (!best || (c.game_number || 0) > (best.game_number || 0) ? c : best), null);
  112: }
  113: 
  114: /**
  115:  * Is the CURRENT cycle (not just any cycle anywhere in the list) in game
  116:  * phase right now? otc.2 (2026-08-12) finding: filtering all cycles for
  117:  * phase 'game' and then taking the highest game_number AMONG THOSE MATCHES
  118:  * is wrong - a stale historical cycle left in game phase outranks a newer
  119:  * cycle that has since moved to prep/processing/downtime, because the newer
  120:  * cycle was never in the filtered set to begin with. Identify the current
  121:  * cycle FIRST, then test its phase.
  122:  */
  123: export function currentCycleInGamePhase(cycles, deriveStatus) {
  124:   const current = currentCycle(cycles);
  125:   return current && cyclePhase(current, deriveStatus) === 'game' ? current : null;
  126: }
  127: 
  128: /** Index of a phase in this cycle's sequence (its own phase_sequence wins). */
  129: export function phaseIndex(cycle, phase) {
  130:   const seq = Array.isArray(cycle?.phase_sequence) && cycle.phase_sequence.length
  131:     ? cycle.phase_sequence
  132:     : CYCLE_PHASE_SEQUENCE;
  133:   return seq.indexOf(phase);
  134: }
  135: 
  136: /** Is feeding open? Rev 2 section 7: feeding opens on prep and stays open in game. */
  137: export function isFeedingOpen(cycle, deriveStatus) {
  138:   const p = cyclePhase(cycle, deriveStatus);
  139:   return p === 'prep' || p === 'game';
  140: }
  141: 
  142: /**
  143:  * CM-5a: does entering `toPhase` from `fromPhase` reset the live tracker?
  144:  *
  145:  * The slate-wipe belongs at PREP entry - prep is the loading of game-starting
  146:  * state (Rev 2 section 2), so the wipe happens before carry-over lands, and
  147:  * feed rolls made during the prep week survive into the game. Entering game
  148:  * FROM prep is therefore non-destructive ("prep and game are deliberately
  149:  * seamless"). Entering game from anywhere else keeps the legacy reset, which
  150:  * is also the fallback path: skip prep and today's exact behaviour returns.
  151:  */
  152: export function resetOnTransition(fromPhase, toPhase) {
  153:   // Entering prep wipes the slate ONCE per chapter, and only from a phase
  154:   // that precedes it. Re-entering prep (toggled off and on, or corrected via
  155:   // another phase and back) would discard feeds already confirmed this prep
  156:   // week; entering prep FROM game would wipe live state mid-session. Both are
  157:   // reachable by one misclick on a button that sits beside Game, so they fail
  158:   // safe here rather than relying on the confirm dialog (review, 2026-08-10).
  159:   if (toPhase === 'prep') return fromPhase !== 'prep' && fromPhase !== 'game';
  160:   if (toPhase === 'game') return fromPhase !== 'prep';
  161:   return false;
  162: }
  163: 
  164: /**
  165:  * The update object for a non-null phase write: the new `phase` field plus its
  166:  * legacy mirror pair, written together in ONE update so the representations
  167:  * cannot desync (the 16 July 2026 failure mode).
  168:  */
  169: export function phaseWrites(phase) {
  170:   const mirror = PHASE_MIRROR[phase];
  171:   if (!mirror) throw new Error('phaseWrites: unknown phase "' + phase + '"');
  172:   return { phase, ...mirror };
  173: }
  174: 
  175: /**
  176:  * The three fields that TOGETHER represent a cycle's phase: the CM-1 canonical
  177:  * `phase` plus its legacy mirror pair. Named once, because more than one caller
  178:  * now needs to say "these fields describe live game-night state, and I must not
  179:  * write them here" (buildPhaseUpdate defends them against caller extras; the
  180:  * Data Portability importer strips them from a restore body - see
  181:  * withoutPhaseFields below).
  182:  */
  183: export const PHASE_FIELDS = Object.freeze(['phase', 'game_phase', 'status']);
  184: 
  185: /**
  186:  * A shallow copy of `doc` with the mirror trio removed.
  187:  *
  188:  * CM-4a review (P1, 2026-08-16): the phase write now carries a destructive
  189:  * consequence (the server wipes tracker_state on a resetting transition), so a
  190:  * body that merely RESTORES data must not carry phase fields at all. Note that
  191:  * "same phase in, no transition, therefore safe" is FALSE for one row of the
  192:  * matrix: resetOnTransition('game', 'game') is true, because entering game from
  193:  * anywhere except prep is the legacy reset. Re-importing a backup of a cycle
  194:  * that is currently in game phase would therefore have wiped every character's
  195:  * live tracker, silently, with no dialog on that path.
  196:  */
  197: export function withoutPhaseFields(doc) {
  198:   const { phase: _p, game_phase: _g, status: _s, ...rest } = doc || {};
  199:   return rest;
  200: }
  201: 
  202: /**
  203:  * The COMPLETE update object for any phase transition, including the null
  204:  * (clear-to-neutral) row and any caller extras. Extracted pure (Codex review
  205:  * finding, 2026-08-10) so the full five-row table is directly testable and so
  206:  * the mirror trio is defended: extras may add fields (closed_at,
  207:  * game_phase_at) but can NEVER override phase, game_phase or status - a
  208:  * caller-supplied conflict is silently discarded in favour of the mirror,
  209:  * because one canonical writer that can be argued with is no canonical writer
  210:  * at all. The null row derives status through `deriveStatus` (db.js injects
  211:  * deriveCycleStatus), preserving #918 clear semantics.
  212:  */
  213: export function buildPhaseUpdate(cycle, phaseOrNull, extra, deriveStatus) {
  214:   const safeExtra = withoutPhaseFields(extra);
  215:   const writes = phaseOrNull === null
  216:     ? {
  217:         phase: null,
  218:         game_phase: null,
  219:         status: typeof deriveStatus === 'function'
  220:           ? deriveStatus({ ...cycle, game_phase: null })
  221:           : cycle?.status,
  222:       }
  223:     : phaseWrites(phaseOrNull);
  224:   return { ...safeExtra, ...writes };
  225: }
  226: 
  227: // Fields a player may write to a submission outside the downtime window,
  228: // because the feed roll happens at game time (and, from CM-1 on, during prep).
  229: // Shared by the submissions PUT deadline check and openCycleVerdict.
  230: export const FEEDING_ONLY_FIELDS = Object.freeze([
  231:   'feeding_roll_player',
  232:   'feeding_vitae_allocation',
  233:   'feeding_deferred',
  234: ]);
  235: 
  236: /**
  237:  * The requireOpenCycle decision, extracted pure so the matrix is unit-testable
  238:  * without a database. Returns 'allow' or 'locked'.
  239:  *
  240:  * Phase-aware lane (cycle carries ANY string `phase`, resolved through the
  241:  * canonical reader - so a malformed value like 'feeding' falls back to the
  242:  * legacy-derived phase and is judged by phase rules, failing CLOSED rather
  243:  * than slipping into the permissive legacy lane; Codex review finding,
  244:  * 2026-08-10):
  245:  *   - ST/dev: always allowed. The processing phase IS the ST writing
  246:  *     resolutions to submissions (cycle-model.md Rev 2 section 2); a
  247:  *     phase-aware gate that locked the ST out of processing would break the
  248:  *     model it implements. (Deviation from the story's AC 5 literal text,
  249:  *     resolved in favour of the ruling document; recorded in the Dev Agent
  250:  *     Record.)
  251:  *   - Player, phase 'downtime': allowed (the downtime window).
  252:  *   - Player, phase 'prep' or 'game', body touches ONLY feeding fields:
  253:  *     allowed (this is what opens feeding during prep).
  254:  *   - Player, anything else: out-of-window exception, else locked.
  255:  *
  256:  * Legacy lane (no `phase` field at all): byte-identical to the pre-CM-1 gate -
  257:  * locked only when raw status is 'closed', with the out-of-window exception.
  258:  */
  259: export function openCycleVerdict({ cycle, role, bodyKeys, oowMatch, deriveStatus }) {
  260:   const keys = Array.isArray(bodyKeys) ? bodyKeys : [];
  261:   const feedingOnly = keys.length > 0 && keys.every(k => FEEDING_ONLY_FIELDS.includes(k));
  262: 
  263:   if (cycle && typeof cycle.phase === 'string' && cycle.phase !== '') {
  264:     if (role === 'st' || role === 'dev') return 'allow';
  265:     const p = cyclePhase(cycle, deriveStatus);
  266:     if (p === 'downtime') return 'allow';
  267:     if ((p === 'prep' || p === 'game') && feedingOnly) return 'allow';
  268:     return oowMatch ? 'allow' : 'locked';
  269:   }
  270: 
  271:   if (cycle?.status === 'closed') {
  272:     return oowMatch ? 'allow' : 'locked';
  273:   }
  274:   return 'allow';
  275: }

