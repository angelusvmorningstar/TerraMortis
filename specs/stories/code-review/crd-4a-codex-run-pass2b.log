  105: export function initContestedResolve(rootEl, ctx, chars = []) {
  106:   if (!rootEl) return;
  107: 
  108:   const challengeId = ctx?.challengeId ? String(ctx.challengeId) : '';
  109:   const challenge = challengeId ? getPendingChallenge(challengeId) : null;
  110:   const character = challenge
  111:     ? (chars || []).find(c => String(c._id) === String(challenge.target_character_id))
  112:     : null;
  113: 
  114:   _resetState(challengeId, challenge, character, (chars || []).length);
  115:   const myMount = _mountGen;
  116:   _render(rootEl);
  117: 
  118:   if (character) {
  119:     ensureLoaded(character).then(() => {
  120:       // A stale mount (player navigated away and back, including to the SAME
  121:       // challenge id, before this resolved) must not paint over a newer
  122:       // mount's state — compared by mount generation, not challengeId, since
  123:       // a remount of the identical challenge shares the same id.
  124:       if (myMount !== _mountGen) return;
  125:       state.wpAvailable = trackerRead(String(character._id))?.willpower ?? 0;
  126:       _render(rootEl);
  127:     });
  128:   }
  129: 
  130:   if (rootEl !== _rootEl) {
  131:     _rootEl = rootEl;
  132:     rootEl.addEventListener('click', (e) => _onClick(e, rootEl));
  133:   }
  134: }
  135: 
  136: function _onClick(e, rootEl) {
  137:   if (e.target.closest('[data-cr-back]')) {
  138:     if (typeof window !== 'undefined' && typeof window.goTab === 'function') window.goTab('contested-queue');
  139:     return;
  140:   }
  141:   if (state.accepting) return; // no interaction once a roll is in flight
  142: 
  143:   const aspectBtn = e.target.closest('[data-cr-aspect]');
  144:   if (aspectBtn) {
  145:     state.aspect = aspectBtn.dataset.crAspect;
  146:     _resolve(rootEl);
  147:     return;
  148:   }
  149: 
  150:   const wpToggle = e.target.closest('[data-cr-wp]');
  151:   if (wpToggle && !wpToggle.classList.contains('disabled')) {
  152:     state.wpOn = !state.wpOn;
  153:     _resolve(rootEl);
  154:     return;
  155:   }
  156: 
  157:   const statusTermBtn = e.target.closest('[data-cr-status-term]');
  158:   if (statusTermBtn) {
  159:     state.statusTerm = statusTermBtn.dataset.crStatusTerm;
  160:     _resolve(rootEl);
  161:     return;
  162:   }
  163: 
  164:   const meritBtn = e.target.closest('[data-cr-merit]');
  165:   if (meritBtn) {
  166:     const key = meritBtn.dataset.crMerit;
  167:     if (state.meritIds.has(key)) state.meritIds.delete(key); else state.meritIds.add(key);
  168:     _resolve(rootEl);
  169:     return;
  170:   }
  171: 
  172:   if (e.target.closest('[data-cr-accept]') && !e.target.closest('[data-cr-accept]').disabled) {
  173:     _accept(rootEl);
  174:   }
  175: }
