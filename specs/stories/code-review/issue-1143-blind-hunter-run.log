+    vi.resetModules();
+    vi.doMock('../db.js', () => ({
+      connectDb: vi.fn().mockResolvedValue(undefined),
+      closeDb: vi.fn(),
+      getCollection: vi.fn(),
+      getDb: vi.fn(() => ({ databaseName: 'tm_suite' })), // NOT *_test
+    }));
+
+    const { isDbAvailable } = await import('./helpers/db-setup.js');
