695: +grep -rnoE "\.style\.[a-zA-Z]+\s*=\s*['\"\`][^'\"\`]*(#[0-9A-Fa-f]{3,6}|rgba?\()" public/js/
696: +grep -rnoE "style=\"[^\"]*(#[0-9A-Fa-f]{3,6}|rgba?\()" public/js/
