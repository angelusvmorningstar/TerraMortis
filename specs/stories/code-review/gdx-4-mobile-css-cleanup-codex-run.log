1660:// ── gdx-4: CSS standards cleanup (issue #985, absorbing #859) ─────────────────
1661-//
1662-// AC4 and AC6 are computed-style properties, so they live here rather than in
1663:// `server/tests/gdx-4-css-standards-grep.test.js`, which owns the source-text
1664-// half (AC1, AC2, AC3). Two AC4 assertions already existed before this story and
1665-// keep working for free: `story-split is single column on phone` and its
1666-// `tab-split` twin, above.
1667-//
1668:// None of these uses `setupSuite()`. That helper waits on `#app` becoming
1669-// visible and is the root cause of the 12 pre-existing failures CLAUDE.md
1670-// documents for this file; gdx-1, gdx-2 and gdx-3 all used a bare `page.goto()`
1671-// for the same reason.
1672-
1673-/**
1674- * Mount a probe node, read computed values off it, then remove it.
1675- *
1676- * Appending to `document.body` is safe for every selector below: none of them
1677- * depends on an ancestor's padding or width cap (the gdx-1/gdx-2 viewport trap),
1678- * because each is a flex/grid container or a colour-only rule measured on itself.
1679- */
1680:async function gdx4Probe(page, className, props, theme) {
1681-  return page.evaluate(({ className, props, theme }) => {
1682-    const root = document.documentElement;
1683:    const had = root.getAttribute('data-theme');
1684:    if (theme) root.setAttribute('data-theme', theme);
1685:    else root.removeAttribute('data-theme');
1686-
1687-    const el = document.createElement('div');
1688-    el.className = className;
1689-    document.body.appendChild(el);
1690-    const cs = getComputedStyle(el);
1691-    const out = {};
1692-    for (const p of props) out[p] = cs[p];
1693-    // Read the tokens off :root in the SAME call and under the SAME theme, so
1694-    // the expectation survives a token retune instead of pinning rgb literals.
1695-    const rootCs = getComputedStyle(root);
1696-    out._tokens = {
1697-      crim: rootCs.getPropertyValue('--crim').trim(),
1698-      txtOnDark: rootCs.getPropertyValue('--txt-on-dark').trim(),
1699-      crim2: rootCs.getPropertyValue('--crim2').trim(),
1700-    };
1701-    document.body.removeChild(el);
1702-
1703:    if (had === null) root.removeAttribute('data-theme'); else root.setAttribute('data-theme', had);
1704-    return out;
1705-  }, { className, props, theme });
1706-}
1707-
1708-/** Resolve a hex/keyword colour to the `rgb(...)` string getComputedStyle returns. */
1709:async function gdx4Resolve(page, value) {
1710-  return page.evaluate((v) => {
1711-    const el = document.createElement('div');
1712-    el.style.color = v;
1713-    document.body.appendChild(el);
1714-    const c = getComputedStyle(el).color;
1715-    document.body.removeChild(el);
1716-    return c;
1717-  }, value);
1718-}
