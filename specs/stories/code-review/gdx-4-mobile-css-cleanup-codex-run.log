675: +btn.style.cssText = 'background:#333;color:#aaa;border:1px solid #555';
676: +el.style.color = '#fff';
677: +
678: +// RIGHT: a class, with the colours declared as tokens in the stylesheet
679: +btn.className = 'dev-preview-btn';
680: +el.classList.add('is-error');
