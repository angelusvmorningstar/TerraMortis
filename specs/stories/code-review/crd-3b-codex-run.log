+import { chromium } from 'playwright';
+import path from 'node:path';
+
+const root = 'D:/Terra Mortis/TM Game';
+const markup = `
+  <div class="tab active" style="display:block;max-width:720px;margin:0 auto">
+    <div class="stm-audit-root">
+      <header class="stm-audit-head"><h2>Resolve Challenge</h2><p class="stm-audit-sub">Build your resistance pool, then roll.</p></header>
+      <div class="cq-resolve-body">
+        <div class="cr-identity-banner">Defending as <strong>Eve Lockridge</strong></div>
+        <div class="ch-pools">
+          <div class="ch-pool-row"><span class="ch-pool-lbl">Challenger</span><span class="ch-pool-val">Mammon</span></div>
+          <div class="ch-pool-row"><span class="ch-pool-lbl">Contest</span><span class="ch-pool-val">Social Manoeuvre</span></div>
+          <div class="ch-pool-row"><span class="ch-pool-lbl">Their pool</span><span class="ch-pool-val">7 dice</span></div>
+        </div>
+        <div><div class="form-section-title">How do you resist?</div><div class="cr-aspect-seg" data-cr-aspect-seg>
+          <button type="button" data-cr-aspect="mental" class="on">Mental<span class="cr-aspect-attr">Resolve · 2</span></button>
+          <button type="button" data-cr-aspect="social">Social<span class="cr-aspect-attr">Composure · 3</span></button>
+          <button type="button" data-cr-aspect="physical">Physical<span class="cr-aspect-attr">Stamina · 1</span></button>
+        </div></div>
+        <div><div class="form-section-title">Willpower</div><button type="button" data-cr-wp class="cr-wp-toggle on"><span>Spend a point of Willpower</span><span class="cr-wp-bonus">+2 dice</span></button><p class="derived-note">3 Willpower available. A Resistance roll gets +2, not the usual +3.</p></div>
+        <div><div class="form-section-title">Merits</div><div class="cr-merit-row"><button type="button" data-cr-merit="indomitable" class="cr-merit-chip on">Indomitable <span class="cr-merit-bonus">+2</span></button><button type="button" data-cr-merit="closed-book" class="cr-merit-chip">Closed Book <span class="cr-merit-bonus">+3</span></button></div></div>
+        <div class="cr-pool-preview"><span class="cr-pool-label">Your pool</span><span class="cr-pool-value">9<span class="cr-pool-unit">dice</span></span></div>
+        <div class="ch-modal-actions cq-actions"><button type="button" class="ch-btn ch-btn-decline" data-cr-back>Back</button><button type="button" class="ch-btn ch-btn-accept" data-cr-accept>Roll 9 Dice</button></div>
+      </div>
+    </div>
+  </div>`;
+
+const browser = await chromium.launch({ headless: true });
+const page = await browser.newPage({ viewport: { width: 900, height: 900 }, deviceScaleFactor: 1 });
+for (const theme of ['light', 'dark']) {
+  await page.setContent(`<!doctype html><html${theme === 'dark' ? ' data-theme="dark"' : ''}><body>${markup}</body></html>`);
+  for (const css of ['public/css/theme.css', 'public/css/components.css', 'public/css/suite.css']) {
+    await page.addStyleTag({ path: path.join(root, css) });
+  }
+  await page.screenshot({ path: `D:/tmp/crd3b-${theme}.png`, fullPage: true });
+  const metrics = await page.evaluate(() => ({
+    bodyWidth: document.body.scrollWidth,
+    viewportWidth: innerWidth,
+    selectedColor: getComputedStyle(document.querySelector('.cr-aspect-seg button.on')).color,
+    selectedBackground: getComputedStyle(document.querySelector('.cr-aspect-seg button.on')).backgroundColor,
+    poolColor: getComputedStyle(document.querySelector('.cr-pool-value')).color,
+    actionHeight: document.querySelector('.ch-modal-actions').getBoundingClientRect().height,
+  }));
+  console.log(theme, JSON.stringify(metrics));
+}
+await browser.close();
