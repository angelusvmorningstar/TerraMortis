 329:       // Losing the seat between submission and approval is a real, narrow case
 330:       // that must not silently apply — the same reasoning office-actions.js
 331:       // re-checks the actor's own court_category at accept. Skipped when the
 332:       // request was submitted by an ST (no requester to have lost anything).
 333:       if (pending.requested_by_character_id) {
 334:         const holderId = seat.holder_id == null ? null : String(seat.holder_id);
 335:         if (holderId !== String(pending.requested_by_character_id))
 336:           throw new RouteResponse(403, {
