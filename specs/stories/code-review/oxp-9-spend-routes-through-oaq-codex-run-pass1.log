  12: // regression in setup-env.js ordering (or an env override) would silently
  13: // point a test run at production.
  14: export function assertTestDbSafety(dbName, isVitest) {
  15:   if (isVitest && !dbName.endsWith('_test')) {
  16:     throw new Error(
  17:       `Refusing to connect: test context (VITEST) targeting non-test database '${dbName}'. ` +
  18:         `Tests must use a *_test database — check tests/helpers/setup-env.js ordering.`
