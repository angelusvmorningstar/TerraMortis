311:   }
312:   res.json(result);
313: }
314: 
315: router.post('/:id/confirm', (req, res) => _applyConfirmationTransition(req, res, 'active', 'confirmed'));
316: router.post('/:id/decline', (req, res) => _applyConfirmationTransition(req, res, 'rejected', 'declined'));
317: 
318: // PUT /:id — edit edge. Split auth (NPCR.9):
319: //   ST: any tracked field can change; existing full-body flow applies.
320: //   Player: must own the edge (created_by_char_id ∈ character_ids) AND edge
321: //           status must be 'active'. Body is whitelisted to
322: //           {state, disposition, custom_label}; other fields are silently
323: //           ignored and a console.warn is logged. 2000-char cap on state.
324: // Both auths: appends a history row with per-field deltas; optimistic
325: // concurrency via updated_at.
326: router.put('/:id', validate(relationshipSchema), async (req, res) => {
327:   const oid = parseId(req.params.id);
328:   if (!oid) return res.status(400).json({ error: 'VALIDATION_ERROR', message: 'Invalid ID' });
329: 
330:   const existing = await col().findOne({ _id: oid });
331:   if (!existing) return res.status(404).json({ error: 'NOT_FOUND', message: 'Relationship not found' });
332: 
333:   const role = req.user?.role;
334:   const isSt = role === 'st' || role === 'dev';
335: 
336:   // Player edit-rights gate.
337:   if (!isSt) {
338:     const charIds = (req.user?.character_ids || []).map(String);
339:     const ownerCharId = String(existing.created_by_char_id || '');
340:     if (!ownerCharId || !charIds.includes(ownerCharId)) {
341:       return res.status(403).json({
342:         error: 'FORBIDDEN',
343:         message: 'Only the creating character can edit this edge. Flag it for ST review instead.',
344:       });
345:     }
346:     if (existing.status !== 'active') {
347:       return res.status(403).json({
348:         error: 'FORBIDDEN',
349:         message: 'Players can only edit active edges.',
350:       });
351:     }

