n Vagabond","status":"complete","revision_note":""}]},"projects_resolved":[{"action_type":"patrol_scout","pool":null,"roll":{"dice_string":"[7,4,1,2,1,1,8]","successes":1,"exceptional":false,"rolled_at":"2026-04-17T03:44:06.963Z","params":{"size":7,"again":10,"success":8,"exc":5,"rote":false}},"st_note":"","pool_player":"Wits + Stealth + Auspex","pool_validated":"Wits 3 + Stealth 2 + Auspex 2 = 7","pool_status":"validated","notes_thread":[],"story_context":"","resolved_at":null,"active_feed_specs":[],"pool_mod_spec":0,"nine_again":false,"rote":false,"eight_again":false,"pool_committed_by":"Angelus","pool_validated_by":"Angelus"},{"action_type":"patrol_scout","pool":null,"roll":{"dice_string":"[5,4,6,7,9,0>1,6]","successes":2,"exceptional":false,"rolled_at":"2026-04-17T03:43:59.769Z","params":{"size":7,"again":10,"success":8,"exc":5,"rote":false}},"st_note":"","pool_player":"Wits + Stealth + Auspex","pool_validated":"Wits 3 + Stealth 2 + Auspex 2 = 7","pool_status":"validated","notes_thread":[],"story_context":"","resolved_at":null,"active_feed_specs":[],"pool_mod_spec":0,"nine_again":false,"rote":false,"eight_again":false,"pool_committed_by":"Angelus","pool_validated_by":"Angelus"},{"action_type":"support","pool":null,"roll":{"dice_string":"[2,8,3,5,3,7,8,0>6,0>3,2]","successes":4,"exceptional":false,"rolled_at":"2026-04-17T03:44:29.557Z","params":{"size":10,"again":10,"success":8,"exc":5,"rote":false}},"st_note":"","pool_player":"Wits + Occult + Cruac","pool_validated":"Wits 3 + Occult 4 + Cruac 3 = 10","pool_status":"validated","notes_thread":[],"story_context":"","resolved_at":null,"active_feed_specs":[],"pool_mod_spec":0,"nine_again":false,"rote":false,"eight_again":false,"pool_committed_by":"Angelus","pool_validated_by":"Angelus"},{"action_type":"misc","pool":null,"roll":{"dice_string":"[1,8,4,4,3,2]","successes":1,"exceptional":false,"rolled_at":"2026-04-17T03:45:27.490Z","params":{"size":6,"again":10,"success":8,"exc":5,"rote":false}},"st_note":"","pool_player":"Wits + Survival","pool_validated":"Wits 3 + Survival 3 = 6","pool_status":"validated","notes_thread":[],"story_context":"The things she is seeing are Changelings. She does not know this (the player suspects).","resolved_at":null,"active_feed_specs":[],"pool_mod_spec":0,"nine_again":false,"rote":false,"eight_again":false,"pool_committed_by":"Angelus","title":"For the Others","desired_outcome":"Offer a good gift to the keepers of the land","description":"Anichka is now aware that she's on someone else's land, or relatively close to it. She has come to the decision that she probably does not want to fight these entities, guessing them to be spirits, or locals in communion with them. She spends some time putting together a small gift for them- One of her second-tier shawls, a string of pearls, and some gathered honey from native bees (hence the Survival roll). She'll top this off with a dressing of kangaroo vine with fruit still on. Trying to position as an offering of thanks, near where she saw them last. Come back, like, twice a week to see if that's been taken or nah.","merits_bonuses":"","pool_validated_by":"Angelus"}],"feeding_vitae_tally":{"herd":2,"ambience":2,"ambience_territory":"Academy","oath_of_fealty":0,"ghouls":0,"rite_cost":1,"manual":0,"total_bonus":3},"feeding_roll_player":{"cols":[{"r":{"v":10,"s":true,"x":true},"ch":[{"v":8,"s":true,"x":false}]},{"r":{"v":1,"s":false,"x":false},"ch":[]},{"r":{"v":3,"s":false,"x":false},"ch":[]},{"r":{"v":9,"s":true,"x":false},"ch":[]},{"r":{"v":3,"s":false,"x":false},"ch":[]},{"r":{"v":4,"s":false,"x":false},"ch":[]},{"r":{"v":7,"s":false,"x":false},"ch":[]}],"successes":3,"vessels":3,"safeVitae":6,"methodName":"Other","pool":7,"again":10,"breakdown":"ST confirmed: Wits 3 + Empathy 3 + 1 = 7","rolledAt":"2026-04-17T09:39:16.033Z","dramaticFailure":false},"feeding_vitae_allocation":[2,2,2]}];
