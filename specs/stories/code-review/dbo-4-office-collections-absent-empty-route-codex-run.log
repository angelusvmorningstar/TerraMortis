 244: // PUT /api/office_actions/:id/accept
 245: // oaq.2: ST-only. Applies the effect for real — re-reads the target live,
 246: // re-validates the action's precondition against its CURRENT status (not
 247: // whatever it was at submission time), claims a budget slot (paid types
 248: // only — budget spends on approval, never on submission, per this story's
 249: // explicit decision), writes the target via the same compare-and-swap
 250: // pattern issue-1143 established, logs the applied effect to
 251: // office_actions (the same collection the client's per-session action log
 252: // already reads via GET /), and marks the pending record resolved — all
 253: // inside one MongoDB transaction so a failure at any step leaves nothing
 254: // half-applied.
 255: //
 256: // Deliberately NOT re-checked here: the live game-phase gate. otc.2's rule
 257: // governs SUBMISSION — an ST reviewing a queue is expected to work through
 258: // it after the game session has ended, not necessarily while a game is
 259: // still live. Re-requiring a live game at accept time would mean nothing
 260: // could ever be approved once a session ends, defeating the point of a
 261: // queue. Product decision, 2026-08-12, after internal review raised it as
 262: // a question — confirmed no re-check wanted. By contrast, whether the
 263: // actor still holds office at all IS re-checked (below): losing office
 264: // entirely between submission and approval is a narrower, different case
 265: // than "the game moved on".
 266: router.put('/:id/accept', requireRole('st'), async (req, res) => {
 267:   const pending = await _findPending(req, res);
 268:   if (!pending) return;
 269: 
 270:   const client = getClient();
 271:   const dbSession = client.startSession();
 272:   let statusCode, body;
 273:   try {
 274:     await dbSession.withTransaction(async () => {
 275:       const actorObjectId  = new ObjectId(pending.actor_id);
 276:       const targetObjectId = new ObjectId(pending.target_id);
 277: 
 278:       const actor = await getCollection('characters').findOne({ _id: actorObjectId }, { session: dbSession });
 279:       if (!actor) throw new RouteResponse(404, { error: 'NOT_FOUND', message: 'Actor not found' });
 280:       // Internal review finding: the actor's authorization to hold office can
 281:       // change between submission and approval (a handover, a removal) just
 282:       // as legitimately as the target's status.city can — re-checked fresh
 283:       // here for the same reason AC5 re-checks the target's precondition,
 284:       // not trusted from whatever was true at submission time.
 285:       if (!actor.court_category) throw new RouteResponse(403, { error: 'FORBIDDEN', message: 'Actor no longer holds a court office' });
 286: 
 287:       const target = await getCollection('characters').findOne({ _id: targetObjectId }, { session: dbSession });
 288:       if (!target) throw new RouteResponse(404, { error: 'NOT_FOUND', message: 'Target not found' });
 289: 
 290:       const old_status = target.status?.city || 0;
 291:       const new_status = computeNewStatus(pending.action_type, old_status);
 292: 
 293:       // review finding (external, verified live): a TRUE concurrent accept
 294:       // race on the SAME pending record — both requests pass _findPending's
 295:       // read before either commits — used to reach the office_actions
 296:       // insertOne below on BOTH sides, and the second one crashed with an
 297:       // uncaught E11000 on the old issue-1143 unique index (a raw
 298:       // MongoServerError, not a RouteResponse, so it propagated as a bare
 299:       // 500). Claiming the pending record HERE, before any other write,
 300:       // means the losing side is rejected cleanly (its own updateOne
 301:       // legitimately matches 0 documents once the winner has committed) and
 302:       // never reaches the log insert or the budget/CAS writes at all.
 303:       const timestamp = new Date().toISOString();
 304:       const resolved_by = req.user.username;
 305:       const resolveResult = await pendingCol().updateOne(
 306:         { _id: pending._id, status: 'pending' },
 307:         { $set: { status: 'resolved', outcome: { old_status, new_status }, resolved_by, updated_at: timestamp } },
 308:         { session: dbSession },
 309:       );
 310:       if (resolveResult.matchedCount === 0)
 311:         throw new RouteResponse(409, { error: 'CONFLICT', message: 'Request is no longer pending', _needsEnrichment: true });
 312: 
 313:       if (PAID_TYPES.has(pending.action_type)) {
 314:         const territories = await getCollection('territories').find({}, { session: dbSession }).toArray();
 315:         const regentAmbience = findRegentTerritory(territories, actor)?.ambience;
 316:         const budget = calcEffectiveCityStatus(actor, regentAmbience);
 317: 
 318:         const budgetKey = `${pending.game_session_id}:${pending.actor_id}`;
 319:         const budgetCol = getCollection('office_action_budgets');
 320:         await budgetCol.updateOne(
 321:           { _id: budgetKey },
 322:           { $setOnInsert: { used: 0 } },
 323:           { session: dbSession, upsert: true },
 324:         );
 325:         const claim = await budgetCol.findOneAndUpdate(
 326:           { _id: budgetKey, used: { $lt: budget } },
 327:           { $inc: { used: 1 } },
 328:           { session: dbSession, returnDocument: 'after' },
 329:         );
 330:         if (!claim)
 331:           throw new RouteResponse(403, { error: 'FORBIDDEN', message: 'Budget exhausted for this session' });
 332:       }
 333: 
 334:       const statusMatch = old_status === 0
 335:         ? { $or: [{ 'status.city': { $exists: false } }, { 'status.city': 0 }] }
 336:         : { 'status.city': old_status };
 337:       const casResult = await getCollection('characters').updateOne(
 338:         { _id: targetObjectId, ...statusMatch },
 339:         { $set: { 'status.city': new_status, updated_at: timestamp } },
 340:         { session: dbSession },
 341:       );
 342:       if (casResult.matchedCount === 0)
 343:         throw new RouteResponse(409, { error: 'CONFLICT', message: 'Target was changed by another action — please retry' });
 344: 
 345:       const logDoc = {
 346:         game_session_id: pending.game_session_id,
 347:         actor_id:    pending.actor_id,
 348:         actor_name:  pending.actor_name,
 349:         target_id:   pending.target_id,
 350:         target_name: pending.target_name,
 351:         action_type: pending.action_type,
 352:         old_status,
 353:         new_status,
 354:         timestamp,
 355:       };
 356:       const insertedLog = await actionsCol().insertOne(logDoc, { session: dbSession });
 357: 
 358:       statusCode = 200;
 359:       body = {
 360:         request: { ...pending, status: 'resolved', outcome: { old_status, new_status }, resolved_by },
 361:         action:  { ...logDoc, _id: insertedLog.insertedId },
 362:         new_status,
 363:       };
 364:     });
 365:   } catch (err) {
 366:     if (err instanceof RouteResponse) {
 367:       statusCode = err.statusCode;
 368:       body = err.body;
 369:       // review finding: this branch fires on a true concurrent-accept race
 370:       // (both requests pass _findPending's read before either commits), so
 371:       // _findPending's own enrichment never ran for the loser. The winner's
 372:       // write is guaranteed committed by the time matchedCount is 0 (that's
 373:       // the only way this filtered update can fail to match), so a plain
 374:       // re-read here reliably sees it.
 375:       if (body._needsEnrichment) {
 376:         delete body._needsEnrichment;
 377:         const fresh = await pendingCol().findOne({ _id: pending._id });
 378:         Object.assign(body, _conflictBody(fresh));
 379:       }
 380:     }
 381:     else throw err;
 382:   } finally {
 383:     await dbSession.endSession();
 384:   }
 385: 
 386:   res.status(statusCode).json(body);
 387: });
