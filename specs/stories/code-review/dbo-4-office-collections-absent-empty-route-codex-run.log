 389: // PUT /api/office_actions/:id/decline
 390: // oaq.2: ST-only. Marks the record declined. No character mutation, no
 391: // budget claim (nothing was ever spent by a submission), no office_actions
 392: // log entry (nothing happened).
 393: router.put('/:id/decline', requireRole('st'), async (req, res) => {
 394:   const pending = await _findPending(req, res);
 395:   if (!pending) return;
 396: 
 397:   const timestamp = new Date().toISOString();
 398:   const declined_by = req.user.username;
 399:   const result = await pendingCol().updateOne(
 400:     { _id: pending._id, status: 'pending' },
 401:     { $set: { status: 'declined', declined_by, updated_at: timestamp } },
 402:   );
 403:   if (!result.matchedCount) {
 404:     // review finding: true concurrent race with another accept/decline —
 405:     // _findPending's own enrichment already ran before this update was
 406:     // attempted, so re-read fresh to name whoever actually won.
 407:     const fresh = await pendingCol().findOne({ _id: pending._id });
 408:     return res.status(409).json(_conflictBody(fresh));
 409:   }
 410: 
 411:   res.json({ declined: true, declined_by });
 412: });
