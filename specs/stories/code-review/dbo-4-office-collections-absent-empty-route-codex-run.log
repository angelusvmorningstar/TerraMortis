 318:   console.log(`Target DB: ${dbName}`);
 319:   console.log('');
 320: 
 321:   await connectDb();
 322:   try {
 323:     const seatsCollection = getCollection('office_seats');
 324:     const seatCount = await seatsCollection.countDocuments({});
 325:     console.log(`office_seats holds ${seatCount} seat(s).`);
 326:     console.log('');
 327: 
 328:     const totals = { migrated: 0, recovered: 0, deleted: 0, refused: 0, alreadySeatKeyed: 0, changedSincePlan: 0 };
 329: 
 330:     for (const name of PURCHASE_COLLECTIONS) {
 331:       const collection = getCollection(name);
 332:       const rows = await planMigration(collection, seatsCollection);
 333:       console.log(`${name}: ${rows.length} document(s).`);
 334: 
 335:       // An empty collection is a clean outcome, not an error.
 336:       // `office_manoeuvre_ranks` was empty live when this was written.
 337:       if (rows.length === 0) {
 338:         console.log('  nothing to migrate.');
 339:         console.log('');
 340:         continue;
 341:       }
 342: 
 343:       const result = await applyMigration(collection, rows, { apply, log: msg => console.log(msg) });
 344:       for (const k of Object.keys(totals)) totals[k] += result[k];
 345:       console.log('');
 346:     }
 347: 
 348:     console.log(
 349:       `Totals: ${totals.migrated} migrated, ${totals.recovered} recovered, ` +
 350:       `${totals.deleted} stale document(s) cleared, ${totals.refused} refused, ` +
 351:       `${totals.alreadySeatKeyed} already seat-keyed, ${totals.changedSincePlan} changed since planning.`
 352:     );
 353:     if (apply) {
