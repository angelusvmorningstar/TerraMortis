 302:       // need mocking the collection to interleave a write mid-call, which
 303:       // is disproportionate for a script one human runs once, by hand.
 304:       changedSincePlan += 1;
 305:       log(`  WARNING  : '${row.category}' changed after being copied to seat ${row.seatId} but before ` +
 306:           'the old document could be removed. BOTH documents now exist; reconcile them by hand.');
 307:     }
 308:   }
 309: 
 310:   return { migrated, recovered, deleted, refused, alreadySeatKeyed, changedSincePlan };
 311: }
