 531:       // aggregation-pipeline update a string beginning with '$' would be read
 532:       // as a field path. Same idiom as office-manoeuvre-rank.js's step route.
 533:       { $set: { rank: 0, office_category: { $literal: category }, updated_at: timestamp } },
 534:     ],
 535:     {
 536:       session: dbSession,
 537:       // upsert: false, DELIBERATELY. A seat that never purchased a rank has no
 538:       // document, nothing to destroy, and needs no document minted saying so.
