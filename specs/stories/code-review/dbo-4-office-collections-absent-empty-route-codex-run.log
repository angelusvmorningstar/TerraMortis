 119: /**
 120:  * A document `_id` shaped like a seat id: `String(ObjectId)`'s own form. No
 121:  * office category is 24 hexadecimal characters long, so the SHAPE alone is
 122:  * unambiguous evidence the key is not a category — but shape alone is not
 123:  * evidence the seat it names still exists (Codex review, oxp.11: an orphaned
 124:  * document — a real seat deleted after this collection was keyed to it, or a
 125:  * hand-malformed record — would match this pattern and be classified as
 126:  * already migrated, when there is in fact no real seat backing it at all).
 127:  * `planMigration` below checks BOTH: the shape, via this pattern, and real
 128:  * existence, against the seats it actually loaded.
 129:  */
 130: const SEAT_KEY = /^[0-9a-fA-F]{24}$/;
 131: 
 132: /**
 133:  * Classify every document in one purchase collection. PURE: reads only, no
 134:  * writes, no side effects, so `main()` can print the whole plan before anyone
 135:  * decides whether to run it.
 136:  *
 137:  * Both collections are taken as ARGUMENTS rather than resolved internally, so a
 138:  * test can hand over `tm_suite_test` collections and this can never reach live
 139:  * data by accident.
 140:  *
 141:  * @param {import('mongodb').Collection} purchaseCollection
 142:  * @param {import('mongodb').Collection} seatsCollection
 143:  * @returns {Promise<Array<{key:string, action:string, category?:string, seatId?:string, seatIds?:string[], doc?:object}>>}
 144:  */
 145: export async function planMigration(purchaseCollection, seatsCollection) {
 146:   const docs = await purchaseCollection.find({}).toArray();
 147:   if (docs.length === 0) return [];
 148: 
 149:   const seats = await seatsCollection.find({}).toArray();
 150:   const byCategory = new Map();
 151:   const realSeatIds = new Set();
 152:   for (const seat of seats) {
 153:     realSeatIds.add(String(seat._id));
 154:     const cat = seat && seat.office_category;
 155:     if (!cat) continue;
 156:     if (!byCategory.has(cat)) byCategory.set(cat, []);
 157:     byCategory.get(cat).push(String(seat._id));
 158:   }
 159: 
 160:   const rows = [];
 161:   for (const doc of docs) {
 162:     const key = String(doc._id);
 163: 
 164:     if (SEAT_KEY.test(key)) {
 165:       if (realSeatIds.has(key)) {
 166:         rows.push({ key, action: 'already-seat-keyed' });
 167:       } else {
 168:         // Shaped like a seat id, but no office_seats document has it. A real
 169:         // seat deleted out from under this purchase document, or a hand-
 170:         // malformed record — either way, silently calling this "migrated" and
 171:         // moving on would leave an unreachable orphan with no seat to belong
 172:         // to. Refuse it the same way an ambiguous or seatless CATEGORY is
 173:         // refused: report it, touch nothing, let a human decide.
 174:         rows.push({ key, action: 'refused-orphaned-seat-key' });
 175:       }
 176:       continue;
 177:     }
 178: 
 179:     const candidates = byCategory.get(key) || [];
 180:     if (candidates.length === 0) {
 181:       rows.push({ key, action: 'refused-no-seat', category: key });
 182:     } else if (candidates.length > 1) {
 183:       rows.push({ key, action: 'refused-ambiguous', category: key, seatIds: [...candidates] });
 184:     } else {
 185:       rows.push({ key, action: 'will-migrate', category: key, seatId: candidates[0], doc });
 186:     }
 187:   }
 188:   return rows;
 189: }
 190: 
 191: /**
 192:  * Build a filter that matches `doc`'s row ONLY if the collection's live copy
 193:  * is still exactly what was captured at plan time — an optimistic-concurrency
 194:  * guard keyed on `updated_at`, which both purchase routes set on every write
 195:  * (Codex review, oxp.11: `planMigration` and `applyMigration` are separate
 196:  * round-trips, so a write landing between them must never be silently
 197:  * discarded by inserting a stale snapshot or deleting a newer value under
 198:  * it). A document that somehow predates `updated_at` entirely is matched by
 199:  * its absence, not by a guessed value.
 200:  *
 201:  * @param {object} doc - the row's plan-time snapshot (`row.doc`)
 202:  * @returns {object} a MongoDB filter fragment
 203:  */
 204: function unchangedSince(doc) {
 205:   return Object.prototype.hasOwnProperty.call(doc, 'updated_at')
 206:     ? { updated_at: doc.updated_at }
 207:     : { updated_at: { $exists: false } };
 208: }
