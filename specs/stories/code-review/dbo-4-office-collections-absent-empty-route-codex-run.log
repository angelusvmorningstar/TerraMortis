 218: export async function applyMigration(purchaseCollection, rows, { apply = false, log = () => {} } = {}) {
 219:   let migrated = 0;
 220:   let recovered = 0;
 221:   let deleted = 0;
 222:   let refused = 0;
 223:   let alreadySeatKeyed = 0;
 224:   let changedSincePlan = 0;
 225: 
 226:   for (const row of rows) {
 227:     if (row.action === 'already-seat-keyed') {
 228:       alreadySeatKeyed += 1;
 229:       log(`  skip     : ${row.key} is already keyed by a seat id`);
 230:       continue;
 231:     }
 232:     if (row.action === 'refused-no-seat') {
 233:       refused += 1;
 234:       log(`  REFUSED  : '${row.category}' has no seat in office_seats. Left untouched; seed a seat first.`);
 235:       continue;
 236:     }
 237:     if (row.action === 'refused-ambiguous') {
 238:       refused += 1;
 239:       log(`  REFUSED  : '${row.category}' has ${row.seatIds.length} seats (${row.seatIds.join(', ')}). ` +
 240:           'A human must decide which seat this purchase state belongs to. Left untouched.');
 241:       continue;
 242:     }
 243:     if (row.action === 'refused-orphaned-seat-key') {
 244:       refused += 1;
 245:       log(`  REFUSED  : ${row.key} is shaped like a seat id, but no office_seats document has it. ` +
 246:           'Left untouched; confirm whether the seat was really deleted, or the key is malformed.');
 247:       continue;
 248:     }
 249: 
 250:     if (!apply) {
 251:       log(`  [DRY RUN] would migrate '${row.category}' -> seat ${row.seatId}`);
 252:       continue;
 253:     }
 254: 
 255:     // Re-check the source is still exactly what planMigration captured,
 256:     // BEFORE writing anything. A concurrent PUT to the category-keyed
 257:     // document between planning and this point must never have its change
 258:     // silently discarded by embedding the stale snapshot at the new seat id.
 259:     const stillCurrent = await purchaseCollection.findOne({ _id: row.key, ...unchangedSince(row.doc) });
 260:     if (!stillCurrent) {
 261:       changedSincePlan += 1;
 262:       log(`  CHANGED  : '${row.category}' was modified after this migration planned its move. ` +
 263:           'Left untouched. Re-run to pick up the current value.');
 264:       continue;
 265:     }
 266: 
 267:     // Insert first. `$setOnInsert` makes this atomic insert-or-nothing, and on
 268:     // the match branch it writes nothing, so an already-migrated document's
 269:     // real values can never be overwritten by a stale category-keyed copy.
 270:     const { _id: _oldKey, ...valueFields } = row.doc;
 271:     const result = await purchaseCollection.updateOne(
 272:       { _id: row.seatId },
 273:       { $setOnInsert: { ...valueFields, office_category: row.category } },
 274:       { upsert: true },
 275:     );
 276: 
 277:     if (result.upsertedCount === 1) {
 278:       migrated += 1;
 279:       log(`  migrated : '${row.category}' -> seat ${row.seatId}`);
 280:     } else {
 281:       recovered += 1;
 282:       log(`  recovered: seat ${row.seatId} already held a document (interrupted earlier run). ` +
 283:           `Kept it as-is; clearing the stale '${row.category}' document.`);
 284:     }
 285: 
 286:     // Delete second, guarded the SAME way as the pre-insert check above, so a
 287:     // write landing in the (much smaller) gap between the insert and this
 288:     // delete is also caught, not just one landing before the insert.
 289:     const del = await purchaseCollection.deleteOne({ _id: row.key, ...unchangedSince(row.doc) });
