diff --git a/tests/.tmp-rlv4-review.spec.js b/tests/.tmp-rlv4-review.spec.js
new file mode 100644
index 0000000000000000000000000000000000000000..33471a1c890893c429661918cb1535ea54ca3938
--- /dev/null
+++ b/tests/.tmp-rlv4-review.spec.js
@@ -0,0 +1,38 @@
+const { test, expect } = require('@playwright/test');
+
+test('review repro: retained pool button resolves against latest render array', async ({ page }) => {
+  await page.goto('/');
+  const result = await page.evaluate(async () => {
+    const { renderCharPools } = await import('/js/game/char-pools.js');
+    const attrs = Object.fromEntries([
+      'Intelligence', 'Wits', 'Resolve', 'Strength', 'Dexterity', 'Stamina',
+      'Presence', 'Manipulation', 'Composure',
+    ].map(name => [name, { dots: 2, bonus: 0 }]));
+    const base = {
+      attributes: attrs, disciplines: {}, merits: [], powers: [], equipment: [],
+      blood_potency: 1,
+    };
+    const a = { ...base, name: 'A', skills: { Occult: { dots: 1, bonus: 0 } } };
+    const b = { ...base, name: 'B', skills: {} };
+    const first = document.createElement('div');
+    const second = document.createElement('div');
+    document.body.append(first, second);
+    const tap = { called: false, value: 'sentinel' };
+    renderCharPools(first, a, value => { tap.called = true; tap.value = value; });
+    const retainedCustomIndex = first.querySelector('.gcp-choice').dataset.idx;
+    renderCharPools(second, b, () => {});
+    first.querySelector('.gcp-choice').click();
+    return {
+      called: tap.called,
+      becameUndefined: tap.value === undefined,
+      retainedCustomIndex,
+      latestCustomIndex: second.querySelector('.gcp-choice').dataset.idx,
+    };
+  });
+  expect(result).toEqual({
+    called: true,
+    becameUndefined: true,
+    retainedCustomIndex: '1',
+    latestCustomIndex: '0',
+  });
+});

