  891:   const body = document.getElementById('panel-body');
  892:   const title = document.getElementById('panel-title');
  893:   body.innerHTML = '';
  894: 
  895:   if (mode === 'char') {
  896:     title.textContent = 'Select Character';
  897:     const role = getRole();
  898:     const info = getPlayerInfo();
  899:     const charList = role === 'st'
  900:       ? suiteState.chars
  901:       : suiteState.chars.filter(c => info?.character_ids?.includes(c._id));
  902:     charList.forEach(c => {
  903:       const el = document.createElement('div');
  904:       el.className = 'panel-item';
  905:       el.innerHTML = `<div><div class="pi-main">${displayName(c)}</div><div class="pi-sub">${c.clan || ''} \u00B7 ${c.covenant || ''}</div></div><div class="pi-badge">${redactPlayer(c.player || '')}</div>`;
  906:       el.addEventListener('click', () => { pickChar(c); closePanel(); });
  907:       body.appendChild(el);
  908:     });
  909:   } else if (mode === 'disc') {
  910:     title.textContent = 'Select Discipline';
  911:     if (!suiteState.rollChar) {
  912:       body.innerHTML = '<div class="hempty" style="padding:24px 16px;">Select a character first</div>';
  913:     } else {
  914:       const c = suiteState.rollChar;
  915:       const allRules = getRulesByCategory('discipline');
  916: 
  917:       // Derive discipline powers from the rules cache (same as the editor sheet).
  918:       // For each discipline the character has dots in, show powers up to that rank.
  919:       const discEntries = Object.entries(c.disciplines || {})
  920:         .filter(([, v]) => (v?.dots || 0) > 0)
  921:         .sort(([a], [b]) => a.localeCompare(b));
  922: 
  923:       for (const [disc, v] of discEntries) {
  924:         const dots = v.dots || 0;
  925:         const ruledPowers = allRules
  926:           .filter(r => r.parent === disc && r.rank != null && r.rank <= dots)
  927:           .sort((a, b) => a.rank - b.rank);
  928:         // Fall back to stored c.powers if no rules exist for this discipline
  929:         const powers = ruledPowers.length
  930:           ? ruledPowers.map(r => ({ name: r.name, discipline: disc }))
  931:           : (c.powers || []).filter(p => p.category === 'discipline' && p.discipline === disc);
  932: 
  933:         if (!powers.length) continue;
  934:         const sec = document.createElement('div');
  935:         sec.className = 'panel-section';
  936:         sec.textContent = disc + ' (' + dots + ')';
  937:         body.appendChild(sec);
  938: 
  939:         for (const p of powers) {
  940:           const lookupKey = p.name || '';
  941:           const pi = getPool(c, lookupKey);
  942:           const hasRoll = pi && !pi.noRoll && pi.total !== undefined;
  943:           let poolEl = '<div class="pi-pool nr">\u2014</div>';
  944:           if (hasRoll) poolEl = '<div class="pi-pool">' + pi.total + '</div>';
  945:           let subStr = '';
  946:           if (hasRoll) subStr = pi.attr + ' + ' + pi.skill + (pi.resistance ? ' \u00B7 vs ' + pi.resistance : '');
  947:           else if (pi && pi.noRoll && pi.info && pi.info.c) subStr = 'Cost: ' + pi.info.c;
  948:           else if (pi && pi.info && pi.info.c) subStr = 'Cost: ' + pi.info.c;
  949:           const el = document.createElement('div');
  950:           el.className = 'panel-item';
  951:           el.innerHTML = '<div><div class="pi-main">' + lookupKey + '</div>' + (subStr ? '<div class="pi-sub">' + subStr + '</div>' : '') + '</div>' + poolEl;
  952:           el.addEventListener('click', () => {
  953:             if (hasRoll) { loadPool(pi.total, lookupKey, pi); }
  954:             else { toast(lookupKey + ' \u2014 no roll'); closePanel(); }
  955:           });
  956:           body.appendChild(el);
  957:         }
  958:       }
  959: 
  960:       // Also show devotions and rites from c.powers (these are character-specific picks)
  961:       const otherPowers = [...devotions(c), ...rites(c)];
  962:       if (otherPowers.length) {
  963:         const sec = document.createElement('div');
  964:         sec.className = 'panel-section';
  965:         sec.textContent = 'Devotions & Rites';
  966:         body.appendChild(sec);
  967:         for (const p of otherPowers) {
  968:           const lookupKey = p.name || '';
  969:           const pi = getPool(c, lookupKey);
  970:           const hasRoll = pi && !pi.noRoll && pi.total !== undefined;
  971:           let poolEl = '<div class="pi-pool nr">\u2014</div>';
  972:           if (hasRoll) poolEl = '<div class="pi-pool">' + pi.total + '</div>';
  973:           let subStr = '';
  974:           if (hasRoll) subStr = pi.attr + ' + ' + pi.skill + (pi.resistance ? ' \u00B7 vs ' + pi.resistance : '');
  975:           else if (pi && pi.noRoll && pi.info && pi.info.c) subStr = 'Cost: ' + pi.info.c;
  976:           const el = document.createElement('div');
  977:           el.className = 'panel-item';
  978:           el.innerHTML = '<div><div class="pi-main">' + lookupKey + '</div>' + (subStr ? '<div class="pi-sub">' + subStr + '</div>' : '') + '</div>' + poolEl;
  979:           el.addEventListener('click', () => {
  980:             if (hasRoll) { loadPool(pi.total, lookupKey, pi); }
  981:             else { toast(lookupKey + ' \u2014 no roll'); closePanel(); }
  982:           });
  983:           body.appendChild(el);
  984:         }
  985:       }
  986:     }
  987:   } else if (mode === 'auspex') {
  988:     title.textContent = 'Auspex Insight';
  989:     const c = suiteState.rollChar || suiteState.sheetChar;
  990:     const dots = c?.disciplines?.Auspex?.dots || 0;
  991:     if (!dots) {
  992:       body.innerHTML = '<div class="hempty" style="padding:24px 16px;">No Auspex rating detected.</div>';
  993:     } else {
  994:       let html = '';
  995:       const maxTier = Math.min(dots, 3);
  996:       for (let tier = 1; tier <= maxTier; tier++) {
  997:         html += `<div class="panel-section">Tier ${tier} \u2014 Auspex ${'&#9679;'.repeat(tier)}</div>`;
  998:         AUSPEX_QUESTIONS[tier].forEach(({ q, fmt }) => {
  999:           html += `<div class="auspex-q-item">
 1000:             <div class="auspex-q-text">${q}</div>
