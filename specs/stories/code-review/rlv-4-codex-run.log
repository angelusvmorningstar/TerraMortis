  647:   try {
  648:     // A surface declares the SET of sheets it needs, not one sheet (D9 Rev 13).
  649:     // admin-shared.css holds classes two or more admin surfaces emit; Downtime
  650:     // will inject the same sheet when it moves. loadSurfaceSheet is idempotent
  651:     // and promise-cached, so the second injection costs nothing and there is no
  652:     // ordering dependency between surfaces. Listed in source order for the
  653:     // cascade, though no cross-sheet conflict exists: the only cross-bucket
  654:     // co-occurrence is .sphere-card + .sphere-card-vacant, whose declarations
  655:     // are disjoint (background/border/padding vs opacity).
  656:     const [mod] = await Promise.all([
  657:       import('./admin/spheres-view.js'),
  658:       loadSurfaceSheet('css/admin-shared.css'),
  659:       loadSurfaceSheet('css/admin-spheres.css'),
  660:     ]);
  661:     await mod.initSpheresView();          // reads #spheres-content itself
  662:   } catch (err) {
  663:     console.error('[spheres] surface failed to load:', err);
  664:     // Write into the inner container, not the tab: replacing the tab would
  665:     // destroy #spheres-content and a retry could then never find it.
  666:     const target = el.querySelector('#spheres-content') || el;
  667:     target.innerHTML = '<p class="placeholder-msg">Spheres failed to load. Reload the page or check your connection.</p>';
