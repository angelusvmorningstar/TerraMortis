  779:   // applied to suiteState.chars AFTER combat-only chars are merged so
  780:   // resist-target attribute lookups also see modded values. Failure is
  781:   // graceful: applyOverlayToAll bails per-character and stripOverlay
  782:   // restores canonical values, so the suite stays operational without mods.
  783:   await loadGlobalSettings();
  784:   const globalEnabled = getGlobalSettings()?.st_mods_enabled !== false;
  785:   // Issue #879 (ADR-006 D4): materialise armour-adjusted defence on every
  786:   // char BEFORE applyOverlayToAll so 'derived.defence' STM mods compose
  787:   // additively on top of the real mechanical base.
  788:   for (const c of (suiteState.chars || [])) materialiseDerivedDefence(c);
  789:   await applyOverlayToAll(suiteState.chars, globalEnabled);
