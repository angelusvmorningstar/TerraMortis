 1017:         const total  = attrV + skillV + unskilled;
 1018:         const pi = { attr: a.attr, attrV, skill: a.skill, skillV, unskilled: unskilled || null, discName: null, discV: 0, resistance: a.resist, total };
 1019:         const el = document.createElement('div');
 1020:         el.className = 'panel-item';
 1021:         let sub = a.attr + ' + ' + a.skill;
 1022:         if (unskilled) sub += ' ' + unskilled + ' (unskilled)';
 1023:         if (a.resist) sub += ' \u00B7 vs ' + a.resist;
 1024:         if (a.note)   sub += ' \u00B7 ' + a.note;
 1025:         el.innerHTML = '<div><div class="pi-main">' + a.name + '</div><div class="pi-sub">' + sub + '</div></div><div class="pi-pool">' + total + '</div>';
 1026:         el.addEventListener('click', () => { loadPool(total, a.name, pi); });
 1027:         body.appendChild(el);
 1028:       });
 1029:     }
 1030:   } else if (mode === 'custom') {
 1031:     // rlv.4 (#1039, D5) — free Attribute x Skill x Discipline ad-hoc pool
 1032:     // builder, for rolls with no pre-built pool button. Attribute is the
 1033:     // only mandatory chip; Skill and Discipline are each independently
 1034:     // optional and toggle off on a second tap. A 0-dot skill is a
 1035:     // deliberate, allowed choice (unskilledPenalty applies), not hidden.
