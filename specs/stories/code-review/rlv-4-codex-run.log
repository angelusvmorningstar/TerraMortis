 1246: async function _switchChar(idx) {
 1247:   const c = editorState.chars[idx];
 1248:   if (!c) return;
 1249:   localStorage.setItem('tm_active_char', String(c._id));
 1250: 
 1251:   // Remember current tab so we stay on it
 1252:   const currentTab = document.querySelector('.tab.active')?.id?.replace('t-', '') || null;
 1253: 
 1254:   // Load tracker from API before rendering
 1255:   await ensureTrackerLoaded(c);
 1256: 
 1257:   // Update state without navigating
 1258:   editorState.editIdx = idx;
 1259:   suiteState.sheetChar = c;
 1260:   suiteState.rollChar = c;
 1261:   pickChar(c);
 1262: 
 1263:   // Editor sheet (STs only)
 1264:   if (getRole() === 'st') {
 1265:     renderIdentityTab(c);
 1266:     renderAttrsTab(c);
 1267:     editorRenderSheet(c);
 1268:   }
 1269: 
 1270:   // Suite sheet — renders into both desktop full sheet and phone split tabs
 1271:   document.getElementById('sh-empty').style.display = 'none';
 1272:   document.getElementById('sh-content-suite').style.display = '';
 1273:   suiteRenderSheet();
 1274: 
 1275:   // Pools panel
 1276:   const poolsEl = document.getElementById('gcp-panel');
 1277:   if (poolsEl) {
 1278:     renderCharPools(poolsEl, c, (p) => {
 1279:       goTab('roll');
 1280:       if (p.opensPanel) { openPanel(p.opensPanel); return; }
 1281:       loadPool(p.total, p.label, p.pi || { total: p.total, attr: p.attr, attrV: p.attrV, skill: p.skill, skillV: p.skillV, nineAgain: p.nineAgain, resistance: p.resistance });
 1282:     });
 1283:   }
 1284: 
 1285:   // Clear MISC past outcomes so they reload for the new character
 1286:   const miscEl = document.getElementById('misc-past-outcomes');
 1287:   if (miscEl) miscEl.innerHTML = '';
 1288: 
 1289:   // Update header name
 1290:   const hdrName = document.getElementById('hdr-char-name');
 1291:   if (hdrName) hdrName.textContent = displayName(c);
 1292: 
 1293:   // Re-render status tab if currently active
 1294:   if (currentTab === 'status') {
 1295:     renderSuiteStatusTab(document.getElementById('t-status'));
 1296:   }
 1297: 
 1298:   // Stay on current tab — don't navigate away
 1299:   if (currentTab) goTab(currentTab);
 1300: }
