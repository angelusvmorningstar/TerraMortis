          let html = '<div class="panel-section">Attribute</div><div class="vm-chip-wrap">';
          ALL_ATTRS.forEach(a => {
            html += `<button class="mchip cp-attr-chip${attr === a ? ' on' : ''}" data-a="${esc(a)}">${esc(a)}</button>`;
