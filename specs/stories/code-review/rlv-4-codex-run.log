 1038:       body.innerHTML = '<div class="hempty" style="padding:24px 16px;">Select a character first</div>';
 1039:     } else {
 1040:       const c = suiteState.rollChar;
 1041:       const myDiscs = Object.entries(c.disciplines || {}).filter(([, v]) => (v?.dots || 0) > 0).map(([name, v]) => ({ name, dots: v.dots }));
 1042:       let attr = null, skill = null, disc = null, showAll = false;
 1043:       const render = () => {
 1044:         let html = '<div class="panel-section">Attribute</div><div class="vm-chip-wrap">';
 1045:         ALL_ATTRS.forEach(a => {
 1046:           html += `<button class="mchip cp-attr-chip${attr === a ? ' on' : ''}" data-a="${esc(a)}">${esc(a)}</button>`;
 1047:         });
 1048:         html += '</div>';
 1049: 
 1050:         const nonZero = ALL_SKILLS.filter(s => skTotal(c, s) > 0);
 1051:         const shown = showAll ? ALL_SKILLS : nonZero;
 1052:         html += `<div class="panel-section">Skill <button class="cp-showall-btn" id="cp-showall">${showAll ? 'non-zero only' : 'show all'}</button></div><div class="vm-chip-wrap">`;
 1053:         if (!shown.length) {
 1054:           html += '<div class="hempty" style="padding:0 16px 8px;">No non-zero skills — tap "show all"</div>';
 1055:         }
 1056:         shown.forEach(s => {
 1057:           html += `<button class="mchip cp-skill-chip${skill === s ? ' on' : ''}" data-s="${esc(s)}">${esc(s)}</button>`;
 1058:         });
 1059:         html += '</div><div class="panel-section">Discipline</div>';
 1060:         html += myDiscs.length
 1061:           ? '<div class="vm-chip-wrap">' + myDiscs.map(d =>
 1062:               `<button class="mchip cp-disc-chip${disc === d.name ? ' on' : ''}" data-d="${esc(d.name)}">${esc(d.name)} (${d.dots})</button>`
 1063:             ).join('') + '</div>'
 1064:           : '<div class="hempty" style="padding:0 16px 8px;">No disciplines</div>';
 1065: 
 1066:         const attrV = attr ? getAttrVal(c, attr) : 0;
 1067:         const skillV = skill ? skTotal(c, skill) : 0;
 1068:         const unskilled = (skill && skillV === 0) ? unskilledPenalty(skill) : 0;
 1069:         const discDots = disc ? (myDiscs.find(d => d.name === disc)?.dots || 0) : 0;
 1070:         const total = Math.max(0, attrV + skillV + unskilled + discDots);
 1071: 
 1072:         if (attr) {
 1073:           const bits = [attr + ' ' + attrV];
 1074:           if (skill) bits.push(skill + ' ' + (unskilled ? unskilled : skillV) + (unskilled ? ' (unskilled)' : ''));
 1075:           if (disc) bits.push(disc + ' ' + discDots);
 1076:           html += `<div class="panel-total">${esc(bits.join(' + '))} = <b>${total}</b> dice</div>`;
 1077:           html += '<button class="pnl-confirm-btn" id="cp-load">Load Pool</button>';
 1078:         }
 1079:         body.innerHTML = html;
 1080:         body.querySelectorAll('.cp-attr-chip').forEach(btn => btn.addEventListener('click', () => { attr = attr === btn.dataset.a ? null : btn.dataset.a; render(); }));
 1081:         body.querySelectorAll('.cp-skill-chip').forEach(btn => btn.addEventListener('click', () => { skill = skill === btn.dataset.s ? null : btn.dataset.s; render(); }));
 1082:         body.querySelectorAll('.cp-disc-chip').forEach(btn => btn.addEventListener('click', () => { disc = disc === btn.dataset.d ? null : btn.dataset.d; render(); }));
 1083:         document.getElementById('cp-showall')?.addEventListener('click', () => { showAll = !showAll; render(); });
 1084:         document.getElementById('cp-load')?.addEventListener('click', () => {
 1085:           const label = [attr, skill, disc].filter(Boolean).join(' + ') || 'Custom Pool';
 1086:           const pi = { total, attr, attrV, skill: skill || null, skillV, unskilled: unskilled || null, discName: disc || null, discV: discDots, resistance: null };
 1087:           loadPool(total, label, pi);
 1088:         });
 1089:       };
 1090:       render();
 1091:     }
 1092:   }
