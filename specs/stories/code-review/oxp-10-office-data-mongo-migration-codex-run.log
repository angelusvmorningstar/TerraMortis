+    }
+    if (duplicateKeys.length) {
+      console.log('');
+      console.log(`  DUPLICATES (${duplicateKeys.length}) — the unique index cannot be created until these are resolved: ${duplicateKeys.join(', ')}`);
+    }
+  }
