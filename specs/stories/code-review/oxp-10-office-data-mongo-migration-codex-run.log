   9: export async function setupDb() {
  10:   try {
  11:     await connectDb(); // No-op if already connected (idempotent)
  12:   } catch (err) {
  13:     console.error('[setupDb] connectDb() failed:', err.message);
  14:     throw err;
  15:   }
  16: 
  17:   // Belt-and-braces: catches the case where a connection was already
  18:   // established (by earlier-running code) before setup-env.js's override
  19:   // took effect. connectDb()'s own guard only fires on the connection that
  20:   // creates `db`; this re-checks whatever connection setupDb() ends up with.
  21:   const dbName = getDb().databaseName;
  22:   if (!dbName.endsWith('_test')) {
  23:     throw new Error(
  24:       `Refusing test run: connected database '${dbName}' does not end with '_test'. ` +
  25:         `Tests must use a *_test database — check tests/helpers/setup-env.js ordering.`
  26:     );
  27:   }
  28: 
  29:   // Non-fatal: a small number of DB-adjacent suites mock '../db.js' with a
  30:   // minimal surface (connectDb/getDb only, e.g. issue-1143-db-setup-skip.test.js's
  31:   // own positive control) that has no working getCollection(). Letting a
  32:   // seeding failure abort setupDb() itself would fail EVERY DB-backed suite
  33:   // over a concern most of them never touch; a suite that actually needs
  34:   // office_content and doesn't have it will fail its own specific assertion
  35:   // instead, which is a clearer signal than an opaque setupDb() rejection.
  36:   try {
  37:     await ensureOfficeContentSeeded();
  38:   } catch (err) {
  39:     console.error('[setupDb] office_content auto-seed failed (non-fatal):', err.message);
  40:   }
  41: }
  42: 
  43: /**
  44:  * oxp.10: every office-purchase route (`office-merit-dots.js`,
  45:  * `office-manoeuvre-rank.js`, `office-purchase.js`) now resolves a seat's
  46:  * office rules by READING the `office_content` collection, not a static
  47:  * import — so any DB-backed suite that PUTs against a real office category
  48:  * needs real documents there, the same way `getTestCharacterIds` auto-seeds
  49:  * minimal characters above. Upserted (not deleted-then-inserted) and keyed on
  50:  * the real natural keys, so this is safe to call from every test file's
  51:  * `setupDb()` without one file's call racing or clobbering another's.
  52:  */
  53: async function ensureOfficeContentSeeded() {
  54:   const col = getCollection('office_content');
  55:   await ensureOfficeContentIndexes(col);
  56:   const docs = buildSeedDocs({ officeData: OFFICE_DATA, meritCaps: MERIT_DOT_CAPS, now: '2026-08-27T00:00:00.000Z' });
  57:   await Promise.all(docs.map(doc => {
  58:     const filter = doc.kind === 'office' ? { kind: 'office', category: doc.category } : { kind: 'merit_caps' };
  59:     return col.updateOne(filter, { $setOnInsert: doc }, { upsert: true });
  60:   }));
  61: }
