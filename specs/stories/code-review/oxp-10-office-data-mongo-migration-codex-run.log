  92: /**
  93:  * Get a few character IDs for testing player filtering.
  94:  *
  95:  * Against tm_suite_test (the default under vitest), the characters collection
  96:  * is usually empty. Auto-seed minimal stub characters when we don't have
  97:  * enough, so tests that just need "some valid character IDs" work without
  98:  * every test file having to roll its own fixtures.
  99:  */
 100: export async function getTestCharacterIds(count = 2) {
 101:   const col = getCollection('characters');
 102:   let chars = await col
 103:     .find({ retired: { $ne: true } })
 104:     .limit(count)
 105:     .project({ _id: 1, name: 1 })
 106:     .toArray();
 107: 
 108:   if (chars.length < count) {
 109:     const need = count - chars.length;
 110:     const stubs = Array.from({ length: need }, (_, i) => ({
 111:       name: `Test Character ${Date.now()}_${i}`,
 112:       retired: false,
 113:       _test_seeded: true,
 114:     }));
 115:     const result = await col.insertMany(stubs);
 116:     const seededIds = Object.values(result.insertedIds);
 117:     const seededDocs = await col
 118:       .find({ _id: { $in: seededIds } })
 119:       .project({ _id: 1, name: 1 })
 120:       .toArray();
 121:     chars = [...chars, ...seededDocs];
 122:   }
 123: 
 124:   return chars.map(c => ({ id: c._id.toString(), name: c.name }));
 125: }

