diff --git a/server/db.js b/server/db.js
index 7cfadb63c2a1e23b461c502a7a1e8709eb4730e2..8f45638d391cd78afa6cd4b62186c68b9ef4099a
--- a/server/db.js
+++ b/server/db.js
@@ -28,7 +28,7 @@
   const uri = config.MONGODB_URI.replace(/[&?]ssl=[^&]*/g, '');
   client = new MongoClient(uri, {
     serverSelectionTimeoutMS: 5000,
-    tls: true,
+    tls: !uri.startsWith('mongodb://127.0.0.1'),
   });
   await client.connect();
   db = client.db(dbName);
