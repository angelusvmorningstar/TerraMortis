 614: async function _adjustMeritDots(el, outcome, data, isOwnOffice, merit, delta) {
 615:   const gen = el._officeManoeuvreGen;
 616:   // Re-fetch fresh rather than trusting DOM state — another ST could have
 617:   // changed this since the row was last rendered.
 618:   let dotsBySeat;
 619:   try { dotsBySeat = await apiGet('/api/office_merit_dots'); } catch { return; }
 620:   const current = (dotsBySeat[outcome.seatId] || {})[merit] || 0;
 621:   const cap = meritCap(merit);
 622:   const next = Math.max(0, Math.min(cap, current + delta));
 623:   if (next === current) return;
 624: 
 625:   try {
 626:     await apiPut(`/api/office_merit_dots/${encodeURIComponent(outcome.seatId)}`, { merit, dots: next });
 627:   } catch {
 628:     return; // silent no-op on failure — the displayed value simply stays put
 629:   }
 630:   // The viewer may have switched category while the write was in flight;
 631:   // re-rendering now would paint this seat's dots into another office's markup.
 632:   if (gen !== el._officeManoeuvreGen) return;
 633:   // oxp.6: refreshes BOTH sections, not just this one — a merit purchase
 634:   // changes the shared balance the manoeuvre section's affordability markers
 635:   // read too.
 636:   await _refreshPurchaseState(el, outcome, data, isOwnOffice, gen);
 637: }
