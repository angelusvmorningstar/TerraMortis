  21:   { id: 'dockyards', name: 'The Dockyards', defaultRegent: 'René St. Dominique', ambience: 'Settled', ambienceMod: 0 },
  22:   { id: 'harbour', name: 'The Harbour', defaultRegent: 'Reed Justice', ambience: 'Untended', ambienceMod: -2 },
  23:   { id: 'northshore', name: 'The North Shore', defaultRegent: 'Alice Vunder', ambience: 'Tended', ambienceMod: +2 },
  24:   { id: 'secondcity', name: 'The Second City', defaultRegent: 'René Meyer', ambience: 'Tended', ambienceMod: +2 },
  25: ];
  26: 
  27: const KEY = 'tm_bids_v2';
  28: 
  29: /**
  30:  * Persisted-payload version. Version 1 is the empty-startable board introduced
  31:  * by TBID.1. A saved payload with NO schemaVersion but a populated
  32:  * `territories` array predates that story: it is kept exactly as saved and
  33:  * stamped on the next write, so shipping this change never wipes a board that
  34:  * is mid-session on somebody's browser.
