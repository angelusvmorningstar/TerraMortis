  45: let state = null;
  46: let modal = null;
  47: let saving = false;
  48: let _saveTimer = null;
  49: 
  50: function dflt() {
  51:   return {
  52:     phase: 'open',
  53:     peek: false,
  54:     territories: [],
  55:   };
  56: }
  57: 
  58: function load() {
  59:   try {
  60:     const s = JSON.parse(localStorage.getItem(KEY) || 'null');
  61:     if (s && Array.isArray(s.territories)) {
  62:       // Already on the current model: use it as saved.
  63:       if (s.schemaVersion != null) return { ...dflt(), ...s };
  64:       // Pre-TBID.1 save with a live board: grandfather it in, version stamped
  65:       // on the next persist() rather than reseeding the old always-five shape.
  66:       if (s.territories.length) return { ...dflt(), ...s, schemaVersion: SCHEMA_VERSION };
