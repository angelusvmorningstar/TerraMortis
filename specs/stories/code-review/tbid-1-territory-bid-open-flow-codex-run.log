+const { test } = require('@playwright/test');
+
+const ST_USER = {
+  id: '123456789', username: 'test_st', global_name: 'Test ST', avatar: null,
+  role: 'st', player_id: 'p-001', character_ids: [], is_dual_role: false,
+};
+
+async function mount(page, names) {
+  await page.route('**/api/auth/me', route => route.fulfill({ status: 200, contentType: 'application/json', body: JSON.stringify(ST_USER) }));
+  await page.route('**/api/characters*', route => route.fulfill({ status: 200, contentType: 'application/json', body: '[]' }));
+  await page.addInitScript(user => {
+    try { if (navigator.serviceWorker) navigator.serviceWorker.register = () => Promise.resolve(); } catch {}
+    localStorage.setItem('tm_auth_token', 'fake-test-token');
+    localStorage.setItem('tm_auth_expires', String(Date.now() + 3600000));
+    localStorage.setItem('tm_auth_user', JSON.stringify(user));
+    localStorage.removeItem('tm_bids_v2');
+  }, ST_USER);
+  await page.goto('/index.html');
+  await page.waitForFunction(() => typeof window._mountTerr === 'function');
+  await page.evaluate(namesArg => {
+    window._charNames = namesArg;
+    const login = document.getElementById('login-screen');
+    if (login) login.style.display = 'none';
+    const app = document.getElementById('app');
+    if (app) app.style.display = '';
+    document.querySelectorAll('.tab').forEach(el => el.classList.remove('active'));
+    document.getElementById('t-territory').classList.add('active');
+    window._mountTerr();
+  }, names);
+}
+
+test('probe catalogue-only and quoted Regent values', async ({ page }) => {
+  await mount(page, ['Alice Vunder', 'Jane "JJ" Doe']);
+  await page.getByRole('button', { name: 'Open Territory Bid' }).click();
+  await page.locator('.pick-tile', { hasText: 'The Academy' }).click();
+  await page.locator('.modal-btns .btn-primary').click();
+  const catalogue = await page.evaluate(() => ({
+    tag: document.querySelector('.regent-tag')?.textContent,
+    selectValue: document.querySelector('.regent-sel')?.value,
+    options: Array.from(document.querySelectorAll('.regent-sel option'), o => ({ text: o.textContent, value: o.value })),
+  }));
+
+  await page.getByRole('button', { name: 'Open Territory Bid' }).click();
+  await page.locator('.pick-tile', { hasText: 'The Harbour' }).click();
+  await page.locator('#modal-regent').selectOption({ label: 'Jane "JJ" Doe' });
+  const quotedBeforeSubmit = await page.locator('#modal-regent').evaluate(el => ({ value: el.value, html: el.innerHTML }));
+  await page.locator('.modal-btns .btn-primary').click();
+  const quotedAfterSubmit = await page.locator('.tc', { hasText: 'The Harbour' }).evaluate(el => ({
+    tag: el.querySelector('.regent-tag')?.textContent,
+    selectValue: el.querySelector('.regent-sel')?.value,
+  }));
+  console.log(JSON.stringify({ catalogue, quotedBeforeSubmit, quotedAfterSubmit }));
+});

