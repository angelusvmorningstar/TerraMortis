===== public/js/game/contested-resolve.js =====
1:/* crd.3b — the real room behind crd.2's door: the defender's own pool-builder
2: * for a contested roll, replacing the honest "coming soon" placeholder this
3: * file used to be.
4: *
5: * Entry contract, extended additively from crd.2's own (mirrors goTab(t) ->
6: * goTab(t, ctx)'s own precedent rather than inventing a new calling shape):
7: *
8: *     goTab('contested-resolve', { challengeId })
9: *       -> initContestedResolve(rootEl, ctx, chars)
10: *
11: * `chars` is the viewer's own full character list (crd.2's own
12: * `suiteState.chars`, already resident in memory — no new GET is added here;
13: * `app.js` already threads it into `initPendingQueue`, just not into this
14: * module until now).
15: *
16: * Trust boundary (crd.3a, unchanged and unmodified by this story): every
17: * aspect/Willpower/merit change calls the server's own PUT .../resolve and
18: * displays exactly the `defender_pool` it returns. Nothing here recomputes or
19: * guesses that number. The final commit calls the pre-existing, unmodified
20: * PUT .../accept — the actual dice roll ALREADY happens server-side there
21: * (crd.1), so this module never rolls its own dice. `mkColsEl` is imported
22: * from roll-v2.js purely to RENDER the rolls the server already decided
23: * (confirmed independent of that file's own pool-building `state` by reading
24: * it directly; it builds each die internally, so no separate die-builder
25: * import is needed here) — this module must never import `../shared/dice.js`'s
26: * `rollPool`/`d10`, which would silently perform a SECOND, illegitimate
27: * client-side roll alongside the server's real one.
28: */
29:
30:import { apiRaw } from '../data/api.js';
31:import { esc, redactCharName } from '../data/helpers.js';
32:import { ROLL_LABELS, getPendingChallenge, markChallengeResolved } from './pending-queue.js';
33:import { ensureLoaded, trackerRead } from './tracker.js';
34:import { mkColsEl } from '../suite/roll-v2.js';
35:
36:const ASPECT_ATTR = { mental: 'Resolve', social: 'Composure', physical: 'Stamina' };
37:const ASPECT_ORDER = ['mental', 'social', 'physical'];
38:const ASPECT_LABEL = { mental: 'Mental', social: 'Social', physical: 'Physical' };
39:// crd.3a's own narrow, explicitly-named 2-merit lookup — mirrored here for
40:// DISPLAY filtering only. The server is the sole authority on whether a
41:// submitted id is actually honoured; this list existing in two places is a
42:// display concern, not a second trust boundary.
43:const RESOLVABLE_MERIT_KEYS = new Set(['indomitable', 'closed-book']);
44:
45:let _rootEl = null;
46:let _resolveGen = 0;
47:// crd.3b code review (external Codex, Pass 1): bumped on every mount, checked
48:// after every awaited network call in _resolve/_accept/the WP-load callback.
49:// _resolveGen alone only orders resolves WITHIN one mount — a mount's own
50:// first resolve call after _resetState still has the SAME _resolveGen value
51:// a still-pending call from a PRIOR mount was issued under, so that stale
52:// call's `gen !== _resolveGen` check could pass by coincidence and paint a
53:// newer mount (even one for a different challenge) with an older mount's
54:// data. _accept had no such guard at all. _mountGen closes both gaps.
55:let _mountGen = 0;
56:
57:const state = {
58:  challengeId: null,
59:  challenge:   null,
60:  character:   null,
61:  charsCount:  0,
62:  wpAvailable: 0,
63:  aspect:      null,
64:  wpOn:        false,
65:  meritIds:    new Set(),
66:  // crd.4a: server-computed { eligible, bp_value, city_value } from the most
67:  // recent /resolve response, or null when the at-Court City Status gate is
68:  // closed for this challenge. statusTerm is the player's own 'bp'|'city'
69:  // choice — NEVER defaulted or pre-selected, even when one value is larger.
70:  statusChoice: null,
71:  statusTerm:   null,
72:  pool:        null,
73:  poolError:   null,
74:  resolving:   false,
75:  accepting:   false,
76:  outcome:     null,   // set once /accept succeeds
77:  acceptError: null,
78:};
79:
80:function _attrEffective(character, attrName) {
81:  const a = character?.attributes?.[attrName];
82:  return (a?.dots || 0) + (a?.bonus || 0);
83:}
84:
85:function _resetState(challengeId, challenge, character, charsCount) {
86:  _mountGen++;
87:  state.challengeId = challengeId;
88:  state.challenge   = challenge;
89:  state.character   = character;
90:  state.charsCount  = charsCount;
91:  state.wpAvailable = 0;
92:  state.aspect      = null;
93:  state.wpOn        = false;
94:  state.meritIds    = new Set();
95:  state.statusChoice = null;
96:  state.statusTerm   = null;
97:  state.pool        = null;
98:  state.poolError   = null;
99:  state.resolving   = false;
100:  state.accepting   = false;
101:  state.outcome     = null;
102:  state.acceptError = null;
103:}
