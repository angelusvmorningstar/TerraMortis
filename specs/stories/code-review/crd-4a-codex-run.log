98:export function shDots(n) {
99:  return '<span class="pointed"></span>'.repeat(Math.max(0, n || 0));
100:}
101:
102:/** Render `base` filled dots followed by `bonus` hollow dots.
103: *
104: *  Issue #408 (Epic STM UX polish): optional `opts` lets callers tag
105: *  a sub-range of dots as "ST-modded" — those dots receive the
106: *  `stm-modded-dot` class + `data-stm-marker-path` attribute + a
107: *  `title` tooltip. The delegated click handler at document.body
108: *  (`installStModPopover`) dispatches on `data-stm-marker-path`, so
109: *  clicking a modded dot opens the popover. This replaces the
110: *  pre-#408 standalone `.stm-marker` pip that visually collided
111: *  with the dot run.
112: *
113: *  opts = {
114: *    filledMod: { from, to, path, title } | undefined,
115: *    hollowMod: { from, to, path, title } | undefined,
116: *  }
117: *  Indices are zero-based into the respective stream
118: *  (filled = positions [0..base-1]; hollow = positions [0..bonus-1]).
119: *  `to` is exclusive. Callers compute hollow-stream indices including
120: *  any auto-bonus offset (attributes: autoBonus dots come first in
121: *  the hollow stream; modded manual bonus starts at autoBonus + ovBonus.base).
122: *
123: *  No-opts path is byte-identical to the pre-#408 implementation. */
124:export function shDotsWithBonus(base, bonus, opts) {
125:  if (!opts || (!opts.filledMod && !opts.hollowMod)) {
126:    if (!bonus) return shDots(base);
127:    return '<span class="pointed"></span>'.repeat(Math.max(0, base || 0)) + '<span class="pointed hollow"></span>'.repeat(Math.max(0, bonus || 0));
128:  }
129:  const fm = opts.filledMod;
130:  const hm = opts.hollowMod;
131:  let out = '';
132:  const baseN = Math.max(0, base || 0);
133:  for (let i = 0; i < baseN; i++) {
134:    if (fm && i >= fm.from && i < fm.to) {
135:      out += `<span class="pointed stm-modded-dot" data-stm-marker-path="${esc(fm.path || '')}" title="${esc(fm.title || '')}"></span>`;
136:    } else {
137:      out += '<span class="pointed"></span>';
138:    }
139:  }
140:  const bonusN = Math.max(0, bonus || 0);
141:  for (let i = 0; i < bonusN; i++) {
142:    if (hm && i >= hm.from && i < hm.to) {
143:      out += `<span class="pointed hollow stm-modded-dot" data-stm-marker-path="${esc(hm.path || '')}" title="${esc(hm.title || '')}"></span>`;
144:    } else {
145:      out += '<span class="pointed hollow"></span>';
146:    }
147:  }
148:  return out;
149:}
