271:export function getWillpower(c) {
272:  const mask  = ARCHETYPES_DB[c.mask]  || {};
273:  const dirge = ARCHETYPES_DB[c.dirge] || {};
274:  return {
275:    mask_1wp:  mask.wp1   || '',
276:    mask_all:  mask.wpAll || '',
277:    dirge_1wp: dirge.wp1  || '',
278:    dirge_all: dirge.wpAll || '',
279:  };
