57: *  discordId / avatarHash may be null — falls back to Discord's default avatar
58: *  set (embed/avatars/0.png) in normal mode. */
59:export function discordAvatarUrl(discordId, avatarHash, size = 64) {
60:  if (isRedactMode()) return REDACTED_AVATAR;
61:  if (discordId && avatarHash) {
