307:// PUT /api/contested_roll_requests/:id/accept — target accepts; dice rolled server-side
308:router.put('/:id/accept', async (req, res) => {
309:  const challenge = await _findChallenge(req, res);
310:  if (!challenge) return;
311:
312:  const charIds = (req.user.character_ids || []).map(id => String(id));
313:  if (!charIds.includes(challenge.target_character_id)) {
314:    return res.status(403).json({ error: 'FORBIDDEN', message: 'You are not the target of this challenge' });
315:  }
316:
317:  // crd.1 INTERIM GUARD (external code review). crd.1 made `defender_pool`
318:  // optional at creation, which made a pending challenge with no pool at all a
319:  // newly reachable state — but left this route unchanged. `_roll(undefined)`
320:  // returns `[]` (Math.max(0, undefined) is NaN, so its loop never runs), so
321:  // accepting one silently resolved the challenge with the defender on ZERO
322:  // dice and handed the attacker the win.
323:  //
324:  // crd.3a's resolve endpoint is what will ever populate `defender_pool` for
325:  // real. Until then, an unresolved request cannot be accepted at all, which is
326:  // safe; silently rolling zero dice, which is not. This is deliberately a
327:  // block and NOT a pool computation — do not grow resolution logic here, it
328:  // belongs in crd.3a. Delete this guard when crd.3a lands and every pending
329:  // challenge reaches accept with a server-computed pool.
330:  //
331:  // `== null` on purpose: an explicit `defender_pool: 0` is a RESOLVED pool
332:  // (crd.3a may legitimately compute zero dice) and must still be accepted.
333:  if (challenge.defender_pool == null) {
334:    return res.status(409).json({
335:      error: 'CONFLICT',
336:      message: 'This challenge has no defender pool yet and cannot be accepted. The defender must resolve their own pool first.',
337:    });
338:  }
339:
340:  // Roll dice server-side for both sides
341:  const atkCols = _roll(challenge.challenger_pool);
342:  const defCols = _roll(challenge.defender_pool);
343:  const atkSuc  = _countSuc(atkCols);
344:  const defSuc  = _countSuc(defCols);
345:
346:  let outcome, margin;
347:  if (atkSuc > defSuc)      { outcome = 'attacker'; margin = atkSuc - defSuc; }
348:  else if (defSuc > atkSuc) { outcome = 'defender'; margin = defSuc - atkSuc; }
349:  else                       { outcome = 'draw';     margin = 0; }
350:
351:  const outcomeData = {
352:    attacker: { name: challenge.challenger_character_name, pool: challenge.challenger_pool, successes: atkSuc, rolls: atkCols },
353:    defender: { name: challenge.target_character_name,    pool: challenge.defender_pool,   successes: defSuc, rolls: defCols },
354:    outcome,
355:    margin,
356:  };
357:
358:  await col().updateOne(
359:    { _id: challenge._id },
360:    { $set: { status: 'resolved', outcome: outcomeData, updated_at: new Date().toISOString() } }
361:  );
362:
363:  // Log to session_logs directly (session_logs HTTP endpoint is ST-only)
364:  try {
365:    await logCol().insertOne({
366:      session_date:  new Date().toISOString().slice(0, 10),
367:      type:          'player_contested_roll',
368:      roll_type:     challenge.roll_type,
369:      power_name:    challenge.power_name || null,
370:      challenge_id:  String(challenge._id),
371:      attacker:      outcomeData.attacker,
372:      defender:      outcomeData.defender,
373:      outcome,
374:      margin,
375:      timestamp:     new Date().toISOString(),
376:    });
377:  } catch { /* log failure is non-fatal */ }
378:
379:  res.json(await col().findOne({ _id: challenge._id }));
380:});
