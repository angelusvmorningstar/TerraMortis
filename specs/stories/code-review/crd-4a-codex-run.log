===== server/tests/crd-4a-defensive-status-choice.test.js =====
1:/**
2: * crd.4a — the at-Court City Status advantage gate on PUT /:id/resolve
3: * (Epic CRD, specs/stories/crd-4a-defensive-status-choice.md).
4: *
5: *   AC1 — the three-condition gate (power_name set, game mode active via
6: *         currentCycleInGamePhase, both sides attended:true in the current
7: *         game session) plus the City-Status-higher requirement, computed
8: *         fresh from live data on every call. Each condition tested failing
9: *         alone.
10: *   AC2 — when the gate is open, the response carries status_choice
11: *         { eligible: true, bp_value, city_value } even before a term is
12: *         chosen. Omitted when the gate is closed.
13: *   AC3 — when the gate is open, defender_status_term becomes required for
14: *         the pool to finalise: missing/invalid leaves defender_pool null
15: *         (not a 400), a valid choice adds the right term's value once.
16: *   AC4 — defender_status_term persists on the document ('bp'|'city'|null).
17: *
18: * Follows crd-3a-resolve-endpoint.test.js's exact fixture/cleanup/
19: * describe.skipIf(!dbAvailable) shape, and otc-2-office-actions-api.test.js's
20: * established pattern for seeding a reliably-"current" chapter and game
21: * session in a shared test database (fileParallelism: false makes a full
22: * defensive wipe of both collections safe within this file's own run).
23: *
24: * DB-backed: real MongoDB required. See db-setup.js.
25: */
26:
27:import { describe, it, expect, beforeAll, beforeEach, afterAll } from 'vitest';
28:import request from 'supertest';
29:import { createTestApp, playerUser } from './helpers/test-app.js';
30:import { setupDb, teardownDb, isDbAvailable } from './helpers/db-setup.js';
31:import { getCollection } from '../db.js';
32:import { ObjectId } from 'mongodb';
33:
34:const dbAvailable = await isDbAvailable();
35:
36:let app;
37:const NAME_PREFIX = 'CRD-4A Probe';
38:const GAME_NUMBER = 977; // distinctive, well above any other fixture's game_number
39:
40:const seededCharIds = [];
41:
42:async function seedChar({ city = 0, bloodPotency = 3, courtCategory = null } = {}) {
43:  const { insertedId } = await getCollection('characters').insertOne({
44:    name: `${NAME_PREFIX} Char ${Date.now()}_${Math.random()}`,
45:    retired: false,
46:    attributes: { Resolve: { dots: 2, bonus: 0 }, Composure: { dots: 2, bonus: 0 }, Stamina: { dots: 2, bonus: 0 } },
47:    merits: [],
48:    blood_potency: bloodPotency,
49:    status: { city },
50:    court_category: courtCategory,
51:  });
52:  seededCharIds.push(insertedId);
53:  return insertedId;
54:}
55:
56:async function seedChallenge(defenderOid, challengerOid, overrides = {}) {
57:  const base = {
58:    challenger_character_id:   String(challengerOid),
59:    challenger_character_name: `${NAME_PREFIX} Challenger`,
60:    target_character_id:       String(defenderOid),
61:    target_character_name:     `${NAME_PREFIX} Target`,
62:    roll_type:       'resistance',
63:    challenger_pool: 5,
64:    power_name:      'Majesty',
65:    request_type:    'contested_roll',
66:    status:          'pending',
67:    outcome:         null,
68:    created_at:      new Date().toISOString(),
69:    updated_at:      new Date().toISOString(),
70:    ...overrides,
71:  };
72:  const { insertedId } = await getCollection('contested_roll_requests').insertOne(base);
73:  return String(insertedId);
74:}
