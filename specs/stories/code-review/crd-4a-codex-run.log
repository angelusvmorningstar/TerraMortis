290:  await col().updateOne(
291:    { _id: challenge._id },
292:    { $set: {
293:        defender_pool:         finalPool,
294:        defender_aspect,
295:        defender_wp_spent:     spendWp,
296:        defender_merit_ids:    resolvedMeritIds,
297:        defender_status_term:  defenderStatusTerm,
298:        updated_at:            new Date().toISOString(),
299:      } }
300:  );
301:
302:  const updated = await col().findOne({ _id: challenge._id });
303:  if (statusChoice) updated.status_choice = statusChoice;
304:  res.json(updated);
305:});
