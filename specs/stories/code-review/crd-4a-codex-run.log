329:    const attr = ASPECT_ATTR[a];
330:    const val = _attrEffective(character, attr);
331:    return `<button type="button" data-cr-aspect="${a}" class="${state.aspect === a ? 'on' : ''}">
332:      ${ASPECT_LABEL[a]}<span class="cr-aspect-attr">${attr} · ${val}</span>
333:    </button>`;
334:  }).join('');
335:
336:  const wpDisabled = state.wpAvailable <= 0;
337:  const wpNote = wpDisabled
338:    ? 'No Willpower available.'
339:    : `${state.wpAvailable} Willpower available. A Resistance roll gets +2, not the usual +3.`;
340:
341:  // crd.4a: the at-Court City Status advantage. Only ever rendered when the
342:  // SERVER says the gate is open (state.statusChoice.eligible) — never a
343:  // client-side guess. Neither option ever carries `.on` by default, even
344:  // when one value is obviously larger; the "Higher" pill is guidance only.
345:  const sc = state.statusChoice;
346:  const statusChoiceHtml = sc?.eligible ? `
347:    <div>
348:      <div class="form-section-title">City Status advantage</div>
349:      <p class="derived-note">You outrank ${esc(redactCharName(c.challenger_character_name || 'them'))} at Court. Pick which term strengthens your defence — you always choose, even when one is clearly larger.</p>
350:      <div class="cr-status-seg" data-cr-status-seg>
351:        <button type="button" data-cr-status-term="bp" class="${state.statusTerm === 'bp' ? 'on' : ''}">
352:          Blood Potency<span class="cr-status-term-val">+${esc(String(sc.bp_value))}</span>${sc.bp_value > sc.city_value ? '<span class="cr-status-pill">Higher</span>' : ''}
353:        </button>
354:        <button type="button" data-cr-status-term="city" class="${state.statusTerm === 'city' ? 'on' : ''}">
355:          City Status gap<span class="cr-status-term-val">+${esc(String(sc.city_value))}</span>${sc.city_value > sc.bp_value ? '<span class="cr-status-pill">Higher</span>' : ''}
356:        </button>
357:      </div>
358:      ${!state.statusTerm ? '<p class="cr-status-unselected-warn">Choose one to include it in your pool.</p>' : ''}
359:    </div>` : '';
360:
361:  const merits = (character.merits || []).filter(m => RESOLVABLE_MERIT_KEYS.has(m.rule_key));
362:  const meritHtml = merits.length
363:    ? `<div class="cr-merit-row">${merits.map(m => {
364:        const on = state.meritIds.has(m.rule_key);
365:        const bonus = m.rule_key === 'indomitable' ? 2 : (m.rating || 0);
366:        return `<button type="button" data-cr-merit="${esc(m.rule_key)}" class="cr-merit-chip${on ? ' on' : ''}">
367:          ${esc(m.name)} <span class="cr-merit-bonus">+${bonus}</span>
368:        </button>`;
369:      }).join('')}</div>`
370:    : `<p class="derived-note">This character has no merits that apply to a contested roll yet.</p>`;
371:
372:  // AC8: a second reason defender_pool can be null (crd-3b's own precedent
373:  // is "no aspect chosen yet") — the gate is open but no status term has
374:  // been picked. Distinguished for messaging, both still mean "not
375:  // finalised yet".
376:  const awaitingStatusTerm = sc?.eligible && !state.statusTerm;
377:
378:  const poolDisplay = state.poolError
379:    ? `<span class="cr-pool-error">${esc(state.poolError)}</span>`
380:    : awaitingStatusTerm
381:      ? `<span class="cr-pool-pending">Choose above</span>`
382:      : `${state.pool == null ? '-' : esc(String(state.pool))}<span class="cr-pool-unit">${state.pool === 1 ? 'die' : 'dice'}</span>`;
383:
384:  // AC7: deliberately NOT gated on state.pool != null — the route's own
385:  // defender_pool == null 409 (crd.1) is what protects this, and this story
386:  // adds no client-side duplicate of that guard (crd.3b code review,
387:  // external Codex, Pass 3a). Gating here would make that 409 unreachable
388:  // from this screen.
389:  const canAccept = !state.resolving && !state.accepting;
390:
391:  return `
392:    <div class="stm-audit-root">
393:      <header class="stm-audit-head"><h2>Resolve Challenge</h2><p class="stm-audit-sub">Build your resistance pool, then roll.</p></header>
394:      <div class="cq-resolve-body">
395:        ${identity}
396:        <div class="ch-pools">
397:          <div class="ch-pool-row"><span class="ch-pool-lbl">Challenger</span><span class="ch-pool-val">${esc(redactCharName(c.challenger_character_name || 'Someone'))}</span></div>
398:          <div class="ch-pool-row"><span class="ch-pool-lbl">Contest</span><span class="ch-pool-val">${esc(ROLL_LABELS[c.roll_type] || c.roll_type || 'Contested Roll')}</span></div>
399:          <div class="ch-pool-row"><span class="ch-pool-lbl">Their pool</span><span class="ch-pool-val">${esc(String(c.challenger_pool))} dice</span></div>
400:        </div>
401:        <div>
402:          <div class="form-section-title">How do you resist?</div>
403:          <div class="cr-aspect-seg" data-cr-aspect-seg>${aspectHtml}</div>
404:        </div>
405:        <div>
406:          <div class="form-section-title">Willpower</div>
407:          <button type="button" data-cr-wp class="cr-wp-toggle${state.wpOn ? ' on' : ''}${wpDisabled ? ' disabled' : ''}">
408:            <span>Spend a point of Willpower</span><span class="cr-wp-bonus">+2 dice</span>
409:          </button>
410:          <p class="derived-note">${esc(wpNote)}</p>
411:        </div>
412:        ${statusChoiceHtml}
413:        <div>
414:          <div class="form-section-title">Merits</div>
415:          ${meritHtml}
416:        </div>
417:        <div class="cr-pool-preview">
418:          <span class="cr-pool-label">Your pool</span>
419:          <span class="cr-pool-value">${poolDisplay}</span>
420:        </div>
421:        ${state.acceptError ? `<p class="cr-pool-error">${esc(state.acceptError)}</p>` : ''}
422:        <div class="ch-modal-actions cq-actions">
423:          <button type="button" class="ch-btn ch-btn-decline" data-cr-back>Back</button>
424:          <button type="button" class="ch-btn ch-btn-accept" data-cr-accept ${canAccept ? '' : 'disabled'}>
425:            ${state.accepting
426:              ? 'Rolling…'
427:              : awaitingStatusTerm
428:                ? 'Choose a status term first'
429:                : (state.pool == null ? 'Choose how to resist' : `Roll ${state.pool} ${state.pool === 1 ? 'Die' : 'Dice'}`)}
430:          </button>
431:        </div>
432:      </div>
433:    </div>`;
434:}
