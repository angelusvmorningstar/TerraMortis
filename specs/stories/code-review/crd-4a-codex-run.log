===== server/schemas/contested_roll_request.schema.js =====
1:/**
2: * JSON Schema (Draft-07) for player-to-player contested roll requests.
3: * Collection: contested_roll_requests
4: *
5: * Validated on POST (challenge creation). Status, outcome, timestamps
6: * are set server-side and not included in this schema.
7: *
8: * crd.1: this collection is shared with Status Actions (`request_type:
9: * 'status_action'`), which bypass this schema entirely via a direct insert in
10: * office-actions.js. Contested rolls now carry their own explicit
11: * `request_type: 'contested_roll'` discriminator rather than being identified
12: * by the ABSENCE of one — see the note on that property below.
13: */
14:
15:export const contestedRollRequestSchema = {
16:  $schema: 'http://json-schema.org/draft-07/schema#',
17:  title: 'TM Contested Roll Request',
18:  type: 'object',
19:  required: [
20:    'challenger_character_id',
21:    'challenger_character_name',
22:    'target_character_id',
23:    'target_character_name',
24:    'roll_type',
25:    'challenger_pool',
26:  ],
27:  additionalProperties: false,
28:  properties: {
29:    challenger_character_id:   { type: 'string', minLength: 1 },
30:    challenger_character_name: { type: 'string', minLength: 1 },
31:    target_character_id:       { type: 'string', minLength: 1 },
32:    target_character_name:     { type: 'string', minLength: 1 },
33:    // crd.1: NOT required. Omitting it is still valid for any caller that
34:    // doesn't set it; contested-rolls.js's own POST / always sets it
35:    // explicitly on the inserted document (mirroring office-actions.js's
36:    // `request_type: 'status_action'`), so the enum here exists to stop a
37:    // client asserting any OTHER type through this route.
38:    request_type: { type: 'string', enum: ['contested_roll'] },
39:    // roll_type categorises the CONTEST for session-log/display purposes.
40:    // It is a different axis from defender_aspect below (which Resistance
41:    // Attribute feeds the defender's pool) — do not derive one from the other.
42:    // 'territory' removed 2026-08-24: territory disputes are resolved by
43:    // influence bid comparison (suite/territory.js), never by dice — there
44:    // was never a real contested roll for this category to model.
45:    roll_type:    { type: 'string', enum: ['social', 'resistance', 'custom'] },
46:    challenger_pool: { type: 'integer', minimum: 0, maximum: 30 },
47:    // crd.1: no longer REQUIRED. It used to be attacker-submitted at creation
48:    // time, which meant the opposing player asserted the defender's own
49:    // resistance number with no defender input at any point before the dice
50:    // were rolled. It becomes server-computed at resolution time (crd.3a); a
51:    // pending challenge between creation and resolution genuinely has none.
52:    defender_pool:   { type: 'integer', minimum: 0, maximum: 30 },
53:    // crd.1: the defender's SUBMITTED resolution choices. All optional at
54:    // creation — they are only ever populated later, by crd.3a's resolve
55:    // endpoint, never by POST /. Listed here (rather than left to fall
56:    // through) because additionalProperties: false still holds.
57:    defender_aspect:    { type: 'string', enum: ['mental', 'social', 'physical'] },
58:    // Boolean, not an integer: the real Willpower rule caps a spend at one
59:    // point per action, so the only question is whether it was spent.
60:    defender_wp_spent:  { type: 'boolean' },
61:    defender_merit_ids: { type: 'array', items: { type: 'string' } },
62:    // crd.4a: which term the defender chose in the at-Court City Status
63:    // advantage gate (Blood Potency vs the City-Status difference). Only
64:    // ever populated by /resolve when the gate is open for this challenge;
65:    // null otherwise (the overwhelming majority case). Listed here for the
66:    // same declared-shape completeness reason defender_aspect etc. are,
67:    // even though this route has no validate() middleware.
68:    defender_status_term: { type: ['string', 'null'], enum: ['bp', 'city', null] },
69:    power_name:   { type: 'string' },
70:  },
71:};

