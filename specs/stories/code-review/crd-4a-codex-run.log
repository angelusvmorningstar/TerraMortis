401:router.put('/:id/void', requireRole('st'), async (req, res) => {
402:  let oid;
403:  try { oid = new ObjectId(req.params.id); } catch {
404:    return res.status(400).json({ error: 'VALIDATION_ERROR', message: 'Invalid ID format' });
405:  }
406:
407:  // oaq.2 review finding: this collection now also carries pending Status
408:  // Actions (request_type: 'status_action'), which have their own
409:  // accept/decline lifecycle in office-actions.js. Without this guard, an
410:  // ST could void a pending Status Action here — a status neither route
411:  // family recognizes, permanently orphaning the record (office-actions.js's
412:  // own _findPending only ever matches status:'pending', so a 'voided'
413:  // record becomes unreachable by either the correct accept or decline).
414:  // gdx.12: same reasoning extends to Humanity Checks (request_type:
415:  // 'humanity_check', humanity-check.js's own accept/decline lifecycle).
416:  const result = await col().updateOne(
417:    { _id: oid, request_type: { $nin: ['status_action', 'humanity_check'] } },
418:    { $set: { status: 'voided', updated_at: new Date().toISOString() } }
419:  );
420:  if (!result.matchedCount) return res.status(404).json({ error: 'NOT_FOUND' });
421:
422:  res.json(await col().findOne({ _id: oid }));
