  DISCORD_REDIRECT_URI: process.env.DISCORD_REDIRECT_URI || 'http://localhost:8080/login.html',

  // Allowed ST Discord IDs
  ST_IDS: (process.env.ST_IDS || '').split(',').filter(Boolean),
};

