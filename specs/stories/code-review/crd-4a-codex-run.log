187:/**
188: * Find a character's regent territory from the territories array.
189: * Returns { territory, territoryId, slug, lieutenantId, ambience } or null.
190: *
191: * Pure function — recomputes on every call. Per issue #13 Surface 2 (audit
192: * 2026-05-05), the previous c._regentTerritory cache could go stale when a
193: * regent or ambience changed mid-session because no bust-on-write hook
194: * existed. Recomputing on every call is O(N) over a 5-element territories
195: * array; the caching layer was an unnecessary optimisation that introduced
196: * a class of display-stale bugs.
197: */
198:export function findRegentTerritory(territories, c) {
199:  if (!territories || !c) return null;
200:  const cid = String(c._id);
201:  // Prefer canonical territories over stale/orphaned duplicates (issue #216).
202:  // If multiple docs match the same regent_id, the one whose slug appears in
203:  // TERRITORY_DATA wins; otherwise the first match is used as a safe fallback.
204:  const canonicalSlugs = new Set(TERRITORY_DATA.map(td => td.slug));
205:  const matches = territories.filter(t => t.regent_id === cid);
206:  if (!matches.length) return null;
207:  const t = matches.find(m => canonicalSlugs.has(m.slug)) || matches[0];
208:  // territoryId is the canonical FK (Mongo _id, stringified) per ADR-002.
209:  // slug is exposed alongside for callers that need to match against legacy
210:  // slug-variant strings (e.g. submissions feeding_territories keys, Q4).
211:  return {
212:    territory: t.name || t.slug,
213:    territoryId: String(t._id),
214:    slug: t.slug || null,
215:    lieutenantId: t.lieutenant_id || null,
216:    ambience: t.ambience || null,
217:  };
218:}
