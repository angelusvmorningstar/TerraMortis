249:export function isSpecs(c) {
250:  const results = [];
251:  for (const m of (c.merits || [])) {
252:    if (m.name?.toLowerCase() !== 'interdisciplinary specialty') continue;
253:    const q = m.qualifier || '';
254:    if (!q) continue;
255:    let fromSkill = null;
256:    for (const [skillName, so] of Object.entries(c.skills || {})) {
257:      if ((so.specs || []).some(s => s.toLowerCase() === q.toLowerCase())) {
258:        fromSkill = skillName;
259:        break;
260:      }
261:    }
262:    if (fromSkill) results.push({ spec: q, fromSkill });
263:  }
264:  return results;
265:}
