public/js\dev-fixtures.js:12:var DT_CYCLES=[{"_id":"69d0a3c5052b57f6be774e69","label":"Downtime 2","game_number":2,"status":"closed","loaded_at":"2026-04-04T05:38:13.443Z","submission_count":29,"deadline_at":"2026-04-08T15:00:00.000Z","regency_character_id":null,"regency_character_name":null,"discipline_profile":{"harbour":{"Dominate":1,"Obfuscate":1,"Nightmare":2,"Vigour":2},"northshore":{"Auspex":2,"Obfuscate":1,"Majesty":1},"secondcity":{"Dominate":1,"Majesty":2},"dockyards":{"Obfuscate":5,"Celerity":1},"academy":{"Obfuscate":2,"Dominate":2,"Majesty":1}},"confirmed_ambience":{"academy":{"ambience":"Tended","ambienceMod":2},"dockyards":{"ambience":"Neglected","ambienceMod":-3},"harbour":{"ambience":"Settled","ambienceMod":0},"northshore":{"ambience":"Curated","ambienceMod":3},"secondcity":{"ambience":"Curated","ambienceMod":3}},"closed_at":"2026-04-17T08:34:40.499Z","ambience_applied":true},{"_id":"dev0000000000000000000dt3","label":"Downtime 3","game_number":3,"status":"open","loaded_at":"2026-04-19T00:00:00.000Z","deadline_at":"2026-05-03T15:00:00.000Z"}];
public/js\dev-fixtures.js:13:var DT_SUBS=[{"_id":"69da323ccc5483a3c77027a0","chapter_id":"69d0a3c5052b57f6be774e69","character_id":"69d720427fdd1b1f9498b0d4","character_name":"Yusuf Mammon Kalusicj","player_name":"Peter Kalt","status":"submitted","timestamp":"8/04/2026 18:56","attended":true,"_raw":{"submission":{"timestamp":"8/04/2026 18:56","email":"pkalt1970@gmail.com","player_name":"Peter Kalt","character_name":"Yusuf Mammon Kalusicj","attended_last_game":true},"narrative":{"travel_description":"I travelled using Obs 1 probably on public transport, maybe an Uber. Hung out in the shadows around the area maybe an hour or two before start. There was the usual Ruse of a VVIP pickup with security detail, earpieces, the whole bit! I had some minor celebrities in evening gowns manipulated/encouraged to participate in the entourage. I entered the vehicle as it arrived at Court (obs2). Visibly walked from limo to doorway/elevator/bouncer. Limousine departs with celebs in tow for a night at the Star Casino once I am out.","game_recount":"- tried to meet all the new players (1st time) so really just engaged in character with all players that would have the chat in character. There was the odd notable blanking and rudeness (presumably IC for \"lore reasons\"). No powers or spending influence.\n\n- Premier finally addressed Carthians after keeping us waiting and proceeded to: set rules; offer explanations as to why this experiment needed to be done in a particular way; copped the verbal bluster of various Carthians trying to state covenant parity; stated a plan to restrict Elders and Blood Potency city-wide because \"YOUNG\" and \"EXPERIMENT\". Yusuf offered support to Carthian principles. tsk.\n\n- Met with the other Carthians who seemed more concerned with establishing the rules for the committee to police each others behaviour according to a new rubric. One carefully designed so that all roles - EXCEPT PREMIER FOR SOME REASON - are shared like a fucking conch shell, so that no one can claim Regency except as proxy for the Movement. lol\n\n- Noticed duplicitous dealings involving Invictus but had the Premier rudely \"send me away\"\n\n- Made a ploy for Regency of Harbour against Reed to test the level of support. I did not manage to get a meeting with the Premier in time, or they forgot, whatever. My name was likely not even on the ballot. Just as well - I never found the voting box to place my influence. haha. OOC n00b.","standout_rp":"Ludika - young Invictus (mekhet I think, maybe Ventrue - OOC I could NOT read any tags or sheets in the game unfortunately vision impairment). We had a fascinating IC conversation. She had real questions... Conrad Sonderguard. His innocent probing and gentle banter. Get close to that guy. Sneakiest bastard in court I reckon. Great IC interactions.","ic_correspondence":"X\nHave [RE]cent eve[N]ts hav[E] [ST]unne[D] me[?]\n[CARTHIAN] work[S] ar[E] quite[T] [UP]lifting.\n[NE]v[E]r woul[D you] [H]av[E] mo[RE] joy [AS AP]pealing as this new experiment.\n\nÝ̵̧̭Ù̴͓̐́S̵̟͖̐̑Ù̴͑́͝F̴͌̾̄͠","most_trusted_pc":"`Einar TechnoViking` - perhaps. He seems ready to stand up to the Premier when they cross the line and betray Carthian principles but a little slow to see that line has already been crossed.","actively_harming_pc":"Rene StD (Invictus), the real seat of power and influence in Sydney. THe worm in the Premiers ear. I have a verbal truce to work with, rather than against, Reed Justice (Conan) and I am happy to be true to that arrangement. But....Rene..... He's Invictus \"Team Captian\", Primogen, Regent of Docks, presumably way up in his clan status too. this guy has peak influence, more city status than the Premier probably.... Why has no one noticed? Am I living in LALA land?","aspirations":"Yusuf feels isolated and unsupported. The Mammon Cult (MMN) is in formative stage, but I dont really have any surety to bother building it up just for someone else to take. At the same time I have not been subtle with its presence. The cult served its initial purpose - the contrivance to get me to Sydney. It stands out as a target. Perhaps I will set it up at this stage as a honey-pot to lure investigation and actions of other kindred. I see the cult as a presently useful expendable asset.\n\nI am guest everywhere, marginalised even in the Covenant. Yusuf has a job here in Sydney - to protect Brandy. But he sees both her and Eve witless puppets on a string of more organised powers. A dangerous predicament. Yusuf must help himself first. Hence taking OBS5. And working on his lair. Mt plans are to get safe and embedded. This court seems like a dangerours and specially curated fishbowl designed to fail. I worry about the consequences for the Carthian Movement. I fear we have been trojan horsed by Eve with a plan to humiliate the movement on the global stage as the \"Carthian Experiment\" fails spectacularly.\n\nIt is unlikely building clan status within the Carthians will be viable. They are riven, misguided and working against their own interests. Eve has already cleverly seen to that. Handing out boons to those who are giddy with the proximity to praxis and ignoring those not actively bending knee. The younger Carthians in the movement seem enthusiastic to embrace a \"lets see hoe THEY like it attitude, rather than a lets do this properly\".\n\nThe City status game is meta-unstable and already stitched up. There are inner and outer cliques quickly forming and Yusuf sees no way into the inner cliques. So Yusuf must build.... \nwith what he has left in the space left to him. THE SEWERS.\n\nThe sewers and catacombs in the territory no one bothered wanting... with his Clan - the Nosferatu. There are not many Nos, and they don't usually play well - not with others and not with themselves. I will make a place in the catacombs. I will open it to others of my kind. I will see who will come to the Necropolis once it is built. The first bricks are laid in this downtime.\n\nSHORT: GET MYSELF SAFE\nMEDIUM: BUILD THE NOS, PROTECT MMN\nLONG: NECROPOLIS UNDER THEIR FEET"},"regency":{"is_regent":false,"territory":null,"residency_grants":[],"total_residency_count":null,"regency_action":null},"feeding":{"method":"Presence 4 + Empathy 3 + Spec: Motives 1 = 12\nType: HUMAN blood\nStyle: I like the homeless people. The cold, dark and rains drive them into the corners where this crawler creeps. Face-in-the-crowd Yusuf blends in. He likes the dirt and the smell. \nHe likes the taste, a goon-bag of wine and a blanket are gifts enough. They sit and talk about their shit lives. Yusufs life was probably shitter, but at least they feel it, Yusuf thinks. And he tastes the goon-bag and hardship in them equally. He drinks at the end of the bin-fire in the hours just before dawn - never killing these.... no never killing. This is an act of sharing in my mind... lol\n\n*Normally* he eats from his HERD of Bankers and the Elites from behind the Mammon throne. Expensive cologne, pressed shirts. They offer their necks up - ecstatic and trembling.\n\nIt is a bland feast and sometime you just need \"home*less-cooking\".","territories":{"The Academy":"Not feeding here","The Harbour":"Resident","The Dockyards":"Not feeding here","The Second City":"Not feeding here","The North Shore":"Resident","The Barrens (No Territory)":"Not feeding here"}},"influence":{"The Academy":0,"The Harbour":2,"The Dockyards":0,"The Second City":1,"The Shore":2},"projects":[{"action_type":"xp_spend","action_type_raw":"XP Spend: Grow your character 🌱","primary_pool":{"expression":"Automatic","size":null},"secondary_pool":null,"desired_outcome":"Discipline: OBFUSCATE 5","description":"Project Name: Very Very Sneaky\nCharacters: ME\nXP SPEND: 3\nMerits: Safe Place 1\nLearn Obfuscate 5. Use Oubliette Power on my safe place lair in the under-Harbour.","project_name":"Very Very Sneaky","characters":"ME","xp_spend":3,"merits":"Safe Place 1","bonuses":null,"detail":"Learn Obfuscate 5. Use Oubliette Power on my safe place lair in the under-Harbour."},{"action_type":"ambience_increase","action_type_raw":"Ambience Change (Increase): Make a Territory delicious 😄","primary_pool":{"expression":"Presence 4 + Intimidation 4 + Spec(Veiled threat) 1 + Air of Menace 2 + Nightmare 4 = 15","size":15},"secondary_pool":{"expression":"Skulk about: Manipulation 3 + Subterfuge 3 + Obfusicate 5 = 11","size":11},"desired_outcome":"Make the sewers under the Harbour territory suitable for Nosferatu inhabitation","description":"Project Name: A fear cleanse of the Burrows\nCharacters: Me \nMerits: Air of Menace\nXP: None\nDescription: I am physically taking myself physically through whatever tunnels I can get access to. The deeper and weirder the better. Appearing as familiar maintenance crew using OBS or simply invisible - i root around down there spreading terror. Moving out the Cave Clan (Human sydney-based subterraneanist community irl) using dread presence and waking terror (nightmare 4). Making it very inhospitable. It will help motivate the \"emergency works\" needed to seal it off... cf Mystery Cult Acquisition action","project_name":"A fear cleanse of the Burrows","characters":"Me","xp_spend":null,"merits":"Air of Menace","bonuses":null,"detail":"I am physically taking myself physically through whatever tunnels I can get access to. The deeper and weirder the better. Appearing as familiar maintenance crew using OBS or simply invisible - i root around down there spreading terror. Moving out the Cave Clan (Human sydney-based subterraneanist community irl) using dread presence and waking terror (nightmare 4). Making it very inhospitable. It will help motivate the \"emergency works\" needed to seal it off... cf Mystery Cult Acquisition action"},{"action_type":"misc","action_type_raw":"Misc: For things that don't fit in other catagories 🤷‍♂️","primary_pool":null,"secondary_pool":null,"desired_outcome":"Move Safe Place 1 into Under Harbour","description":"NAME: A rotten Nest\nCAST: Me\nMERITS: Safe Place 1\nXP: NONE\nDESC: I am starting to setup my own personal space in the underHarbour as it opens. A large Siphon. The access to it is presently a little too open. Too many routes still in and out that are mortal traversible, but it will be a great space with work. Whilst waiting for the future construction mods and investment, I move my possessions, set up a small lair, and shed the vitae to hide it, twist it, and make it a suitable nightmare churn-funnel so that Yusuf feels confident he would hear distant screams and not the sounds of approach...","project_name":"A rotten Nest","characters":"Me","xp_spend":null,"merits":"Safe Place 1","bonuses":null,"detail":"I am starting to setup my own personal space in the underHarbour as it opens. A large Siphon. The access to it is presently a little too open. Too many routes still in and out that are mortal traversible, but it will be a great space with work. Whilst waiting for the future construction mods and investment, I move my possessions, set up a small lair, and shed the vitae to hide it, twist it, and make it a suitable nightmare churn-funnel so that Yusuf feels confident he would hear distant screams and not the sounds of approach..."},{"action_type":"misc","action_type_raw":"Misc: For things that don't fit in other catagories 🤷‍♂️","primary_pool":{"expression":"Msytery Cult Initiate 5","size":5},"secondary_pool":{"expression":"Presence 4 + Empathy 4","size":8},"desired_outcome":"Maintain Mystery Cult status","description":"NAME: \"MMN Sees\"\nCAST: ME\nBONUSES:\nDESC: This is the required DT action to keep the whole Mystery Cult apparatus going. Mainting networks, grooming new members, allocating resources, solving the odd mortal cult issue. I am supporting the Mammons cult activities in the SHORE","project_name":"\"MMN Sees\"","characters":"ME","xp_spend":null,"merits":null,"bonuses":null,"detail":"This is the required DT action to keep the whole Mystery Cult apparatus going. Mainting networks, grooming new members, allocating resources, solving the odd mortal cult issue. I am supporting the Mammons cult activities in the SHORE"}],"sphere_actions":[{"merit_type":"Allies 3 (Finance)","action_type":"Ambience Change (Increase): Make a Territory delicious 😄","desired_outcome":"Increase the SHORE ambience","description":"The Mammon cult may not be good for elite members, but on their climb up its ranks the entropy of their climb maketh the garden more verdant for all kindred...","dice_pool":{"expression":"Allies 3 (Finance)","size":3}},{"merit_type":"Allies 2 (Politics)","action_type":"Ambience Change (Increase): Make a Territory delicious 😄","desired_outcome":"INCREASE the HARBOUR ambience","description":"The subtle pro-kindred enshittification of Sydney Harbour after dark. (For the Nos 3am vibe baby!!!)The territory will be both better (for all) and worse (for mortals) in a clever way. Events will simultaneously draw people into the Harbour district, but stupid track-works close down public transport just as events let out forcing walks home. Public works for safety that actually break existing lighting. Energy saving initatives means that there is dim-lights but far apart. cost savings. it is almost like the bad ideas are deliberate....","dice_pool":{"expression":"Allies 2 (Politics)","size":2}},{"merit_type":"Mystery Cult Initiate","action_type":"Acquisition: Use your standing in Status/Mystery Cult to procure an item 💵","desired_outcome":"Reserve/Block access to chunks of sewer/rail networks","description":"The network of influence in Politics and Finance that is the MMN cult reaps its rewards in greased palms. The right bribe, the right contract, the right environmental report. Volia - whole chunks of subterranean tunnels sealed off with special works here - accidental concrete spill there, sealed off for the M11 tunnel. Tunnels, mostly bare, ugly, damp, infested. But directly underneath and nowhere all at once! It is a patchwork of forgotten RTA service tunnels, WW2 shuttered ammunition tunnels, redundant storm-water catchment sumps, etc... It is not ownership per se. It is sealing the entry points off little clusters and burying them administratively so they are nobody's business.","dice_pool":{"expression":"Mystery Cult Initiate","size":null}}],"contact_actions":{"has_contacts":true,"requests":["Contact Type: STREET\nSupporting Info: rumours of a vigiliantee in the Harbour\nRequest: The word on the street is Ballsack is rolling in the lower tiers as a vigilantee. I want details. Is this some kind of Punisher style murderer using vigilantism as a justification to kill or is there a daredevil style hand targeting the previously untouchables? The street contacts may have anecdotes and better rumours. What is his caper? I am trying to find out the why more than the what.","Contact Type: LEGAL\nSupporting Info: Previous DT searches in Finince Sphere\nRequest: Last months search indicated that there is another player with established Allies Finance in the game. A inquiry/ exposé on multi-nationals will be a good chance to look into new players in detail. (Avoid Reed Justice)","Contact Type: UNDERWORLD\nSupporting Info: whos fucking with the Harbour\nRequest: Who is dedicating any efforts to systematically messing with Harbour infrastrucure"]},"retainer_actions":{"has_retainers":false,"actions":[]},"acquisitions":{"has_acquisitions":true,"resource_acquisitions":"Character Resources Level: 3\nRelevant Merit: Allies (Finance)\nRes-Acq 1 Description: A continued investment in the maintenance of decoration of the MMN cult premises in the Shore. This is not security, the facility has no real security at this stage. I want it to LOOK like a VEILED THREAT, an obviously and SUSPICIOUSLY open target. It is what it is. \"Like an obviously armed homeowner trying to trigger castle-doctrine\". Any thinking kindred is being invited to look and think twice.\nRes-Acq 1 Availability: 3","skill_acquisitions":"Character Skill Level: Intimidate 4 + Spec: Veiled Threats 1\nRelevant Merit: Air of Menace +2, Contacts (Police)\nSkill-Aqu # Description: Surveillance Thermal Cameras x3 with LoRaWanMesh Monitors x2 (Advanced - Encrypted Piezo-powered)\nSkill-Aqu # Availability: 3 (+1 for the advanced I guess ST?) = 4"},"ritual_casting":{"has_rituals":false,"casting":null},"meta":{"st_notes":"yes.The surveillance cameras I am trying to procure are a gift for Conrad Sunderland. I will pass them on with the full chain-of-custody documentation that certifies they are not manipulated or modified in any way between the Israeli manufacturer and his secured delivery. It is up to his discretion whether to trust that - but I have not manipulated the cameras in any way. I make it very clear that these cameras are a gift, without strings or obligation attached and he is free to use them however he likes but he must note that there are 2 monitor portals for the cameras (there are 3 cams) and I have the second one. In the spirit of \"a pleasure shared is a pleasure doubled\". I will contact the player IC on Discord with my \"attempt\". I guess rolls will determine if it came off to secure them...\n\nMy nights are focused with either managing the cult of Mammons activities, which I see like a job taking several half nights every week. This occurs in the Shore. One of those, I will stop by the Crone Temple on night of service - explaining that the Mother offered invite that I have spontaneously accepted. (all true except the spontaneous part). This attendance is lip service to my Hostesses in the Shore. My initial actual curiosity in the sermon is minimal. But I have never actually witnessed any REAL CRUAC up close before and it might just be a surprise awakening. I should let Mother Crone Anichka roll against my Resolve+BP probably to see how compelling her sermon is. ;)\n\nI like to inhabit the Harbour now. I like it neglected to be honest and I want to savour the shittyness before the kindred money moves in. I supplemnent herd feeding there. I lurk and menace. I want the sewers (only) to be a place of twisted vibes. particularly the near the manholes, drains and rail maintenance tunnels adjacent to my Safe Place. I want everything to avoid those corners except the cockies.\n\nThis serves the long-term goal to establish a SafePlace/Warren/Necropolis for the Nos.\n[!!!] Im not going for any mechanical benefit from Nos rulebook. My XP is pre-spent in my head for the next 2 years... lol. At most I am trying to build up my own Clan status, by embodying peak-Nos'ness, supporting other clanspeeps, and reaching out along Nos lines so that the other Nos know the I/WE ARE here, lurking too. I'd be cool if we share SafePlace merits together, and my OBS5 Oubliette can make for a truly BIZONKERS commons. I reckon its narratively cool and want to try to get traction next game... I hope the STs agree?","xp_spend":"XP Claimed: 3\nTotal XP Spent: 3\nProject 1: 3XP","lore_questions":"GROW action and requirements. how that interacts with territory. which territories have which social groups as focused isn't super clear how that all works. Do I need to be regent of the Shore to scramble for Allies 5? Can the regent of the shore strip that?","form_rating":1,"form_comments":"it would be cool if you had, like, a dedicated website or something, .... Should only take a couple of days.... week tops! ;)"},"_character_id":"69d720427fdd1b1f9498b0d4"},"responses":{"travel":"I travelled using Obs 1 probably on public transport, maybe an Uber. Hung out in the shadows around the area maybe an hour or two before start. There was the usual Ruse of a VVIP pickup with security detail, earpieces, the whole bit! I had some minor celebrities in evening gowns manipulated/encouraged to participate in the entourage. I entered the vehicle as it arrived at Court (obs2). Visibly walked from limo to doorway/elevator/bouncer. Limousine departs with celebs in tow for a night at the Star Casino once I am out.","game_recount":"- tried to meet all the new players (1st time) so really just engaged in character with all players that would have the chat in character. There was the odd notable blanking and rudeness (presumably IC for \"lore reasons\"). No powers or spending influence.\n\n- Premier finally addressed Carthians after keeping us waiting and proceeded to: set rules; offer explanations as to why this experiment needed to be done in a particular way; copped the verbal bluster of various Carthians trying to state covenant parity; stated a plan to restrict Elders and Blood Potency city-wide because \"YOUNG\" and \"EXPERIMENT\". Yusuf offered support to Carthian principles. tsk.\n\n- Met with the other Carthians who seemed more concerned with establishing the rules for the committee to police each others behaviour according to a new rubric. One carefully designed so that all roles - EXCEPT PREMIER FOR SOME REASON - are shared like a fucking conch shell, so that no one can claim Regency except as proxy for the Movement. lol\n\n- Noticed duplicitous dealings involving Invictus but had the Premier rudely \"send me away\"\n\n- Made a ploy for Regency of Harbour against Reed to test the level of support. I did not manage to get a meeting with the Premier in time, or they forgot, whatever. My name was likely not even on the ballot. Just as well - I never found the voting box to place my influence. haha. OOC n00b.","correspondence":"X\nHave [RE]cent eve[N]ts hav[E] [ST]unne[D] me[?]\n[CARTHIAN] work[S] ar[E] quite[T] [UP]lifting.\n[NE]v[E]r woul[D you] [H]av[E] mo[RE] joy [AS AP]pealing as this new experiment.\n\nÝ̵̧̭Ù̴͓̐́S̵̟͖̐̑Ù̴͑́͝F̴͌̾̄͠","trust":"`Einar TechnoViking` - perhaps. He seems ready to stand up to the Premier when they cross the line and betray Carthian principles but a little slow to see that line has already been crossed.","harm":"Rene StD (Invictus), the real seat of power and influence in Sydney. THe worm in the Premiers ear. I have a verbal truce to work with, rather than against, Reed Justice (Conan) and I am happy to be true to that arrangement. But....Rene..... He's Invictus \"Team Captian\", Primogen, Regent of Docks, presumably way up in his clan status too. this guy has peak influence, more city status than the Premier probably.... Why has no one noticed? Am I living in LALA land?","aspirations":"Yusuf feels isolated and unsupported. The Mammon Cult (MMN) is in formative stage, but I dont really have any surety to bother building it up just for someone else to take. At the same time I have not been subtle with its presence. The cult served its initial purpose - the contrivance to get me to Sydney. It stands out as a target. Perhaps I will set it up at this stage as a honey-pot to lure investigation and actions of other kindred. I see the cult as a presently useful expendable asset.\n\nI am guest everywhere, marginalised even in the Covenant. Yusuf has a job here in Sydney - to protect Brandy. But he sees both her and Eve witless puppets on a string of more organised powers. A dangerous predicament. Yusuf must help himself first. Hence taking OBS5. And working on his lair. Mt plans are to get safe and embedded. This court seems like a dangerours and specially curated fishbowl designed to fail. I worry about the consequences for the Carthian Movement. I fear we have been trojan horsed by Eve with a plan to humiliate the movement on the global stage as the \"Carthian Experiment\" fails spectacularly.\n\nIt is unlikely building clan status within the Carthians will be viable. They are riven, misguided and working against their own interests. Eve has already cleverly seen to that. Handing out boons to those who are giddy with the proximity to praxis and ignoring those not actively bending knee. The younger Carthians in the movement seem enthusiastic to embrace a \"lets see hoe THEY like it attitude, rather than a lets do this properly\".\n\nThe City status game is meta-unstable and already stitched up. There are inner and outer cliques quickly forming and Yusuf sees no way into the inner cliques. So Yusuf must build.... \nwith what he has left in the space left to him. THE SEWERS.\n\nThe sewers and catacombs in the territory no one bothered wanting... with his Clan - the Nosferatu. There are not many Nos, and they don't usually play well - not with others and not with themselves. I will make a place in the catacombs. I will open it to others of my kind. I will see who will come to the Necropolis once it is built. The first bricks are laid in this downtime.\n\nSHORT: GET MYSELF SAFE\nMEDIUM: BUILD THE NOS, PROTECT MMN\nLONG: NECROPOLIS UNDER THEIR FEET","rp_shoutout":"[\"Ludika - young Invictus (mekhet I think\",\"maybe Ventrue - OOC I could NOT read any tags or sheets in the game unfortunately vision impairment). We had a fascinating IC conversation. She had real questions... Conrad Sonderguard. His innocent probing and gentle banter. Get close to that guy. Sneakiest bastard in court I reckon. Great IC interactions.\"]","_gate_is_regent":"no","_feed_method":"other","feeding_description":"Presence 4 + Empathy 3 + Spec: Motives 1 = 12\nType: HUMAN blood\nStyle: I like the homeless people. The cold, dark and rains drive them into the corners where this crawler creeps. Face-in-the-crowd Yusuf blends in. He likes the dirt and the smell. \nHe likes the taste, a goon-bag of wine and a blanket are gifts enough. They sit and talk about their shit lives. Yusufs life was probably shitter, but at least they feel it, Yusuf thinks. And he tastes the goon-bag and hardship in them equally. He drinks at the end of the bin-fire in the hours just before dawn - never killing these.... no never killing. This is an act of sharing in my mind... lol\n\n*Normally* he eats from his HERD of Bankers and the Elites from behind the Mammon throne. Expensive cologne, pressed shirts. They offer their necks up - ecstatic and trembling.\n\nIt is a bland feast and sometime you just need \"home*less-cooking\".","feeding_territories":"{\"the_acad