  38:     request_type: { type: 'string', enum: ['contested_roll'] },
  39:     // roll_type categorises the CONTEST for session-log/display purposes.
  40:     // It is a different axis from defender_aspect below (which Resistance
  41:     // Attribute feeds the defender's pool) — do not derive one from the other.
  42:     // 'territory' removed 2026-08-24: territory disputes are resolved by
