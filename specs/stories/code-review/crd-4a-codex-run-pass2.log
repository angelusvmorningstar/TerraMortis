  12:  * by the ABSENCE of one — see the note on that property below.
  13:  */
  14: 
  15: export const contestedRollRequestSchema = {
  16:   $schema: 'http://json-schema.org/draft-07/schema#',
  17:   title: 'TM Contested Roll Request',
  18:   type: 'object',
  19:   required: [
  20:     'challenger_character_id',
  21:     'challenger_character_name',
  22:     'target_character_id',
  23:     'target_character_name',
  24:     'roll_type',
  25:     'challenger_pool',
  26:   ],
  27:   additionalProperties: false,
  28:   properties: {
  29:     challenger_character_id:   { type: 'string', minLength: 1 },
  30:     challenger_character_name: { type: 'string', minLength: 1 },
  31:     target_character_id:       { type: 'string', minLength: 1 },
  32:     target_character_name:     { type: 'string', minLength: 1 },
  33:     // crd.1: NOT required. Omitting it is still valid for any caller that
  34:     // doesn't set it; contested-rolls.js's own POST / always sets it
