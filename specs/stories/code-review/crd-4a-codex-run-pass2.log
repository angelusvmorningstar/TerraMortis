  27: import { describe, it, expect, beforeAll, beforeEach, afterAll } from 'vitest';
  28: import request from 'supertest';
  29: import { createTestApp, playerUser } from './helpers/test-app.js';
  30: import { setupDb, teardownDb, isDbAvailable } from './helpers/db-setup.js';
  31: import { getCollection } from '../db.js';
  32: import { ObjectId } from 'mongodb';
  33: 
  34: const dbAvailable = await isDbAvailable();
  35: 
  36: let app;
  37: const NAME_PREFIX = 'CRD-4A Probe';
  38: const GAME_NUMBER = 977; // distinctive, well above any other fixture's game_number
  39: 
  40: const seededCharIds = [];
  41: 
  42: async function seedChar({ city = 0, bloodPotency = 3, courtCategory = null } = {}) {
  43:   const { insertedId } = await getCollection('characters').insertOne({
  44:     name: `${NAME_PREFIX} Char ${Date.now()}_${Math.random()}`,
  45:     retired: false,
  46:     attributes: { Resolve: { dots: 2, bonus: 0 }, Composure: { dots: 2, bonus: 0 }, Stamina: { dots: 2, bonus: 0 } },
  47:     merits: [],
  48:     blood_potency: bloodPotency,
  49:     status: { city },
  50:     court_category: courtCategory,
  51:   });
  52:   seededCharIds.push(insertedId);
  53:   return insertedId;
  54: }
  55: 
  56: async function seedChallenge(defenderOid, challengerOid, overrides = {}) {
  57:   const base = {
  58:     challenger_character_id:   String(challengerOid),
  59:     challenger_character_name: `${NAME_PREFIX} Challenger`,
  60:     target_character_id:       String(defenderOid),
  61:     target_character_name:     `${NAME_PREFIX} Target`,
  62:     roll_type:       'resistance',
  63:     challenger_pool: 5,
  64:     power_name:      'Majesty',
  65:     request_type:    'contested_roll',
  66:     status:          'pending',
  67:     outcome:         null,
  68:     created_at:      new Date().toISOString(),
  69:     updated_at:      new Date().toISOString(),
  70:     ...overrides,
  71:   };
  72:   const { insertedId } = await getCollection('contested_roll_requests').insertOne(base);
  73:   return String(insertedId);
  74: }
  75: 
  76: // otc-2's own established defensive pattern: currentCycleInGamePhase picks
  77: // the single highest-game_number chapter across the WHOLE shared test
  78: // database, so a leftover from another file could otherwise outrank this
  79: // one — full wipe first, matching that precedent exactly.
  80: async function seedChapter(phase = 'game') {
  81:   await getCollection('chapters').deleteMany({});
  82:   await getCollection('chapters').insertOne({
  83:     label: `${NAME_PREFIX} Cycle`, phase, game_number: GAME_NUMBER,
  84:   });
  85: }
  86: 
  87: async function seedNoChapter() {
  88:   await getCollection('chapters').deleteMany({});
  89: }
  90: 
  91: // Mirrors findLatestSession()'s own defensive pattern (otc-2): the gate's
  92: // own attendance lookup sorts game_sessions by session_date desc, so a
  93: // leftover from another file with today's date could otherwise outrank this
  94: // one — clear every session at-or-before today first.
  95: async function seedSession(attendance) {
  96:   const today = new Date().toISOString().slice(0, 10);
  97:   await getCollection('game_sessions').deleteMany({ session_date: { $lte: today } });
  98:   await getCollection('game_sessions').insertOne({
  99:     title: `${NAME_PREFIX} Session`,
 100:     session_date: today,
 101:     game_number: GAME_NUMBER,
 102:     attendance,
 103:   });
 104: }
 105: 
 106: async function seedNoSession() {
 107:   const today = new Date().toISOString().slice(0, 10);
 108:   await getCollection('game_sessions').deleteMany({ session_date: { $lte: today } });
 109: }
 110: 
 111: function bothAttended(defenderOid, challengerOid) {
 112:   return [
 113:     { character_id: String(defenderOid),   character_name: `${NAME_PREFIX} Target`,     attended: true },
 114:     { character_id: String(challengerOid), character_name: `${NAME_PREFIX} Challenger`, attended: true },
 115:   ];
 116: }
 117: 
 118: function defenderUser(targetOid) { return playerUser([targetOid.toString()]); }
 119: 
 120: function resolveReq(id, body, user) {
 121:   return request(app).put(`/api/contested_roll_requests/${id}/resolve`).set('X-Test-User', user).send(body);
 122: }
 123: 
 124: async function cleanup() {
 125:   await getCollection('contested_roll_requests').deleteMany({
 126:     $or: [
 127:       { challenger_character_name: { $regex: `^${NAME_PREFIX}` } },
 128:       { target_character_name:     { $regex: `^${NAME_PREFIX}` } },
 129:     ],
 130:   });
 131:   await getCollection('characters').deleteMany({ name: { $regex: `^${NAME_PREFIX}` } });
 132:   await getCollection('territories').deleteMany({ name: { $regex: `^${NAME_PREFIX}` } });
 133:   await getCollection('chapters').deleteMany({ label: { $regex: `^${NAME_PREFIX}` } });
 134:   await getCollection('game_sessions').deleteMany({ title: { $regex: `^${NAME_PREFIX}` } });
 135: }
