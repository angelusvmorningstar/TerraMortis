_player":"Wits + Survival","pool_validated":"Wits 3 + Survival 3 = 6","pool_status":"validated","notes_thread":[],"story_context":"The things she is seeing are Changelings. She does not know this (the player suspects).","resolved_at":null,"active_feed_specs":[],"pool_mod_spec":0,"nine_again":false,"rote":false,"eight_again":false,"pool_committed_by":"Angelus","title":"For the Others","desired_outcome":"Offer a good gift to the keepers of the land","description":"Anichka is now aware that she's on someone else's land, or relatively close to it. She has come to the decision that she probably does not want to fight these entities, guessing them to be spirits, or locals in communion with them. She spends some time putting together a small gift for them- One of her second-tier shawls, a string of pearls, and some gathered honey from native bees (hence the Survival roll). She'll top this off with a dressing of kangaroo vine with fruit still on. Trying to position as an offering of thanks, near where she saw them last. Come back, like, twice a week to see if that's been taken or nah.","merits_bonuses":"","pool_validated_by":"Angelus"}],"feeding_vitae_tally":{"herd":2,"ambience":2,"ambience_territory":"Academy","oath_of_fealty":0,"ghouls":0,"rite_cost":1,"manual":0,"total_bonus":3},"feeding_roll_player":{"cols":[{"r":{"v":10,"s":true,"x":true},"ch":[{"v":8,"s":true,"x":false}]},{"r":{"v":1,"s":false,"x":false},"ch":[]},{"r":{"v":3,"s":false,"x":false},"ch":[]},{"r":{"v":9,"s":true,"x":false},"ch":[]},{"r":{"v":3,"s":false,"x":false},"ch":[]},{"r":{"v":4,"s":false,"x":false},"ch":[]},{"r":{"v":7,"s":false,"x":false},"ch":[]}],"successes":3,"vessels":3,"safeVitae":6,"methodName":"Other","pool":7,"again":10,"breakdown":"ST confirmed: Wits 3 + Empathy 3 + 1 = 7","rolledAt":"2026-04-17T09:39:16.033Z","dramaticFailure":false},"feeding_vitae_allocation":[2,2,2]}];
